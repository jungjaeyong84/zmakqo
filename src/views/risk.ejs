<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>DONBEOLJA · 리스크</title>
  <style>
    body { font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial; margin:0; background:#fff; }
    .wrap { padding:20px; }
    .card { border:1px solid #e6e6e6; border-radius:16px; padding:18px; max-width:900px; }
    h1 { margin:0 0 8px 0; font-size:22px; }
    .muted { color:#666; font-size:12px; }
    .row { display:flex; gap:12px; flex-wrap:wrap; margin-top:14px; }
    label { font-size:12px; color:#333; display:block; margin-bottom:6px; }
    input, select { width:260px; padding:10px 12px; border:1px solid #ddd; border-radius:10px; font-size:13px; }
    .btn { display:inline-block; padding:10px 14px; border-radius:12px; border:1px solid #ddd; background:#111; color:#fff; cursor:pointer; font-size:13px; }
    .btn2 { display:inline-block; padding:10px 14px; border-radius:12px; border:1px solid #ddd; background:#fff; color:#111; cursor:pointer; font-size:13px; }
    .grid { display:grid; grid-template-columns: 1fr 1fr; gap:12px; }
    @media (max-width: 900px) { .grid { grid-template-columns:1fr; } input,select{width:100%;} }
    .status { margin-top:10px; font-size:12px; color:#0a7; }
    .err { color:#c00; }
    .kv { margin-top:10px; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New"; font-size:12px; background:#fafafa; border:1px solid #eee; padding:10px; border-radius:12px; white-space:pre-wrap; }
  

/* NAV_UNIFY_V1 */
.topbar{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin:10px 0 14px 0}
.brand{font-weight:900;letter-spacing:-0.2px}
.topnav{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.topnav a{display:inline-block;padding:7px 10px;border-radius:999px;border:1px solid #e6e6e6;background:#fff;color:#111;text-decoration:none;font-size:12px}
.topnav a.ghost{background:#fff;color:#111;opacity:.9}
.topnav a.active{background:#111;color:#fff;border-color:#111}


/* INSPECTOR_STRIP_V1 */
.inspector{display:flex;gap:8px;flex-wrap:wrap;align-items:center;justify-content:flex-end;margin-left:auto}
.inspector .chip{
  max-width:220px;
  padding:6px 10px;border-radius:999px;border:1px solid #eaeaea;
  background:#f7f7f7;color:#333;font-size:11px;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}
.inspector .chip b{color:#111;font-weight:800}

</style>
<style>
/* GLOBAL_NAV_V1 */
.topbar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:12px 0 18px 0}
.brand{font-weight:900;font-size:16px}
.topnav{display:flex;gap:8px;flex-wrap:wrap}
.topnav a{padding:7px 12px;border-radius:999px;border:1px solid #e6e6e6;
          background:#fff;color:#111;text-decoration:none;font-size:12px}
.topnav a.active{background:#111;color:#fff;border-color:#111}
.topnav a.ghost{opacity:.9}
</style>
</head>
<body>
  <div class="topbar">
    <div class="brand">DONBEOLJA Ω</div>
    <div class="topnav">
      <a href="/dashboard/home">대시보드</a>
      <a href="/dashboard/report">리포트</a>
      <a href="/dashboard/trading">거래</a>
      <a href="/dashboard/settings" class="active">설정</a>
    </div>
  </div>

  <div class="wrap">
    <div class="card">
      <h1>리스크 예산 설정</h1>
      <div class="muted">저장 즉시 다음 실행부터 적용됩니다.</div>

      <div class="row">
        <button class="btn2" id="reloadBtn">다시 불러오기</button>
        <button class="btn" id="saveBtn">저장</button>
      </div>

      <div class="grid" style="margin-top:12px;">
        <div>
          <label>사용 여부</label>
          <select id="enabled">
            <option value="1">켜짐</option>
            <option value="0">꺼짐</option>
          </select>
        </div>

        <div>
          <label>초과 시 정책</label>
          <select id="on_exceed">
            <option value="CLAMP">CLAMP (예산에 맞게 축소)</option>
            <option value="SKIP">SKIP (진입/추가진입 스킵)</option>
          </select>
        </div>

        <div>
          <label>총 예산 한도</label>
          <input id="total_max_krw" inputmode="numeric" placeholder="3000000" />
        </div>
        <div>
          <label>기본 마켓 한도</label>
          <input id="default_max_krw" inputmode="numeric" placeholder="50000" />
        </div>
      </div>

      <div style="margin-top:14px;" class="muted">마켓별 한도 (없으면 기본 한도 적용)</div>

      <div class="grid" style="margin-top:10px;">
        <div>
          <label>KRW-BTC</label>
          <input id="m_KRW-BTC" inputmode="numeric" placeholder="100000" />
        </div>
        <div>
          <label>KRW-ETH</label>
          <input id="m_KRW-ETH" inputmode="numeric" placeholder="70000" />
        </div>
        <div>
          <label>KRW-XRP</label>
          <input id="m_KRW-XRP" inputmode="numeric" placeholder="1000" />
        </div>
      </div>

      <div id="status" class="status"></div>
      <div id="raw" class="kv" style="display:none;"></div>
    </div>
  </div>

<script>
async function apiGet(path){
  const r = await fetch(path, { credentials:"include" });
  const t = await r.text();
  let j=null; try{ j=JSON.parse(t);}catch(_){}
  return { ok:r.ok, status:r.status, json:j, text:t };
}
async function apiPost(path, body){
  const r = await fetch(path, {
    method:"POST",
    headers:{ "content-type":"application/json" },
    body: JSON.stringify(body||{}),
    credentials:"include"
  });
  const t = await r.text();
  let j=null; try{ j=JSON.parse(t);}catch(_){}
  return { ok:r.ok, status:r.status, json:j, text:t };
}

function setStatus(msg, isErr){
  const el = document.getElementById("status");
  el.className = "status" + (isErr ? " err" : "");
  el.textContent = msg || "";
}

function numOrNull(v){
  const n = Number(String(v||"").replace(/,/g,"").trim());
  return Number.isFinite(n) ? n : null;
}

function fillForm(x){
  const enabled = (x && String(x.enabled) === "0") ? "0" : "1";
  document.getElementById("enabled").value = enabled;
  document.getElementById("on_exceed").value = String(x.on_exceed || "CLAMP");
  document.getElementById("total_max_krw").value = (x.total_max_krw ?? "") + "";
  document.getElementById("default_max_krw").value = (x.default_max_krw ?? "") + "";

  const by = x.by_market || {};
  for (const k of ["KRW-BTC","KRW-ETH","KRW-XRP"]) {
    const v = by[k];
    document.getElementById("m_"+k).value = (v ?? "") + "";
  }

  const raw = document.getElementById("raw");
  raw.style.display = "block";
  raw.textContent = JSON.stringify(x, null, 2);
}

async function load(){
  setStatus("불러오는 중...");
  const r = await apiGet("/api/risk/settings");
  if (!r.ok || !r.json || r.json.ok !== true){
    setStatus("불러오기 실패: " + (r.json ? JSON.stringify(r.json) : r.text), true);
    return;
  }
  fillForm(r.json.data || {});
  setStatus("불러옴");
}

async function save(){
  const payload = {
    enabled: document.getElementById("enabled").value === "1",
    on_exceed: document.getElementById("on_exceed").value,
    total_max_krw: numOrNull(document.getElementById("total_max_krw").value),
    default_max_krw: numOrNull(document.getElementById("default_max_krw").value),
    by_market: {
      "KRW-BTC": numOrNull(document.getElementById("m_KRW-BTC").value),
      "KRW-ETH": numOrNull(document.getElementById("m_KRW-ETH").value),
      "KRW-XRP": numOrNull(document.getElementById("m_KRW-XRP").value),
    }
  };

  for (const k of Object.keys(payload.by_market)) {
    if (payload.by_market[k] === null) delete payload.by_market[k];
  }
  if (payload.default_max_krw === null) payload.default_max_krw = 0;
  if (payload.total_max_krw === null) payload.total_max_krw = 0;

  setStatus("저장 중...");
  const r = await apiPost("/api/risk/settings", payload);
  if (!r.ok || !r.json || r.json.ok !== true){
    setStatus("저장 실패: " + (r.json ? JSON.stringify(r.json) : r.text), true);
    return;
  }
  setStatus("저장 완료");
  await load();
}

document.getElementById("reloadBtn").addEventListener("click", load);
document.getElementById("saveBtn").addEventListener("click", save);

load();
</script>

<script>
/* INSPECTOR_SCRIPT_V1 */
(function(){
  try{
    var elMode=document.getElementById("ins-mode");
    var elRules=document.getElementById("ins-rules");
    var elEval=document.getElementById("ins-eval");
    var elTime=document.getElementById("ins-time");
    var elPath=document.getElementById("ins-path");
    if(!elMode) return;

    // data-*가 있으면 우선 사용, 없으면 fallback
    var body=document.body;
    var mode=body.getAttribute("data-mode") || "local";
    var rules=body.getAttribute("data-rules") || "-";
    var ev=body.getAttribute("data-eval") || "-";

    // time/path는 항상 갱신 가능
    var now=new Date(Date.now() + 9*60*60*1000);
    var hh=String(now.getUTCHours()).padStart(2,"0");
    var mm=String(now.getUTCMinutes()).padStart(2,"0");
    var ss=String(now.getUTCSeconds()).padStart(2,"0");

    elMode.textContent=mode;
    elRules.textContent=rules;
    elEval.textContent=ev;
    elTime.textContent=hh+":"+mm+":"+ss;
    elPath.textContent=location.pathname;

    setInterval(function(){
      var n=new Date(Date.now() + 9*60*60*1000);
      elTime.textContent=String(n.getUTCHours()).padStart(2,"0")+":"+String(n.getUTCMinutes()).padStart(2,"0")+":"+String(n.getUTCSeconds()).padStart(2,"0");
    }, 1000);
  }catch(e){}
})();
</script>

</body>
</html>
