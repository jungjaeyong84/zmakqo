<%- include('partials/app_start_unified', { title: `${model && model.title ? model.title : '최신 전략'} · DONBEOLJA`, pageTitle: model && model.title ? model.title : '최신 전략', active: model && model.active ? model.active : 'recovery' }) %>

<style>
  .sl-line {
    padding: 12px 14px;
    border-radius: 12px;
    background: var(--md-surface-container);
    border: 1px solid var(--md-outline);
    line-height: 1.6;
    font-size: 13px;
  }
  .sl-markdown {
    white-space: pre-wrap;
    word-break: keep-all;
    line-height: 1.65;
    font-size: 13px;
    color: var(--md-on-surface);
    margin: 0;
  }
</style>

<%
  const vm = model || {};
  const latest = vm.latest || null;
  const lines = Array.isArray(latest && latest.lines) ? latest.lines : [];
  const markdown = String(vm.markdown || '').trim();
%>

<nav class="subnav">
  <%- include('partials/control_surface_nav', { active: vm.active || 'recovery' }) %>
</nav>

<div class="card">
  <div class="card-body" style="display:flex; flex-direction:column; gap:12px;">
    <div>
      <div class="body-sm text-primary" style="font-weight:700; text-transform:uppercase; letter-spacing:.08em;">최신 전략 원문</div>
      <div style="font-size:24px; font-weight:800; letter-spacing:-.03em;"><%= vm.title || '최신 전략' %></div>
      <div class="text-muted body-sm">회고에서 만든 최신 전략 원문을 그대로 읽는 화면입니다.</div>
    </div>
    <div style="display:flex; gap:8px; flex-wrap:wrap;">
      <a href="/dashboard/recovery" class="btn btn-filled">회복 현황</a>
      <a href="/dashboard/home" class="btn btn-outlined">홈으로</a>
    </div>
  </div>
</div>

<div class="grid cols-3">
  <div class="metric-card">
    <div class="metric-card-label">기간</div>
    <div class="metric-card-value"><%= vm.period || '-' %></div>
  </div>
  <div class="metric-card">
    <div class="metric-card-label">기준</div>
    <div class="metric-card-value"><%= latest && latest.source ? latest.source : '-' %></div>
  </div>
  <div class="metric-card">
    <div class="metric-card-label">갱신 시각</div>
    <div class="metric-card-value"><%= latest && latest.generated_at_kst ? latest.generated_at_kst : '-' %></div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <div class="card-title">핵심 줄</div>
    <div class="card-subtitle">최신 전략에 저장된 핵심 문장을 먼저 읽습니다.</div>
  </div>
  <div class="card-body">
    <div style="display:flex; flex-direction:column; gap:10px;">
      <% if (lines.length) { %>
        <% lines.forEach((line, index) => { %>
          <div class="sl-line"><strong><%= index + 1 %>.</strong> <%= line %></div>
        <% }) %>
      <% } else { %>
        <div class="empty-state">아직 최신 전략이 생성되지 않았습니다.</div>
      <% } %>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <div class="card-title">원문</div>
    <div class="card-subtitle">원문 스냅샷이 있으면 그대로 보여줍니다.</div>
  </div>
  <div class="card-body">
    <pre class="sl-markdown"><%= markdown || '아직 원문이 없습니다.' %></pre>
  </div>
</div>

<%- include('partials/app_end_unified') %>
