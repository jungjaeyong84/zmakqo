<%
  const __mode = String(typeof mode !== 'undefined' && mode ? mode : 'report');
  const __surfaceHref = String(typeof surfaceHref !== 'undefined' && surfaceHref ? surfaceHref : '/dashboard/home');
  const __surfaceLabel = String(typeof surfaceLabel !== 'undefined' && surfaceLabel ? surfaceLabel : 'Mission Control');
  const __detailHref = String(typeof detailHref !== 'undefined' && detailHref ? detailHref : '/dashboard/audit');
  const __detailLabel = String(typeof detailLabel !== 'undefined' && detailLabel ? detailLabel : 'Audit');
  const __extraHref = String(typeof extraHref !== 'undefined' && extraHref ? extraHref : '');
  const __extraLabel = String(typeof extraLabel !== 'undefined' && extraLabel ? extraLabel : '');
  const __kicker = __mode === 'trading' ? 'Secondary Execution View' : 'Secondary Report View';
  const __title = __mode === 'trading'
    ? 'Execution 판단의 정본은 Control Surface입니다.'
    : '운영 판단의 정본은 Mission/Audit입니다.';
  const __summary = __mode === 'trading'
    ? '이 화면은 포지션, 인텐트, 체결 저널을 세부 확인하는 보조 화면입니다. source mode, authority, deployment 판정은 Mission/Execution/Audit에서 먼저 읽습니다.'
    : '이 화면은 기간 성과와 평가를 깊게 보는 보조 화면입니다. 목표 상태, authority, deployment, blocker 판단은 Mission/Recovery/Audit에서 먼저 읽습니다.';
%>

<div class="legacy-bridge">
  <div class="legacy-bridge-copy">
    <div class="legacy-bridge-kicker"><%= __kicker %></div>
    <div class="legacy-bridge-title"><%= __title %></div>
    <div class="subtle"><%= __summary %></div>
  </div>
  <div class="legacy-bridge-actions">
    <a class="btn ghost slim" href="<%= __surfaceHref %>"><%= __surfaceLabel %></a>
    <a class="btn ghost slim" href="<%= __detailHref %>"><%= __detailLabel %></a>
    <% if (__extraHref && __extraLabel) { %>
      <a class="btn ghost slim" href="<%= __extraHref %>"><%= __extraLabel %></a>
    <% } %>
  </div>
</div>
