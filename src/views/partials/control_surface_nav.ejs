<%
  const __active = (typeof active !== 'undefined' && active) ? String(active) : 'mission';
  const __links = [
    { key: 'mission', href: '/dashboard/home', label: '전략 개요' },
    { key: 'recovery', href: '/dashboard/recovery', label: '전략 회복' },
    { key: 'deployment', href: '/dashboard/deployment', label: '전략 적용' },
    { key: 'execution', href: '/dashboard/execution', label: '거래 추적' },
    { key: 'server-primary', href: '/dashboard/server-primary', label: '전환 진행' },
    { key: 'audit', href: '/dashboard/audit', label: '기록 점검' },
  ];
%>
<div class="subnav" style="margin-top:-4px; margin-bottom:18px;">
  <% __links.forEach((link) => { %>
    <a href="<%= link.href %>" class="<%= __active === link.key ? 'active' : '' %>"><%= link.label %></a>
  <% }) %>
</div>
