<%- include('partials/app_start', { title: '저널 · DONBEOLJA Ω', pageTitle: '저널', active: 'trading' }) %>

<%
  const sideLabel = (side) => {
    const s = String(side || '').toUpperCase();
    if (s === 'BUY') return '매수';
    if (s === 'SELL') return '매도';
    if (s === 'HOLD') return '대기';
    return side || '-';
  };
  const fmtKst = (v) => {
    if (!v) return '-';
    const raw = String(v);
    if (raw.includes('KST')) return raw;
    const ms = Date.parse(raw);
    if (!Number.isFinite(ms)) return raw;
    const k = new Date(ms + 9 * 60 * 60 * 1000);
    const pad = (n) => String(n).padStart(2, '0');
    return `${k.getUTCFullYear()}-${pad(k.getUTCMonth() + 1)}-${pad(k.getUTCDate())} ${pad(k.getUTCHours())}:${pad(k.getUTCMinutes())}:${pad(k.getUTCSeconds())} KST`;
  };
  const fmtKrw = (x) => {
    const n = Number(x);
    if (!Number.isFinite(n)) return '-';
    const cut = Math.trunc(n / 10) * 10;
    return cut.toLocaleString();
  };
  const exitEventTag = (event) => {
    const ev = String(event || '').toUpperCase();
    let m = ev.match(/^EXIT_TP_P1_([0-9]+(?:\.[0-9]+)?)P$/);
    if (m) return `TP1_${m[1]}`;
    m = ev.match(/^EXIT_TP_C_([0-9]+(?:\.[0-9]+)?)P$/);
    if (m) return `TP1_${m[1]}`;
    m = ev.match(/^EXIT_TRAIL_([0-9]+(?:\.[0-9]+)?)P$/);
    if (m) return `TRAIL_${m[1]}`;
    m = ev.match(/^EXIT_SL_([0-9]+(?:\.[0-9]+)?)P$/);
    if (m) return `SL_${m[1]}`;
    m = ev.match(/^EXIT_BE_([0-9]+(?:\.[0-9]+)?)P$/);
    if (m) return `BE_${m[1]}`;
    if (ev.startsWith('EXIT_TP_P1')) return 'TP1';
    if (ev.startsWith('EXIT_TP_C')) return 'TP1';
    if (ev.startsWith('EXIT_TRAIL')) return 'TRAIL';
    if (ev.startsWith('EXIT_SL')) return 'SL';
    if (ev.startsWith('EXIT_BE')) return 'BE';
    return null;
  };
  const eventDisplay = (event) => {
    const rawUpper = String(event || '').toUpperCase();
    if (rawUpper === 'LONG') return 'LONG';
    if (rawUpper === 'SHORT') return 'SHORT';
    const entryMatch = rawUpper.match(/^(EARLY|CORE|PRE_REAL|REAL)_(LONG|SHORT)$/);
    if (entryMatch) return entryMatch[2];
    let raw = String(event || '-');
    raw = rawUpper.replace(/^EXIT_TP_C_([0-9]+(?:\.[0-9]+)?)P$/, 'EXIT_TP_P1_$1P');
    raw = raw === 'EXIT_TP_C' ? 'EXIT_TP_P1' : raw;
    const tag = exitEventTag(event);
    return tag ? `${raw} (${tag})` : raw;
  };
%>

<div class="subnav">
  <a href="/dashboard/trading">상태</a>
  <a class="active" href="/dashboard/journal">저널</a>
  <a href="/dashboard/ai">AI 저널</a>
</div>

<div class="card">
  <h2>타임라인</h2>
  <div class="subtle">
    최근 체결/거래 이벤트(최대 200). 실행은 하지 않고 “기록만” 보여줍니다.
  </div>
  <div class="hr"></div>

  <div class="kv">
    <div class="k">건수</div><div class="v"><%= meta && meta.n != null ? meta.n : (trades ? trades.length : 0) %></div>
    <div class="k">최신 시각</div><div class="v mono"><%= meta && meta.last_created_kst ? meta.last_created_kst : '-' %></div>
  </div>
</div>

<div class="hr"></div>

<div class="tablewrap">
  <div class="head">
    <h2>거래 기록</h2>
    <div class="subtle">컬렉션: fills_paper</div>
  </div>
  <div class="scroll">
    <table>
      <thead>
        <tr>
          <th>시간</th>
          <th>마켓</th>
          <th>방향</th>
          <th>이벤트</th>
          <th>가격</th>
          <th>비중/수량</th>
          <th>수수료</th>
          <th>손익</th>
          <th>메모</th>
        </tr>
      </thead>
      <tbody>
        <% if (!trades || trades.length === 0) { %>
          <tr><td colspan="9" class="subtle">아직 기록이 없습니다. (초기 구간이거나 컬렉션 미생성)</td></tr>
        <% } else { %>
          <% trades.forEach(t => { %>
            <tr>
              <td class="mono"><%= fmtKst(t.created_kst || t.created_at) %></td>
              <td class="mono"><%= t.symbol_or_pair_id || '-' %></td>
              <td><%= sideLabel(t.side) %></td>
              <td>
                <%= eventDisplay(t.event) %>
              </td>
              <td class="mono"><%= (t.exec_price == null) ? '-' : fmtKrw(t.exec_price) %></td>
              <td class="mono"><%= (t.qty_pct == null && t.exec_qty_base == null) ? '-' : (t.qty_pct == null ? fmtKrw(t.exec_qty_base) : Number(t.qty_pct).toFixed(2)) %></td>
              <td class="mono"><%= (t.fee_value == null) ? '-' : fmtKrw(t.fee_value) %></td>
              <td class="mono"><%= (t.pnl == null) ? '-' : fmtKrw(t.pnl) %></td>
              <td class="subtle"><%= t.note || '' %></td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/app_end') %>
