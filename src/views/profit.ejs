<%- include('partials/app_start', { title: '수익 · DONBEOLJA Ω', pageTitle: '수익', active: 'profit' }) %>

<%
  const unit = (profit && profit.unit) ? profit.unit : 'USDT';
  const isUsdt = String(unit).toUpperCase() === 'USDT';
  const rangeAgg = (profit && profit.rangeAgg) ? profit.rangeAgg : {};
  const ranges = (profit && profit.ranges) ? profit.ranges : {};
  const dailySeriesByRange = (profit && profit.dailySeriesByRange) ? profit.dailySeriesByRange : {};
  const cumulativeSeriesByRange = (profit && profit.cumulativeSeriesByRange) ? profit.cumulativeSeriesByRange : {};
  const dayStatsByRange = (profit && profit.dayStatsByRange) ? profit.dayStatsByRange : {};
  const defaultRangeKey = (profit && profit.defaultRangeKey) ? profit.defaultRangeKey : 'd7';
  const pnlBasis = (typeof pnl_basis !== 'undefined' && pnl_basis) ? String(pnl_basis) : 'trade';
  const isBinanceBasis = pnlBasis === 'binance';
  const tradesLabel = isBinanceBasis ? '거래일 수' : '거래 수';
  const winRateLabel = isBinanceBasis ? '승률(일자)' : '승률(거래)';
  const winLossLabel = isBinanceBasis ? '승/패(일자)' : '승/패(거래)';
  const basisHint = isBinanceBasis ? 'BINANCE 호환(일자/Funding 포함)' : '체결 기준';
  const customRangeData = (profit && profit.customRange) ? profit.customRange : (typeof customRange !== 'undefined' ? customRange : null);
  const rangeWarningMsg = (profit && profit.rangeWarning) ? profit.rangeWarning : (typeof rangeWarning !== 'undefined' ? rangeWarning : null);
  const dailySeries = Array.isArray(dailySeriesByRange[defaultRangeKey]) ? dailySeriesByRange[defaultRangeKey] : [];
  const cumulativeSeries = Array.isArray(cumulativeSeriesByRange[defaultRangeKey]) ? cumulativeSeriesByRange[defaultRangeKey] : [];
  const dayStats = dayStatsByRange[defaultRangeKey] || { win: 0, loss: 0, flat: 0 };
  const topMarkets = (profit && Array.isArray(profit.topMarkets)) ? profit.topMarkets : [];
  const leverageSummary = (typeof leverage_summary !== 'undefined' && leverage_summary)
    ? leverage_summary
    : ((profit && profit.leverage_summary) ? profit.leverage_summary : null);

  function fmtNum(v, digits = 2) {
    const n = Number(v);
    if (!Number.isFinite(n)) return '-';
    return n.toLocaleString('en-US', { maximumFractionDigits: digits, minimumFractionDigits: digits });
  }
  function fmtInt(v) {
    const n = Number(v);
    if (!Number.isFinite(n)) return '-';
    return n.toLocaleString('en-US');
  }
  function fmtPct(v) {
    const n = Number(v);
    if (!Number.isFinite(n)) return '-';
    return (n * 100).toFixed(2) + '%';
  }
  function pnlColor(v) {
    const n = Number(v);
    if (!Number.isFinite(n) || n === 0) return 'neutral';
    return n > 0 ? 'up' : 'down';
  }
  function fmtPnl(v) {
    const n = Number(v);
    if (!Number.isFinite(n)) return '-';
    const sign = n > 0 ? '+' : '';
    return sign + fmtNum(n, 2) + ' ' + unit;
  }
  function fmtNumHtml(v, digits = 2) {
    const n = Number(v);
    if (!Number.isFinite(n)) return '-';
    const txt = fmtNum(n, digits) + ' ' + unit;
    if (!isUsdt) return txt;
    return txt + ` <span class="subtle mono usdt-krw" data-usdt="${n}">(≈ - KRW)</span>`;
  }
  function fmtPnlHtml(v) {
    const n = Number(v);
    if (!Number.isFinite(n)) return '-';
    const sign = n > 0 ? '+' : '';
    const txt = sign + fmtNum(n, 2) + ' ' + unit;
    if (!isUsdt) return txt;
    return txt + ` <span class="subtle mono usdt-krw" data-usdt="${n}">(≈ - KRW)</span>`;
  }
  function fmtRangeLabel(r) {
    if (!r) return '-';
    return String(r.label || '-');
  }
  function fmtKstYmd(ms) {
    const n = Number(ms);
    if (!Number.isFinite(n)) return '-';
    const k = new Date(n + 9 * 60 * 60 * 1000);
    const y = k.getUTCFullYear();
    const m = String(k.getUTCMonth() + 1).padStart(2, '0');
    const d = String(k.getUTCDate()).padStart(2, '0');
    return `${y}-${m}-${d}`;
  }
  function fmtRangeWindow(r) {
    if (!r) return '-';
    const from = Number(r.from);
    const to = Number(r.to);
    if (!Number.isFinite(from) || !Number.isFinite(to) || to <= from) return '-';
    return `${fmtKstYmd(from)} ~ ${fmtKstYmd(to - 1)} KST`;
  }
  function fmtLeverage(v) {
    const n = Number(v);
    if (!Number.isFinite(n) || n <= 0) return '-';
    const rounded = Math.round(n * 10) / 10;
    return `${rounded}x`;
  }
  function leverageBadge(tier) {
    const t = String(tier || '').toLowerCase();
    if (t === '3x') return 'warn';
    if (t === '2x') return 'ok';
    if (t.endsWith('x')) return 'dim';
    return 'dim';
  }
%>

<style>
  .profit-shell{
    background: transparent;
    border: 0;
    border-radius: 0;
    padding: 0;
    color: var(--text);
    box-shadow: none;
  }
  .profit-head{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap: 12px;
    margin-bottom: 12px;
  }
  .profit-title{
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.2px;
  }
  .profit-sub{
    color: var(--muted);
    font-size: 12px;
  }
  .profit-range{
    display:flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .profit-range-wrap{
    display:flex;
    flex-direction:column;
    align-items:flex-end;
    gap: 4px;
  }
  .profit-range-window{
    font-size: 11px;
    color: var(--muted);
    text-align: right;
    white-space: nowrap;
  }
  .profit-range button{
    background: #fff;
    color: var(--text);
    border: 1px solid var(--line);
    padding: 6px 10px;
    border-radius: 10px;
    font-size: 11px;
    cursor: pointer;
  }
  .profit-range button.active{
    background: #f1f4f8;
    color: var(--text);
    border-color: var(--line);
  }
  .profit-range .range-note{
    font-size: 11px;
    color: var(--muted);
    padding-left: 6px;
  }
  .profit-warning{
    margin-top: 6px;
    font-size: 11px;
    color: #b45309;
  }
  .profit-cards{
    display:grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-bottom: 14px;
  }
  .profit-card{
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 12px;
    min-height: 84px;
  }
  .profit-card .label{ font-size: 11px; color: var(--muted); }
  .profit-card .value{ font-size: 18px; font-weight: 700; margin-top: 6px; }
  .profit-card .meta{ font-size: 11px; color: var(--muted); margin-top: 4px; }
  .profit-card .value.up{ color: #23d18b; }
  .profit-card .value.down{ color: #ff6b6b; }
  .profit-card .value.neutral{ color: var(--text); }

  .profit-grid{
    display:grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 12px;
  }
  .profit-panel{
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 14px;
  }
  .profit-panel h3{
    margin: 0 0 10px 0;
    font-size: 13px;
    color: var(--text);
  }
  .profit-kv{
    display:grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px 12px;
    font-size: 12px;
  }
  .profit-kv .k{ color: var(--muted); }
  .profit-kv .v{ color: var(--text); text-align: right; }

  .profit-chart{
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 14px;
  }
  .chart-bars{
    display:grid;
    grid-template-columns: repeat(auto-fit, minmax(6px, 1fr));
    align-items: end;
    gap: 2px;
    height: 140px;
    margin-top: 10px;
  }
  .bar{
    width: 100%;
    border-radius: 4px 4px 2px 2px;
    background: #e3e7ee;
    min-height: 2px;
  }
  .bar.up{ background: #23d18b; }
  .bar.down{ background: #ff6b6b; }
  .bar.flat{ background: #3b4452; }

  .profit-lines{
    height: 140px;
    margin-top: 10px;
    background: #f5f7fb;
    border-radius: 10px;
    border: 1px solid var(--line);
    position: relative;
  }
  .profit-lines svg{ position:absolute; inset:0; width:100%; height:100%; }
  .profit-lines .axis{ position:absolute; inset:10px; border-left:1px solid var(--line); border-bottom:1px solid var(--line); }

  .profit-footer{
    display:grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 12px;
  }
  .profit-donut{
    width: 140px;
    height: 140px;
    border-radius: 50%;
    background: conic-gradient(#23d18b 0deg, #23d18b var(--used, 0deg), #e3e7ee var(--used, 0deg));
    display:flex;
    align-items:center;
    justify-content:center;
    position: relative;
  }
  .profit-donut::after{
    content: '';
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--card);
    border: 1px solid var(--line);
  }
  .profit-donut-label{
    position: absolute;
    font-size: 11px;
    color: var(--text);
  }

  .profit-toplist{
    display:flex;
    flex-direction:column;
    gap: 8px;
  }
  .profit-toplist .row{
    display:flex;
    justify-content:space-between;
    padding: 8px 10px;
    border-radius: 10px;
    background: var(--card);
    border: 1px solid var(--line);
    font-size: 12px;
  }
  .profit-toplist .row .mk{ color: var(--text); font-weight: 600; }
  .profit-toplist .row .val{ color: var(--muted); }

  .range-modal{
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.35);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 50;
  }
  .range-modal.show{ display: flex; }
  .range-modal__panel{
    width: min(420px, 92vw);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 18px;
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.18);
  }
  .range-modal__title{
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 4px;
  }
  .range-modal__desc{
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 14px;
  }
  .range-modal__grid{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 14px;
  }
  .range-modal__label{
    font-size: 11px;
    color: var(--muted);
    margin-bottom: 6px;
  }
  .range-modal__input{
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 8px 10px;
    font-size: 12px;
    background: #fff;
  }
  .range-modal__actions{
    display: flex;
    justify-content: flex-end;
    gap: 8px;
  }
  .range-modal__btn{
    border: 1px solid var(--line);
    background: #fff;
    color: var(--text);
    padding: 8px 14px;
    border-radius: 10px;
    font-size: 12px;
    cursor: pointer;
  }
  .range-modal__btn.primary{
    background: #111827;
    color: #fff;
    border-color: #111827;
  }

  @media (max-width: 980px){
    .profit-head{ flex-direction: column; align-items: flex-start; }
    .profit-range-wrap{ align-items: flex-start; }
    .profit-range-window{ text-align: left; white-space: normal; }
    .profit-cards{ grid-template-columns: repeat(2, 1fr); }
    .profit-grid{ grid-template-columns: 1fr; }
    .profit-footer{ grid-template-columns: 1fr; }
  }
</style>

<%- include('partials/legacy_report_subnav', { activeTab: 'profit' }) %>
<%- include('partials/legacy_control_surface_bridge', { mode: 'report', surfaceHref: '/dashboard/home', surfaceLabel: 'Mission', detailHref: '/dashboard/audit', detailLabel: 'Audit', extraHref: '/dashboard/recovery', extraLabel: 'Recovery' }) %>

<div class="profit-shell">
  <div class="profit-head">
    <div>
      <div class="profit-title">수익 세부 분석</div>
      <div class="profit-sub"><%= exchange %> · 실현 손익 기반 보조 화면 · <%= basisHint %><% if (customRangeData && customRangeData.start && customRangeData.end) { %> · <%= customRangeData.start %> ~ <%= customRangeData.end %><% } %></div>
      <% if (leverageSummary && leverageSummary.enabled) { %>
        <div class="profit-sub">배율 상태 · 2x <%= fmtInt(leverageSummary.tier_2x || 0) %> / 3x <%= fmtInt(leverageSummary.tier_3x || 0) %> (활성 <%= fmtInt(leverageSummary.active_markets || 0) %>)</div>
      <% } %>
      <% if (rangeWarningMsg) { %>
        <div class="profit-warning"><%= rangeWarningMsg %></div>
      <% } %>
    </div>
    <div class="profit-range-wrap">
      <div class="profit-range" id="profit-range">
        <button data-range="d7" class="<%= defaultRangeKey === 'd7' ? 'active' : '' %>">7D</button>
        <button data-range="d30" class="<%= defaultRangeKey === 'd30' ? 'active' : '' %>">1M</button>
        <button data-range="d90" class="<%= defaultRangeKey === 'd90' ? 'active' : '' %>">3M</button>
        <button data-range="m6" class="<%= defaultRangeKey === 'm6' ? 'active' : '' %>">6M</button>
        <button data-range="custom" class="<%= defaultRangeKey === 'custom' ? 'active' : '' %>">기간선택</button>
      </div>
      <div class="profit-range-window" id="profit-range-window"><%= fmtRangeWindow(ranges[defaultRangeKey]) %></div>
    </div>
  </div>

  <div class="profit-cards">
    <div class="profit-card">
      <div class="label">Today PNL</div>
      <div class="value <%= pnlColor(rangeAgg.today && rangeAgg.today.total) %>" data-field="today_pnl"><%- fmtPnlHtml(rangeAgg.today && rangeAgg.today.total) %></div>
      <div class="meta" data-field="today_pct"><%= fmtPct((profit && profit.total_max_krw && rangeAgg.today && rangeAgg.today.total != null) ? (rangeAgg.today.total / profit.total_max_krw) : null) %></div>
    </div>
    <div class="profit-card">
      <div class="label" data-field="range_label"><%= fmtRangeLabel(ranges[defaultRangeKey]) %> PNL</div>
      <div class="value <%= pnlColor(rangeAgg[defaultRangeKey] && rangeAgg[defaultRangeKey].total) %>" data-field="range_pnl"><%- fmtPnlHtml(rangeAgg[defaultRangeKey] && rangeAgg[defaultRangeKey].total) %></div>
      <div class="meta" data-field="range_pct"><%= fmtPct((profit && profit.total_max_krw && rangeAgg[defaultRangeKey] && rangeAgg[defaultRangeKey].total != null) ? (rangeAgg[defaultRangeKey].total / profit.total_max_krw) : null) %></div>
    </div>
    <div class="profit-card">
      <div class="label">30D PNL</div>
      <div class="value <%= pnlColor(rangeAgg.d30 && rangeAgg.d30.total) %>" data-field="range2_pnl"><%- fmtPnlHtml(rangeAgg.d30 && rangeAgg.d30.total) %></div>
      <div class="meta" data-field="range2_pct"><%= fmtPct((profit && profit.total_max_krw && rangeAgg.d30 && rangeAgg.d30.total != null) ? (rangeAgg.d30.total / profit.total_max_krw) : null) %></div>
    </div>
    <div class="profit-card">
      <div class="label">6M PNL</div>
      <div class="value <%= pnlColor(rangeAgg.m6 && rangeAgg.m6.total) %>" data-field="m6_pnl"><%- fmtPnlHtml(rangeAgg.m6 && rangeAgg.m6.total) %></div>
      <div class="meta" data-field="m6_pct"><%= fmtPct((profit && profit.total_max_krw && rangeAgg.m6 && rangeAgg.m6.total != null) ? (rangeAgg.m6.total / profit.total_max_krw) : null) %></div>
    </div>
  </div>

  <div class="profit-grid">
    <div class="profit-panel">
      <h3>손익 분석</h3>
      <div class="profit-kv">
        <div class="k">총 이익</div><div class="v" data-field="total_profit"><%- fmtNumHtml(rangeAgg[defaultRangeKey] && rangeAgg[defaultRangeKey].total_profit, 2) %></div>
        <div class="k">총 손실</div><div class="v" data-field="total_loss"><%- fmtNumHtml(rangeAgg[defaultRangeKey] && rangeAgg[defaultRangeKey].total_loss, 2) %></div>
        <div class="k">순손익</div><div class="v" data-field="net_pnl"><%- fmtNumHtml(rangeAgg[defaultRangeKey] && rangeAgg[defaultRangeKey].total, 2) %></div>
        <div class="k" data-field-label="trades_n"><%= tradesLabel %></div><div class="v" data-field="trades_n"><%= fmtInt(rangeAgg[defaultRangeKey] && rangeAgg[defaultRangeKey].trades_n) %></div>
        <div class="k" data-field-label="win_rate"><%= winRateLabel %></div><div class="v" data-field="win_rate"><%= fmtPct(rangeAgg[defaultRangeKey] && rangeAgg[defaultRangeKey].win_rate) %></div>
        <div class="k" data-field-label="trade_stats"><%= winLossLabel %></div><div class="v" data-field="trade_stats"><%= (rangeAgg[defaultRangeKey] && rangeAgg[defaultRangeKey].win_n != null && rangeAgg[defaultRangeKey].loss_n != null) ? (fmtInt(rangeAgg[defaultRangeKey].win_n) + ' / ' + fmtInt(rangeAgg[defaultRangeKey].loss_n)) : '-' %></div>
        <div class="k">승일/패일/보합(일자)</div><div class="v" data-field="day_stats"><%= dayStats ? (dayStats.win + ' / ' + dayStats.loss + ' / ' + dayStats.flat) : '-' %></div>
        <div class="k">평균 이익</div><div class="v" data-field="avg_profit"><%- fmtNumHtml(rangeAgg[defaultRangeKey] && rangeAgg[defaultRangeKey].avg_profit, 2) %></div>
        <div class="k">평균 손실</div><div class="v" data-field="avg_loss"><%- fmtNumHtml(rangeAgg[defaultRangeKey] && rangeAgg[defaultRangeKey].avg_loss, 2) %></div>
        <div class="k">손익비</div><div class="v" data-field="pl_ratio"><%= fmtNum(rangeAgg[defaultRangeKey] && rangeAgg[defaultRangeKey].pl_ratio, 2) %></div>
        <div class="k">거래대금</div><div class="v" data-field="notional"><%- fmtNumHtml(rangeAgg[defaultRangeKey] && rangeAgg[defaultRangeKey].notional, 2) %></div>
      </div>
    </div>

    <div class="profit-chart">
      <h3 id="daily-title">일별 손익 (<%= fmtRangeLabel(ranges[defaultRangeKey]) %>)</h3>
      <div class="chart-bars" id="daily-bars">
        <% dailySeries.forEach(function(d){ %>
          <div class="bar <%= d.dir %>" style="height:<%= d.height_pct %>%" title="<%= d.day %> · <%= fmtNum(d.pnl, 2) %> <%= unit %>"></div>
        <% }) %>
      </div>
    </div>
  </div>

  <div class="profit-grid" style="margin-top:12px;">
    <div class="profit-chart">
      <h3 id="cum-title">Cumulative PNL (<%= fmtRangeLabel(ranges[defaultRangeKey]) %>)</h3>
      <div class="profit-lines">
        <div class="axis"></div>
        <svg viewBox="0 0 100 100" preserveAspectRatio="none">
          <path id="cum-line" d="" fill="none" stroke="#f5c84c" stroke-width="1.5" />
        </svg>
      </div>
    </div>

    <div class="profit-panel">
      <h3>Top Markets</h3>
      <div class="profit-toplist">
        <% if (topMarkets.length === 0) { %>
          <div class="row"><span class="mk">-</span><span class="val">데이터 없음</span></div>
        <% } else { %>
          <% topMarkets.forEach(function(r){ %>
            <div class="row">
              <span class="mk">
                <%= r.market %>
                <% if (r.leverage_tier) { %>
                  · <span class="pill <%= leverageBadge(r.leverage_tier) %>"><%= r.leverage_tier %></span>
                <% } else if (r.leverage != null) { %>
                  · <span class="pill dim"><%= fmtLeverage(r.leverage) %></span>
                <% } %>
              </span>
              <span class="val"><%- fmtPnlHtml(r.pnl_krw) %></span>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>

  <div class="profit-footer">
    <div class="profit-panel" style="display:flex; align-items:center; gap:18px;">
      <div class="profit-donut" style="--used:<%= (profit && profit.total_used_pct != null) ? (profit.total_used_pct * 360).toFixed(1) + 'deg' : '0deg' %>">
      <div class="profit-donut-label"><%= profit && profit.total_used_pct != null ? (profit.total_used_pct * 100).toFixed(1) + '%' : '-' %></div>
      </div>
      <div>
        <div class="subtle">예산 사용률</div>
        <div class="metric-value" style="color:var(--text); font-size:18px;">
          <%- profit && profit.total_used_krw != null ? fmtNumHtml(profit.total_used_krw, 2) : '-' %>
          / <%- profit && profit.total_max_krw != null ? fmtNumHtml(profit.total_max_krw, 2) : '-' %>
        </div>
      </div>
    </div>

    <div class="profit-panel">
      <h3>Range Snapshot</h3>
      <div class="profit-kv">
        <div class="k">기준</div><div class="v" id="range-label"><%= fmtRangeLabel(ranges[defaultRangeKey]) %></div>
        <div class="k" data-range-label="trades_n"><%= tradesLabel %></div><div class="v" id="range-trades"><%= fmtInt(rangeAgg[defaultRangeKey] && rangeAgg[defaultRangeKey].trades_n) %></div>
        <div class="k">순손익</div><div class="v" id="range-net"><%- fmtPnlHtml(rangeAgg[defaultRangeKey] && rangeAgg[defaultRangeKey].total) %></div>
        <div class="k" data-range-label="win_rate"><%= winRateLabel %></div><div class="v" id="range-win"><%= fmtPct(rangeAgg[defaultRangeKey] && rangeAgg[defaultRangeKey].win_rate) %></div>
        <div class="k" data-range-label="trade_stats"><%= winLossLabel %></div><div class="v" id="range-trade-stats"><%= (rangeAgg[defaultRangeKey] && rangeAgg[defaultRangeKey].win_n != null && rangeAgg[defaultRangeKey].loss_n != null) ? (fmtInt(rangeAgg[defaultRangeKey].win_n) + ' / ' + fmtInt(rangeAgg[defaultRangeKey].loss_n)) : '-' %></div>
        <div class="k">승일/패일/보합(일자)</div><div class="v" id="range-day-stats"><%= dayStats ? (dayStats.win + ' / ' + dayStats.loss + ' / ' + dayStats.flat) : '-' %></div>
      </div>
    </div>
  </div>
</div>

<div class="range-modal" id="profit-range-modal" aria-hidden="true">
  <div class="range-modal__panel">
    <div class="range-modal__title">기간 선택</div>
    <div class="range-modal__desc">2년(730일) 이내로 기간을 선택하세요.</div>
    <div class="range-modal__grid">
      <div>
        <div class="range-modal__label">시작일</div>
        <input type="date" class="range-modal__input" id="profit-range-start">
      </div>
      <div>
        <div class="range-modal__label">종료일</div>
        <input type="date" class="range-modal__input" id="profit-range-end">
      </div>
    </div>
    <div class="range-modal__actions">
      <button type="button" class="range-modal__btn" id="profit-range-cancel">취소</button>
      <button type="button" class="range-modal__btn primary" id="profit-range-apply">확인</button>
    </div>
  </div>
</div>

<script>
(function(){
  const data = {
    rangeAgg: <%- JSON.stringify(rangeAgg || {}) %>,
    ranges: <%- JSON.stringify(ranges || {}) %>,
    unit: <%- JSON.stringify(unit) %>,
    isUsdt: <%- JSON.stringify(isUsdt) %>,
    totalMax: <%- JSON.stringify(profit && profit.total_max_krw != null ? profit.total_max_krw : null) %>,
    dailySeriesByRange: <%- JSON.stringify(dailySeriesByRange || {}) %>,
    cumulativeSeriesByRange: <%- JSON.stringify(cumulativeSeriesByRange || {}) %>,
    dayStatsByRange: <%- JSON.stringify(dayStatsByRange || {}) %>,
    defaultRangeKey: <%- JSON.stringify(defaultRangeKey || "d7") %>,
    customRange: <%- JSON.stringify(customRangeData || null) %>
  };
  const buttons = document.querySelectorAll('#profit-range button');
  if (!buttons.length) return;
  const modal = document.getElementById('profit-range-modal');
  const startInput = document.getElementById('profit-range-start');
  const endInput = document.getElementById('profit-range-end');
  const cancelBtn = document.getElementById('profit-range-cancel');
  const applyBtn = document.getElementById('profit-range-apply');

  function fmtNum(v, digits){
    const n = Number(v);
    if (!Number.isFinite(n)) return '-';
    return n.toLocaleString('en-US', { maximumFractionDigits: digits, minimumFractionDigits: digits });
  }
  function fmtPct(v){
    const n = Number(v);
    if (!Number.isFinite(n)) return '-';
    return (n * 100).toFixed(2) + '%';
  }
  function fmtPnl(v){
    const n = Number(v);
    if (!Number.isFinite(n)) return '-';
    const sign = n > 0 ? '+' : '';
    return sign + fmtNum(n, 2) + ' ' + data.unit;
  }
  function fmtNumHtml(v, digits){
    const n = Number(v);
    if (!Number.isFinite(n)) return '-';
    const txt = fmtNum(n, digits == null ? 2 : digits) + ' ' + data.unit;
    if (!data.isUsdt) return txt;
    return txt + ` <span class="subtle mono usdt-krw" data-usdt="${n}">(≈ - KRW)</span>`;
  }
  function fmtPnlHtml(v){
    const n = Number(v);
    if (!Number.isFinite(n)) return '-';
    const sign = n > 0 ? '+' : '';
    const txt = sign + fmtNum(n, 2) + ' ' + data.unit;
    if (!data.isUsdt) return txt;
    return txt + ` <span class="subtle mono usdt-krw" data-usdt="${n}">(≈ - KRW)</span>`;
  }
  function fmtKrwApprox(x){
    const n = Number(x);
    if (!Number.isFinite(n)) return '-';
    const sign = n < 0 ? '-' : '';
    const abs = Math.abs(n);
    const cut = Math.trunc(abs / 10) * 10;
    return sign + cut.toLocaleString('en-US');
  }
  function fmtKstYmd(ms){
    const n = Number(ms);
    if (!Number.isFinite(n)) return '-';
    const k = new Date(n + 9 * 60 * 60 * 1000);
    const y = k.getUTCFullYear();
    const m = String(k.getUTCMonth() + 1).padStart(2, '0');
    const d = String(k.getUTCDate()).padStart(2, '0');
    return `${y}-${m}-${d}`;
  }
  function fmtRangeWindow(range){
    const from = Number(range && range.from);
    const to = Number(range && range.to);
    if (!Number.isFinite(from) || !Number.isFinite(to) || to <= from) return '-';
    return `${fmtKstYmd(from)} ~ ${fmtKstYmd(to - 1)} KST`;
  }
  const getUsdtKrwRate = (() => {
    let cached = null;
    let inflight = null;
    return () => {
      if (cached) return Promise.resolve(cached);
      if (inflight) return inflight;
      inflight = fetch("https://open.er-api.com/v6/latest/USD")
        .then((r) => r.json())
        .then((fx) => {
          const usdKrw = fx && fx.rates ? Number(fx.rates.KRW) : NaN;
          if (!Number.isFinite(usdKrw) || usdKrw <= 0) return null;
          cached = usdKrw;
          return cached;
        })
        .catch(() => null)
        .finally(() => {
          inflight = null;
        });
      return inflight;
    };
  })();
  const applyUsdtKrw = (rate) => {
    const targets = document.querySelectorAll(".usdt-krw[data-usdt]");
    if (!targets.length) return;
    targets.forEach((el) => {
      const raw = Number(el.dataset.usdt);
      if (!Number.isFinite(raw) || !Number.isFinite(rate)) {
        el.textContent = "(≈ - KRW)";
        return;
      }
      const krw = raw * rate;
      el.textContent = `(≈ ${fmtKrwApprox(krw)} KRW)`;
    });
  };
  const refreshUsdtKrw = () => {
    if (!data.isUsdt) return;
    const targets = document.querySelectorAll(".usdt-krw[data-usdt]");
    if (!targets.length) return;
    getUsdtKrwRate().then((rate) => {
      if (!rate) return;
      applyUsdtKrw(rate);
    });
  };
  function setPnlClass(el, v){
    if (!el) return;
    el.classList.remove('up', 'down', 'neutral');
    const n = Number(v);
    if (!Number.isFinite(n) || n === 0) el.classList.add('neutral');
    else if (n > 0) el.classList.add('up');
    else el.classList.add('down');
  }
  function renderDaily(series){
    const box = document.getElementById('daily-bars');
    if (!box) return;
    if (!Array.isArray(series) || series.length === 0) {
      box.innerHTML = '';
      return;
    }
    const html = series.map((d) => {
      const height = Number(d.height_pct) || 0;
      const dir = d.dir || 'flat';
      const title = `${d.day || ''} · ${fmtNum(d.pnl, 2)} ${data.unit}`;
      return `<div class="bar ${dir}" style="height:${height}%" title="${title}"></div>`;
    }).join('');
    box.innerHTML = html;
  }
  function renderCumulative(series){
    const path = document.getElementById('cum-line');
    if (!path) return;
    if (!Array.isArray(series) || series.length === 0) {
      path.setAttribute('d', '');
      return;
    }
    const max = Math.max(...series.map(c => c.value));
    const min = Math.min(...series.map(c => c.value));
    const span = (max - min) || 1;
    const denom = series.length > 1 ? (series.length - 1) : 1;
    const pts = series.map((c, i) => {
      const x = (i / denom) * 100;
      const y = 100 - ((c.value - min) / span) * 100;
      return `${i === 0 ? 'M' : 'L'} ${x.toFixed(2)} ${y.toFixed(2)}`;
    }).join(' ');
    path.setAttribute('d', pts);
  }
  function openModal(){
    if (!modal) return;
    const today = new Date();
    const iso = (d) => d.toISOString().slice(0, 10);
    const fallbackEnd = iso(today);
    const fallbackStart = iso(new Date(today.getTime() - 29 * 24 * 60 * 60 * 1000));
    if (startInput) startInput.value = (data.customRange && data.customRange.start) ? data.customRange.start : fallbackStart;
    if (endInput) endInput.value = (data.customRange && data.customRange.end) ? data.customRange.end : fallbackEnd;
    modal.classList.add('show');
    modal.setAttribute('aria-hidden', 'false');
  }
  function closeModal(){
    if (!modal) return;
    modal.classList.remove('show');
    modal.setAttribute('aria-hidden', 'true');
  }
  function applyCustomRange(){
    const start = startInput ? startInput.value : '';
    const end = endInput ? endInput.value : '';
    if (!start || !end) return;
    const url = new URL(window.location.href);
    url.searchParams.set('start', start);
    url.searchParams.set('end', end);
    url.searchParams.set('range', 'custom');
    window.location.href = url.toString();
  }
  function stripCustomQuery(){
    const url = new URL(window.location.href);
    if (!url.searchParams.has('start') && !url.searchParams.has('end')) return;
    url.searchParams.delete('start');
    url.searchParams.delete('end');
    url.searchParams.delete('range');
    window.history.replaceState({}, '', url.toString());
  }
  function applyRange(key){
    const agg = data.rangeAgg[key] || {};
    const totalMax = Number(data.totalMax);
    const daily = (data.dailySeriesByRange && data.dailySeriesByRange[key]) ? data.dailySeriesByRange[key] : [];
    const cum = (data.cumulativeSeriesByRange && data.cumulativeSeriesByRange[key]) ? data.cumulativeSeriesByRange[key] : [];
    const stats = (data.dayStatsByRange && data.dayStatsByRange[key]) ? data.dayStatsByRange[key] : { win: 0, loss: 0, flat: 0 };
    const rangeLabel = (data.ranges && data.ranges[key] && data.ranges[key].label) ? data.ranges[key].label : key;

    const pnlEl = document.querySelector('[data-field="range_pnl"]');
    const pnlPctEl = document.querySelector('[data-field="range_pct"]');
    const rangeLabelEl = document.querySelector('[data-field="range_label"]');
    const rangeWindowEl = document.getElementById('profit-range-window');
    const tradesEl = document.getElementById('range-trades');
    const netEl = document.getElementById('range-net');
    const winEl = document.getElementById('range-win');
    const tradeStatsEl = document.getElementById('range-trade-stats');
    const dayStatsEl = document.getElementById('range-day-stats');
    const labelEl = document.getElementById('range-label');

    if (pnlEl) {
      pnlEl.innerHTML = fmtPnlHtml(agg.total);
      setPnlClass(pnlEl, agg.total);
    }
    if (pnlPctEl) pnlPctEl.textContent = (Number.isFinite(totalMax) && Number.isFinite(agg.total)) ? fmtPct(agg.total / totalMax) : '-';
    if (tradesEl) tradesEl.textContent = agg.trades_n != null ? fmtNum(agg.trades_n, 0) : '-';
    if (netEl) netEl.innerHTML = fmtPnlHtml(agg.total);
    if (winEl) winEl.textContent = fmtPct(agg.win_rate);
    if (tradeStatsEl) tradeStatsEl.textContent = (agg.win_n != null && agg.loss_n != null) ? `${fmtNum(agg.win_n, 0)} / ${fmtNum(agg.loss_n, 0)}` : '-';
    if (dayStatsEl) dayStatsEl.textContent = `${stats.win} / ${stats.loss} / ${stats.flat}`;
    if (labelEl) labelEl.textContent = rangeLabel;
    if (rangeLabelEl) rangeLabelEl.textContent = rangeLabel + ' PNL';
    if (rangeWindowEl) rangeWindowEl.textContent = fmtRangeWindow(data.ranges && data.ranges[key]);

    const setField = (field, value, isHtml) => {
      const el = document.querySelector(`[data-field="${field}"]`);
      if (!el) return;
      if (isHtml) el.innerHTML = value;
      else el.textContent = value;
    };
    setField('total_profit', agg.total_profit != null ? fmtNumHtml(agg.total_profit, 2) : '-', true);
    setField('total_loss', agg.total_loss != null ? fmtNumHtml(agg.total_loss, 2) : '-', true);
    setField('net_pnl', agg.total != null ? fmtNumHtml(agg.total, 2) : '-', true);
    setField('trades_n', agg.trades_n != null ? fmtNum(agg.trades_n, 0) : '-');
    setField('win_rate', fmtPct(agg.win_rate));
    setField('trade_stats', (agg.win_n != null && agg.loss_n != null) ? `${fmtNum(agg.win_n, 0)} / ${fmtNum(agg.loss_n, 0)}` : '-');
    setField('day_stats', `${stats.win} / ${stats.loss} / ${stats.flat}`);
    setField('avg_profit', agg.avg_profit != null ? fmtNumHtml(agg.avg_profit, 2) : '-', true);
    setField('avg_loss', agg.avg_loss != null ? fmtNumHtml(agg.avg_loss, 2) : '-', true);
    setField('pl_ratio', agg.pl_ratio != null ? fmtNum(agg.pl_ratio, 2) : '-');
    setField('notional', agg.notional != null ? fmtNumHtml(agg.notional, 2) : '-', true);

    const dailyTitle = document.getElementById('daily-title');
    const cumTitle = document.getElementById('cum-title');
    if (dailyTitle) dailyTitle.textContent = `Daily PNL (${rangeLabel})`;
    if (cumTitle) cumTitle.textContent = `Cumulative PNL (${rangeLabel})`;

    renderDaily(daily);
    renderCumulative(cum);
    refreshUsdtKrw();

    buttons.forEach((b)=>{
      if (b.dataset.range === key) b.classList.add('active');
      else b.classList.remove('active');
    });
    if (key !== 'custom') stripCustomQuery();
  }

  buttons.forEach((btn)=>{
    btn.addEventListener('click', () => {
      if (btn.dataset.range === 'custom') {
        openModal();
        return;
      }
      applyRange(btn.dataset.range);
    });
  });

  if (modal) {
    modal.addEventListener('click', (event) => {
      if (event.target === modal) closeModal();
    });
  }
  if (cancelBtn) cancelBtn.addEventListener('click', closeModal);
  if (applyBtn) applyBtn.addEventListener('click', applyCustomRange);

  applyRange(data.defaultRangeKey || 'd7');
  refreshUsdtKrw();
})();
</script>
