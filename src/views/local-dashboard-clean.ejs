<!doctype html>
<html lang="ko">
<head>
  <%
    const validationView = (typeof validation !== "undefined" && validation) ? validation : {
      readiness: "WAIT_BOOTSTRAP_EXPANSION",
      readinessLabel: "확인 중",
      recommendationText: "validation 데이터를 계산 중입니다.",
      bootstrapGate: {},
      paperGate: {},
      summaryLines: [],
    };
  %>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= header.title %></title>
  <meta http-equiv="refresh" content="45" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #f5f1e8;
      --surface: rgba(255, 252, 246, 0.86);
      --surface-strong: #fffaf1;
      --line: rgba(44, 32, 20, 0.08);
      --text: #1f1a15;
      --muted: #74685a;
      --up: #1e8f5a;
      --down: #c0553d;
      --neutral: #7a7368;
      --warn: #a46a1d;
      --bad: #b4432c;
      --ok: #196c48;
      --accent: #2d6cdf;
      --shadow: 0 24px 72px rgba(43, 30, 17, 0.12);
      --radius-xl: 28px;
      --radius-lg: 20px;
      --radius-md: 14px;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; min-height: 100%; }
    body {
      font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif;
      background:
        radial-gradient(circle at top left, rgba(255, 205, 114, 0.32), transparent 28%),
        radial-gradient(circle at top right, rgba(100, 143, 255, 0.18), transparent 24%),
        linear-gradient(180deg, #f7f2ea 0%, #efe7da 100%);
      color: var(--text);
      padding: 24px;
    }
    .shell {
      max-width: 1460px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 18px;
    }
    .panel {
      background: var(--surface);
      backdrop-filter: blur(18px);
      border: 1px solid var(--line);
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow);
    }
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1.5fr) minmax(340px, 0.8fr);
      gap: 18px;
      padding: 22px;
    }
    .hero-left,
    .hero-right,
    .section,
    .mini-panel {
      background: rgba(255,255,255,0.56);
      border: 1px solid rgba(44, 32, 20, 0.06);
      border-radius: 22px;
    }
    .hero-left { padding: 28px; }
    .hero-right { padding: 24px; }
    .eyebrow {
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--muted);
    }
    h1 {
      margin: 12px 0 10px;
      font-size: clamp(34px, 5vw, 54px);
      line-height: 0.98;
      letter-spacing: -0.05em;
    }
    .hero-copy {
      margin: 0;
      max-width: 720px;
      color: var(--muted);
      font-size: 15px;
      line-height: 1.75;
    }
    .hero-meta,
    .badge-row,
    .kpi-grid,
    .section-grid,
    .mini-grid,
    .stack,
    .row,
    .table-row,
    .progress-row {
      display: flex;
      gap: 10px;
    }
    .hero-meta,
    .badge-row,
    .stack {
      flex-wrap: wrap;
    }
    .hero-meta { margin-top: 18px; }
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 14px;
      border-radius: 999px;
      background: rgba(255,255,255,0.82);
      border: 1px solid rgba(44,32,20,0.07);
      font-size: 12px;
      font-weight: 600;
      color: var(--text);
    }
    .dot {
      width: 9px;
      height: 9px;
      border-radius: 999px;
      background: var(--neutral);
    }
    .dot.ok, .status.ok { background: var(--ok); }
    .dot.warn, .status.warn { background: var(--warn); }
    .dot.bad, .status.bad { background: var(--bad); }
    .dot.up { background: var(--up); }
    .dot.down { background: var(--down); }
    .status-pill {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 14px 16px;
      border-radius: 18px;
      background: rgba(255,255,255,0.72);
      border: 1px solid rgba(44, 32, 20, 0.08);
      margin-bottom: 14px;
    }
    .status-label { font-size: 13px; color: var(--muted); }
    .status-value { font-size: 22px; font-weight: 700; }
    .status-detail { color: var(--muted); font-size: 13px; line-height: 1.5; }
    .button-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 11px 16px;
      border-radius: 14px;
      text-decoration: none;
      font-weight: 700;
      color: white;
      background: linear-gradient(135deg, #1f6ef3 0%, #3259d8 100%);
      box-shadow: 0 10px 24px rgba(45, 108, 223, 0.24);
    }
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 14px;
    }
    .kpi-card {
      padding: 18px;
      border-radius: 20px;
      background: var(--surface-strong);
      border: 1px solid var(--line);
    }
    .kpi-label {
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 10px;
    }
    .kpi-value {
      font-size: 28px;
      font-weight: 750;
      letter-spacing: -0.04em;
      margin-bottom: 6px;
    }
    .kpi-value.up { color: var(--up); }
    .kpi-value.down { color: var(--down); }
    .kpi-note { font-size: 13px; color: var(--muted); }
    .section-grid {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 18px;
    }
    .section {
      padding: 22px;
    }
    .span-12 { grid-column: span 12; }
    .span-8 { grid-column: span 8; }
    .span-7 { grid-column: span 7; }
    .span-6 { grid-column: span 6; }
    .span-5 { grid-column: span 5; }
    .span-4 { grid-column: span 4; }
    .section-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 14px;
      margin-bottom: 18px;
    }
    .section-title {
      margin: 4px 0 0;
      font-size: 24px;
      letter-spacing: -0.04em;
    }
    .section-copy {
      margin: 8px 0 0;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.6;
    }
    .mini-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }
    .mini-panel {
      padding: 18px;
    }
    .mini-title {
      margin: 8px 0 12px;
      font-size: 18px;
      letter-spacing: -0.03em;
    }
    .stat-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
    .stat-item {
      padding: 12px 0;
      border-top: 1px solid rgba(44,32,20,0.06);
    }
    .stat-item:first-child,
    .metric-row:first-child,
    .table-row:first-child,
    .progress-row:first-child { border-top: 0; }
    .stat-label,
    .metric-label,
    .table-meta {
      font-size: 12px;
      color: var(--muted);
    }
    .stat-value {
      margin-top: 6px;
      font-size: 17px;
      font-weight: 700;
    }
    .metric-row,
    .table-row,
    .progress-row {
      align-items: center;
      justify-content: space-between;
      padding: 12px 0;
      border-top: 1px solid rgba(44,32,20,0.06);
    }
    .metric-value {
      font-size: 15px;
      font-weight: 700;
      text-align: right;
    }
    .progress-label {
      min-width: 0;
      flex: 1;
      padding-right: 14px;
    }
    .progress-bar {
      flex: 0 0 44%;
      height: 10px;
      border-radius: 999px;
      background: rgba(44,32,20,0.08);
      overflow: hidden;
    }
    .progress-fill {
      height: 100%;
      border-radius: inherit;
      background: linear-gradient(90deg, #2d6cdf 0%, #5e8cff 100%);
    }
    .table {
      border-top: 1px solid rgba(44,32,20,0.06);
    }
    .table-main {
      font-size: 14px;
      font-weight: 600;
    }
    .table-main.up { color: var(--up); }
    .table-main.down { color: var(--down); }
    .muted { color: var(--muted); }
    .empty {
      padding: 18px;
      border-radius: 16px;
      background: rgba(255,255,255,0.58);
      border: 1px dashed rgba(44,32,20,0.12);
      color: var(--muted);
      font-size: 13px;
    }
    .pipeline-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 14px;
    }
    .pipeline-card {
      padding: 18px;
      border-radius: 18px;
      background: rgba(255,255,255,0.66);
      border: 1px solid rgba(44,32,20,0.07);
    }
    .pipeline-name { font-size: 14px; font-weight: 700; }
    .pipeline-primary {
      margin-top: 18px;
      font-size: 26px;
      font-weight: 750;
      letter-spacing: -0.04em;
    }
    .pipeline-secondary { margin-top: 6px; color: var(--muted); font-size: 13px; }
    .pipeline-time { margin-top: 16px; color: var(--muted); font-size: 12px; }
    @media (max-width: 1180px) {
      .hero,
      .kpi-grid,
      .mini-grid,
      .pipeline-grid,
      .section-grid { grid-template-columns: 1fr; }
      .span-8, .span-7, .span-6, .span-5, .span-4, .span-12 { grid-column: span 1; }
      .stat-list { grid-template-columns: 1fr; }
      .progress-bar { flex-basis: 38%; }
    }
    @media (max-width: 720px) {
      body { padding: 14px; }
      .hero-left, .hero-right, .section, .panel { padding: 18px; }
      .status-pill { align-items: flex-start; flex-direction: column; }
      .table-row, .progress-row, .metric-row { align-items: flex-start; flex-direction: column; }
      .progress-bar { width: 100%; flex-basis: auto; }
    }
  </style>
</head>
<body>
  <div class="shell">
    <section class="panel hero">
      <div class="hero-left">
        <div class="eyebrow">Local Runtime</div>
        <h1><%= header.title %></h1>
        <p class="hero-copy"><%= header.subtitle %> 기존 HQ 화면을 이어붙이지 않고, 지금 실제로 돌아가는 `v3 paper` 산출물만 읽어오는 새 화면입니다.</p>
        <div class="hero-meta">
          <span class="badge"><span class="dot <%= health.tone %>"></span><%= health.label %></span>
          <span class="badge">권고 <strong><%= snapshot.recommendation %></strong></span>
          <span class="badge">전략 ID <strong><%= snapshot.strategyId %></strong></span>
          <span class="badge"><%= header.refreshNote %></span>
        </div>
      </div>
      <div class="hero-right">
        <div class="status-pill">
          <div>
            <div class="status-label">마지막 cycle 완료</div>
            <div class="status-value"><%= helpers.formatDateTime(snapshot.latestCycleAt) %></div>
          </div>
          <span class="badge"><%= helpers.formatAgo(snapshot.latestCycleAt) %></span>
        </div>
        <div class="status-pill">
          <div>
            <div class="status-label">현재 bootstrap 판단</div>
            <div class="status-value"><%= snapshot.targetHit ? '승급 가능' : 'shadow 유지' %></div>
          </div>
          <span class="badge"><%= snapshot.recommendation %></span>
        </div>
        <div class="status-detail"><%= health.detail %></div>
        <div style="margin-top:16px">
          <a class="button-link" href="/dashboard/home">지금 새로고침</a>
        </div>
      </div>
    </section>

    <section class="kpi-grid">
      <% overviewCards.forEach(function(card) { %>
        <article class="kpi-card">
          <div class="kpi-label"><%= card.label %></div>
          <div class="kpi-value <%= card.tone %>"><%= card.value %></div>
          <div class="kpi-note"><%= card.note %></div>
        </article>
      <% }) %>
    </section>

    <section class="panel section span-12">
      <div class="section-head">
        <div>
          <div class="eyebrow">Pipeline</div>
          <h2 class="section-title">v3 paper 파이프라인</h2>
          <p class="section-copy">lane → entry → exit → performance → validation 다섯 단계만 남겨서 봅니다.</p>
        </div>
      </div>
      <div class="pipeline-grid">
        <% pipeline.forEach(function(item) { %>
          <article class="pipeline-card">
            <div class="pipeline-name"><%= item.label %></div>
            <div class="pipeline-primary"><%= item.primary %></div>
            <div class="pipeline-secondary"><%= item.secondary %></div>
            <div class="pipeline-time"><%= helpers.formatDateTime(item.updatedAt) %></div>
          </article>
        <% }) %>
      </div>
    </section>

    <section class="panel section span-12">
      <div class="section-head">
        <div>
          <div class="eyebrow">Validation Gate</div>
          <h2 class="section-title">표본 검증 상태</h2>
          <p class="section-copy"><%= validationView.recommendationText %></p>
        </div>
        <span class="badge"><%= validationView.readinessLabel %></span>
      </div>
      <div class="mini-grid">
        <section class="mini-panel">
          <div class="eyebrow">Bootstrap Gate</div>
          <div class="mini-title"><%= validationView.bootstrapGate.retained_sample_n || 0 %> / <%= validationView.bootstrapGate.min_required_n || 0 %></div>
          <div class="stat-list">
            <div class="stat-item"><div class="stat-label">Retained Sample</div><div class="stat-value"><%= validationView.bootstrapGate.retained_sample_n || 0 %></div></div>
            <div class="stat-item"><div class="stat-label">Need More</div><div class="stat-value"><%= validationView.bootstrapGate.remaining_to_min_n || 0 %></div></div>
            <div class="stat-item"><div class="stat-label">Win Rate</div><div class="stat-value"><%= validationView.bootstrapGate.win_rate_pct != null ? validationView.bootstrapGate.win_rate_pct + '%' : '-' %></div></div>
            <div class="stat-item"><div class="stat-label">Expectancy</div><div class="stat-value"><%= validationView.bootstrapGate.expectancy_usdt != null ? validationView.bootstrapGate.expectancy_usdt + ' USDT' : '-' %></div></div>
          </div>
        </section>
        <section class="mini-panel">
          <div class="eyebrow">Paper Gate</div>
          <div class="mini-title"><%= validationView.paperGate.closed_trade_n || 0 %> / <%= validationView.paperGate.min_required_n || 0 %></div>
          <div class="stat-list">
            <div class="stat-item"><div class="stat-label">Closed Trades</div><div class="stat-value"><%= validationView.paperGate.closed_trade_n || 0 %></div></div>
            <div class="stat-item"><div class="stat-label">Need More</div><div class="stat-value"><%= validationView.paperGate.remaining_to_min_n || 0 %></div></div>
            <div class="stat-item"><div class="stat-label">Win Rate</div><div class="stat-value"><%= validationView.paperGate.win_rate_pct != null ? validationView.paperGate.win_rate_pct + '%' : '-' %></div></div>
            <div class="stat-item"><div class="stat-label">Expectancy</div><div class="stat-value"><%= validationView.paperGate.expectancy_r != null ? validationView.paperGate.expectancy_r + 'R' : '-' %></div></div>
          </div>
        </section>
      </div>
      <div style="margin-top:14px" class="table">
        <% if (validationView.summaryLines && validationView.summaryLines.length) { %>
          <% validationView.summaryLines.forEach(function(line) { %>
            <div class="metric-row">
              <div class="metric-label"><%= line %></div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="empty">validation summary가 아직 없습니다.</div>
        <% } %>
      </div>
    </section>

    <section class="section-grid">
      <article class="panel section span-7">
        <div class="section-head">
          <div>
            <div class="eyebrow">Bootstrap</div>
            <h2 class="section-title">허용 코호트 품질</h2>
            <p class="section-copy">기준선과 retained cohort 성과를 나란히 비교합니다.</p>
          </div>
          <span class="badge"><%= helpers.formatDateTime(bootstrap.generatedAt) %></span>
        </div>
        <div class="mini-grid">
          <section class="mini-panel">
            <div class="eyebrow">Retained</div>
            <div class="mini-title"><%= bootstrap.retained.winRate %> win</div>
            <div class="stat-list">
              <div class="stat-item"><div class="stat-label">Sample</div><div class="stat-value"><%= bootstrap.retained.sampleN %></div></div>
              <div class="stat-item"><div class="stat-label">Expectancy</div><div class="stat-value"><%= bootstrap.retained.expectancy %></div></div>
              <div class="stat-item"><div class="stat-label">Profit Factor</div><div class="stat-value"><%= bootstrap.retained.profitFactor %></div></div>
              <div class="stat-item"><div class="stat-label">Net PnL</div><div class="stat-value"><%= bootstrap.retained.netPnl %></div></div>
            </div>
          </section>
          <section class="mini-panel">
            <div class="eyebrow">Baseline</div>
            <div class="mini-title"><%= bootstrap.baseline.winRate %> win</div>
            <div class="stat-list">
              <div class="stat-item"><div class="stat-label">Sample</div><div class="stat-value"><%= bootstrap.baseline.sampleN %></div></div>
              <div class="stat-item"><div class="stat-label">Expectancy</div><div class="stat-value"><%= bootstrap.baseline.expectancy %></div></div>
              <div class="stat-item"><div class="stat-label">Profit Factor</div><div class="stat-value"><%= bootstrap.baseline.profitFactor %></div></div>
              <div class="stat-item"><div class="stat-label">Net PnL</div><div class="stat-value"><%= bootstrap.baseline.netPnl %></div></div>
            </div>
          </section>
        </div>
        <div style="margin-top:14px" class="table">
          <% if (bootstrap.topCohorts.length) { %>
            <% bootstrap.topCohorts.forEach(function(item) { %>
              <div class="progress-row">
                <div class="progress-label">
                  <div class="table-main"><%= item.key %></div>
                  <div class="table-meta"><%= item.n %> samples · expectancy <%= item.expectancy %></div>
                </div>
                <div class="progress-bar"><div class="progress-fill" style="width:<%= Math.max(8, Math.min(100, item.win_rate || 0)) %>%"></div></div>
                <div class="metric-value"><%= item.win_rate %>%</div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="empty">retained top cohort 데이터가 아직 없습니다.</div>
          <% } %>
        </div>
      </article>

      <article class="panel section span-5">
        <div class="section-head">
          <div>
            <div class="eyebrow">Filter</div>
            <h2 class="section-title">차단 사유</h2>
            <p class="section-copy">현재 lane 차단과 bootstrap 제거 사유만 간단히 봅니다.</p>
          </div>
        </div>
        <div class="mini-panel" style="margin-bottom:14px">
          <div class="eyebrow">Lane Blocked</div>
          <div class="table">
            <% if (flow.blockedReasons.length) { %>
              <% flow.blockedReasons.forEach(function(item) { %>
                <div class="metric-row">
                  <div class="metric-label"><%= item.label %></div>
                  <div class="metric-value"><%= item.value %></div>
                </div>
              <% }) %>
            <% } else { %>
              <div class="empty">현재 차단 사유 없음</div>
            <% } %>
          </div>
        </div>
        <div class="mini-panel">
          <div class="eyebrow">Bootstrap Removed</div>
          <div class="table">
            <% if (bootstrap.removedReasons.length) { %>
              <% bootstrap.removedReasons.forEach(function(item) { %>
                <div class="metric-row">
                  <div class="metric-label"><%= item.label %></div>
                  <div class="metric-value"><%= item.value %></div>
                </div>
              <% }) %>
            <% } else { %>
              <div class="empty">제거 사유 데이터가 없습니다.</div>
            <% } %>
          </div>
        </div>
      </article>

      <article class="panel section span-6">
        <div class="section-head">
          <div>
            <div class="eyebrow">Activity</div>
            <h2 class="section-title">최근 paper 청산</h2>
            <p class="section-copy">가장 최근 청산 결과만 짧게 보여줍니다.</p>
          </div>
        </div>
        <div class="table">
          <% if (performance.recentExits.length) { %>
            <% performance.recentExits.forEach(function(item) { %>
              <div class="table-row">
                <div>
                  <div class="table-main"><%= item.symbol || '-' %> · <%= item.side || '-' %> · <%= item.exit_event || item.status || '-' %></div>
                  <div class="table-meta"><%= helpers.formatDateTime(item.closed_at) %> · <%= item.setup_type || '-' %> · <%= item.entry_grade || '-' %></div>
                </div>
                <div class="table-main <%= helpers.toneByNumber(item.realized_r) %>"><%= helpers.formatR(item.realized_r, 2) %> / <%= helpers.formatPnlPercent(item.realized_pnl_pct, 2) %></div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="empty">아직 닫힌 paper trade가 없습니다.</div>
          <% } %>
        </div>
      </article>

      <article class="panel section span-6">
        <div class="section-head">
          <div>
            <div class="eyebrow">Entry Flow</div>
            <h2 class="section-title">최근 entry 기록</h2>
            <p class="section-copy">중복 진입 여부와 신호 흐름을 빠르게 확인합니다.</p>
          </div>
        </div>
        <div class="table">
          <% if (flow.recentEntries.length) { %>
            <% flow.recentEntries.forEach(function(item) { %>
              <div class="table-row">
                <div>
                  <div class="table-main"><%= item.symbol || '-' %> · <%= item.side || '-' %> · <%= item.setup_type || '-' %></div>
                  <div class="table-meta"><%= helpers.formatDateTime(item.opened_at || item.created_at || item.ts) %> · <%= item.entry_grade || '-' %> · <%= item.status_detail || item.current_status || item.status || '-' %></div>
                </div>
                <div class="metric-value"><%= item.signal_price != null ? item.signal_price : '-' %></div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="empty">entry ledger 데이터가 아직 없습니다.</div>
          <% } %>
        </div>
      </article>

      <article class="panel section span-5">
        <div class="section-head">
          <div>
            <div class="eyebrow">Performance</div>
            <h2 class="section-title">성과 요약</h2>
            <p class="section-copy">오늘과 전체 성과만 남겼습니다.</p>
          </div>
        </div>
        <div class="mini-panel" style="margin-bottom:14px">
          <div class="eyebrow">Today</div>
          <div class="stat-list">
            <div class="stat-item"><div class="stat-label">Trades</div><div class="stat-value"><%= performance.today.trades %></div></div>
            <div class="stat-item"><div class="stat-label">Win Rate</div><div class="stat-value"><%= performance.today.winRate %></div></div>
            <div class="stat-item"><div class="stat-label">Net</div><div class="stat-value"><%= performance.today.netR %></div></div>
          </div>
        </div>
        <div class="mini-panel">
          <div class="eyebrow">All Time</div>
          <div class="stat-list">
            <div class="stat-item"><div class="stat-label">Trades</div><div class="stat-value"><%= performance.allTime.trades %></div></div>
            <div class="stat-item"><div class="stat-label">Win Rate</div><div class="stat-value"><%= performance.allTime.winRate %></div></div>
            <div class="stat-item"><div class="stat-label">Expectancy</div><div class="stat-value"><%= performance.allTime.expectancy %></div></div>
          </div>
        </div>
      </article>

      <article class="panel section span-7">
        <div class="section-head">
          <div>
            <div class="eyebrow">Cycle</div>
            <h2 class="section-title">최근 cycle 단계</h2>
            <p class="section-copy">실패 step이 있으면 여기서 바로 보입니다.</p>
          </div>
        </div>
        <div class="table">
          <% if (cycle.recentSteps.length) { %>
            <% cycle.recentSteps.forEach(function(step) { %>
              <div class="table-row">
                <div>
                  <div class="table-main"><%= step.step %></div>
                  <div class="table-meta"><%= step.script %></div>
                </div>
                <div style="text-align:right">
                  <div class="table-main <%= Number(step.rc) === 0 ? 'up' : 'down' %>">rc <%= step.rc %></div>
                  <div class="table-meta"><%= helpers.formatDateTime(step.ts) %> · <%= step.duration_ms || 0 %>ms</div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="empty">cycle 로그가 아직 없습니다.</div>
          <% } %>
        </div>
      </article>
    </section>
  </div>
</body>
</html>
