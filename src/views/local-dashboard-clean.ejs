<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>DONBEOLJA</title>
<meta http-equiv="refresh" content="60">
<style>
  :root{
    --bg:#0f1115; --panel:#171a21; --panel2:#1d212a; --line:#272c38;
    --fg:#e6e9ef; --dim:#9aa3b2; --faint:#6b7484;
    --ok:#3ecf8e; --up:#3ecf8e; --down:#f0616d; --warn:#f5a524; --bad:#f0616d;
  }
  @media (prefers-color-scheme: light){
    :root{ --bg:#f6f7f9; --panel:#fff; --panel2:#f0f2f5; --line:#e0e3e9;
           --fg:#16191f; --dim:#5b6472; --faint:#8a93a3; }
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--fg);
    font:14px/1.5 -apple-system,BlinkMacSystemFont,"Apple SD Gothic Neo",Pretendard,sans-serif}
  .wrap{max-width:760px;margin:0 auto;padding:24px 16px 56px}

  .top{display:flex;align-items:baseline;gap:10px;margin-bottom:16px}
  h1{font-size:19px;margin:0;letter-spacing:.5px}
  .stamp{margin-left:auto;color:var(--faint);font-size:11.5px;font-variant-numeric:tabular-nums}

  /* 상태 스트립 — 사실 4개, 설명 없음 */
  .strip{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);
    border:1px solid var(--line);border-radius:10px;overflow:hidden;margin-bottom:18px}
  .strip div{background:var(--panel);padding:10px 12px}
  .strip .k{color:var(--faint);font-size:11px}
  .strip .v{font-size:15px;font-weight:600;margin-top:2px}
  .ok,.up{color:var(--up)} .down,.bad{color:var(--down)} .warn{color:var(--warn)}

  /* 메인 카드 */
  .main{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:20px;margin-bottom:16px}
  .main h2{font-size:15px;margin:0 0 2px;display:flex;align-items:center;gap:8px}
  .badge{font-size:11px;padding:3px 9px;border-radius:999px;background:var(--panel2);
    border:1px solid var(--line);color:var(--dim);font-weight:500}
  .badge.up{color:var(--up)} .badge.down{color:var(--down)}
  .cfg{color:var(--faint);font-size:11.5px;margin:0 0 16px;font-variant-numeric:tabular-nums}

  .big{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:14px;margin-bottom:16px}
  .big div .k{color:var(--faint);font-size:11px}
  .big div .v{font-size:26px;font-weight:650;letter-spacing:-.5px;margin-top:3px;
    font-variant-numeric:tabular-nums}
  .big div .s{color:var(--faint);font-size:11px;margin-top:1px}

  .bar{height:7px;background:var(--panel2);border:1px solid var(--line);border-radius:99px;
    overflow:hidden;margin:4px 0 6px}
  .bar>i{display:block;height:100%;background:var(--up)}
  .barnote{color:var(--faint);font-size:11.5px;margin-bottom:16px}

  table{width:100%;border-collapse:collapse;font-size:12.5px;font-variant-numeric:tabular-nums}
  th,td{text-align:right;padding:6px 8px;border-bottom:1px solid var(--line);white-space:nowrap}
  th{color:var(--faint);font-weight:500;font-size:11px}
  th:first-child,td:first-child{text-align:left}
  tbody tr:last-child td{border-bottom:none}
  .tblwrap{overflow-x:auto}
  .sub{color:var(--dim);font-size:12px;margin:16px 0 6px;font-weight:600}
  .mut{color:var(--faint)}

  /* 나머지 레인 — 한 줄씩 */
  .others{background:var(--panel);border:1px solid var(--line);border-radius:12px;overflow:hidden}
  .row{display:flex;align-items:center;gap:12px;padding:11px 16px;border-bottom:1px solid var(--line)}
  .row:last-child{border-bottom:none}
  .row .n{font-size:13px;min-width:118px}
  .row .st{font-size:13px;font-weight:600;font-variant-numeric:tabular-nums}
  .row .nt{color:var(--faint);font-size:11.5px;margin-left:auto;text-align:right}
  /* On a phone the three columns collide and every value wraps mid-word.
     Stack instead: name+value on one line, the note underneath. */
  @media (max-width: 560px){
    .row{flex-wrap:wrap;row-gap:3px}
    .row .n{min-width:0;flex:1}
    .row .st{white-space:nowrap}
    .row .nt{flex-basis:100%;margin-left:0;text-align:left}
    .strip{grid-template-columns:repeat(2,1fr)}
    .big{grid-template-columns:repeat(2,1fr)}
  }
  .empty{color:var(--faint);font-size:12.5px;padding:14px 0;text-align:center}
  footer{color:var(--faint);font-size:11px;text-align:center;margin-top:20px}
</style>
</head>
<body>
<div class="wrap">

  <div class="top">
    <h1>DONBEOLJA</h1>
    <span class="stamp"><%= helpers.formatDateTime(generatedAt) %></span>
  </div>

  <div class="strip">
    <% strip.forEach(function(s){ %>
      <div><div class="k"><%= s.label %></div><div class="v <%= s.tone %>"><%= s.value %></div></div>
    <% }); %>
  </div>

  <div class="main">
    <h2>
      v7 포지셔닝
      <span class="badge <%= v7.tone %>"><%= v7.verdictLabel %></span>
    </h2>
    <p class="cfg">
      고래-개미 포지션 격차 · 횡단면 랭킹 · 달러뉴트럴
      · 롱 하위 <%= v7.k %>개 / 숏 상위 <%= v7.k %>개 (<%= v7.symbols %>개 중)
      · 4시간 리밸런싱 · 회전량당 0.07% 비용
      <br>가격에서 유도되지 않는 유일한 신호입니다 — 대형 계정과 개인 계정의 실제 보유 방향 차이.
    </p>

    <div class="big">
      <div>
        <div class="k">리밸런싱</div>
        <div class="v"><%= helpers.formatNumber(v7.periods) %></div>
        <div class="s">4시간마다 1회</div>
      </div>
      <% if (v7.realised && v7.realised.t_stat !== null) { %>
        <div>
          <div class="k">누적 순손익</div>
          <div class="v <%= v7.realised.total_net_pct >= 0 ? 'up' : 'down' %>">
            <%= helpers.formatSigned(v7.realised.total_net_pct, 2, '%') %>
          </div>
          <div class="s">회당 <%= helpers.formatSigned(v7.realised.mean_net_pct, 3, '%') %></div>
        </div>
        <div>
          <div class="k">연환산</div>
          <div class="v <%= v7.realised.ann_pct >= 0 ? 'up' : 'down' %>">
            <%= helpers.formatSigned(v7.realised.ann_pct, 1, '%') %>
          </div>
          <div class="s">변동성 <%= helpers.formatNumber(v7.realised.vol_pct, 1) %>%</div>
        </div>
        <div>
          <div class="k">t 값</div>
          <div class="v <%= v7.realised.t_stat > 1.96 ? 'up' : '' %>">
            <%= helpers.formatNumber(v7.realised.t_stat, 2) %>
          </div>
          <div class="s">1.96 넘어야 유의</div>
        </div>
      <% } else { %>
        <div>
          <div class="k">누적 순손익</div><div class="v mut">-</div><div class="s">첫 수익 확정 대기</div>
        </div>
        <div>
          <div class="k">연환산</div><div class="v mut">-</div><div class="s">-</div>
        </div>
        <div>
          <div class="k">t 값</div><div class="v mut">-</div><div class="s">1.96 넘어야 유의</div>
        </div>
      <% } %>
    </div>

    <div class="bar"><i style="width:<%= v7.progressPct %>%"></i></div>
    <div class="barnote">
      <%= helpers.formatNumber(v7.periods) %> / <%= helpers.formatNumber(v7.minN) %> 회
      — 백테스트가 쓴 242기간과 견줄 수 있는 지점입니다 (유의 기준이 아니라 비교 기준).
      <%
        /* This lane's entire purpose is watching the forward t move away from
           the backtest t. Showing the backtest RETURN alone would read as a
           forecast; the caveat is what bounds the claim, so both ship together
           and neither is optional. */
      %>
      <% if (v7.expectedT !== null) { %>
        <br>백테스트 40.5일: 연 <%= helpers.formatSigned(v7.expectedAnnPct, 1, '%') %> · <b>북의 t <%= helpers.formatNumber(v7.expectedT, 2) %></b>
        <% if (v7.expectedIcT !== null) { %> · 원시 횡단면 IC의 t <%= helpers.formatNumber(v7.expectedIcT, 2) %><% } %>
        <br>북의 t는 1.96에 <b style="color:var(--down)">미달</b>합니다. 명목 유의한 것은 원시 IC뿐이고,
        그마저 8개 특징 중 최고를 고른 것이라 본페로니 기준(2.73)은 통과하지 못합니다.
        표본이 늘 때 t가 오르는지 내리는지가 이 레인이 답하려는 유일한 질문입니다.
      <% } %>
      <% if (v7.sampleReq) { %>
        <br>현재 분산 기준 유의까지 <%= helpers.formatNumber(v7.sampleReq.n_for_t196) %>회(약 <%= v7.sampleReq.days_to_n %>일) 필요.
      <% } %>
    </div>

    <% if (v7.longs.length || v7.shorts.length) { %>
      <div class="sub">현재 북 · <%= helpers.formatDateTime(v7.latestAt) %> 기준</div>
      <div class="tblwrap"><table>
        <thead><tr><th>방향</th><th>심볼</th></tr></thead>
        <tbody>
          <tr>
            <td class="up">롱</td>
            <td class="mut"><%= v7.longs.map(function(s){ return s.replace('USDT',''); }).join(' · ') %></td>
          </tr>
          <tr>
            <td class="down">숏</td>
            <td class="mut"><%= v7.shorts.map(function(s){ return s.replace('USDT',''); }).join(' · ') %></td>
          </tr>
        </tbody>
      </table></div>
    <% } %>

    <% if (v7.recent.length) { %>
      <div class="sub">최근 리밸런싱</div>
      <div class="tblwrap"><table>
        <thead><tr><th>시각</th><th>총수익%</th><th>회전량</th><th>비용%</th><th>순%</th><th>누적배수</th></tr></thead>
        <tbody>
          <% v7.recent.forEach(function(p){ %>
            <tr>
              <td class="mut"><%= helpers.formatDateTime(p.bar_time) %></td>
              <td class="mut"><%= p.prior_gross_pct === null || p.prior_gross_pct === undefined ? '-' : helpers.formatSigned(p.prior_gross_pct, 3, '%') %></td>
              <td class="mut"><%= helpers.formatNumber(p.turnover, 2) %></td>
              <td class="mut"><%= helpers.formatNumber(p.cost_pct, 3) %></td>
              <td class="<%= p.net_pct >= 0 ? 'up' : 'down' %>"><%= helpers.formatSigned(p.net_pct, 3, '%') %></td>
              <td class="mut"><%= helpers.formatNumber(p.equity, 4) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table></div>
    <% } %>

    <% if (!v7.recent.length) { %>
      <div class="empty">아직 리밸런싱이 없습니다. v5 수집기가 새 4시간 구간을 확보하면 시작합니다.</div>
    <% } %>
  </div>

  <div class="others">
    <% others.forEach(function(o){ %>
      <div class="row">
        <span class="n mut"><%= o.name %></span>
        <span class="st"><%= o.state %></span>
        <span class="nt"><%= o.note %> · <%= helpers.formatAgo(o.at) %></span>
      </div>
    <% }); %>
  </div>

  <footer>실거래 0원 · 전 레인 페이퍼 · <%= header.refreshNote %></footer>
</div>
</body>
</html>
