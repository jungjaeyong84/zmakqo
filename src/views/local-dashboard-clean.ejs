<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= header.title %> 로컬 대시보드</title>
<meta http-equiv="refresh" content="60">
<style>
  :root{
    --bg:#0f1115; --panel:#171a21; --panel2:#1d212a; --line:#272c38;
    --fg:#e6e9ef; --dim:#9aa3b2; --faint:#6b7484;
    --ok:#3ecf8e; --up:#3ecf8e; --down:#f0616d; --warn:#f5a524; --bad:#f0616d; --neutral:#7d8698;
  }
  @media (prefers-color-scheme: light){
    :root{
      --bg:#f6f7f9; --panel:#ffffff; --panel2:#f0f2f5; --line:#e0e3e9;
      --fg:#16191f; --dim:#5b6472; --faint:#8a93a3;
    }
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--fg);
    font:14px/1.55 -apple-system,BlinkMacSystemFont,"Apple SD Gothic Neo","Pretendard",Segoe UI,sans-serif;}
  .wrap{max-width:1180px;margin:0 auto;padding:28px 20px 64px}
  header.top{display:flex;flex-wrap:wrap;align-items:baseline;gap:12px;margin-bottom:22px}
  h1{font-size:22px;margin:0;letter-spacing:.5px}
  .sub{color:var(--dim);font-size:13px}
  .spacer{flex:1}
  .stamp{color:var(--faint);font-size:12px;font-variant-numeric:tabular-nums}

  .grid{display:grid;gap:12px}
  .cards{grid-template-columns:repeat(auto-fit,minmax(215px,1fr));margin-bottom:26px}
  .card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:15px 16px}
  .card .k{color:var(--dim);font-size:12px;letter-spacing:.3px}
  .card .v{font-size:23px;font-weight:650;margin:7px 0 5px;letter-spacing:-.3px}
  .card .n{color:var(--faint);font-size:12px;line-height:1.45}
  .tone-ok .v,.tone-up .v{color:var(--up)}
  .tone-down .v,.tone-bad .v{color:var(--down)}
  .tone-warn .v{color:var(--warn)}

  section{background:var(--panel);border:1px solid var(--line);border-radius:12px;
    padding:18px 18px 16px;margin-bottom:16px}
  section > h2{font-size:15px;margin:0 0 3px;display:flex;align-items:center;gap:9px;flex-wrap:wrap}
  section > .desc{color:var(--faint);font-size:12.5px;margin:0 0 14px}
  .pill{font-size:11px;padding:2.5px 9px;border-radius:999px;border:1px solid var(--line);
    background:var(--panel2);color:var(--dim);font-weight:500;letter-spacing:.2px}
  .pill.ok{color:var(--ok);border-color:color-mix(in srgb,var(--ok) 40%,transparent)}
  .pill.up{color:var(--up);border-color:color-mix(in srgb,var(--up) 40%,transparent)}
  .pill.warn{color:var(--warn);border-color:color-mix(in srgb,var(--warn) 40%,transparent)}
  .pill.bad{color:var(--bad);border-color:color-mix(in srgb,var(--bad) 40%,transparent)}

  .tblwrap{overflow-x:auto;-webkit-overflow-scrolling:touch}
  table{width:100%;border-collapse:collapse;font-size:13px;min-width:440px}
  th,td{text-align:right;padding:8px 10px;border-bottom:1px solid var(--line);
    font-variant-numeric:tabular-nums;white-space:nowrap}
  th{color:var(--dim);font-weight:500;font-size:12px}
  th:first-child,td:first-child{text-align:left}
  tbody tr:last-child td{border-bottom:none}
  .pos{color:var(--up)} .neg{color:var(--down)} .mut{color:var(--faint)}

  .lanes{grid-template-columns:repeat(auto-fit,minmax(255px,1fr))}
  .lane{background:var(--panel2);border:1px solid var(--line);border-radius:10px;padding:13px 14px}
  .lane .h{display:flex;align-items:center;gap:8px;margin-bottom:9px}
  .lane .nm{font-weight:600;font-size:13.5px}
  .lane .st{font-size:18px;font-weight:600;margin-bottom:3px}
  .lane .nt{color:var(--faint);font-size:11.5px}

  .bar{height:6px;background:var(--panel2);border-radius:99px;overflow:hidden;margin:9px 0 6px;
    border:1px solid var(--line)}
  .bar > i{display:block;height:100%;background:var(--neutral)}

  .note{background:var(--panel2);border-left:3px solid var(--line);border-radius:0 8px 8px 0;
    padding:11px 13px;color:var(--dim);font-size:12.5px;margin-top:13px}
  .note b{color:var(--fg);font-weight:600}
  .retired{opacity:.72}
  .retired h2{color:var(--dim)}
  footer{color:var(--faint);font-size:11.5px;text-align:center;margin-top:28px;line-height:1.7}
</style>
</head>
<body>
<div class="wrap">

  <header class="top">
    <h1><%= header.title %></h1>
    <span class="sub"><%= header.subtitle %></span>
    <span class="spacer"></span>
    <span class="stamp"><%= helpers.formatDateTime(generatedAt) %> · <%= header.refreshNote %></span>
  </header>

  <div class="grid cards">
    <% overviewCards.forEach(function(c){ %>
      <div class="card tone-<%= c.tone %>">
        <div class="k"><%= c.label %></div>
        <div class="v"><%= c.value %></div>
        <div class="n"><%= c.note %></div>
      </div>
    <% }); %>
  </div>

  <section>
    <h2>가동 레인</h2>
    <p class="desc">v3 방향성 레인은 2026-08-07 은퇴했습니다. 아래가 현재 살아 있는 전부입니다.</p>
    <div class="grid lanes">
      <% lanes.forEach(function(l){ %>
        <div class="lane">
          <div class="h">
            <span class="nm"><%= l.label %></span>
            <span class="pill <%= l.tone %>"><%= l.role %></span>
          </div>
          <div class="st"><%= l.state %></div>
          <div class="nt"><%= l.note %></div>
          <div class="nt" style="margin-top:5px">갱신 <%= helpers.formatAgo(l.updatedAt) %></div>
        </div>
      <% }); %>
    </div>
  </section>

  <section>
    <h2>
      펀딩 캐리
      <span class="pill <%= carry.isDormant ? '' : 'up' %>"><%= carry.verdictLabel %></span>
      <span class="pill">주력</span>
    </h2>
    <p class="desc">
      현물 매수 + 선물 숏으로 가격 변동을 상쇄하고 8시간마다 들어오는 수수료만 받습니다.
      맞힐 것이 없으므로 예측 정확도가 개입하지 않습니다.
      최근 <%= helpers.formatNumber(carry.windowDays) %>일 기준, 연 <%= helpers.formatNumber(carry.alertApyPct) %>% 넘으면 알림.
    </p>

    <div class="tblwrap">
      <table>
        <thead><tr><th>심볼</th><th>펀딩 APY</th><th>비용 차감 후</th><th>무위험 대비</th><th>이벤트</th><th>역전 횟수</th></tr></thead>
        <tbody>
          <% carry.perSymbol.forEach(function(r){ var s = carry.excessFor('funding', r.symbol); %>
            <tr>
              <td><%= r.symbol.replace('USDT','') %></td>
              <td><%= helpers.formatPercent(r.apyPct) %></td>
              <td class="mut"><%= s ? helpers.formatPercent(s.annualized_net_pct) : '-' %></td>
              <td class="<%= s && s.excess_pct > 0 ? 'pos' : 'neg' %>">
                <%= s ? helpers.formatSigned(s.excess_pct) : '-' %>
              </td>
              <td class="mut"><%= helpers.formatNumber(r.events) %></td>
              <td class="<%= r.negativeEvents > 0 ? 'neg' : 'mut' %>"><%= helpers.formatNumber(r.negativeEvents) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <% if (carry.basisSources.length) { %>
      <p class="desc" style="margin:18px 0 8px">
        <b style="color:var(--fg)">분기선물 베이시스</b> — 만기가 있어 인도일에 차익거래로 수렴합니다.
        펀딩과 달리 재가격되지 않으므로, 진입 시점의 수익률이 만기까지 확정됩니다.
      </p>
      <div class="tblwrap">
        <table>
          <thead><tr><th>계약</th><th>연환산 순수익</th><th>무위험 대비</th></tr></thead>
          <tbody>
            <% carry.basisSources.forEach(function(s){ %>
              <tr>
                <td><%= s.symbol.replace('USDT','') %></td>
                <td><%= helpers.formatPercent(s.annualized_net_pct) %></td>
                <td class="<%= s.excess_pct > 0 ? 'pos' : 'neg' %>"><%= helpers.formatSigned(s.excess_pct) %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>

    <% if (carry.isDormant) { %>
      <div class="note">
        <b>지금 아무것도 하지 않는 것이 정상 동작입니다.</b>
        어떤 심볼도 무위험 수익률을 의미 있게 넘지 못해, 자본은 무위험 자산에 대기합니다.
        방향성 전략과 달리 이 상태에서는 손실이 발생하지 않습니다 — 틀릴 베팅 자체가 없기 때문입니다.
        <% if (!carry.hot.length) { %>과열 심볼: 없음.<% } else { %>과열 심볼: <%= carry.hot.join(', ') %>.<% } %>
      </div>
    <% } %>
  </section>

  <section>
    <h2>v4 크로스섹셔널 페이퍼 <span class="pill">관찰</span></h2>
    <p class="desc">
      시장중립 롱숏. 90일 기준까지 <%= helpers.formatNumber(v4.days) %>일 누적
      (연변동성이 낮게 유지되면 중립이 작동하는 것).
    </p>
    <div class="bar"><i style="width:<%= v4.progressPct %>%"></i></div>

    <div class="tblwrap">
      <table>
        <thead><tr><th>변형</th><th>일수</th><th>연수익</th><th>무위험 대비</th><th>초과 샤프</th><th>변동성</th><th>MDD</th><th>판정</th></tr></thead>
        <tbody>
          <% v4.variants.forEach(function(v){ %>
            <tr>
              <td><%= v.name %></td>
              <td class="mut"><%= helpers.formatNumber(v.days) %></td>
              <td class="<%= v.annPct >= 0 ? 'pos' : 'neg' %>"><%= helpers.formatPercent(v.annPct, 1) %></td>
              <td class="<%= v.excessPct >= 0 ? 'pos' : 'neg' %>"><%= helpers.formatSigned(v.excessPct, 1) %></td>
              <td class="<%= v.excessSharpe >= 0 ? 'pos' : 'neg' %>"><%= helpers.formatNumber(v.excessSharpe, 2) %></td>
              <td class="mut"><%= helpers.formatPercent(v.volPct, 1) %></td>
              <td class="neg"><%= helpers.formatPercent(v.maxDdPct, 1) %></td>
              <td class="mut"><%= v.verdict %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <div class="note">
      진단 결과 이 구조는 이 거래소에서 구조적으로 불리합니다. 유니버스 평균 쌍상관이 0.693이라
      <b>27종목이 실질 1.4개 독립 베팅</b>에 불과하고, 그래서 샤프 0.5를 넘기려면 IC 0.121이 필요합니다
      (달성 가능 범위는 0.02~0.05). 신호를 개선해서 해결되는 문제가 아닙니다.
      90일까지는 판정을 보류하고 데이터만 쌓습니다.
    </div>
  </section>

  <section>
    <h2>
      v5 flow 수집기
      <span class="pill <%= flow.failures.length ? 'warn' : 'ok' %>">
        <%= flow.failures.length ? flow.failures.length + '건 실패' : '정상' %>
      </span>
    </h2>
    <p class="desc">
      OI · 큰손/개미 롱숏비율 · 테이커비율은 가격에서 유도할 수 없는 정보인데,
      바이낸스는 <b><%= flow.apiHorizonDays %>일치만</b> 제공합니다. 적어두지 않으면 다음 달에도 <%= flow.apiHorizonDays %>일입니다.
    </p>

    <div class="tblwrap">
      <table>
        <thead><tr><th>확보 기간</th><th>총 행수</th><th>직전 추가</th><th>심볼</th><th>최초</th><th>최신</th></tr></thead>
        <tbody>
          <tr>
            <td class="<%= (flow.bankedSpanDays||0) > flow.apiHorizonDays ? 'pos' : '' %>">
              <%= helpers.formatNumber(flow.bankedSpanDays, 0) %>일
            </td>
            <td><%= helpers.formatNumber(flow.rowsTotal) %></td>
            <td class="mut">+<%= helpers.formatNumber(flow.rowsAppended) %></td>
            <td class="mut"><%= helpers.formatNumber(flow.symbols) %></td>
            <td class="mut"><%= helpers.formatDateTime(flow.earliest) %></td>
            <td class="mut"><%= helpers.formatDateTime(flow.latest) %></td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="note">
      <b>이 데이터는 백필이 불가능합니다.</b> <%= flow.apiHorizonDays %>일 넘게 수집이 멈추면
      그 구간은 영구히 사라집니다. 데드맨이 26시간 기준으로 감시하는 이유입니다.
    </div>
  </section>

  <section>
    <h2>인프라 <span class="pill <%= deadman.stale.length ? 'bad' : 'ok' %>">
      <%= deadman.stale.length ? deadman.stale.length + '개 정지' : '전부 정상' %></span></h2>
    <p class="desc">데드맨 심박 감시 및 원장 백업. 감시 대상은 <em>살아 있어야 하는</em> 레인만입니다 —
      일부러 멈춘 작업을 감시하면 영구 오알람이 되고, 늑대소년이 된 데드맨은 무시당합니다.</p>

    <div class="tblwrap">
      <table>
        <thead><tr><th>감시 대상</th><th>상태</th><th>마지막 갱신</th><th>허용 지연</th></tr></thead>
        <tbody>
          <% deadman.healthy.forEach(function(h){ %>
            <tr>
              <td><%= h.name %></td>
              <td class="pos">정상</td>
              <td class="mut"><%= Math.round(h.age_ms/60000) %>분 전</td>
              <td class="mut"><%= Math.round(h.max_age_ms/3600000) %>시간</td>
            </tr>
          <% }); %>
          <% deadman.stale.forEach(function(h){ %>
            <tr>
              <td><%= h.name %></td>
              <td class="neg">심박 정지</td>
              <td class="neg"><%= Math.round(h.age_ms/60000) %>분 전</td>
              <td class="mut"><%= Math.round(h.max_age_ms/3600000) %>시간</td>
            </tr>
          <% }); %>
          <tr>
            <td>원장 백업</td>
            <td class="pos"><%= helpers.formatNumber(backup.count) %>개 보관</td>
            <td class="mut"><%= helpers.formatAgo(backup.latestAt) %></td>
            <td class="mut">일 1회</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="retired">
    <h2><%= retired.label %> <span class="pill">은퇴 <%= retired.retiredOn %></span></h2>
    <p class="desc">기록으로만 남깁니다. 아래 수치는 정지 시점에 고정된 값이며 더 이상 갱신되지 않습니다.</p>

    <div class="tblwrap">
      <table>
        <thead><tr><th>최종 거래</th><th>승률</th><th>비용 전 기대값</th><th>비용 후 기대값</th><th>동결 시각</th></tr></thead>
        <tbody>
          <tr>
            <td><%= helpers.formatNumber(retired.finalTrades) %></td>
            <td><%= helpers.formatPercent(retired.finalWinRate) %></td>
            <td class="pos"><%= helpers.formatNumber(retired.finalGrossExpectancyR, 4) %>R</td>
            <td class="<%= retired.finalExpectancyR > 0 ? 'pos' : 'neg' %>">
              <%= helpers.formatNumber(retired.finalExpectancyR, 4) %>R
            </td>
            <td class="mut"><%= helpers.formatDateTime(retired.lastUpdated) %></td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="note">
      <b>은퇴 사유.</b> <%= retired.reason %>
      신호에 비용 전 우위는 실재했지만(<%= helpers.formatNumber(retired.finalGrossExpectancyR, 4) %>R/거래),
      왕복 비용이 그 우위와 거의 같은 크기여서 순 기대값이 0으로 수렴했습니다.
      실행 개선으로도 넘을 수 없음을 확인했습니다 — 모든 진입이 메이커로 체결되는 물리적 최선에서도
      0.0488R로 게이트(0.05R)에 미달하고, 신뢰구간이 0을 포함합니다.
    </div>
  </section>

  <footer>
    실거래 노출 0 USDT · 전 레인 페이퍼 · 주문 경로 없음<br>
    <%= helpers.formatDateTime(generatedAt) %> 생성 · <%= header.refreshNote %>
  </footer>

</div>
</body>
</html>
