<%- include('partials/app_start_unified', { title: '분석 · DONBEOLJA', pageTitle: '분석', active: 'analysis' }) %>

<div class="grid cols-3">
  <div class="card">
    <div class="card-header">
      <div class="card-title">리포트</div>
      <div class="card-subtitle">기간 성과와 개선팩을 깊게 보는 보조 화면입니다.</div>
    </div>
    <div class="card-body">
      <table class="table-compact">
        <tr><td class="text-muted">최근 주간</td><td id="an-wk">...</td></tr>
        <tr><td class="text-muted">최근 월간</td><td id="an-mo">...</td></tr>
      </table>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <div class="card-title">평가</div>
      <div class="card-subtitle">표본 수, EV, 유지/제거 판단 근거를 세부 확인합니다.</div>
    </div>
    <div class="card-body">
      <table class="table-compact">
        <tr><td class="text-muted">평가 주차</td><td id="an-ev-week">...</td></tr>
        <tr><td class="text-muted">상태</td><td id="an-ev-status">...</td></tr>
      </table>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <div class="card-title">브리핑</div>
      <div class="card-subtitle">현재 상태를 사람이 읽기 쉬운 문장으로 다시 요약합니다.</div>
    </div>
    <div class="card-body">
      <table class="table-compact">
        <tr><td class="text-muted">출처</td><td id="an-br-src">...</td></tr>
        <tr><td class="text-muted">업데이트</td><td id="an-br-upd">...</td></tr>
      </table>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <div class="card-title">데이터 신선도</div>
    <div class="card-subtitle">신호/체결의 최신 도착 시각을 확인합니다. 운영 판단은 미션/실행/감사에서 먼저 읽습니다.</div>
  </div>
  <div class="card-body">
    <div class="grid cols-2">
      <div class="mini-card">
        <div class="metric-card-label">신호 최신</div>
        <div class="metric-card-value mono" style="font-size:13px;" id="an-sig">...</div>
      </div>
      <div class="mini-card">
        <div class="metric-card-label">체결 최신</div>
        <div class="metric-card-value mono" style="font-size:13px;" id="an-fill">...</div>
      </div>
    </div>
  </div>
</div>

<script>
(async function(){
  async function j(url){
    try{
      const r = await fetch(url, { credentials:'include' });
      const t = await r.text();
      try{ return { ok:r.ok, json: JSON.parse(t) }; } catch(_){ return { ok:r.ok, json:null }; }
    }catch(e){ return { ok:false, json:null }; }
  }
  function set(id, v){
    const el = document.getElementById(id);
    if (el) el.textContent = v;
  }
  function toMsSafe(v){
    if (!v) return null;
    const direct = Date.parse(String(v));
    if (Number.isFinite(direct)) return direct;
    const s = String(v);
    if (s.includes(" KST")) {
      const iso = s.replace(" KST", "+09:00");
      const ms = Date.parse(iso);
      if (Number.isFinite(ms)) return ms;
    }
    return null;
  }
  function fmtKstMs(ms){
    if (!Number.isFinite(ms)) return "-";
    const k = new Date(ms + 9 * 60 * 60 * 1000);
    const pad = (n) => String(n).padStart(2, "0");
    return `${k.getUTCFullYear()}-${pad(k.getUTCMonth() + 1)}-${pad(k.getUTCDate())} ${pad(k.getUTCHours())}:${pad(k.getUTCMinutes())}:${pad(k.getUTCSeconds())} KST`;
  }
  function fmtKst(v){
    if (!v) return "-";
    const ms = toMsSafe(v);
    if (!Number.isFinite(ms)) return String(v);
    return fmtKstMs(ms);
  }
  function statusLabel(s){
    const x = String(s || "").toUpperCase();
    if (x === "GREEN" || x === "PASS" || x === "OK") return "양호";
    if (x === "YELLOW" || x === "WARN") return "주의";
    if (x === "RED" || x === "FAIL") return "경고";
    if (x === "INCONCLUSIVE" || x === "NEED_DATA") return "보류";
    return s || "-";
  }

  const ev = await j('/api/eval/latest');
  if (ev.ok && ev.json && ev.json.ok){
    set('an-ev-week', ev.json.id || '-');
    const st = ev.json.data && ev.json.data.status ? ev.json.data.status : (ev.json.status || 'OK');
    set('an-ev-status', statusLabel(st));
  } else {
    set('an-ev-week','(확인 불가)');
    set('an-ev-status','(확인 불가)');
  }

  const wk = await j('/api/report/latest?mode=weekly');
  const mo = await j('/api/report/latest?mode=monthly');
  if (wk.ok && wk.json && wk.json.ok) set('an-wk', (wk.json.id||'LATEST__weekly') + ' · ' + fmtKst(wk.json.data?.computed_at || '-'));
  else set('an-wk','(확인 불가)');
  if (mo.ok && mo.json && mo.json.ok) set('an-mo', (mo.json.id||'LATEST__monthly') + ' · ' + fmtKst(mo.json.data?.computed_at || '-'));
  else set('an-mo','(확인 불가)');

  const br = await j('/api/briefing/latest');
  if (br.ok && br.json && br.json.ok){
    set('an-br-src', 'kpi_latest (' + (br.json.count||0) + ' rows)');
    set('an-br-upd', fmtKst(br.json.computed_at || '-'));
  } else {
    set('an-br-src','(확인 불가)');
    set('an-br-upd','(확인 불가)');
  }

  const st = await j('/api/state');
  let latestSigText = null;
  let latestFillText = null;
  if (st.ok && st.json && st.json.ok && Array.isArray(st.json.rows)){
    let sigMs = null;
    let sigMarket = null;
    let fillMs = null;
    let fillMarket = null;
    for (const row of st.json.rows){
      const s = row.last_signal || null;
      const f = row.last_fill || null;
      const sMs = toMsSafe(s?.created_at || s?.created_kst || s?.createdAt);
      const fMs = toMsSafe(f?.created_at || f?.created_kst || f?.createdAt);
      if (Number.isFinite(sMs) && (sigMs === null || sMs > sigMs)) {
        sigMs = sMs;
        sigMarket = row.market || s?.symbol_or_pair_id || s?.symbol || null;
      }
      if (Number.isFinite(fMs) && (fillMs === null || fMs > fillMs)) {
        fillMs = fMs;
        fillMarket = row.market || f?.symbol_or_pair_id || f?.symbol || null;
      }
    }
    if (sigMs !== null) {
      latestSigText = fmtKstMs(sigMs) + (sigMarket ? (' · ' + sigMarket) : '');
      set('an-sig', latestSigText);
    }
    if (fillMs !== null) {
      latestFillText = fmtKstMs(fillMs) + (fillMarket ? (' · ' + fillMarket) : '');
      set('an-fill', latestFillText);
    }
  }

  // freshness: piggyback report preview (cheap)
  const now = new Date();
  const from = new Date(now.getTime() - 7*24*60*60*1000).toISOString();
  const to = now.toISOString();
  const prev = await j('/api/report/preview?from=' + encodeURIComponent(from) + '&to=' + encodeURIComponent(to));
  if (prev.ok && prev.json && prev.json.ok){
    const counts = prev.json.counts || {};
    const fillsNew = counts.fills_new ?? prev.json.fillsNew ?? prev.json.fills_new ?? '-';
    const sellsNew = counts.sells_new ?? prev.json.sellsNew ?? prev.json.sells_new ?? '-';
    const fillSuffix = '신규체결=' + fillsNew + ', 신규매도=' + sellsNew;
    if (latestFillText) set('an-fill', latestFillText + ' · ' + fillSuffix);
    else set('an-fill', fillSuffix);
    if (!latestSigText) set('an-sig', fmtKst(prev.json.range?.to || '(확인 불가)'));
  } else {
    set('an-sig','(미리보기 없음)');
    set('an-fill','(미리보기 없음)');
  }
})();
</script>

<%- include('partials/app_end_unified') %>
