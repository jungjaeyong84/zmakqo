<%- include('partials/app_start', { title: '입출금 · DONBEOLJA Ω', pageTitle: '입출금', active: 'cashflow' }) %>

<%
  const entries = (cashflow && Array.isArray(cashflow.entries)) ? cashflow.entries : [];
  const coins = (cashflow && Array.isArray(cashflow.coins)) ? cashflow.coins : [];
  const summary = cashflow && cashflow.summary ? cashflow.summary : null;
  const summaryCoin = summary ? summary.coin : null;
  const rangeDays = range && range.days ? range.days : 30;
  const customRangeData = (typeof customRange !== 'undefined') ? customRange : null;
  const rangeWarningMsg = (typeof rangeWarning !== 'undefined') ? rangeWarning : null;
  const rangeLabel = (customRangeData && customRangeData.start && customRangeData.end)
    ? (`기간선택 · ${customRangeData.start} ~ ${customRangeData.end}`)
    : (`최근 ${rangeDays}일`);

  function fmtNum(v, digits = 4) {
    const n = Number(v);
    if (!Number.isFinite(n)) return "-";
    return n.toLocaleString('en-US', { maximumFractionDigits: digits, minimumFractionDigits: digits });
  }
  function fmtAmt(v, digits = 4) {
    const n = Number(v);
    if (!Number.isFinite(n)) return "-";
    return n.toLocaleString('en-US', { maximumFractionDigits: digits, minimumFractionDigits: 0 });
  }
  function fmtKst(ms) {
    const n = Number(ms);
    if (!Number.isFinite(n)) return "-";
    const k = new Date(n + 9 * 60 * 60 * 1000);
    const pad = (x) => String(x).padStart(2, "0");
    return `${k.getUTCFullYear()}-${pad(k.getUTCMonth() + 1)}-${pad(k.getUTCDate())} ${pad(k.getUTCHours())}:${pad(k.getUTCMinutes())}`;
  }
  function fmtKrw(v) {
    const n = Number(v);
    if (!Number.isFinite(n)) return "-";
    const sign = n < 0 ? "-" : "";
    const abs = Math.abs(n);
    return sign + Math.round(abs).toLocaleString("en-US");
  }
%>

<%- include('partials/legacy_report_subnav', { activeTab: 'cashflow' }) %>
<%- include('partials/legacy_control_surface_bridge', { mode: 'report', surfaceHref: '/dashboard/home', surfaceLabel: '미션', detailHref: '/dashboard/audit', detailLabel: '감사', extraHref: '/dashboard/deployment', extraLabel: '배포' }) %>

<style>
  .cashflow-shell{ background: transparent; border: 0; border-radius: 0; padding: 0; box-shadow: none; }
  .cashflow-head{ display:flex; align-items:flex-start; justify-content:space-between; gap: 12px; flex-wrap:wrap; margin-bottom: 12px; }
  .cashflow-title{ font-size: 18px; font-weight: 700; letter-spacing: -0.2px; }
  .cashflow-sub{ color: var(--muted); font-size: 12px; }
  .cashflow-controls{ display:flex; gap: 8px; flex-wrap:wrap; align-items:center; }
  .cashflow-controls label{ display:flex; align-items:center; gap:8px; font-size:12px; color: var(--muted); background:#fff; border:1px solid var(--line); padding:6px 8px; border-radius:10px; }
  .cashflow-controls .label-text{ white-space: nowrap; }
  .cashflow-controls select{ border:0; background:transparent; font-size:12px; color: var(--text); outline:none; }
  .cashflow-controls button{ background:#fff; border:1px solid var(--line); border-radius:10px; padding:6px 10px; font-size:12px; cursor:pointer; }
  .cashflow-cards{ display:grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 14px; }
  .cashflow-card{ background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 12px; min-height: 80px; }
  .cashflow-card .k{ color: var(--muted); font-size: 11px; }
  .cashflow-card .v{ font-size: 16px; font-weight: 700; margin-top: 6px; }
  .cashflow-card .note{ font-size: 11px; color: var(--muted); margin-top: 4px; }
  .cashflow-table{ width:100%; border-collapse: collapse; }
  .cashflow-table th{ text-align:left; font-size: 11px; color: var(--muted); padding: 8px 10px; border-bottom: 1px solid var(--line); }
  .cashflow-table td{ font-size: 12px; padding: 9px 10px; border-bottom: 1px solid var(--line); }
  .cashflow-table tr:last-child td{ border-bottom: 0; }
  .cashflow-amount.up{ color: #0b6; font-weight: 600; }
  .cashflow-amount.down{ color: #c23; font-weight: 600; }
  .cashflow-amount.neutral{ color: var(--text); font-weight: 600; }
  .cashflow-tag{ display:inline-flex; padding:2px 8px; border-radius:999px; font-size:11px; border:1px solid var(--line); background:#fff; }
  .cashflow-tag.deposit{ color:#0b6; border-color: rgba(11,102,85,0.25); }
  .cashflow-tag.withdraw{ color:#c23; border-color: rgba(194,35,51,0.25); }
  .cashflow-tag.transfer{ color:#2563eb; border-color: rgba(37,99,235,0.25); }
  .cashflow-tag.excluded{ color:#b7791f; border-color: rgba(183,121,31,0.35); margin-left:6px; }
  .cashflow-section{ background: var(--card); border:1px solid var(--line); border-radius: 14px; padding: 14px; margin-bottom: 14px; }

  .cf-modal{ position: fixed; inset: 0; display:none; align-items:center; justify-content:center; z-index: 2000; }
  .cf-modal.open{ display:flex; }
  .cf-modal-backdrop{ position:absolute; inset:0; background: rgba(0,0,0,0.35); }
  .cf-modal-body{ position:relative; background:#fff; border:1px solid var(--line); border-radius:16px; padding:18px; width: min(420px, 92vw); box-shadow: 0 20px 40px rgba(0,0,0,0.18); }
  .cf-modal-head{ display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:6px; }
  .cf-modal-title{ font-size:16px; font-weight:700; }
  .cf-modal-close{ border:0; background:#fff; font-size:18px; cursor:pointer; color: var(--muted); }
  .cf-modal-sub{ font-size:12px; color: var(--muted); margin-bottom:12px; }
  .cf-modal-grid{ display:grid; grid-template-columns: 1fr 1fr; gap:10px; }
  .cf-modal-grid label{ font-size:12px; color: var(--muted); display:flex; flex-direction:column; gap:6px; }
  .cf-modal-grid input{ border:1px solid var(--line); border-radius:10px; padding:8px 10px; font-size:12px; }
  .cf-modal-actions{ margin-top:14px; display:flex; justify-content:flex-end; }
  .cf-modal-actions .btn{ background:#111; color:#fff; border:0; border-radius:12px; padding:8px 16px; font-size:12px; cursor:pointer; }

  @media (max-width: 900px){
    .cashflow-cards{ grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px){
    .cashflow-cards{ grid-template-columns: 1fr; }
    .cashflow-controls{ width:100%; }
    .cashflow-controls label, .cashflow-controls button{ width:100%; justify-content:space-between; }
  }
</style>

<div class="cashflow-shell">
  <div class="cashflow-head">
    <div>
      <div class="cashflow-title">입출금 세부 분석</div>
      <div class="cashflow-sub"><%= exchange %> · BINANCE Wallet · 보조 화면 · <%= rangeLabel %> · USDT는 당시 1h 시세로 환산</div>
      <div class="cashflow-sub">자금 이동 세부 로그를 확인하는 용도이며, 운영 판단은 미션/감사를 우선합니다.</div>
    </div>
    <div class="cashflow-controls">
      <label>
        <span class="label-text">기간</span>
        <select id="cf-range" data-current="<%= range && range.key ? range.key : 'd30' %>">
          <% if (customRangeData && customRangeData.start && customRangeData.end) { %>
            <option value="custom" selected disabled>기간선택</option>
          <% } %>
          <% (ranges || []).forEach(r => { %>
            <option value="<%= r.key %>" <%= (range && r.key === range.key) ? 'selected' : '' %>><%= r.label %></option>
          <% }) %>
        </select>
      </label>
      <label>
        <span class="label-text">유형</span>
        <select id="cf-type" data-current="all">
          <option value="all">전체</option>
          <option value="DEPOSIT">입금</option>
          <option value="WITHDRAW">출금</option>
          <option value="TRANSFER">전송</option>
        </select>
      </label>
      <label>
        <span class="label-text">코인</span>
        <select id="cf-coin" data-current="all">
          <option value="all">전체</option>
          <% coins.forEach(c => { %>
            <option value="<%= c.coin %>"><%= c.coin %></option>
          <% }) %>
        </select>
      </label>
      <button id="cf-range-open" type="button">기간선택</button>
      <button id="cf-reset" type="button">초기화</button>
    </div>
  </div>

  <% if (rangeWarningMsg) { %>
    <div class="card" style="margin-bottom:12px;">
      <div class="subtle"><%= rangeWarningMsg %></div>
    </div>
  <% } %>

  <% if (error) { %>
    <div class="card">
      <div class="subtle">입출금 데이터를 불러오지 못했습니다.</div>
      <div class="mono"><%= error %></div>
    </div>
  <% } else if (!supported) { %>
    <div class="card">
      <div class="subtle">현재는 BINANCEFUT 입출금만 지원합니다.</div>
    </div>
  <% } else { %>
    <div class="cashflow-cards">
      <div class="cashflow-card" id="cf-card-1">
        <div class="k" id="cf-card-1-label">입금 합계 (<%= summaryCoin || '-' %>)</div>
        <div class="v" id="cf-card-1-value"><%= summary ? fmtNum(summary.deposit, 4) : '-' %></div>
        <div class="note" id="cf-card-1-note">
          <%= summaryCoin ? '완료 기준 · 외부 입출금 집계' : '코인별 합계만 표시' %>
          <% if (summary && summary.coin === 'USDT' && summary.krw_deposit != null) { %>
            · ≈ <%= fmtKrw(summary.krw_deposit) %> KRW
          <% } %>
        </div>
      </div>
      <div class="cashflow-card" id="cf-card-2">
        <div class="k" id="cf-card-2-label">출금 합계 (<%= summaryCoin || '-' %>)</div>
        <div class="v" id="cf-card-2-value"><%= summary ? fmtNum(summary.withdraw, 4) : '-' %></div>
        <div class="note" id="cf-card-2-note">
          <%= summaryCoin ? '완료 기준 · 외부 입출금 집계' : '코인별 합계만 표시' %>
          <% if (summary && summary.coin === 'USDT' && summary.krw_withdraw != null) { %>
            · ≈ <%= fmtKrw(summary.krw_withdraw) %> KRW
          <% } %>
        </div>
      </div>
      <div class="cashflow-card" id="cf-card-3">
        <div class="k" id="cf-card-3-label">순유입 (<%= summaryCoin || '-' %>)</div>
        <div class="v" id="cf-card-3-value"><%= summary ? fmtNum(summary.net, 4) : '-' %></div>
        <div class="note" id="cf-card-3-note">
          <%= summaryCoin ? '입금-출금 · 외부 입출금 집계' : '코인별 합계만 표시' %>
          <% if (summary && summary.coin === 'USDT' && summary.krw_net != null) { %>
            · ≈ <%= fmtKrw(summary.krw_net) %> KRW
          <% } %>
        </div>
      </div>
      <div class="cashflow-card" id="cf-card-4">
        <div class="k" id="cf-card-4-label">완료 건수</div>
        <div class="v" id="cf-card-4-value"><%= summary ? (summary.n_deposit + summary.n_withdraw) : '-' %></div>
        <div class="note" id="cf-card-4-note"><%= entries.length ? ('전체 기록 ' + entries.length + '건') : '기록 없음' %></div>
      </div>
    </div>

  <% if (coins.length > 1 || !summaryCoin) { %>
      <div class="cashflow-section">
        <h2>코인별 합계</h2>
        <div class="subtle">완료된 입출금만 집계합니다. 운영 판단은 미션/감사를 우선합니다.</div>
        <div class="hr"></div>
        <table class="cashflow-table">
          <thead>
            <tr>
              <th>코인</th>
              <th>입금</th>
              <th>출금</th>
              <th>순유입</th>
              <th>건수</th>
            </tr>
          </thead>
          <tbody>
            <% coins.forEach(c => { %>
              <tr>
                <td class="mono"><%= c.coin %></td>
                <td class="mono">
                  <%= fmtAmt(c.deposit, 4) %>
                  <% if (c.coin === 'USDT' && c.krw_deposit != null) { %>
                    <div class="subtle">≈ <%= fmtKrw(c.krw_deposit) %> KRW</div>
                  <% } %>
                </td>
                <td class="mono">
                  <%= fmtAmt(c.withdraw, 4) %>
                  <% if (c.coin === 'USDT' && c.krw_withdraw != null) { %>
                    <div class="subtle">≈ <%= fmtKrw(c.krw_withdraw) %> KRW</div>
                  <% } %>
                </td>
                <td class="mono">
                  <%= fmtAmt(c.net, 4) %>
                  <% if (c.coin === 'USDT' && c.krw_net != null) { %>
                    <div class="subtle">≈ <%= fmtKrw(c.krw_net) %> KRW</div>
                  <% } %>
                </td>
                <td class="mono"><%= c.n_deposit + c.n_withdraw %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>

    <div class="cashflow-section">
      <h2>입출금 내역</h2>
      <div class="subtle">Binance wallet 기준 세부 로그입니다. 전송/입출금 모두 표시하며, 완료 외 상태는 참고용으로 표시합니다.</div>
      <div class="hr"></div>
      <table class="cashflow-table" id="cf-table">
        <thead>
          <tr>
            <th>시각(KST)</th>
            <th>유형</th>
            <th>코인</th>
            <th>수량</th>
            <th>수수료</th>
            <th>상태</th>
            <th>비고</th>
          </tr>
        </thead>
        <tbody>
          <% if (!entries.length) { %>
            <tr><td colspan="7" class="subtle"><%= rangeLabel %> 기준 입출금 기록이 없습니다.</td></tr>
          <% } %>
          <% entries.forEach(row => { %>
            <% const isTransfer = row.type === 'TRANSFER'; %>
            <% const dir = isTransfer ? row.direction : (row.type === 'DEPOSIT' ? 'IN' : 'OUT'); %>
            <% const sign = dir === 'IN' ? '+' : (dir === 'OUT' ? '-' : ''); %>
            <% const amtClass = dir === 'IN' ? 'up' : (dir === 'OUT' ? 'down' : 'neutral'); %>
            <tr
              data-type="<%= row.type %>"
              data-coin="<%= row.coin %>"
              data-completed="<%= row.completed ? '1' : '0' %>"
              data-excluded="<%= row.excluded_from_summary ? '1' : '0' %>"
              data-direction="<%= dir || '' %>"
              data-amount="<%= Number.isFinite(Number(row.amount)) ? Number(row.amount) : '' %>"
              data-krw="<%= Number.isFinite(Number(row.krw_amount)) ? Number(row.krw_amount) : '' %>"
            >
              <td class="mono"><%= fmtKst(row.time_ms) %></td>
              <td>
                <span class="cashflow-tag <%= row.type === 'DEPOSIT' ? 'deposit' : (row.type === 'WITHDRAW' ? 'withdraw' : 'transfer') %>">
                  <%= row.type === 'DEPOSIT' ? '입금' : (row.type === 'WITHDRAW' ? '출금' : '전송') %>
                </span>
              </td>
              <td class="mono"><%= row.coin %></td>
              <td class="mono cashflow-amount <%= amtClass %>">
                <%= sign %><%= fmtAmt(row.amount, 6) %>
                <% if (row.coin === 'USDT' && row.krw_amount != null) { %>
                  <div class="subtle">≈ <%= fmtKrw(row.krw_amount) %> KRW</div>
                <% } %>
              </td>
              <td class="mono"><%= row.fee != null ? fmtAmt(row.fee, 6) : '-' %></td>
              <td class="mono">
                <%= row.status_label %>
                <% if (row.excluded_from_summary) { %>
                  <span class="cashflow-tag excluded" title="전송과 중복되어 합계에서 제외">중복 제외</span>
                <% } %>
              </td>
              <td class="mono">
                <%= row.remark ? row.remark : '-' %>
                <% if (row.exclude_reason === 'MIRROR_TRANSFER_IN') { %>
                  <div class="subtle">전송 미러 감지로 합계 제외</div>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<div class="cf-modal" id="cf-range-modal" aria-hidden="true">
  <div class="cf-modal-backdrop" data-close="1"></div>
  <div class="cf-modal-body">
    <div class="cf-modal-head">
      <div class="cf-modal-title">기간선택</div>
      <button class="cf-modal-close" type="button" data-close="1">×</button>
    </div>
    <div class="cf-modal-sub">6개월 이내로 선택할 수 있습니다.</div>
    <div class="cf-modal-grid">
      <label>
        시작일
        <input type="date" id="cf-start" value="<%= customRangeData && customRangeData.start ? customRangeData.start : '' %>"/>
      </label>
      <label>
        종료일
        <input type="date" id="cf-end" value="<%= customRangeData && customRangeData.end ? customRangeData.end : '' %>"/>
      </label>
    </div>
    <div class="cf-modal-actions">
      <button class="btn" id="cf-range-apply" type="button">확인</button>
    </div>
  </div>
</div>

<script>
(function(){
  const rangeSel = document.getElementById('cf-range');
  const typeSel = document.getElementById('cf-type');
  const coinSel = document.getElementById('cf-coin');
  const resetBtn = document.getElementById('cf-reset');
  const table = document.getElementById('cf-table');
  const rangeOpen = document.getElementById('cf-range-open');
  const modal = document.getElementById('cf-range-modal');
  const startInput = document.getElementById('cf-start');
  const endInput = document.getElementById('cf-end');
  const applyBtn = document.getElementById('cf-range-apply');
  const card1Label = document.getElementById('cf-card-1-label');
  const card1Value = document.getElementById('cf-card-1-value');
  const card1Note = document.getElementById('cf-card-1-note');
  const card2Label = document.getElementById('cf-card-2-label');
  const card2Value = document.getElementById('cf-card-2-value');
  const card2Note = document.getElementById('cf-card-2-note');
  const card3Label = document.getElementById('cf-card-3-label');
  const card3Value = document.getElementById('cf-card-3-value');
  const card3Note = document.getElementById('cf-card-3-note');
  const card4Label = document.getElementById('cf-card-4-label');
  const card4Value = document.getElementById('cf-card-4-value');
  const card4Note = document.getElementById('cf-card-4-note');
  if (!table) return;

  const toNum = (v) => {
    const n = Number(v);
    return Number.isFinite(n) ? n : null;
  };
  const fmtNum = (n, digits = 4) => {
    if (!Number.isFinite(n)) return '-';
    return n.toLocaleString('en-US', { minimumFractionDigits: digits, maximumFractionDigits: digits });
  };
  const fmtKrw = (n) => {
    if (!Number.isFinite(n)) return '-';
    const sign = n < 0 ? '-' : '';
    return sign + Math.round(Math.abs(n)).toLocaleString('en-US');
  };

  const getRows = () => Array.from(table.querySelectorAll('tbody tr[data-type]'));
  const rowMeta = (tr) => ({
    type: tr.getAttribute('data-type'),
    coin: tr.getAttribute('data-coin'),
    completed: tr.getAttribute('data-completed') === '1',
    excluded: tr.getAttribute('data-excluded') === '1',
    direction: tr.getAttribute('data-direction'),
    amount: toNum(tr.getAttribute('data-amount')),
    krw: toNum(tr.getAttribute('data-krw')),
  });

  const matchRow = (meta, type, coin) => {
    const matchType = type === 'all' || meta.type === type;
    const matchCoin = coin === 'all' || meta.coin === coin;
    return matchType && matchCoin;
  };

  const updateCards = () => {
    const type = typeSel ? typeSel.value : 'all';
    const coin = coinSel ? coinSel.value : 'all';
    const labelCoin = coin === 'all' ? '전체' : coin;
    const rows = getRows().map((tr) => rowMeta(tr)).filter((meta) => matchRow(meta, type, coin));

    if (type === 'TRANSFER') {
      let inAmt = 0;
      let outAmt = 0;
      let inKrw = 0;
      let outKrw = 0;
      let count = 0;
      rows.forEach((r) => {
        if (r.type !== 'TRANSFER' || !r.completed || !Number.isFinite(r.amount)) return;
        count += 1;
        if (r.direction === 'IN') {
          inAmt += r.amount;
          if (Number.isFinite(r.krw)) inKrw += Math.abs(r.krw);
          return;
        }
        if (r.direction === 'OUT') {
          outAmt += r.amount;
          if (Number.isFinite(r.krw)) outKrw += Math.abs(r.krw);
        }
      });
      const netAmt = inAmt - outAmt;
      const netKrw = inKrw - outKrw;

      if (card1Label) card1Label.textContent = `전송 IN 합계 (${labelCoin})`;
      if (card2Label) card2Label.textContent = `전송 OUT 합계 (${labelCoin})`;
      if (card3Label) card3Label.textContent = `순전송 (${labelCoin})`;
      if (card4Label) card4Label.textContent = '완료 건수';

      if (card1Value) card1Value.textContent = fmtNum(inAmt, 4);
      if (card2Value) card2Value.textContent = fmtNum(outAmt, 4);
      if (card3Value) card3Value.textContent = fmtNum(netAmt, 4);
      if (card4Value) card4Value.textContent = String(count);

      if (card1Note) card1Note.textContent = Number.isFinite(inKrw) && inKrw > 0 ? `완료 기준 · 내부 전송 참고용 · ≈ ${fmtKrw(inKrw)} KRW` : '완료 기준 · 내부 전송 참고용';
      if (card2Note) card2Note.textContent = Number.isFinite(outKrw) && outKrw > 0 ? `완료 기준 · 내부 전송 참고용 · ≈ ${fmtKrw(outKrw)} KRW` : '완료 기준 · 내부 전송 참고용';
      if (card3Note) card3Note.textContent = Number.isFinite(netKrw) && netKrw !== 0 ? `IN-OUT · 내부 전송 참고용 · ≈ ${fmtKrw(netKrw)} KRW` : 'IN-OUT · 내부 전송 참고용';
      if (card4Note) card4Note.textContent = `표시 기준 ${rows.length}건`;
      return;
    }

    let deposit = 0;
    let withdraw = 0;
    let net = 0;
    let depositKrw = 0;
    let withdrawKrw = 0;
    let netKrw = 0;
    let nDeposit = 0;
    let nWithdraw = 0;
    let excludedMirror = 0;

    rows.forEach((r) => {
      if (r.type === 'DEPOSIT' && r.completed && r.excluded) excludedMirror += 1;
      if (!r.completed || r.excluded) return;
      if (r.type === 'DEPOSIT') {
        if (!Number.isFinite(r.amount)) return;
        deposit += r.amount;
        net += r.amount;
        nDeposit += 1;
        if (Number.isFinite(r.krw)) {
          depositKrw += Math.abs(r.krw);
          netKrw += Math.abs(r.krw);
        }
        return;
      }
      if (r.type === 'WITHDRAW') {
        if (!Number.isFinite(r.amount)) return;
        withdraw += r.amount;
        net -= r.amount;
        nWithdraw += 1;
        if (Number.isFinite(r.krw)) {
          withdrawKrw += Math.abs(r.krw);
          netKrw -= Math.abs(r.krw);
        }
      }
    });

    if (card1Label) card1Label.textContent = `입금 합계 (${labelCoin})`;
    if (card2Label) card2Label.textContent = `출금 합계 (${labelCoin})`;
    if (card3Label) card3Label.textContent = `순유입 (${labelCoin})`;
    if (card4Label) card4Label.textContent = '완료 건수';

    if (card1Value) card1Value.textContent = fmtNum(deposit, 4);
    if (card2Value) card2Value.textContent = fmtNum(withdraw, 4);
    if (card3Value) card3Value.textContent = fmtNum(net, 4);
    if (card4Value) card4Value.textContent = String(nDeposit + nWithdraw);

    const noteBase = excludedMirror > 0 ? `완료 기준 · 외부 입출금 집계 · 중복 제외 ${excludedMirror}건` : '완료 기준 · 외부 입출금 집계';
    if (card1Note) card1Note.textContent = Number.isFinite(depositKrw) && depositKrw > 0 ? `${noteBase} · ≈ ${fmtKrw(depositKrw)} KRW` : noteBase;
    if (card2Note) card2Note.textContent = Number.isFinite(withdrawKrw) && withdrawKrw > 0 ? `${noteBase} · ≈ ${fmtKrw(withdrawKrw)} KRW` : noteBase;
    if (card3Note) card3Note.textContent = Number.isFinite(netKrw) && netKrw !== 0 ? `입금-출금 · 외부 입출금 집계 · ≈ ${fmtKrw(netKrw)} KRW` : '입금-출금 · 외부 입출금 집계';
    if (card4Note) card4Note.textContent = `표시 기준 ${rows.length}건`;
  };

  const applyFilters = () => {
    const type = typeSel ? typeSel.value : 'all';
    const coin = coinSel ? coinSel.value : 'all';
    const rows = table.querySelectorAll('tbody tr[data-type]');
    rows.forEach((tr) => {
      const meta = rowMeta(tr);
      tr.style.display = matchRow(meta, type, coin) ? '' : 'none';
    });
    updateCards();
  };

  if (typeSel) typeSel.addEventListener('change', applyFilters);
  if (coinSel) coinSel.addEventListener('change', applyFilters);

  if (rangeSel) {
    rangeSel.addEventListener('change', () => {
      const params = new URLSearchParams(window.location.search);
      params.set('range', rangeSel.value || 'd30');
      params.delete('start');
      params.delete('end');
      window.location.search = params.toString();
    });
  }

  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      if (typeSel) typeSel.value = 'all';
      if (coinSel) coinSel.value = 'all';
      applyFilters();
    });
  }

  const openModal = () => {
    if (!modal) return;
    modal.classList.add('open');
    modal.setAttribute('aria-hidden', 'false');
    if (startInput && !startInput.value) {
      const now = new Date();
      const start = new Date(now.getTime() - (30 * 24 * 60 * 60 * 1000));
      startInput.value = start.toISOString().slice(0, 10);
    }
    if (endInput && !endInput.value) {
      endInput.value = new Date().toISOString().slice(0, 10);
    }
  };

  const closeModal = () => {
    if (!modal) return;
    modal.classList.remove('open');
    modal.setAttribute('aria-hidden', 'true');
  };

  if (rangeOpen) rangeOpen.addEventListener('click', openModal);
  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target && e.target.getAttribute('data-close')) closeModal();
    });
  }

  if (applyBtn) {
    applyBtn.addEventListener('click', () => {
      const startVal = startInput ? startInput.value : '';
      const endVal = endInput ? endInput.value : '';
      if (!startVal || !endVal) return;
      const params = new URLSearchParams(window.location.search);
      params.set('start', startVal);
      params.set('end', endVal);
      params.set('range', 'custom');
      window.location.search = params.toString();
    });
  }

  applyFilters();
})();
</script>

<%- include('partials/app_end') %>
