<%- include('partials/app_start_unified', { title: '리포트 · DONBEOLJA', pageTitle: '리포트', active: 'report' }) %>

<%
  const budgetUnit = String(
    (budget && budget.unit) ||
    (budget_perf && budget_perf.unit) ||
    (String(exchange || '').includes('BINANCE') ? 'USDT' : 'KRW')
  ).toUpperCase();
  const pillFor = (s) => {
    const x = String(s || '').toUpperCase();
    if (x === 'GREEN' || x === 'PASS') return 'ok';
    if (x === 'YELLOW' || x === 'WARN') return 'warn';
    if (x === 'RED' || x === 'FAIL') return 'bad';
    return 'dim';
  };
  const chipFor = (s) => {
    const x = String(s || '').toUpperCase();
    if (x === 'GREEN' || x === 'PASS') return 'chip success';
    if (x === 'YELLOW' || x === 'WARN') return 'chip warning';
    if (x === 'RED' || x === 'FAIL') return 'chip error';
    return 'chip';
  };
  const statusLabel = (s) => {
    const x = String(s || 'INCONCLUSIVE').toUpperCase();
    if (x === 'GREEN' || x === 'PASS') return '양호';
    if (x === 'YELLOW' || x === 'WARN') return '주의';
    if (x === 'RED' || x === 'FAIL') return '경고';
    if (x === 'INCONCLUSIVE' || x === 'NEED_DATA') return '보류';
    return s || '-';
  };
  const fmtNum = (x) => (x == null || x === '' || Number.isNaN(Number(x))) ? '-' : Number(x).toLocaleString();
  const fmtKrw = (x) => {
    const n = Number(x);
    if (!Number.isFinite(n)) return '-';
    if (budgetUnit === 'USDT') {
      return n.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
    const cut = Math.trunc(n / 10) * 10;
    return cut.toLocaleString();
  };
  const fmtPct = (x) => (x == null || x === '' || Number.isNaN(Number(x))) ? '-' : (Number(x).toFixed(2) + '%');
  const fmtPctRatio = (x) => {
    const n = Number(x);
    if (!Number.isFinite(n)) return '-';
    return (n * 100).toFixed(2) + '%';
  };
  const fmtKst = (v) => {
    if (!v) return '-';
    const raw = String(v);
    if (raw.includes('KST')) return raw;
    const ms = Date.parse(raw);
    if (!Number.isFinite(ms)) return raw;
    const k = new Date(ms + 9 * 60 * 60 * 1000);
    const pad = (n) => String(n).padStart(2, '0');
    return `${k.getUTCFullYear()}-${pad(k.getUTCMonth() + 1)}-${pad(k.getUTCDate())} ${pad(k.getUTCHours())}:${pad(k.getUTCMinutes())}:${pad(k.getUTCSeconds())} KST`;
  };
  const fmtPctSigned = (x) => {
    const n = Number(x);
    if (!Number.isFinite(n)) return '-';
    const sign = n > 0 ? '+' : n < 0 ? '' : '';
    return sign + (n * 100).toFixed(2) + '%';
  };
  const fmtNumSigned = (x) => {
    const n = Number(x);
    if (!Number.isFinite(n)) return '-';
    const sign = n > 0 ? '+' : n < 0 ? '' : '';
    return sign + n.toLocaleString();
  };
  const fmtKrwSigned = (x) => {
    const n = Number(x);
    if (!Number.isFinite(n)) return '-';
    const sign = n > 0 ? '+' : n < 0 ? '' : '';
    if (budgetUnit === 'USDT') {
      return sign + n.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
    const cut = Math.trunc(n / 10) * 10;
    return sign + cut.toLocaleString();
  };
  const pillForPnl = (x) => {
    const n = Number(x);
    if (!Number.isFinite(n)) return 'dim';
    if (n > 0) return 'ok';
    if (n < 0) return 'bad';
    return 'warn';
  };
  const chipForPnl = (x) => {
    const n = Number(x);
    if (!Number.isFinite(n)) return 'chip';
    if (n > 0) return 'chip success';
    if (n < 0) return 'chip error';
    return 'chip warning';
  };
  const fmtSide = (s) => {
    const x = String(s || '').toUpperCase();
    if (x === 'BUY') return '매수';
    if (x === 'SELL') return '매도';
    return x || '-';
  };
  const decisionLabel = (d) => {
    const x = String(d || '').toUpperCase();
    if (x === 'KEEP') return '유지';
    if (x === 'DROP') return '제거';
    if (x === 'NEED_DATA') return '보류';
    return '-';
  };
  const decisionPill = (d) => {
    const x = String(d || '').toUpperCase();
    if (x === 'KEEP') return 'ok';
    if (x === 'DROP') return 'bad';
    if (x === 'NEED_DATA') return 'warn';
    return 'dim';
  };
  const decisionChip = (d) => {
    const x = String(d || '').toUpperCase();
    if (x === 'KEEP') return 'chip success';
    if (x === 'DROP') return 'chip error';
    if (x === 'NEED_DATA') return 'chip warning';
    return 'chip';
  };
  const exchangeLabel = (ex) => {
    const v = String(ex || '').toUpperCase();
    if (v.includes('BINANCE')) return '바이낸스';
    return '바이낸스';
  };
  const leverageSummary = (typeof leverage_summary !== 'undefined' && leverage_summary) ? leverage_summary : (budget && budget.leverage_summary ? budget.leverage_summary : null);
  const fmtLeverage = (x) => {
    const n = Number(x);
    if (!Number.isFinite(n) || n <= 0) return '-';
    const rounded = Math.round(n * 10) / 10;
    return `${rounded}x`;
  };
  const leverageBadge = (tier) => {
    const t = String(tier || '').toLowerCase();
    if (t === '3x') return 'chip warning';
    if (t === '2x') return 'chip success';
    return 'chip';
  };
%>

