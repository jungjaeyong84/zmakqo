<script>
(function(){
  const card = document.getElementById("account-growth-card");
  if (!card) return;
  const savedExchange = (() => {
    try { return localStorage.getItem("db_exchange_mode"); } catch(_) { return null; }
  })();
  const exchange = (() => {
    const raw = String(card.dataset.exchange || savedExchange || "BINANCEFUT").toUpperCase();
    if (raw.includes("BINANCE")) return "BINANCEFUT";
    return "BINANCEFUT";
  })();
  const elTotal = document.getElementById("acc-total-krw");
  const elCash = document.getElementById("acc-cash-krw");
  const elUpdated = document.getElementById("acc-updated-at");
  const elDaily = document.getElementById("acc-daily-pct");
  const elWeekly = document.getElementById("acc-weekly-pct");
  const elMonthly = document.getElementById("acc-monthly-pct");
  const elNote = document.getElementById("acc-growth-note");

  const fmtMoney = (x, unit) => {
    const n = Number(x);
    if (!Number.isFinite(n)) return "-";
    if (String(unit).toUpperCase() === "USDT") {
      return n.toFixed(2);
    }
    const cut = Math.trunc(n / 10) * 10;
    return cut.toLocaleString();
  };
  const fmtPct = (x) => {
    const n = Number(x);
    if (!Number.isFinite(n)) return "-";
    const sign = n > 0 ? "+" : "";
    return sign + (n * 100).toFixed(2) + "%";
  };
  const fmtKst = (s) => {
    if (!s) return "-";
    const ms = Date.parse(String(s));
    if (!Number.isFinite(ms)) return String(s);
    const k = new Date(ms + 9 * 60 * 60 * 1000);
    const pad = (n) => String(n).padStart(2, "0");
    return `${k.getUTCFullYear()}-${pad(k.getUTCMonth() + 1)}-${pad(k.getUTCDate())} ${pad(k.getUTCHours())}:${pad(k.getUTCMinutes())} KST`;
  };
  const setBar = (role, pct) => {
    const el = card.querySelector(`.rpt-bar-fill[data-role="${role}"]`);
    if (!el) return;
    const v = Number(pct);
    if (!Number.isFinite(v)) {
      el.className = "rpt-bar-fill dim";
      el.style.height = "6%";
      return;
    }
    const cap = 0.2;
    const h = Math.min(Math.abs(v), cap) / cap * 100;
    el.style.height = Math.max(6, h) + "%";
    el.className = "rpt-bar-fill " + (v > 0 ? "ok" : v < 0 ? "bad" : "dim");
  };

  fetch("/api/account/summary?exchange=" + encodeURIComponent(exchange))
    .then((r) => r.json())
    .then((j) => {
      if (!j || !j.ok) {
        const msg = (j && (j.message || j.error)) ? String(j.message || j.error) : "불러오기 실패";
        if (elNote) elNote.textContent = `불러오기 실패: ${msg}`;
        return;
      }
      const unit = String(j.unit || (exchange.includes("BINANCE") ? "USDT" : "KRW")).toUpperCase();
      const totalVal = Number.isFinite(Number(j.total_value)) ? j.total_value : j.total_krw;
      const cashVal = Number.isFinite(Number(j.cash_value)) ? j.cash_value : j.cash_krw;
      if (elTotal) elTotal.textContent = fmtMoney(totalVal, unit) + " " + unit;
      if (elCash) elCash.textContent = fmtMoney(cashVal, unit) + " " + unit;
      if (elUpdated) elUpdated.textContent = fmtKst(j.updated_at);

      const daily = j.growth && j.growth.daily ? j.growth.daily.pct : null;
      const weekly = j.growth && j.growth.weekly ? j.growth.weekly.pct : null;
      const monthly = j.growth && j.growth.monthly ? j.growth.monthly.pct : null;

      if (elDaily) elDaily.textContent = fmtPct(daily);
      if (elWeekly) elWeekly.textContent = fmtPct(weekly);
      if (elMonthly) elMonthly.textContent = fmtPct(monthly);

      setBar("daily", daily);
      setBar("weekly", weekly);
      setBar("monthly", monthly);

      if (elNote) {
        const missing = Array.isArray(j.missing_markets) && j.missing_markets.length
          ? `가격 미확인: ${j.missing_markets.join(", ")}`
          : "정상";
        const basis = String(j.growth_basis || "");
        const basisText = basis === "TRADING_PNL_EX_CASHFLOW"
          ? "입출금 보정 적용"
          : "총자산 기준";
        elNote.textContent = `${missing} · ${basisText}`;
      }
    })
    .catch(() => {
      if (elNote) elNote.textContent = "불러오기 실패";
    });
})();
</script>

<%- include('partials/app_end_unified') %>
