<script>
(function () {
  const metaEl = document.getElementById("tier-health-meta");
  const refreshBtn = document.getElementById("tier-health-refresh");
  const exchange = <%- JSON.stringify(String(exchange || "BINANCEFUT")) %>;
  const tf = <%- JSON.stringify(String(signal_tf || exec_tf || "15m")) %>;

  function fmtNum(v) {
    const n = Number(v);
    return Number.isFinite(n) ? n.toLocaleString() : "-";
  }
  function fmtRate(v) {
    const n = Number(v);
    return Number.isFinite(n) ? (n * 100).toFixed(2) + "%" : "-";
  }
  function fmtPctRaw(v) {
    const n = Number(v);
    return Number.isFinite(n) ? n.toFixed(4) + "%" : "-";
  }
  function setText(id, value) {
    const el = document.getElementById(id);
    if (el) el.textContent = value;
  }
  function setWindow(prefix, payload) {
    if (!payload) {
      setText(prefix + "-signals-total", "-");
      setText(prefix + "-trades-total", "-");
      setText(prefix + "-win-rate", "-");
      setText(prefix + "-avg-pnl", "-");
      return;
    }
    const signals = payload.signals || {};
    const trades = payload.trades && payload.trades.total ? payload.trades.total : {};
    setText(prefix + "-signals-total", fmtNum(signals.total_entry_signals));
    setText(prefix + "-trades-total", fmtNum(trades.trades));
    setText(prefix + "-win-rate", fmtRate(trades.win_rate));
    setText(prefix + "-avg-pnl", fmtPctRaw(trades.avg_pnl_pct));
  }
  async function loadTierHealth(refresh) {
    try {
      if (metaEl) metaEl.textContent = "로딩 중...";
      const q = new URLSearchParams({
        exchange: exchange,
        tf: tf,
        refresh: refresh ? "1" : "0",
      });
      const res = await fetch("/api/report/tier-health?" + q.toString(), { credentials: "same-origin" });
      const j = await res.json();
      if (!res.ok || !j || j.ok !== true || !j.payload) throw new Error((j && j.message) || "tier health load failed");
      const report = j.payload.report || {};
      setWindow("th24", report["24h"] || null);
      setWindow("th72", report["72h"] || null);
      if (metaEl) {
        const gen = j.payload.generated_at ? String(j.payload.generated_at).replace("T", " ").replace("Z", " UTC") : "-";
        metaEl.textContent = `생성시각: ${gen} · 출처: ${j.source || "-"}`;
      }
    } catch (_err) {
      setWindow("th24", null);
      setWindow("th72", null);
      if (metaEl) metaEl.textContent = "로드 실패";
    }
  }

  if (refreshBtn) refreshBtn.addEventListener("click", () => loadTierHealth(true));
  loadTierHealth(false);
})();
</script>

