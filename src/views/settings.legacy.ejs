    </div>
    <div class="subtle" style="margin-top:6px; display:flex; gap:8px; flex-wrap:wrap;">
      <span class="pill dim">대상 <span class="mono" id="ai-provider-label">-</span></span>
      <span class="pill dim">통화 <span class="mono" id="ai-unit">KRW</span></span>
    </div>

    <div class="hr"></div>

    <div class="grid cols-2">
      <div>
        <label>언어</label>
        <select id="ai-lang">
          <option value="ko">한국어</option>
          <option value="en">영어</option>
        </select>
      </div>
