      if (!el) return;
      el.textContent = text;
      el.classList.remove("ok","warn","bad","dim");
      el.classList.add(level || "dim");
    }
    function normalizeProvider(v){
      const raw = String(v || "").trim().toUpperCase();
      if (raw.includes("BINANCE")) return "BINANCEFUT";
      return "BINANCEFUT";
    }
    function activeProvider(){
      try {
        const saved = localStorage.getItem("db_exchange_mode");
        if (saved) return normalizeProvider(saved);
      } catch(_) {}
      const nav = document.getElementById("ex-mode");
      if (nav && nav.value) return normalizeProvider(nav.value);
      return normalizeProvider($("ex-provider")?.value || "BINANCEFUT");
    }
    function parseList(raw){
      return String(raw || "")
        .split(/[\n,]/)
        .map((s)=>s.trim())
        .filter(Boolean);
    }
    function fmtKst(v){
      if (!v) return "-";
      const raw = String(v);
      if (raw.includes("KST")) return raw;
      const ms = Date.parse(raw);
      if (!Number.isFinite(ms)) return raw;
      const k = new Date(ms + 9 * 60 * 60 * 1000);
      const pad = (n) => String(n).padStart(2, "0");
      return `${k.getUTCFullYear()}-${pad(k.getUTCMonth() + 1)}-${pad(k.getUTCDate())} ${pad(k.getUTCHours())}:${pad(k.getUTCMinutes())}:${pad(k.getUTCSeconds())} KST`;
    }
    async function load(providerOverride){
      setStatus("불러오는 중…", "dim");
      const provider = String(providerOverride || activeProvider() || "BINANCEFUT").toUpperCase();
      const r = await fetch("/api/settings/exchanges?provider=" + encodeURIComponent(provider), { credentials: "include" });
      const t = await r.text();
      let j = null;
      try { j = JSON.parse(t); } catch(_) { j = null; }
      if (!r.ok || !j || !j.ok){
        setStatus("불러오기 실패 (" + r.status + ")", "bad");
        return;
      }
      const data = j.data || {};
      $("ex-enabled").value = String(!!data.enabled);
      const resolvedProvider = String(data.provider || provider || "BINANCEFUT").toUpperCase();
      $("ex-provider").value = resolvedProvider;
      const nav = document.getElementById("ex-mode");
      const fixedWrap = $("ex-provider-fixed");
      const selectWrap = $("ex-provider-wrap");
      if (nav && fixedWrap && selectWrap) {
        fixedWrap.style.display = "block";
        selectWrap.style.display = "none";
        const label = $("ex-provider-label");
        if (label) label.textContent = "바이낸스(선물)";
      }
      $("ex-markets").value = Array.isArray(data.markets) ? data.markets.join(", ") : "";
      $("ex-tf").value = Array.isArray(data.tf_allowlist) ? data.tf_allowlist.join(", ") : "";
      $("ex-exec-tf").value = data.exec_tf || "";
      $("ex-upd-at").textContent = fmtKst(data.updated_at || "-");
      $("ex-upd-by").textContent = data.updated_by || "-";
      const keyHint = data.api_key_hint ? "API 키: " + data.api_key_hint : "API 키: -";
      const secHint = data.api_secret_hint ? "API 시크릿: " + data.api_secret_hint : "API 시크릿: -";
      $("ex-key-status").textContent = keyHint + " / " + secHint;
      setStatus("불러옴", "ok");
    }
    function collect(){
      const provider = String($("ex-provider")?.value || activeProvider() || "BINANCEFUT").toUpperCase();
      const payload = {
        enabled: $("ex-enabled").value === "true",
        provider,
        markets: parseList($("ex-markets").value),
        tf_allowlist: parseList($("ex-tf").value),
        exec_tf: String($("ex-exec-tf").value || "").trim(),
        clear_keys: $("ex-clear-keys").checked,
      };
      const apiKey = $("ex-api-key").value.trim();
      const apiSecret = $("ex-api-secret").value.trim();
      if (apiKey) payload.api_key = apiKey;
      if (apiSecret) payload.api_secret = apiSecret;
      return payload;
    }
    async function save(){
      const btn = $("ex-save");
      btn.disabled = true;
      setStatus("저장 중…", "dim");
      let payload = null;
      try { payload = collect(); }
      catch(e){
        btn.disabled = false;
        setStatus("입력 오류: " + e.message, "bad");
        return;
      }
      try{
        const r = await fetch("/api/settings/exchanges", {
          method: "POST",
          headers: { "Content-Type":"application/json" },
          credentials: "include",
          body: JSON.stringify(payload),
        });
        const t = await r.text();
        let j = null;
        try { j = JSON.parse(t); } catch(_) { j = null; }
        if (!r.ok || !j || !j.ok){
          setStatus("저장 실패 (" + r.status + ")", "bad");
          btn.disabled = false;
          return;
        }
        setStatus("저장 완료 ✅", "ok");
        setTimeout(()=>{ btn.disabled = false; }, 1500);
        $("ex-api-key").value = "";
        $("ex-api-secret").value = "";
        $("ex-clear-keys").checked = false;
        await load();
      }catch(e){
        setStatus("저장 오류: " + e.message, "bad");
        btn.disabled = false;
      }
    }
    async function testConn(){
      const markets = parseList($("ex-markets").value);
      if (!markets.length){
        setStatus("테스트 실패: 마켓 없음", "bad");
        return;
      }
      setStatus("테스트 중…", "dim");
      $("ex-test-result").textContent = "";
      const provider = String($("ex-provider")?.value || "BINANCEFUT").toUpperCase();
      try{
        const url = "/api/settings/exchanges/test?provider=" + encodeURIComponent(provider) + "&markets=" + encodeURIComponent(markets.join(","));
        const r = await fetch(url, { credentials: "include" });
        const t = await r.text();
        let j = null;
        try { j = JSON.parse(t); } catch(_) { j = null; }
        if (!r.ok || !j || !j.ok){
          setStatus("테스트 실패 (" + r.status + ")", "bad");
          $("ex-test-result").textContent = (j && (j.error || j.message)) ? (j.error || j.message) : t.slice(0, 200);
          return;
        }
        setStatus("테스트 성공 ✅", "ok");
        $("ex-test-result").textContent = "지연 " + j.latency_ms + "ms · 마켓 " + j.count;
      }catch(e){
        setStatus("테스트 오류: " + e.message, "bad");
      }
    }

    $("ex-save").addEventListener("click", save);
    $("ex-test").addEventListener("click", testConn);
    $("ex-live-test").addEventListener("click", async () => {
      setStatus("실거래 키 점검 중…", "dim");
      $("ex-test-result").textContent = "";
      const provider = String($("ex-provider")?.value || activeProvider() || "BINANCEFUT").toUpperCase();
      try{
        const r = await fetch("/api/settings/exchanges/live-check?provider=" + encodeURIComponent(provider), { credentials: "include" });
        const t = await r.text();
        let j = null;
        try { j = JSON.parse(t); } catch(_) { j = null; }
        if (!r.ok || !j || !j.ok){
          setStatus("점검 실패 (" + r.status + ")", "bad");
          $("ex-test-result").textContent = (j && (j.error || j.message)) ? (j.error || j.message) : t.slice(0, 200);
          return;
        }
        setStatus("점검 성공 ✅", "ok");
        const msg = "자산 " + (j.asset_count || 0) + "개 확인 · canTrade=" + String(!!j.can_trade);
        $("ex-test-result").textContent = msg;
      }catch(e){
        setStatus("점검 오류: " + e.message, "bad");
      }
    });
    const navSel = document.getElementById("ex-mode");
    if (navSel) {
      navSel.addEventListener("change", async () => {
        await load(activeProvider());
      });
    } else {
      $("ex-provider").addEventListener("change", async () => {
        const provider = String($("ex-provider").value || "BINANCEFUT").toUpperCase();
        const cur = $("ex-markets").value.trim();
        const isKrw = cur.includes("KRW-");
        const isUsdt = cur.toUpperCase().includes("USDT");
        const isKrx = cur.toUpperCase().includes("KRX:");
        if (
          !cur
          || (provider === "BINANCEFUT" && (isKrw || isKrx))
        ) {
          $("ex-markets").value = "BTCUSDT, ETHUSDT, BNBUSDT, XRPUSDT, SOLUSDT, DOGEUSDT, AXSUSDT";
        }
        await load(provider);
      });
    }
    load(activeProvider());
  })();
  </script>

<% } else { %>

  <style>
    .rb-toast{ position:fixed; right:18px; bottom:18px; background:#111; color:#fff; padding:10px 12px; border-radius:12px; font-size:12px; border:1px solid rgba(0,0,0,0.15); box-shadow:0 10px 30px rgba(0,0,0,0.15); opacity:1; transition:opacity 0.2s ease; z-index:9999; }
