<%
  var __tab = (typeof tab !== 'undefined' && tab) ? String(tab) : 'risk';
  var markets = (typeof markets_expected !== 'undefined' && Array.isArray(markets_expected)) ? markets_expected : [];
  var __activeNav = 'settings';
  var __tabMetaMap = {
    risk: {
      title: '리스크 설정',
      desc: '주문 한도, 진입 강도, 기대값, 대기 타이밍을 조정합니다.',
      badge: '거래 위험',
      eyebrow: '자금 보호',
    },
    system: {
      title: '시스템 설정',
      desc: '실행 모드, 스케줄러, 체결 프로파일, 실거래 가드를 관리합니다.',
      badge: '운영 런타임',
      eyebrow: '운영 기본',
    },
    ai: {
      title: '리포트 설정',
      desc: 'AI 리포트와 자금 배분 자동화에 쓰는 모델과 기준을 관리합니다.',
      badge: '리포트 자동화',
      eyebrow: '리포트 자동화',
    },
    exchanges: {
      title: '거래소 설정',
      desc: '거래소 연결, 실행 단위, 거래 대상 마켓을 관리합니다.',
      badge: '거래 연결',
      eyebrow: '거래 연결',
    },
  };
  var __tabMeta = __tabMetaMap[__tab] || __tabMetaMap.risk;
%>

<%- include('partials/app_start_unified', { title: '설정 · DONBEOLJA', pageTitle: '설정', active: __activeNav }) %>

<style>
  .settings-mini-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  @media (max-width: 1180px) {
    .settings-mini-grid { grid-template-columns: 1fr; }
  }
</style>

<div class="grid cols-2" style="grid-template-columns: minmax(0, 1.4fr) minmax(280px, 0.8fr);">
  <div class="card">
    <div class="card-body">
      <div class="body-sm text-primary" style="font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;"><%= __tabMeta.eyebrow %></div>
      <div style="font-size: 22px; font-weight: 800; letter-spacing: -0.04em; margin-top: 6px;"><%= __tabMeta.title %></div>
      <div class="text-muted body-sm" style="margin-top: 6px; line-height: 1.55;"><%= __tabMeta.desc %></div>
      <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px;">
        <span class="chip primary filled"><%= __tabMeta.badge %></span>
        <span class="chip">저장은 수동 버튼으로만 적용</span>
        <span class="chip">일부 항목은 재시작 필요</span>
      </div>
    </div>
  </div>
  <div class="card">
    <div class="card-body">
      <div class="grid cols-2">
        <div class="mini-card">
          <div class="metric-card-label">저장 원칙</div>
          <div class="body-sm" style="margin-top: 6px;">중복 저장을 막기 위해 항상 명시적 버튼 클릭으로만 적용합니다.</div>
        </div>
        <div class="mini-card">
          <div class="metric-card-label">주의 항목</div>
          <div class="body-sm" style="margin-top: 6px;">리스크와 실거래 설정은 주문 강도와 실제 실행에 직접 영향을 줍니다.</div>
        </div>
        <div class="mini-card">
          <div class="metric-card-label">검증 방식</div>
          <div class="body-sm" style="margin-top: 6px;">설정 변경 후에는 거래기록과 전략상태에서 실제 반영 여부를 확인해야 합니다.</div>
        </div>
        <div class="mini-card">
          <div class="metric-card-label">범위</div>
          <div class="body-sm" style="margin-top: 6px;">현재 화면은 바이낸스 선물 운영 기준으로 정리되어 있습니다.</div>
        </div>
      </div>
    </div>
  </div>
</div>

<%
  var execMode = (typeof system_settings !== 'undefined' && system_settings) ? (system_settings.execution_mode || 'PAPER') : 'PAPER';
  var marketCount = markets.length;
  var budgetMax = (typeof budget_summary !== 'undefined' && budget_summary && budget_summary.total_max_krw != null) ? budget_summary.total_max_krw : null;
%>
<div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center;padding:12px 16px;border:1px solid var(--md-outline-variant);border-radius:var(--md-shape-md);background:var(--md-surface-container-low)">
  <span class="chip sm <%= execMode === 'LIVE' ? 'success' : 'primary' %>"><%= execMode === 'LIVE' ? '실거래 운영 중' : '모의거래 모드' %></span>
  <span class="chip sm filled">활성 마켓 <%= marketCount %>개</span>
  <% if (budgetMax != null) { %><span class="chip sm filled">예산 <%= Number(budgetMax).toLocaleString(undefined, {maximumFractionDigits:0}) %> USDT</span><% } %>
</div>

<nav class="tabs">
  <a href="/dashboard/settings?tab=risk" <%= __tab === 'risk' ? 'class="active"' : '' %>>리스크</a>
  <a href="/dashboard/settings?tab=system" <%= __tab === 'system' ? 'class="active"' : '' %>>시스템</a>
  <a href="/dashboard/settings?tab=ai" <%= __tab === 'ai' ? 'class="active"' : '' %>>리포트</a>
  <a href="/dashboard/settings?tab=exchanges" <%= __tab === 'exchanges' ? 'class="active"' : '' %>>거래소</a>
</nav>

<% if (__tab === 'system') { %>
  <%- include('settings/system', { markets: markets }) %>
<% } else if (__tab === 'ai') { %>
  <%- include('settings/ai', { markets: markets }) %>
<% } else if (__tab === 'exchanges') { %>
  <%- include('settings/exchanges', { markets: markets }) %>
<% } else { %>
  <%- include('settings/risk', { markets: markets }) %>
<% } %>

<%- include('partials/app_end_unified') %>
