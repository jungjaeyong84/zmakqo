          </div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-body" style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
        <button class="btn btn-filled" type="button" id="sys-save">저장</button>
        <a class="btn btn-outlined sm" href="/scheduler/status" target="_blank" rel="noopener">스케줄러 상태 보기</a>
        <span class="chip" id="sys-status">상태 대기</span>
      </div>
