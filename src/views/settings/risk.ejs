  <script>
  (function(){
    function $(id){ return document.getElementById(id); }
    function normalizeProvider(v){
      const raw = String(v || "").trim().toUpperCase();
      if (raw.includes("BINANCE")) return "BINANCEFUT";
      return "BINANCEFUT";
    }
    function activeProvider(){
      try {
        const saved = localStorage.getItem("db_exchange_mode");
        if (saved) return normalizeProvider(saved);
      } catch(_) {}
      const nav = document.getElementById("ex-mode");
      if (nav && nav.value) return normalizeProvider(nav.value);
      return "BINANCEFUT";
    }
    function aiAllocUnit(provider){
      return { unit: "USDT", step: 1, minPh: "예: 50", maxPh: "예: 500" };
    }
    function applyAiAllocUnit(provider){
      const u = aiAllocUnit(provider);
      const unit = u.unit;
      const step = u.step;
      const minEl = $("ai-alloc-min");
      const maxEl = $("ai-alloc-max");
      if ($("ai-alloc-unit")) $("ai-alloc-unit").textContent = unit;
      if ($("ai-alloc-unit-min")) $("ai-alloc-unit-min").textContent = unit;
      if ($("ai-alloc-unit-max")) $("ai-alloc-unit-max").textContent = unit;
      if (minEl) {
        minEl.step = String(step);
        minEl.placeholder = u.minPh;
      }
      if (maxEl) {
        maxEl.step = String(step);
        maxEl.placeholder = u.maxPh;
      }
    }
    function fmtPct(v){
      const n = Number(v);
      if (!Number.isFinite(n)) return "-";
      return (Math.round(n * 1000) / 10).toFixed(1) + "%";
    }
    function fmtRatio(v){
      const n = Number(v);
      if (!Number.isFinite(n)) return "-";
      return (Math.round(n * 100) / 100).toFixed(2);
    }
    function fmtRegime(v){
      const raw = String(v || "").toUpperCase();
      if (!raw) return "-";
      if (raw.includes("AGG") || raw === "AGGRESSIVE") return "상향";
      if (raw.includes("NEU") || raw === "NEUTRAL") return "중립";
      if (raw.includes("CON") || raw === "CONSERVATIVE") return "하향";
      return raw;
    }
    function normalizeBiasTag(v){
      const raw = String(v || "").toUpperCase();
      if (raw.includes("LONG") || raw.includes("BULL") || raw === "UP") return "LONG";
      if (raw.includes("SHORT") || raw.includes("BEAR") || raw === "DOWN") return "SHORT";
      return "NEUTRAL";
    }
    function biasTagFromLast(last){
      if (!last || typeof last !== "object") return "NEUTRAL";
      const side = (last.side_allocation && typeof last.side_allocation === "object") ? last.side_allocation : null;
      const tag = normalizeBiasTag((side && side.bias_direction) || last.direction || "");
      if (tag !== "NEUTRAL") return tag;
      const modeTag = String(last.mode || "").toUpperCase();
      if (modeTag.includes("AGG")) return "LONG";
      if (modeTag.includes("CON")) return "SHORT";
      return "NEUTRAL";
    }
    function fmtBias(v){
      const tag = normalizeBiasTag(v);
      if (tag === "LONG") return "매수 우위";
      if (tag === "SHORT") return "매도 우위";
      return "중립";
    }
    function setStatus(text, level){
      const el = $("ai-alloc-status");
      if (!el) return;
      el.textContent = text;
      el.classList.remove("ok","warn","bad","dim");
      el.classList.add(level || "dim");
    }
    function numOrZero(v){
      const n = Number(v);
      return Number.isFinite(n) ? n : 0;
    }
    function numOrNull(v){
      const n = Number(v);
      return Number.isFinite(n) ? n : null;
    }
    function fmtKst(v){
      if (!v) return "-";
      const raw = String(v);
      if (raw.includes("KST")) return raw;
      const ms = Date.parse(raw);
      if (!Number.isFinite(ms)) return raw;
      const k = new Date(ms + 9 * 60 * 60 * 1000);
      const pad = (n) => String(n).padStart(2, "0");
      return `${k.getUTCFullYear()}-${pad(k.getUTCMonth() + 1)}-${pad(k.getUTCDate())} ${pad(k.getUTCHours())}:${pad(k.getUTCMinutes())}:${pad(k.getUTCSeconds())} KST`;
    }
    function toggleModelInput(){
      const val = $("ai-alloc-model").value;
      $("ai-alloc-model-custom").style.display = (val === "custom") ? "block" : "none";
    }
    function toggleClaudeAllocModelInput(){
      const sel = $("ai-alloc-claude-model");
      const custom = $("ai-alloc-claude-model-custom");
      if (!sel || !custom) return;
      custom.style.display = (sel.value === "custom") ? "block" : "none";
    }
    function normalizeRunHours(values){
      const out = [];
      const seen = new Set();
      for (const v of (values || [])) {
        const n = Number(v);
        if (!Number.isFinite(n)) continue;
        const h = Math.trunc(n);
        if (h < 0 || h > 23) continue;
        if (seen.has(h)) continue;
        seen.add(h);
        out.push(h);
      }
      return out;
    }
    function normalizeRunMinute(value, fallback = 30){
      const n = Number(value);
      if (!Number.isFinite(n)) {
        const f = Number(fallback);
        if (!Number.isFinite(f)) return 0;
        return Math.max(0, Math.min(59, Math.trunc(f)));
      }
      const m = Math.trunc(n);
      if (m < 0) return 0;
      if (m > 59) return 59;
      return m;
    }
    function parseRunHoursInput(raw){
      const src = String(raw || "").trim();
      if (!src) return [];
      const parts = src
        .split(/[\s,]+/)
        .map((x) => x.trim())
        .filter(Boolean);
      return normalizeRunHours(parts);
    }
    function fmtRunHours(hours, minute){
      const h = normalizeRunHours(hours);
      if (!h.length) return "-";
      const mm = String(normalizeRunMinute(minute, 30)).padStart(2, "0");
      return "매일 " + h.map((x) => `${String(x).padStart(2, "0")}:${mm}`).join(", ");
    }
    async function load(){
      setStatus("불러오는 중…", "dim");
      const provider = activeProvider();
      applyAiAllocUnit(provider);
      const label = $("ai-alloc-provider-label");
      if (label) label.textContent = "BINANCEFUT";
      const r = await fetch("/api/settings/ai-allocation?provider=" + encodeURIComponent(provider), { credentials: "include" });
      const t = await r.text();
      let j = null;
      try { j = JSON.parse(t); } catch(_) { j = null; }
      if (!r.ok || !j || !j.ok){
        setStatus("불러오기 실패 (" + r.status + ")", "bad");
        return;
      }
      const d = j.data || {};
      $("ai-alloc-enabled").value = String(!!d.enabled);
      $("ai-alloc-apply").value = String(!!d.apply_live);
      $("ai-alloc-cadence").value = String(d.cadence_days ?? 7);
      $("ai-alloc-dow").value = String(d.run_dow ?? 1);
      $("ai-alloc-hour").value = String(d.run_hour_kst ?? 9);
      const runMinute = normalizeRunMinute(d.run_minute_kst ?? 30, 30);
      $("ai-alloc-minute").value = String(runMinute);
      const runHours = normalizeRunHours(Array.isArray(d.run_hours_kst) ? d.run_hours_kst : []);
      $("ai-alloc-hours").value = runHours.join(",");
      $("ai-alloc-max-change").value = String(d.max_change_pct ?? 0.05);
      $("ai-alloc-min").value = String(d.min_per_market_krw ?? 100000);
      $("ai-alloc-max").value = String(d.max_per_market_krw ?? 3000000);
      $("ai-alloc-total-cap").value = String(d.total_cap_pct_max ?? 0.8);
      $("ai-alloc-reinvest").value = String(d.reinvest_rate ?? 0.6);
      $("ai-alloc-reinvest-loss").value = String(d.reinvest_loss_rate ?? 1.0);
      $("ai-alloc-eq-min").value = String(d.equity_mult_min ?? 0.6);
      $("ai-alloc-eq-max").value = String(d.equity_mult_max ?? 1.4);
      const capNow = $("ai-alloc-cap-now");
      const eqNow = $("ai-alloc-eq-now");
      const reinvestNow = $("ai-alloc-reinvest-now");
      const sideNow = $("ai-alloc-side-now");
      const ensembleNow = $("ai-alloc-ensemble-now");
      const slotsNow = $("ai-alloc-slots-now");
      const lastAt = $("ai-alloc-last-at");
      const lastBias = $("ai-alloc-last-bias-pill");
      const lastRegime = $("ai-alloc-last-regime-pill");
      if (capNow) capNow.textContent = fmtPct(d.total_cap_pct_max ?? 0.8);
      if (eqNow) eqNow.textContent = `${fmtRatio(d.equity_mult_min ?? 0.6)} ~ ${fmtRatio(d.equity_mult_max ?? 1.4)}`;
      if (reinvestNow) reinvestNow.textContent = `${fmtPct(d.reinvest_rate ?? 0.6)} / 손실 ${fmtRatio(d.reinvest_loss_rate ?? 1.0)}x`;
      const last = d.last_run || {};
      if (sideNow) {
        const sa = (last.side_allocation && typeof last.side_allocation === "object") ? last.side_allocation : null;
        if (sa) {
          sideNow.textContent = `매수 ${(fmtPct(sa.long_pct || 0)).replace('.0%', '%')} / 매도 ${(fmtPct(sa.short_pct || 0)).replace('.0%', '%')}`;
        } else {
          sideNow.textContent = `매수 x${fmtRatio(d.side_scale_max ?? 1.35)} / 매도 x${fmtRatio(d.side_scale_min ?? 0.65)}`;
        }
      }
      if (ensembleNow) {
        const ensOn = d.ensemble_enabled !== false;
        const wg = Number.isFinite(Number(d.ensemble_w_gpt)) ? Number(d.ensemble_w_gpt) : 0.6;
        const wc = Number.isFinite(Number(d.ensemble_w_claude)) ? Number(d.ensemble_w_claude) : 0.4;
        ensembleNow.textContent = `${ensOn ? "켜짐" : "꺼짐"} · GPT ${fmtRatio(wg)} / Claude ${fmtRatio(wc)}`;
      }
      if (slotsNow) {
        if (runHours.length) slotsNow.textContent = fmtRunHours(runHours, runMinute);
        else slotsNow.textContent = `기본 ${String(Number(d.run_hour_kst ?? 9)).padStart(2, "0")}:${String(runMinute).padStart(2, "0")}`;
      }
      if (lastAt) lastAt.textContent = fmtKst(last.created_at || "-");
      if (lastBias) {
        const biasTag = biasTagFromLast(last);
        lastBias.textContent = fmtBias(biasTag);
        lastBias.classList.remove("ok","warn","bad","dim");
        const cls = biasTag === "LONG"
          ? "ok"
          : (biasTag === "SHORT" ? "warn" : "dim");
        lastBias.classList.add(cls);
      }
      if (lastRegime) {
        const modeTag = String(last.mode || "").toUpperCase();
        lastRegime.textContent = fmtRegime(last.mode);
        lastRegime.classList.remove("ok","warn","bad","dim");
        const cls = modeTag.includes("AGG")
          ? "ok"
          : (modeTag.includes("CON") ? "warn" : "dim");
        lastRegime.classList.add(cls);
      }
      $("ai-alloc-news").value = String(d.news_window_days ?? 7);
      $("ai-alloc-min-bars").value = String(d.min_bars ?? 30);
      $("ai-alloc-bars-limit").value = String(d.bars_limit ?? 1200);
      $("ai-alloc-directional-enabled").value = String(d.directional_enabled !== false);
      $("ai-alloc-side-tilt").value = String(d.side_bias_max_tilt ?? 0.35);
      $("ai-alloc-side-neutral").value = String(d.side_bias_neutral_threshold ?? 0.05);
      $("ai-alloc-side-min-conf").value = String(d.side_bias_min_confidence ?? 0.3);
      $("ai-alloc-side-min").value = String(d.side_scale_min ?? 0.65);
      $("ai-alloc-side-max").value = String(d.side_scale_max ?? 1.35);
      $("ai-alloc-gpt").value = String(d.gpt_enabled !== false);
      const model = String(d.gpt_model || "gpt-4o");
      const modelPreset = (model === "gpt-4o" || model === "gpt-4o-mini") ? model : "custom";
      $("ai-alloc-model").value = modelPreset;
      $("ai-alloc-model-custom").value = (modelPreset === "custom") ? model : "";
      $("ai-alloc-claude").value = String(d.claude_enabled !== false);
      const claudeModel = String(d.claude_model || "claude-opus-4-5-20251101");
      const claudeModelSel = $("ai-alloc-claude-model");
      const claudeModelCustom = $("ai-alloc-claude-model-custom");
      if (claudeModelSel) {
        const known = [
          "claude-3-5-sonnet-20241022",
          "claude-opus-4-5-20251101",
          "claude-opus-4-1",
          "claude-3-haiku-20240307",
        ];
        if (known.includes(claudeModel)) {
          claudeModelSel.value = claudeModel;
          if (claudeModelCustom) claudeModelCustom.value = "";
        } else {
          claudeModelSel.value = "custom";
          if (claudeModelCustom) claudeModelCustom.value = claudeModel;
        }
      }
      $("ai-alloc-ensemble").value = String(d.ensemble_enabled !== false);
      $("ai-alloc-w-gpt").value = String(d.ensemble_w_gpt ?? 0.6);
      $("ai-alloc-w-claude").value = String(d.ensemble_w_claude ?? 0.4);
      $("ai-alloc-temp").value = String(d.gpt_temperature ?? 0.2);
      $("ai-alloc-key").value = "";
      $("ai-alloc-key-hint").textContent = d.api_key_hint ? `키 상태: ${d.api_key_hint}` : "키 상태: 없음";
      $("ai-alloc-upd-at").textContent = fmtKst(d.updated_at || "-");
      $("ai-alloc-upd-by").textContent = d.updated_by || "-";
      toggleModelInput();
      toggleClaudeAllocModelInput();
      setStatus("불러옴", "ok");
    }
    function collect(){
      const modelSel = $("ai-alloc-model").value;
      const model = (modelSel === "custom")
        ? ($("ai-alloc-model-custom").value.trim() || "gpt-4o")
        : modelSel;
      const claudeModelSel = $("ai-alloc-claude-model").value;
      const claudeModel = (claudeModelSel === "custom")
        ? ($("ai-alloc-claude-model-custom").value.trim() || "claude-opus-4-5-20251101")
        : claudeModelSel;
      const runHours = parseRunHoursInput($("ai-alloc-hours").value);
      const runHour = numOrZero($("ai-alloc-hour").value);
      const runMinute = normalizeRunMinute($("ai-alloc-minute").value, 30);
      return {
        enabled: $("ai-alloc-enabled").value === "true",
        apply_live: $("ai-alloc-apply").value === "true",
        cadence_days: numOrZero($("ai-alloc-cadence").value),
        run_dow: numOrZero($("ai-alloc-dow").value),
        run_hour_kst: runHours.length ? runHours[0] : runHour,
        run_hours_kst: runHours,
        run_minute_kst: runMinute,
        news_window_days: numOrZero($("ai-alloc-news").value),
        max_change_pct: numOrNull($("ai-alloc-max-change").value),
        min_per_market_krw: numOrZero($("ai-alloc-min").value),
        max_per_market_krw: numOrZero($("ai-alloc-max").value),
        total_cap_pct_max: numOrNull($("ai-alloc-total-cap").value),
        reinvest_rate: numOrNull($("ai-alloc-reinvest").value),
        reinvest_loss_rate: numOrNull($("ai-alloc-reinvest-loss").value),
        equity_mult_min: numOrNull($("ai-alloc-eq-min").value),
        equity_mult_max: numOrNull($("ai-alloc-eq-max").value),
        directional_enabled: $("ai-alloc-directional-enabled").value === "true",
        side_bias_max_tilt: numOrNull($("ai-alloc-side-tilt").value),
        side_bias_neutral_threshold: numOrNull($("ai-alloc-side-neutral").value),
        side_bias_min_confidence: numOrNull($("ai-alloc-side-min-conf").value),
        side_scale_min: numOrNull($("ai-alloc-side-min").value),
        side_scale_max: numOrNull($("ai-alloc-side-max").value),
        min_bars: numOrZero($("ai-alloc-min-bars").value),
        bars_limit: numOrZero($("ai-alloc-bars-limit").value),
        mode_scale: {
          aggressive: 1,
          neutral: 1,
          conservative: 1,
        },
        gpt_enabled: $("ai-alloc-gpt").value === "true",
        gpt_model: model,
        claude_enabled: $("ai-alloc-claude").value === "true",
        claude_model: claudeModel,
        ensemble_enabled: $("ai-alloc-ensemble").value === "true",
        ensemble_w_gpt: numOrNull($("ai-alloc-w-gpt").value),
        ensemble_w_claude: numOrNull($("ai-alloc-w-claude").value),
        gpt_temperature: numOrNull($("ai-alloc-temp").value),
        api_key: $("ai-alloc-key").value.trim(),
      };
    }
    async function save(){
      const btn = $("ai-alloc-save");
      btn.disabled = true;
      setStatus("저장 중…", "dim");
      let payload = null;
      try { payload = collect(); }
      catch(e){
        btn.disabled = false;
        setStatus("입력 오류: " + e.message, "bad");
        return;
      }
      try{
        const provider = activeProvider();
        const r = await fetch("/api/settings/ai-allocation?provider=" + encodeURIComponent(provider), {
          method: "POST",
          headers: { "Content-Type":"application/json" },
          credentials: "include",
          body: JSON.stringify(payload),
        });
        const t = await r.text();
        let j = null;
        try { j = JSON.parse(t); } catch(_) { j = null; }
        if (!r.ok || !j || !j.ok){
          setStatus("저장 실패 (" + r.status + ")", "bad");
          btn.disabled = false;
          return;
        }
        setStatus("저장 완료 ✅", "ok");
        setTimeout(()=>{ btn.disabled = false; }, 1500);
        await load();
      }catch(e){
        setStatus("저장 오류: " + e.message, "bad");
        btn.disabled = false;
      }
    }
    $("ai-alloc-save").addEventListener("click", save);
    $("ai-alloc-model").addEventListener("change", toggleModelInput);
    $("ai-alloc-claude-model").addEventListener("change", toggleClaudeAllocModelInput);
    const navSel = document.getElementById("ex-mode");
    if (navSel) navSel.addEventListener("change", load);
    load();
  })();
  </script>

