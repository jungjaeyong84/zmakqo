      </div>
    </div>
    <div class="card-body">
      <div class="grid cols-3">
        <div>
          <label>Claude API 키</label>
          <input id="rb-claude-key" type="password" placeholder="입력 시 저장됩니다" />
          <div class="body-sm text-muted" id="rb-claude-key-hint">키 상태: -</div>
        </div>
        <div>
          <label>Claude 모델</label>
          <select id="rb-claude-model">
            <option value="claude-opus-4-5-20251101">claude-opus-4-5-20251101</option>
            <option value="claude-3-5-sonnet-20241022">claude-3-5-sonnet-20241022</option>
            <option value="claude-3-opus-20240229">claude-3-opus-20240229</option>
            <option value="claude-3-haiku-20240307">claude-3-haiku-20240307</option>
            <option value="opus-4">opus-4</option>
            <option value="claude-opus-4-1">claude-opus-4-1</option>
            <option value="claude-opus-4-5">claude-opus-4-5</option>
            <option value="claude-opus-4-6">claude-opus-4-6</option>
            <option value="custom">직접 입력</option>
          </select>
          <input id="rb-claude-model-custom" type="text" placeholder="예: claude-opus-4-5-20251101" style="margin-top: 6px; display: none;" />
        </div>
        <div>
          <label>앙상블 허용 임계값(0~1)</label>
          <input id="rb-ensemble-allow" type="number" min="0" max="1" step="0.01" placeholder="예: 0.6" />
        </div>
        <div>
          <label>앙상블 축소 임계값(0~1)</label>
          <input id="rb-ensemble-reduce" type="number" min="0" max="1" step="0.01" placeholder="예: 0.45" />
        </div>
        <div style="display: flex; align-items: flex-end; gap: 8px;">
          <button class="btn btn-outlined sm" type="button" id="rb-claude-save">저장</button>
        </div>
      </div>
    </div>
  </div>
