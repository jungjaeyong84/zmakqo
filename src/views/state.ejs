<%- include('partials/app_start', { title: '거래 · DONBEOLJA Ω', pageTitle: '거래', active: 'trading' }) %>

<%
  const budgetUnit = String(String(exchange || "").includes("BINANCE") ? "USDT" : "KRW").toUpperCase();
  const fmtNum = (x) => (x == null || x === '' || Number.isNaN(Number(x))) ? '-' : Number(x).toLocaleString();
  const fmtKrw = (x) => {
    const n = Number(x);
    if (!Number.isFinite(n)) return '-';
    if (budgetUnit === "USDT") {
      return n.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
    const cut = Math.trunc(n / 10) * 10;
    return cut.toLocaleString();
  };
  const fmtPct = (x) => (x == null || x === '' || Number.isNaN(Number(x))) ? '-' : (Number(x).toFixed(2) + '%');
  const fmtPctRatio = (x) => {
    const n = Number(x);
    if (!Number.isFinite(n)) return '-';
    return (n * 100).toFixed(2) + '%';
  };
  const fmtMin = (ms) => {
    const n = Number(ms);
    if (!Number.isFinite(n)) return '-';
    return Math.round(n / 60000).toLocaleString();
  };
  const fmtRemain = (ms) => {
    const n = Number(ms);
    if (!Number.isFinite(n) || n <= 0) return '-';
    const totalSec = Math.max(0, Math.round(n / 1000));
    const h = Math.floor(totalSec / 3600);
    const m = Math.floor((totalSec % 3600) / 60);
    if (h > 0) return `${h}h ${m}m`;
    return `${m}m`;
  };
  const fmtKst = (v) => {
    if (!v) return '-';
    const raw = String(v);
    if (raw.includes('KST')) return raw;
    const ms = Date.parse(raw);
    if (!Number.isFinite(ms)) return raw;
    const k = new Date(ms + 9 * 60 * 60 * 1000);
    const pad = (n) => String(n).padStart(2, '0');
    return `${k.getUTCFullYear()}-${pad(k.getUTCMonth() + 1)}-${pad(k.getUTCDate())} ${pad(k.getUTCHours())}:${pad(k.getUTCMinutes())}:${pad(k.getUTCSeconds())} KST`;
  };
  const exchangeLabel = (typeof exchange !== 'undefined' && exchange) ? exchange : '-';
  const tfLabel = (typeof tf_default !== 'undefined' && tf_default) ? tf_default : '-';
  const positionLabel = (st) => {
    const s = String(st || 'FLAT').toUpperCase();
    if (s === 'FLAT') return '대기';
    if (s === 'ACTIVE') return '보유';
    if (s === 'EXIT_ONLY') return '청산만';
    return st || '-';
  };
  const positionSideLabel = (side) => {
    const s = String(side || '').toUpperCase();
    if (s === 'LONG') return '롱';
    if (s === 'SHORT') return '숏';
    return null;
  };
  const sideLabel = (side) => {
    const s = String(side || '').toUpperCase();
    if (s === 'BUY') return '매수';
    if (s === 'SELL') return '매도';
    if (s === 'HOLD') return '대기';
    return side || '-';
  };
  const guardrailLabel = (s) => {
    const x = String(s || '').toUpperCase();
    if (x === 'ALERT') return '경고';
    if (x === 'OK') return '정상';
    if (x === 'ERROR') return '오류';
    if (x === 'NO_TRADES') return '체결 없음';
    return '비활성';
  };
  const guardrailPill = (s) => {
    const x = String(s || '').toUpperCase();
    if (x === 'ALERT') return 'bad';
    if (x === 'OK') return 'ok';
    if (x === 'ERROR') return 'warn';
    if (x === 'NO_TRADES') return 'warn';
    return 'dim';
  };
  const fmtUnit = (x) => {
    if (x == null || x === '' || Number.isNaN(Number(x))) return '-';
    return budgetUnit === "USDT"
      ? Number(x).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })
      : (Math.trunc(Number(x) / 10) * 10).toLocaleString();
  };
  const leverageSummary = (typeof leverage_summary !== 'undefined' && leverage_summary) ? leverage_summary : null;
  const rollbackSummary = (typeof rollback_summary !== 'undefined' && rollback_summary) ? rollback_summary : null;
  const fmtLeverage = (x) => {
    const n = Number(x);
    if (!Number.isFinite(n) || n <= 0) return '-';
    const rounded = Math.round(n * 10) / 10;
    return `${rounded}x`;
  };
  const leverageBadge = (tier) => {
    const t = String(tier || '').toLowerCase();
    if (t === '3x') return 'warn';
    if (t === '2x') return 'ok';
    if (t.endsWith('x')) return 'dim';
    return 'dim';
  };
  const exitEventTag = (event) => {
    const ev = String(event || '').toUpperCase();
    let m = ev.match(/^EXIT_TP_P1_([0-9]+(?:\.[0-9]+)?)P$/);
    if (m) return `TP1_${m[1]}`;
    m = ev.match(/^EXIT_TP_C_([0-9]+(?:\.[0-9]+)?)P$/);
    if (m) return `TP1_${m[1]}`;
    m = ev.match(/^EXIT_TRAIL_([0-9]+(?:\.[0-9]+)?)P$/);
    if (m) return `TRAIL_${m[1]}`;
    m = ev.match(/^EXIT_SL_([0-9]+(?:\.[0-9]+)?)P$/);
    if (m) return `SL_${m[1]}`;
    m = ev.match(/^EXIT_BE_([0-9]+(?:\.[0-9]+)?)P$/);
    if (m) return `BE_${m[1]}`;
    if (ev.startsWith('EXIT_TP_P1')) return 'TP1';
    if (ev.startsWith('EXIT_TP_C')) return 'TP1';
    if (ev.startsWith('EXIT_TRAIL')) return 'TRAIL';
    if (ev.startsWith('EXIT_SL')) return 'SL';
    if (ev.startsWith('EXIT_BE')) return 'BE';
    return null;
  };
  const eventDisplay = (event) => {
    const rawUpper = String(event || '').toUpperCase();
    if (rawUpper === 'LONG') return 'LONG';
    if (rawUpper === 'SHORT') return 'SHORT';
    const entryMatch = rawUpper.match(/^(EARLY|CORE|PRE_REAL|REAL)_(LONG|SHORT)$/);
    if (entryMatch) return entryMatch[2];
    let raw = String(event || '-');
    raw = rawUpper.replace(/^EXIT_TP_C_([0-9]+(?:\.[0-9]+)?)P$/, 'EXIT_TP_P1_$1P');
    raw = raw === 'EXIT_TP_C' ? 'EXIT_TP_P1' : raw;
    const tag = exitEventTag(event);
    return tag ? `${raw} (${tag})` : raw;
  };
%>

<%- include('partials/legacy_trading_subnav', { activeTab: 'state' }) %>
<%- include('partials/legacy_control_surface_bridge', { mode: 'trading', surfaceHref: '/dashboard/execution', surfaceLabel: 'Execution', detailHref: '/dashboard/home', detailLabel: 'Mission', extraHref: '/dashboard/audit', extraLabel: 'Audit' }) %>

<style>
  .trading-kpi-block{
    margin-bottom: 24px;
  }
  @media (max-width: 760px){
    .trading-kpi-block{
      margin-bottom: 18px;
    }
  }
</style>

<div class="section-head">
  <div class="section-title">실행 핵심</div>
  <div class="subtle">실행 상태와 리스크를 먼저 확인합니다.</div>
</div>

<div class="metric-grid trading-kpi-block">
  <div class="metric-card">
    <div class="metric-label">거래소 · TF</div>
    <div class="metric-value"><%= exchangeLabel %></div>
    <div class="metric-meta mono">TF <%= tfLabel %> · <%= now_kst || '-' %></div>
  </div>
  <div class="metric-card">
    <div class="metric-label">스케줄러</div>
    <div class="metric-value"><%= health && health.last_tick_kst ? 'RUN' : 'IDLE' %></div>
    <div class="metric-meta mono"><%= health && health.last_tick_kst ? health.last_tick_kst : '-' %></div>
  </div>
  <div class="metric-card">
    <div class="metric-label">리스크 가드레일</div>
    <div class="metric-value">
      <span class="pill <%= guardrailPill(health && health.guardrail ? health.guardrail.status : null) %>">
        <%= guardrailLabel(health && health.guardrail ? health.guardrail.status : null) %>
      </span>
    </div>
    <div class="metric-meta">
      일일 손익 <%= fmtKrw(health && health.guardrail ? health.guardrail.daily_realized_krw : null) %> <%= budgetUnit %>
      · <%= health && health.guardrail && health.guardrail.daily_realized_source ? health.guardrail.daily_realized_source : '-' %>
    </div>
  </div>
  <div class="metric-card">
    <div class="metric-label">대기 인텐트</div>
    <div class="metric-value"><%= intent_summary && intent_summary.pending != null ? intent_summary.pending : '-' %></div>
    <div class="metric-meta">총 <%= intent_summary && intent_summary.total != null ? intent_summary.total : '-' %> 건</div>
  </div>
</div>

<div class="card">
  <h2>요약</h2>
  <div class="subtle">
    이 페이지는 상태를 보여줍니다. “강제 정리/대기 취소”는 마켓별로 동작합니다.
  </div>
  <div class="hr"></div>
  <div class="kv">
    <div class="k">현재 시각</div><div class="v mono"><%= now_kst || '-' %></div>
    <div class="k">대상 마켓</div><div class="v mono"><%= (markets_expected || []).join(', ') %></div>
    <div class="k">거래소</div><div class="v mono"><%= exchangeLabel %></div>
    <div class="k">기본 TF</div><div class="v mono"><%= tfLabel %></div>
    <div class="k">배율 상태</div>
    <div class="v">
      <% if (leverageSummary && leverageSummary.enabled) { %>
        <span class="pill ok">2x <%= fmtNum(leverageSummary.tier_2x || 0) %></span>
        <span class="pill warn">3x <%= fmtNum(leverageSummary.tier_3x || 0) %></span>
        <span class="subtle mono">· 활성 <%= fmtNum(leverageSummary.active_markets || 0) %></span>
      <% } else { %>
        <span class="pill dim">현물/비활성</span>
      <% } %>
    </div>
    <div class="k">롤백 상태</div>
    <div class="v">
      <% if (rollbackSummary && rollbackSummary.enabled) { %>
        <% const rbCount = Number(rollbackSummary.rollback_active || 0); %>
        <% if (rbCount > 0) { %>
          <span class="pill bad">활성 <%= fmtNum(rbCount) %></span>
          <span class="subtle mono">· 최대 남은 <%= fmtRemain(rollbackSummary.max_remaining_ms) %></span>
        <% } else { %>
          <span class="pill ok">비활성</span>
        <% } %>
      <% } else { %>
        <span class="pill dim">현물/비활성</span>
      <% } %>
    </div>
  </div>
  <% if (typeof intent_summary !== 'undefined' && intent_summary) { %>
    <div class="hr"></div>
    <div class="kv">
      <div class="k">인텐트 합계</div><div class="v mono"><%= intent_summary.total %></div>
      <div class="k">대기</div><div class="v mono"><%= intent_summary.pending %></div>
      <div class="k">체결</div><div class="v mono"><%= intent_summary.filled %></div>
      <div class="k">취소</div><div class="v mono"><%= intent_summary.canceled %></div>
      <div class="k">만료 대기</div><div class="v mono"><%= intent_summary.expired_pending %></div>
    </div>
  <% } %>
</div>

<div class="hr"></div>

<div class="card">
  <h2>자동 실행 감시</h2>
  <div class="subtle">스케줄러/신호/체결/데이터 최신 상태</div>
  <div class="hr"></div>
  <div class="kv">
    <div class="k">스케줄러 최근</div><div class="v mono"><%= health && health.last_tick_kst ? health.last_tick_kst : '-' %></div>
    <div class="k">최근 간격</div><div class="v mono"><%= fmtMin(health && health.tick_interval_ms) %> 분</div>
    <div class="k">신호 최근(수신)</div><div class="v mono"><%= health && health.last_signal_any_kst ? health.last_signal_any_kst : '-' %></div>
    <div class="k">신호 최근(저장)</div><div class="v mono"><%= health && health.last_signal_kst ? health.last_signal_kst : '-' %></div>
    <div class="k">체결 최근</div><div class="v mono"><%= health && health.last_fill_kst ? health.last_fill_kst : '-' %></div>
    <div class="k">봉 최신</div><div class="v mono"><%= health && health.latest_bar_kst ? health.latest_bar_kst : '-' %></div>
    <div class="k">봉 지연</div><div class="v mono"><%= fmtNum(health && health.stale_bars_n) %> 개</div>
    <div class="k">로그 레벨</div><div class="v mono"><%= health && health.log_level ? health.log_level : '-' %></div>
    <div class="k">보관 기간</div><div class="v mono"><%= (health && typeof health.retention_days !== 'undefined') ? health.retention_days : '-' %> 일</div>
  </div>
  <div class="hr"></div>
  <% if (health && health.guardrail) { %>
    <div class="kv">
      <div class="k">리스크 가드레일</div><div class="v"><span class="pill <%= guardrailPill(health.guardrail.status) %>"><%= guardrailLabel(health.guardrail.status) %></span></div>
      <div class="k">일일 손익</div><div class="v mono"><%= fmtKrw(health.guardrail.daily_realized_krw) %></div>
      <div class="k">일일 거래 수</div><div class="v mono"><%= fmtNum(health.guardrail.daily_trades_n) %></div>
      <div class="k">일일 소스</div><div class="v mono"><%= health.guardrail.daily_realized_source || '-' %></div>
      <div class="k">소스 상세</div><div class="v mono">
        <% if (health.guardrail.daily_source_breakdown) { %>
          E:<%= fmtNum(health.guardrail.daily_source_breakdown.external_markets) %> /
          F:<%= fmtNum(health.guardrail.daily_source_breakdown.fallback_markets) %> /
          N:<%= fmtNum(health.guardrail.daily_source_breakdown.none_markets) %>
        <% } else { %>
          -
        <% } %>
      </div>
      <div class="k">소스 정책</div><div class="v mono"><%= health.guardrail.pnl_source_policy || '-' %></div>
      <div class="k">손실률</div><div class="v mono"><%= fmtPctRatio(health.guardrail.daily_loss_pct) %></div>
      <div class="k">손실 한도(%)</div><div class="v mono"><%= fmtPctRatio(health.guardrail.threshold_pct) %></div>
      <div class="k">손실 한도(금액)</div><div class="v mono"><%= fmtUnit(health.guardrail.threshold_krw) %> <%= budgetUnit %></div>
      <div class="k">총 예산</div><div class="v mono"><%= fmtUnit(health.guardrail.total_max_krw) %> <%= budgetUnit %></div>
    </div>
  <% } %>
  <% if (health && health.drop_summary) { %>
    <div class="hr"></div>
    <div class="subtle">신호 필터링 요약 (<%= health.drop_summary.window_hours %>h)</div>
    <div class="kv">
      <div class="k">드랍 합계</div><div class="v mono"><%= fmtNum(health.drop_summary.total) %></div>
      <div class="k">AI_BLOCK</div>
      <div class="v mono">
        <%= fmtNum(health.drop_summary.ai_block) %>
        <% if (health.drop_summary.ai_block_pct != null) { %>
          · <%= fmtPctRatio(health.drop_summary.ai_block_pct) %>
        <% } %>
      </div>
      <div class="k">상위 사유</div><div class="v"><%= (health.drop_summary.top_reasons || []).length ? health.drop_summary.top_reasons.join(', ') : '-' %></div>
      <div class="k">AI 이유</div><div class="v"><%= (health.drop_summary.top_ai_reasons || []).length ? health.drop_summary.top_ai_reasons.join(', ') : '-' %></div>
    </div>
    <% if (health.drop_summary.by_market && health.drop_summary.by_market.length) { %>
      <div class="hr"></div>
      <div class="subtle">AI_BLOCK 상세 (마켓별)</div>
      <div class="tablewrap">
        <div class="scroll" style="max-height:260px;">
          <table>
            <thead>
              <tr>
                <th>마켓</th>
                <th>드랍</th>
                <th>AI_BLOCK</th>
                <th>사유 TOP</th>
                <th>AI 이유</th>
              </tr>
            </thead>
            <tbody>
              <% health.drop_summary.by_market.forEach((m) => { %>
                <tr>
                  <td class="mono"><%= m.market %></td>
                  <td class="mono"><%= fmtNum(m.total) %></td>
                  <td class="mono">
                    <%= fmtNum(m.ai_block) %>
                    <% if (m.ai_block_pct != null) { %>
                      · <%= fmtPctRatio(m.ai_block_pct) %>
                    <% } %>
                  </td>
                  <td><%= (m.top_reasons || []).length ? m.top_reasons.join(', ') : '-' %></td>
                  <td><%= (m.top_ai_reasons || []).length ? m.top_ai_reasons.join(', ') : '-' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  <% } %>
  <div class="hr"></div>
  <% if (health && health.warnings && health.warnings.length) { %>
    <div class="subtle">경고</div>
    <div style="display:flex; gap:8px; flex-wrap:wrap; margin-top:8px;">
      <% health.warnings.forEach(w => { %>
        <span class="pill <%= w.level %>"><%= w.message %></span>
      <% }) %>
    </div>
  <% } else { %>
    <span class="pill ok">정상</span>
  <% } %>
</div>

<div class="hr"></div>

<% if (typeof kpi_summary !== 'undefined' && kpi_summary) { %>
  <div class="card">
    <h2>성과 요약 (KPI)</h2>
    <div class="subtle">최근 KPI 스냅샷 기준입니다.</div>
    <div class="hr"></div>
    <div class="kv">
      <div class="k">최근 계산</div><div class="v mono"><%= kpi_summary.last_computed_kst || '-' %></div>
      <div class="k">표본 최소치</div>
      <div class="v mono">
        <%= fmtNum(kpi_summary.min_n) %> / <%= fmtNum(kpi_summary.kpi_min_n) %>
        (<%= fmtNum(kpi_summary.ready_markets) %>/<%= fmtNum(kpi_summary.total_markets) %>)
      </div>
      <div class="k">평균 승률</div><div class="v mono"><%= fmtPctRatio(kpi_summary.avg_win_rate) %></div>
      <div class="k">평균 EV</div><div class="v mono"><%= fmtPctRatio(kpi_summary.avg_ev) %></div>
      <div class="k">평균 MDD</div><div class="v mono"><%= fmtPctRatio(kpi_summary.avg_mdd) %></div>
      <div class="k">꼬리 손실(최악)</div><div class="v mono"><%= fmtPctRatio(kpi_summary.worst_tail) %></div>
      <div class="k">상태 분포</div><div class="v"><%= kpi_summary.status_text || '-' %></div>
    </div>
  </div>
  <div class="hr"></div>
<% } %>

<div class="tablewrap">
  <div class="head">
    <h2>마켓 상태</h2>
    <div class="subtle">포지션 + 최근 신호/체결 + 대기 주문</div>
  </div>
  <div class="scroll" style="max-height:520px;">
    <table>
      <thead>
        <tr>
          <th>마켓</th>
          <th>포지션</th>
          <th>청산 상태</th>
          <th>최근 신호</th>
          <th>최근 체결</th>
          <th>대기 주문</th>
          <th>강제 정리</th>
        </tr>
      </thead>
      <tbody>
        <% (rows || []).forEach(r => { %>
          <tr>
            <% const ps = r.pending_intents || []; %>
            <td class="mono"><%= r.market %></td>
            <td class="mono">
              <%= positionLabel(r.position_state || (r.position && r.position.state)) %>
              <% const posSide = positionSideLabel(r.position && (r.position.position_side || r.position.positionSide || r.position.side)); %>
              <% if (posSide) { %> · <%= posSide %><% } %>
              · <%= fmtPct(r.position_size_pct) %>
              <% if (r.position_leverage_tier) { %>
                · <span class="pill <%= leverageBadge(r.position_leverage_tier) %>"><%= r.position_leverage_tier %></span>
              <% } else if (r.position_leverage != null) { %>
                · <span class="pill dim"><%= fmtLeverage(r.position_leverage) %></span>
              <% } %>
              <% if (r.position_rollback_active) { %>
                · <span class="pill bad">롤백</span>
                <% if (r.position_rollback_remaining_ms != null) { %>
                  <span class="subtle mono"><%= fmtRemain(r.position_rollback_remaining_ms) %></span>
                <% } %>
              <% } %>
              <% if (r.position_avg_price != null) { %> · 평균가 <%= fmtKrw(r.position_avg_price) %><% } %>
            </td>
            <td>
              <% if (r.exit_stage) { %>
                <% if (r.exit_stage.label && r.exit_stage.label !== 'TP1 대기') { %>
                  <span class="pill <%= r.exit_stage.pill %>"><%= r.exit_stage.label %></span>
                <% } %>
                <div class="subtle mono" style="margin-top:6px;">
                  <%= r.exit_stage.compact_headline.left_label %> <%= fmtKrw(r.exit_stage.compact_headline.left_price) %>
                  · <%= r.exit_stage.compact_headline.right_label %> <%= fmtKrw(r.exit_stage.compact_headline.right_price) %>
                </div>
                <div style="display:flex; flex-wrap:wrap; gap:6px; margin-top:6px;">
                  <% if (r.exit_stage.tp1_pending) { %>
                    <span class="pill warn">TP1 진행</span>
                  <% } %>
                  <% if (r.exit_stage.native_refresh_status && r.exit_stage.native_refresh_status !== 'OK') { %>
                    <span class="pill <%= r.exit_stage.native_refresh_status === 'FAILED' ? 'bad' : 'warn' %>">보호 <%= r.exit_stage.native_refresh_status %></span>
                  <% } %>
                  <% if (r.exit_stage.native_tp_status && r.exit_stage.native_tp_status !== 'OK' && r.exit_stage.native_tp_status !== r.exit_stage.native_refresh_status) { %>
                    <span class="pill <%= r.exit_stage.native_tp_status === 'FAILED' ? 'bad' : 'warn' %>">TP <%= r.exit_stage.native_tp_status %></span>
                  <% } %>
                  <% if (r.exit_stage.native_protection_stale) { %>
                    <span class="pill bad">보호 STALE</span>
                  <% } %>
                  <% if (r.exit_stage.tp1_skip_reason) { %>
                    <span class="pill bad"><%= r.exit_stage.tp1_skip_reason %></span>
                  <% } %>
                </div>
              <% } else { %>
                <span class="subtle">-</span>
              <% } %>
            </td>
            <td class="mono">
              <% if (r.last_signal) { %>
                <%= fmtKst((r._view && r._view.last_signal_ts) ? r._view.last_signal_ts : (r.last_signal.created_kst || r.last_signal.created_at)) %>
                · <%= sideLabel(r.last_signal.side) %>
                · <%= eventDisplay(r.last_signal.event) %>
                <% if (r.last_signal.event_intent) { %> · <span class="subtle"><%= r.last_signal.event_intent %></span><% } %>
                <% if (r.last_signal.qty_pct != null || r.last_signal.qtyPct != null) { %>
                  · 비중 <%= fmtNum(r.last_signal.qty_pct ?? r.last_signal.qtyPct) %>
                <% } %>
                <% if (r.last_signal.late_by_bars != null && Number(r.last_signal.late_by_bars) !== 0) { %>
                  · 지연 <%= fmtNum(r.last_signal.late_by_bars) %> bar
                <% } %>
                <% if (r.last_signal.mapping_ok === false) { %> · <span class="pill bad">매핑 오류</span><% } %>
              <% } else { %>-<% } %>
            </td>
            <td class="mono">
              <% if (r.last_fill) { %>
                <%= fmtKst((r._view && r._view.last_fill_ts) ? r._view.last_fill_ts : (r.last_fill.created_kst || r.last_fill.created_at)) %>
                · <%= sideLabel(r.last_fill.side) %>
                · <%= eventDisplay(r.last_fill.event) %>
                <% if (r.last_fill.leverage_tier) { %>
                  · <span class="pill <%= leverageBadge(r.last_fill.leverage_tier) %>"><%= r.last_fill.leverage_tier %></span>
                <% } else if (r.last_fill.leverage_applied != null) { %>
                  · <span class="pill dim"><%= fmtLeverage(r.last_fill.leverage_applied) %></span>
                <% } %>
                <% if (r.last_fill.exec_price != null) { %> · <%= fmtKrw(r.last_fill.exec_price) %><% } %>
                <% if (r.last_fill.signal_price_diff_pct != null) { %>
                  · 신호대비 <%= (r.last_fill.signal_price_diff_pct * 100).toFixed(2) %>%
                <% } %>
                <% if (r.last_fill.exec_price_source) { %> · <span class="subtle"><%= r.last_fill.exec_price_source %></span><% } %>
              <% } else { %>-<% } %>
            </td>
            <td class="pending-cell">
              <% if (ps.length === 0) { %>
                <span class="subtle pending-empty">없음</span>
              <% } else { %>
                <div class="subtle pending-count">건수: <span class="mono"><%= ps.length %></span></div>
                <div class="subtle pending-list">
                  <% ps.slice(0,3).forEach(p => { %>
                    <div class="mono">
                      <%= p.intent_id || p.id || '-' %>
                      · <%= p.side || '-' %>
                      · <%= eventDisplay(p.event) %>
                      <% if (p.scheduled_exec_bar_close_time_utc_ms) { %>
                        · 예정 <%= new Date(p.scheduled_exec_bar_close_time_utc_ms + 9*60*60*1000).toISOString().replace("T"," ").slice(0,16) %> KST
                      <% } %>
                      <% if (p.expires_at) { %>
                        <% const expMs = Date.parse(p.expires_at); %>
                        · 만료 <%= Number.isFinite(expMs) ? (new Date(expMs + 9*60*60*1000).toISOString().replace("T"," ").slice(0,16) + " KST") : p.expires_at %>
                      <% } %>
                      <% if (p.pending_reason || p.status_reason) { %>
                        <% const _pendingReason = String(p.pending_reason || p.status_reason || "").toUpperCase(); %>
                        ·
                        <% if (_pendingReason === "EXTERNAL_FILL_RECONCILED") { %>
                          <span class="pill ok">외부체결 보정</span>
                        <% } else { %>
                          <span class="subtle"><%= p.pending_reason || p.status_reason %></span>
                        <% } %>
                      <% } %>
                    </div>
                  <% }) %>
                </div>
              <% } %>
            </td>
            <% const posStateRaw = String(r.position_state || (r.position && r.position.state) || '').toUpperCase(); %>
            <% const posSize = Number(r.position_size_pct); %>
            <% const posActive = Number.isFinite(posSize) && posSize > 0 && posStateRaw !== 'FLAT'; %>
            <td>
              <div style="display:flex; gap:6px; flex-wrap:wrap;">
                <button class="btn ghost slim cancel-pending-btn" data-market="<%= r.market %>" data-exchange="<%= exchange %>" data-pending-count="<%= ps.length %>" <%= ps.length ? '' : 'disabled' %>>대기 취소</button>
                <button class="btn ghost slim force-exit-btn" data-market="<%= r.market %>" data-exchange="<%= exchange %>" data-fraction="0.5" <%= posActive ? '' : 'disabled' %>>50% 정리</button>
                <button class="btn ghost slim force-exit-btn" data-market="<%= r.market %>" data-exchange="<%= exchange %>" data-fraction="1" <%= posActive ? '' : 'disabled' %>>전량 정리</button>
              </div>
            </td>
          </tr>
        <% }) %>
        <% if (!rows || rows.length===0) { %>
          <tr><td colspan="7" class="subtle">데이터 없음</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
(function(){
  const buttons = Array.from(document.querySelectorAll(".force-exit-btn"));
  const cancelButtons = Array.from(document.querySelectorAll(".cancel-pending-btn"));
  if (!buttons.length && !cancelButtons.length) return;

  function notify(msg, ok){
    if (window.dbExchangeToast) {
      window.dbExchangeToast(msg, ok ? "ok" : "bad");
      return;
    }
    alert(msg);
  }

  function markButtonsRequested(btn, selector){
    const root = btn && btn.closest ? btn.closest("td") : null;
    const targets = root ? Array.from(root.querySelectorAll(selector)) : [btn];
    targets.forEach((b) => {
      if (!b) return;
      b.disabled = true;
      b.textContent = "요청됨";
    });
  }

  function updatePendingCell(btn, canceled){
    const row = btn && btn.closest ? btn.closest("tr") : null;
    if (!row) return;
    const cell = row.querySelector(".pending-cell");
    if (!cell) return;
    cell.innerHTML = '<span class="subtle pending-empty">없음</span>';
    const cancelBtn = row.querySelector(".cancel-pending-btn");
    if (cancelBtn) cancelBtn.disabled = true;
  }

  async function postForceExit(btn){
    const market = btn.getAttribute("data-market");
    const exchange = btn.getAttribute("data-exchange");
    const fraction = Number(btn.getAttribute("data-fraction"));
    const label = fraction >= 1 ? "전량" : "50%";
    if (!market || !Number.isFinite(fraction)) return;
    const ok = confirm(`[${market}] ${label} 정리를 요청할까요?`);
    if (!ok) return;
    btn.disabled = true;
    try{
      const res = await fetch("/api/trading/force-exit", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "include",
      body: JSON.stringify({ market, fraction, provider: exchange }),
      });
      const text = await res.text();
      let payload = null;
      try { payload = JSON.parse(text); } catch(_) { payload = null; }
      if (!res.ok || !payload || !payload.ok) {
        const msg = payload && payload.error ? payload.error : "요청 실패";
        notify(msg, false);
        return;
      }
      const when = payload.scheduled_exec_kst ? ` (예정 ${payload.scheduled_exec_kst})` : "";
      notify(`강제 정리 요청 완료${when}`, true);
      markButtonsRequested(btn, ".force-exit-btn");
    } catch (e) {
      notify("요청 중 오류가 발생했습니다", false);
    } finally {
      btn.disabled = false;
    }
  }

  async function postCancelPending(btn){
    const market = btn.getAttribute("data-market");
    const exchange = btn.getAttribute("data-exchange");
    const pendingCount = Number(btn.getAttribute("data-pending-count") || 0);
    if (!market) return;
    const label = pendingCount > 0 ? ` (${pendingCount}건)` : "";
    const ok = confirm(`[${market}] 대기 주문${label}을 모두 취소할까요?`);
    if (!ok) return;
    btn.disabled = true;
    try{
      const res = await fetch("/api/trading/cancel-pending", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "include",
        body: JSON.stringify({ market, provider: exchange }),
      });
      const text = await res.text();
      let payload = null;
      try { payload = JSON.parse(text); } catch(_) { payload = null; }
      if (!res.ok || !payload || !payload.ok) {
        const msg = payload && payload.error ? payload.error : "요청 실패";
        notify(msg, false);
        return;
      }
      notify(`대기 주문 취소 완료 · ${payload.canceled || 0}건`, true);
      updatePendingCell(btn, payload.canceled || 0);
    } catch (e) {
      notify("요청 중 오류가 발생했습니다", false);
    } finally {
      btn.disabled = false;
    }
  }

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => postForceExit(btn));
  });
  cancelButtons.forEach((btn) => {
    btn.addEventListener("click", () => postCancelPending(btn));
  });
})();
</script>

