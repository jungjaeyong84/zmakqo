<%- include('partials/app_start_unified', { title: '거래기록 · DONBEOLJA', pageTitle: '거래기록', active: 'trading' }) %>

<%
  const budgetUnit = String(String(exchange || '').includes('BINANCE') ? 'USDT' : 'KRW').toUpperCase();
  const signalRows = Array.isArray(signals12) ? signals12 : [];
  const fillRows = Array.isArray(fills12) ? fills12 : [];
  const marketRows = Array.isArray(rows) ? rows : [];
  const dropSummary = health && health.drop_summary ? health.drop_summary : null;
  const topDropMarkets = Array.isArray(dropSummary && dropSummary.by_market) ? dropSummary.by_market.slice(0, 5) : [];
  const recentDropN = dropSummary && dropSummary.total != null ? Number(dropSummary.total) : 0;
  const monitoredMarketsN = Array.isArray(markets_expected) ? markets_expected.length : 0;
  const shadowMode = !!show_shadow_signals;
  const topReasons = Array.isArray(dropSummary && dropSummary.top_reasons) ? dropSummary.top_reasons.slice(0, 4) : [];
  const serverSignalN = signalRows.filter((row) => row && (row.authoritative === true || String(row.source || '').toUpperCase() === 'SERVER')).length;
  const pineSignalN = signalRows.filter((row) => row && String(row.source || '').toUpperCase() === 'PINE_SHADOW').length;
  const activePositionsN = marketRows.filter((row) => {
    const state = String(row && row.position_state || '').toUpperCase();
    return state === 'ACTIVE' || state === 'EXIT_ONLY';
  }).length;
  const pendingMarketsN = marketRows.filter((row) => Array.isArray(row && row.pending_intents) && row.pending_intents.length > 0).length;
  const canceledRejectedProviderN = Number(intent_summary && intent_summary.canceled_rejected_provider);
  const canceledTimeoutProviderN = Number(intent_summary && intent_summary.canceled_timeout_provider);
  const canceledFailedInternalN = Number(intent_summary && intent_summary.canceled_failed_internal);

  function fmtNum(x, digits = 0) {
    const n = Number(x);
    if (!Number.isFinite(n)) return '-';
    return n.toLocaleString(undefined, { minimumFractionDigits: digits, maximumFractionDigits: digits });
  }
  function fmtPrice(x) {
    const n = Number(x);
    if (!Number.isFinite(n)) return '-';
    return budgetUnit === 'USDT'
      ? n.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })
      : (Math.trunc(n / 10) * 10).toLocaleString();
  }
  function fmtPct(x) {
    const n = Number(x);
    if (!Number.isFinite(n)) return '-';
    return (n * 100).toFixed(1) + '%';
  }
  function fmtKst(v) {
    if (!v) return '-';
    const raw = String(v);
    if (raw.includes('KST')) return raw;
    const ms = Date.parse(raw);
    if (!Number.isFinite(ms)) return raw;
    const d = new Date(ms + 9 * 60 * 60 * 1000);
    const pad = (n) => String(n).padStart(2, '0');
    return `${pad(d.getUTCMonth() + 1)}-${pad(d.getUTCDate())} ${pad(d.getUTCHours())}:${pad(d.getUTCMinutes())}`;
  }
  function displaySymbol(raw) {
    const s = String(raw || '-');
    return s.replace(/USDT$/i, '');
  }
  function eventLabel(event) {
    const s = String(event || '').toUpperCase();
    if (s.includes('SHORT')) return '매도';
    if (s.includes('LONG')) return '매수';
    if (s.startsWith('EXIT')) return '청산';
    return s || '-';
  }
  function eventTone(event) {
    const s = String(event || '').toUpperCase();
    if (s.includes('SHORT')) return 'short';
    if (s.includes('LONG')) return 'long';
    return 'filled';
  }
  function gradeLabel(signal) {
    const g = String(signal && signal.entry_grade || '').toUpperCase();
    if (g === 'CORE') return '강한 신호';
    if (g === 'EARLY') return '초기 신호';
    return '-';
  }
  function sourceLabel(signal) {
    if (!signal) return '-';
    const source = String(signal.source || '').toUpperCase();
    if (signal.authoritative === true || source === 'SERVER') return '자동 분석';
    if (source === 'PINE_SHADOW') return '보조 분석';
    if (source === 'WEBHOOK') return '외부';
    return '-';
  }
  function statusLabel(signal) {
    if (!signal) return '-';
    if (signal.exec_plan && signal.exec_plan.status) {
      const s = String(signal.exec_plan.status_detail || signal.exec_plan.status || signal.exec_plan.status_family).toUpperCase();
      if (s === 'PENDING') return '대기 중';
      if (s === 'FILLED') return '체결됨';
      if (s === 'REJECTED_PROVIDER') return '거래소 거절';
      if (s === 'TIMEOUT_PROVIDER') return '시간 초과';
      if (s === 'FAILED_INTERNAL') return '내부 오류';
      if (s === 'CANCELED') return '취소됨';
      return s;
    }
    if (signal._signal_source === 'DROP') return '건너뜀';
    return '수신';
  }
  function positionStateLabel(row) {
    const s = String(row && row.position_state || '').toUpperCase();
    if (s === 'ACTIVE') return '보유 중';
    if (s === 'EXIT_ONLY') return '청산 대기';
    if (s === 'QUARANTINE') return '거래 중단';
    if (s === 'WATCH_ONLY') return '관찰 중';
    return '대기';
  }
  function positionSideLabel(row) {
    const side = String(row && row.position && (row.position.position_side || row.position.positionSide || row.position.side) || '').toUpperCase();
    if (side === 'LONG') return '매수';
    if (side === 'SHORT') return '매도';
    return null;
  }
  function leverageText(x, tier) {
    const n = Number(x);
    if (tier) return String(tier);
    if (!Number.isFinite(n) || n <= 0) return '-';
    return `${Math.round(n * 10) / 10}x`;
  }
  function noteShort(v, len = 28) {
    const raw = String(v || '-');
    return raw.length > len ? raw.slice(0, len) + '...' : raw;
  }
  function lineageHref({ signalId = null, intentId = null, fillId = null, tradeId = null } = {}) {
    const q = [];
    if (exchange) q.push(`provider=${encodeURIComponent(String(exchange))}`);
    if (signalId) q.push(`signal_id=${encodeURIComponent(String(signalId))}`);
    if (intentId) q.push(`intent_id=${encodeURIComponent(String(intentId))}`);
    if (fillId) q.push(`fill_id=${encodeURIComponent(String(fillId))}`);
    if (tradeId) q.push(`trade_id=${encodeURIComponent(String(tradeId))}`);
    return `/api/state/lineage${q.length ? `?${q.join("&")}` : ""}`;
  }

  const guardrailStatus = health && health.guardrail && health.guardrail.status ? String(health.guardrail.status).toUpperCase() : '';
  const guardrailLabel = guardrailStatus === 'QUARANTINE' ? '거래 중단' : guardrailStatus === 'WATCH_ONLY' ? '관찰 중' : (health && health.guardrail && health.guardrail.status ? health.guardrail.status : '-');
  const guardrailTone = guardrailStatus === 'QUARANTINE' ? 'error' : guardrailStatus === 'WATCH_ONLY' ? 'warning' : 'success';
%>

<style>
  /* -- State page-specific styles -- */
  .state-overview {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    gap: 12px;
    margin-bottom: 18px;
  }
  .state-section { margin-bottom: 18px; }
  .state-section summary {
    cursor: pointer;
    user-select: none;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .state-section summary::-webkit-details-marker { display: none; }
  .state-section summary::before {
    content: '\25B6';
    font-size: 10px;
    color: var(--md-on-surface-variant);
    transition: transform 0.15s ease;
    display: inline-block;
  }
  .state-section[open] summary::before {
    transform: rotate(90deg);
  }
  .state-section .card { margin-top: 10px; }

  .records-strip {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }
  .runtime-row,
  .drop-row {
    padding: 12px 14px;
    border: 1px solid var(--md-outline-variant);
    border-radius: var(--md-shape-md);
    background: var(--md-surface-container-low);
  }
  .runtime-row + .runtime-row,
  .drop-row + .drop-row { margin-top: 8px; }
  .runtime-row .rlabel,
  .drop-row .rlabel {
    color: var(--md-on-surface-variant);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
  }
  .runtime-row strong,
  .drop-row strong {
    display: block;
    margin-top: 4px;
    font-size: 13px;
    color: var(--md-on-surface);
  }
  .runtime-row .rmeta,
  .drop-row .rmeta {
    margin-top: 4px;
    color: var(--md-on-surface-variant);
    font-size: 11px;
    line-height: 1.45;
  }
  .lineage-link {
    font-size: 11px;
    color: var(--md-on-surface-variant);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .action-stack {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .market-row-highlight {
    background: color-mix(in srgb, var(--warning, #f59e0b) 10%, transparent);
  }
  .market-row-highlight td:first-child {
    box-shadow: inset 3px 0 0 var(--warning, #f59e0b);
  }
  .action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 30px;
    padding: 0 10px;
    border-radius: var(--md-shape-full);
    border: 1px solid var(--md-outline);
    background: var(--md-surface);
    font-size: 11px;
    font-weight: 500;
    color: var(--md-on-surface);
    cursor: pointer;
    transition: background var(--md-motion-std);
  }
  .action-btn:hover { background: var(--md-surface-container-low); }
  .action-btn:disabled { opacity: 0.38; cursor: not-allowed; }
  .action-btn.warn {
    border-color: var(--md-warning);
    background: var(--md-warning-container);
    color: #7c5800;
  }
  .action-btn.bad {
    border-color: var(--md-error);
    background: var(--md-error-container);
    color: var(--md-error);
  }
  .pending-stack {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  .signal-status-stack,
  .market-status-stack {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  .summary-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .table-note {
    color: var(--md-on-surface-variant);
    font-size: 11px;
    line-height: 1.45;
    margin-top: 2px;
  }
  .right-align { text-align: right; }
  .center-align { text-align: center; }
  .side-by-side {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 16px;
  }

  @media (max-width: 1260px) {
    .side-by-side { grid-template-columns: 1fr; }
  }
  @media (max-width: 860px) {
    .state-overview { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 520px) {
    .state-overview { grid-template-columns: 1fr; }
  }
</style>

<!-- Overview KPI -->
<div class="state-overview">
  <div class="metric-card">
    <div class="metric-card-label">거래 신호</div>
    <div class="metric-card-value sm"><%= fmtNum(signalRows.length) %>건</div>
    <div class="metric-card-meta">자동 분석 <%= fmtNum(serverSignalN) %> · 보조 분석 <%= fmtNum(pineSignalN) %></div>
  </div>
  <div class="metric-card">
    <div class="metric-card-label">체결</div>
    <div class="metric-card-value sm"><%= fmtNum(fillRows.length) %>건</div>
    <div class="metric-card-meta">최근 12건 기준</div>
  </div>
  <div class="metric-card">
    <div class="metric-card-label">대기 중인 주문</div>
    <div class="metric-card-value sm"><%= intent_summary && intent_summary.pending != null ? fmtNum(intent_summary.pending) : '-' %></div>
    <div class="metric-card-meta">
      총 <%= intent_summary && intent_summary.total != null ? fmtNum(intent_summary.total) : '-' %>건
      <% if (canceledRejectedProviderN || canceledTimeoutProviderN || canceledFailedInternalN) { %>
        · 실패 <%= fmtNum(canceledRejectedProviderN + canceledTimeoutProviderN + canceledFailedInternalN) %>건
      <% } %>
      <%
        // 2026-04-28 V2 audit Step B — V2 entry intent surface.
        // Visible only when V2 collection has data (post-cutover or canary
        // entries). Operators can confirm V2 traffic flow without leaving
        // the trading state page.
        const v2IntentCount = intent_summary && intent_summary.v2_signal_intent_count;
        const v2IntentRecent = intent_summary && intent_summary.v2_signal_intent_recent_n;
      %>
      <% if (Number.isFinite(Number(v2IntentCount)) && Number(v2IntentCount) > 0) { %>
        · V2 신호 <%= fmtNum(Number(v2IntentCount)) %>건
        <% if (Number.isFinite(Number(v2IntentRecent)) && Number(v2IntentRecent) > 0) { %>
          (24h <%= fmtNum(Number(v2IntentRecent)) %>건)
        <% } %>
      <% } %>
    </div>
  </div>
  <div class="metric-card">
    <div class="metric-card-label">보유 포지션</div>
    <div class="metric-card-value sm"><%= fmtNum(activePositionsN) %>개</div>
    <div class="metric-card-meta">감시 마켓 <%= fmtNum(monitoredMarketsN) %>개</div>
  </div>
</div>

<!-- Recent Signals -->
<div class="state-section card">
  <div class="card-header">
    <div>
      <div class="card-title">최근 거래 신호</div>
      <div class="card-subtitle">최근 수신된 신호와 처리 결과입니다.</div>
    </div>
  </div>
  <div class="card-body">
    <% if (signalRows.length) { %>
      <div class="records-strip">
        <span class="chip primary sm">전체 <%= fmtNum(signalRows.length) %></span>
        <span class="chip warning sm">건너뜀 <%= fmtNum(recentDropN) %></span>
      </div>
      <div class="table-wrap">
        <table class="table-compact">
          <colgroup>
            <col style="width: 15%">
            <col style="width: 12%">
            <col style="width: 15%">
            <col style="width: 15%">
            <col style="width: 28%">
            <col style="width: 15%">
          </colgroup>
          <thead>
            <tr>
              <th>시각</th>
              <th>종목</th>
              <th>방향</th>
              <th>결과</th>
              <th>사유</th>
              <th>상세</th>
            </tr>
          </thead>
          <tbody>
            <% signalRows.forEach((s) => { %>
              <tr>
                <td class="mono"><%= fmtKst(s.created_kst || s.created_at) %></td>
                <td><strong><%= displaySymbol(s.symbol_or_pair_id || s.symbol) %></strong></td>
                <td>
                  <div class="signal-status-stack">
                    <span class="chip sm <%= eventTone(s.event) %>"><%= eventLabel(s.event) %></span>
                    <% if (gradeLabel(s) !== '-') { %><span class="chip sm <%= gradeLabel(s) === '강한 신호' ? 'primary' : 'filled' %>"><%= gradeLabel(s) %></span><% } %>
                  </div>
                </td>
                <td>
                  <span class="chip sm filled"><%= statusLabel(s) %></span>
                  <% if (s.signal_id || s.intent_id) { %>
                    <% const sLineageHref = lineageHref({ signalId: s.signal_id, intentId: s.intent_id }); %>
                    <div class="table-note">
                      <a class="lineage-link" href="<%= sLineageHref %>" data-lineage-href="<%= sLineageHref %>" target="_blank" rel="noopener">추적</a>
                      <span class="badge" data-lineage-href="<%= sLineageHref %>">확인 중</span>
                    </div>
                  <% } %>
                </td>
                <td><span class="body-sm"><%= noteShort(s.display_reason_ko || s.display_reason || s.reason || '-') %></span></td>
                <td>
                  <details>
                    <summary class="body-sm text-muted" style="cursor:pointer;">더보기</summary>
                    <div class="table-note" style="margin-top:4px;">
                      분석: <%= sourceLabel(s) %><br>
                      <% if (s.market || s.timeframe) { %>TF: <span class="mono"><%= s.market || s.timeframe || '-' %></span><br><% } %>
                      <% if (s.trace_meta) { %>메타: <span class="mono" style="word-break:break-all;"><%= s.trace_meta %></span><% } %>
                    </div>
                  </details>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="empty-state">
        <div class="empty-state-text">최근 거래 신호가 없습니다.</div>
      </div>
    <% } %>
  </div>
</div>

<!-- Market Execution Board -->
<div class="state-section card">
  <div class="card-header">
    <div>
      <div class="card-title">마켓별 현황</div>
      <div class="card-subtitle">종목별 포지션, 최근 신호, 대기 주문을 확인하고 즉시 조치할 수 있습니다.</div>
    </div>
  </div>
  <div class="card-body">
    <div class="table-wrap">
      <table class="table-compact">
        <colgroup>
          <col style="width: 14%">
          <col style="width: 18%">
          <col style="width: 18%">
          <col style="width: 12%">
          <col style="width: 14%">
          <col style="width: 24%">
        </colgroup>
        <thead>
          <tr>
            <th>종목</th>
            <th>포지션</th>
            <th>최근 신호</th>
            <th>대기</th>
            <th>최근 체결</th>
            <th>조치</th>
          </tr>
        </thead>
        <tbody>
          <% marketRows.forEach((r) => { %>
            <% const posSide = positionSideLabel(r); %>
            <% const pendingCount = Array.isArray(r.pending_intents) ? r.pending_intents.length : 0; %>
            <% const posActive = String(r.position_state || '').toUpperCase() === 'ACTIVE' || String(r.position_state || '').toUpperCase() === 'EXIT_ONLY'; %>
            <tr class="<%= selected_market && r.market === selected_market ? 'market-row-highlight' : '' %>">
              <td><strong><%= displaySymbol(r.market) %></strong><br><span class="text-muted body-sm"><%= r.tf || tf_default || '-' %></span></td>
              <td>
                <div class="market-status-stack">
                  <span class="chip sm filled"><%= positionStateLabel(r) %></span>
                  <% if (posSide) { %><span class="chip sm <%= posSide === '매수' ? 'long' : 'short' %>"><%= posSide %></span><% } %>
                </div>
                <div class="table-note"><%= r.position_size_pct != null ? `${fmtNum(r.position_size_pct, 0)}% 비중` : '' %> <%= leverageText(r.position_leverage, r.position_leverage_tier) %></div>
              </td>
              <td>
                <% if (r.last_signal) { %>
                  <div class="market-status-stack">
                    <span class="chip sm <%= eventTone(r.last_signal.event) %>"><%= eventLabel(r.last_signal.event) %></span>
                    <span class="chip sm filled"><%= sourceLabel(r.last_signal) %></span>
                  </div>
                  <div class="table-note"><%= fmtKst(r._view && r._view.last_signal_ts) %></div>
                  <% if (r.last_signal.signal_id || r.last_signal.intent_id) { %>
                    <% const rowSignalLineageHref = lineageHref({ signalId: r.last_signal.signal_id, intentId: r.last_signal.intent_id }); %>
                    <div class="table-note">
                      <a class="lineage-link" href="<%= rowSignalLineageHref %>" data-lineage-href="<%= rowSignalLineageHref %>" target="_blank" rel="noopener">추적</a>
                      <span class="badge" data-lineage-href="<%= rowSignalLineageHref %>">확인 중</span>
                    </div>
                  <% } %>
                <% } else { %>
                  <span class="text-muted">없음</span>
                <% } %>
              </td>
              <td class="pending-cell">
                <% if (pendingCount > 0) { %>
                  <div class="pending-stack">
                    <span class="chip sm warning"><%= pendingCount %>건</span>
                  </div>
                <% } else { %>
                  <span class="text-muted">없음</span>
                <% } %>
              </td>
              <td class="right-align">
                <% if (r.last_fill && r.last_fill.exec_price != null) { %>
                  <strong class="mono"><%= fmtPrice(r.last_fill.exec_price) %></strong>
                  <div class="table-note"><%= fmtKst(r._view && r._view.last_fill_ts) %></div>
                  <% if (r.last_fill.fill_id || r.last_fill.trade_id || r.last_fill.intent_id) { %>
                    <% const rowFillLineageHref = lineageHref({ fillId: r.last_fill.fill_id, tradeId: r.last_fill.trade_id, intentId: r.last_fill.intent_id, signalId: r.last_fill.signal_id }); %>
                    <div class="table-note">
                      <a class="lineage-link" href="<%= rowFillLineageHref %>" data-lineage-href="<%= rowFillLineageHref %>" target="_blank" rel="noopener">추적</a>
                      <span class="badge" data-lineage-href="<%= rowFillLineageHref %>">확인 중</span>
                    </div>
                  <% } %>
                <% } else { %>
                  <span class="text-muted">-</span>
                <% } %>
              </td>
              <td>
                <div class="action-stack">
                  <button class="action-btn cancel-pending-btn" data-market="<%= r.market %>" data-exchange="<%= exchange %>" data-pending-count="<%= pendingCount %>" <%= pendingCount ? '' : 'disabled' %>>대기 취소</button>
                  <button class="action-btn warn force-exit-btn" data-market="<%= r.market %>" data-exchange="<%= exchange %>" data-fraction="0.5" <%= posActive ? '' : 'disabled' %>>50% 정리</button>
                  <button class="action-btn bad force-exit-btn" data-market="<%= r.market %>" data-exchange="<%= exchange %>" data-fraction="1" <%= posActive ? '' : 'disabled' %>>전량 정리</button>
                </div>
              </td>
            </tr>
          <% }) %>
          <% if (!marketRows.length) { %>
            <tr><td colspan="6" class="empty-state" style="padding:24px;">감시 중인 종목이 없습니다.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Recent Fills -->
<div class="state-section card">
  <div class="card-header">
    <div>
      <div class="card-title">최근 체결 내역</div>
      <div class="card-subtitle">실제로 거래소에서 체결된 주문 목록입니다.</div>
    </div>
  </div>
  <div class="card-body">
    <% if (fillRows.length) { %>
      <div class="table-wrap">
        <table class="table-compact">
          <colgroup>
            <col style="width: 16%">
            <col style="width: 14%">
            <col style="width: 12%">
            <col style="width: 18%">
            <col style="width: 28%">
            <col style="width: 12%">
          </colgroup>
          <thead>
            <tr>
              <th>시각</th>
              <th>종목</th>
              <th>방향</th>
              <th class="right-align">체결가</th>
              <th>메모</th>
              <th>상세</th>
            </tr>
          </thead>
          <tbody>
            <% fillRows.forEach((f) => { %>
              <tr>
                <td class="mono"><%= fmtKst(f.created_kst || f.created_at) %></td>
                <td><strong><%= displaySymbol(f.symbol || f.symbol_or_pair_id || f.market) %></strong></td>
                <td class="center-align"><span class="chip sm <%= eventTone(f.event) %>"><%= eventLabel(f.event) %></span></td>
                <td class="right-align mono"><%= f.exec_price != null ? fmtPrice(f.exec_price) : '-' %></td>
                <td><span class="body-sm"><%= noteShort(f.display_exec_ko || f.display_exec_text || '-') %></span></td>
                <td>
                  <details>
                    <summary class="body-sm text-muted" style="cursor:pointer;">더보기</summary>
                    <div class="table-note" style="margin-top:4px;">
                      레버리지: <%= leverageText(f.leverage_applied, f.leverage_tier) %>
                      <% if (f.fill_id || f.trade_id || f.intent_id) { %>
                        <% const fLineageHref = lineageHref({ fillId: f.fill_id, tradeId: f.trade_id, intentId: f.intent_id, signalId: f.signal_id }); %>
                        <br><a class="lineage-link" href="<%= fLineageHref %>" data-lineage-href="<%= fLineageHref %>" target="_blank" rel="noopener">추적</a>
                        <span class="badge" data-lineage-href="<%= fLineageHref %>">확인 중</span>
                      <% } %>
                      <% if (f.trace_meta) { %><br>메타: <span class="mono" style="word-break:break-all;"><%= f.trace_meta %></span><% } %>
                    </div>
                  </details>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="empty-state">
        <div class="empty-state-text">최근 체결 내역이 없습니다.</div>
      </div>
    <% } %>
  </div>
</div>

<!-- Collapsible: System Details -->
<details class="state-section">
  <summary><span class="card-title" style="font-size:14px;">시스템 상세 정보</span> <span class="text-muted body-sm">리스크 관리, 건너뜀 요약, 레버리지, 성과 지표</span></summary>

  <div class="side-by-side" style="margin-top:12px;">
    <!-- Runtime / Guardrail -->
    <div class="card">
      <div class="card-header">
        <div>
          <div class="card-title">실행 상태</div>
          <div class="card-subtitle">시스템 가동 상태와 리스크 관리 현황</div>
        </div>
      </div>
      <div class="card-body">
        <div class="runtime-row">
          <div class="rlabel">시스템</div>
          <strong><%= health && health.last_tick_kst ? '가동 중' : '대기' %></strong>
          <div class="rmeta">
            거래소: <%= exchange || '-' %> · 기본 TF: <span class="mono"><%= tf_default || '-' %></span><br>
            마지막 작동: <span class="mono"><%= health && health.last_tick_kst ? health.last_tick_kst : '-' %></span>
          </div>
        </div>
        <div class="runtime-row">
          <div class="rlabel">리스크 관리</div>
          <strong><span class="chip sm <%= guardrailTone %>"><%= guardrailLabel %></span></strong>
          <div class="rmeta">일일 손익 <%= fmtPrice(health && health.guardrail ? health.guardrail.daily_realized_krw : null) %> <%= budgetUnit %></div>
        </div>
        <div class="runtime-row">
          <div class="rlabel">최신 데이터</div>
          <strong><%= health && health.latest_bar_kst ? health.latest_bar_kst : '-' %></strong>
          <div class="rmeta">지연 데이터 <%= fmtNum(health && health.stale_bars_n) %>개</div>
        </div>
        <div class="runtime-row">
          <div class="rlabel">최근 체결</div>
          <strong><%= health && health.last_fill_kst ? health.last_fill_kst : '-' %></strong>
        </div>
        <% if (shadowMode || true) { %>
        <div class="runtime-row">
          <div class="rlabel">신호 보기 모드</div>
          <strong><%= shadowMode ? '보조 분석 포함' : '자동 분석만' %></strong>
          <div class="rmeta"><a class="btn btn-text sm" href="<%= shadowMode ? '/dashboard/trading?shadow=0' : '/dashboard/trading?shadow=1' %>"><%= shadowMode ? '자동 분석만 보기' : '보조 분석 포함 보기' %></a></div>
        </div>
        <% } %>
      </div>
    </div>

    <!-- Drop Summary -->
    <div class="card">
      <div class="card-header">
        <div>
          <div class="card-title">건너뜀 요약</div>
          <div class="card-subtitle">
            최근 <%= dropSummary ? `${dropSummary.window_hours}시간` : '' %> 동안 필터링된 신호 <%= fmtNum(recentDropN) %>건
          </div>
        </div>
      </div>
      <div class="card-body">
        <% if (topReasons.length) { %>
          <div class="summary-pills" style="margin-bottom:12px;">
            <% topReasons.forEach((reason) => { %>
              <span class="chip sm filled"><%= reason %></span>
            <% }) %>
          </div>
        <% } %>
        <% if (topDropMarkets.length) { %>
          <% topDropMarkets.forEach((m) => { %>
            <div class="drop-row">
              <div class="rlabel"><%= displaySymbol(m.market) %></div>
              <strong><%= fmtNum(m.total) %>건 · AI 차단 <%= fmtNum(m.ai_block) %>건</strong>
              <div class="rmeta"><%= (m.top_reasons || []).join(', ') || '상세 사유 없음' %></div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="empty-state">
            <div class="empty-state-text">최근 건너뜀이 없습니다.</div>
          </div>
        <% } %>
        <%
          // P3-12: individual drop rows with explicit reason codes so ops can
          // diagnose a silent drop without parsing aggregate chips.
          const recentDropRows = Array.isArray(dropSummary && dropSummary.recent_rows)
            ? dropSummary.recent_rows
            : [];
        %>
        <% if (recentDropRows.length) { %>
          <div class="card-subtitle" style="margin-top:14px; margin-bottom:6px;">최근 건너뜀 상세</div>
          <div class="drop-rows-detail">
            <% recentDropRows.forEach((row) => { %>
              <div class="drop-row">
                <div class="rlabel">
                  <%= row.symbol ? displaySymbol(row.symbol) : '-' %>
                  <% if (row.side) { %><span class="chip sm"><%= String(row.side).toUpperCase() %></span><% } %>
                  <% if (row.execution_mode) { %><span class="chip sm"><%= row.execution_mode %></span><% } %>
                </div>
                <strong><%= row.reason %></strong>
                <div class="rmeta">
                  <%= row.reason_family %>
                  <% if (row.event) { %> · <%= row.event %><% } %>
                  <% if (row.created_at) { %> · <%= row.created_at %><% } %>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <div class="side-by-side" style="margin-top:12px;">
    <!-- Leverage Summary -->
    <div class="card">
      <div class="card-header">
        <div>
          <div class="card-title">레버리지 현황</div>
          <div class="card-subtitle">감시 종목의 레버리지 설정</div>
        </div>
      </div>
      <div class="card-body">
        <div class="runtime-row">
          <div class="rlabel">2x 종목</div>
          <strong><%= leverage_summary && leverage_summary.tier_2x != null ? fmtNum(leverage_summary.tier_2x) : '-' %></strong>
          <div class="rmeta">활성 <%= leverage_summary && leverage_summary.active_markets != null ? fmtNum(leverage_summary.active_markets) : '-' %>개</div>
        </div>
        <div class="runtime-row">
          <div class="rlabel">3x 종목</div>
          <strong><%= leverage_summary && leverage_summary.tier_3x != null ? fmtNum(leverage_summary.tier_3x) : '-' %></strong>
          <div class="rmeta">기본 레버리지 <%= leverage_summary && leverage_summary.default_leverage != null ? leverage_summary.default_leverage : '-' %>x</div>
        </div>
        <div class="runtime-row">
          <div class="rlabel">롤백 상태</div>
          <strong><%= rollback_summary && rollback_summary.rollback_active != null ? fmtNum(rollback_summary.rollback_active) : '-' %></strong>
          <div class="rmeta">최대 남은 시간 <%= rollback_summary && rollback_summary.max_remaining_ms != null ? fmtNum(Math.round(rollback_summary.max_remaining_ms / 60000)) : '-' %>분</div>
        </div>
      </div>
    </div>

    <!-- KPI Summary -->
    <div class="card">
      <div class="card-header">
        <div>
          <div class="card-title">성과 지표</div>
          <div class="card-subtitle">실행 품질 지표 현황</div>
        </div>
      </div>
      <div class="card-body">
        <div class="runtime-row">
          <div class="rlabel">준비 종목</div>
          <strong><%= kpi_summary && kpi_summary.ready_markets != null ? fmtNum(kpi_summary.ready_markets) : '-' %> / <%= kpi_summary && kpi_summary.total_markets != null ? fmtNum(kpi_summary.total_markets) : '-' %></strong>
          <div class="rmeta">최소 표본 <%= kpi_summary && kpi_summary.kpi_min_n != null ? fmtNum(kpi_summary.kpi_min_n) : '-' %>건</div>
        </div>
        <div class="runtime-row">
          <div class="rlabel">평균 승률</div>
          <strong><%= kpi_summary && kpi_summary.avg_win_rate != null ? fmtPct(kpi_summary.avg_win_rate) : '-' %></strong>
          <div class="rmeta">평균 기대값 <%= kpi_summary && kpi_summary.avg_ev != null ? fmtNum(kpi_summary.avg_ev, 2) : '-' %></div>
        </div>
        <div class="runtime-row">
          <div class="rlabel">상태</div>
          <strong><%= kpi_summary && kpi_summary.status_text ? kpi_summary.status_text : '-' %></strong>
          <div class="rmeta">최근 계산 <%= kpi_summary && kpi_summary.last_computed_kst ? kpi_summary.last_computed_kst : '-' %></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Failure breakdown (hidden by default inside the collapsible) -->
  <% if (canceledRejectedProviderN || canceledTimeoutProviderN || canceledFailedInternalN) { %>
  <div class="card" style="margin-top:12px;">
    <div class="card-header">
      <div>
        <div class="card-title">주문 실패 상세</div>
      </div>
    </div>
    <div class="card-body">
      <div class="records-strip">
        <span class="chip sm error">거래소 거절 <%= fmtNum(canceledRejectedProviderN) %></span>
        <span class="chip sm warning">시간 초과 <%= fmtNum(canceledTimeoutProviderN) %></span>
        <span class="chip sm filled">내부 오류 <%= fmtNum(canceledFailedInternalN) %></span>
      </div>
    </div>
  </div>
  <% } %>
</details>

<script>
(function(){
  const buttons = Array.from(document.querySelectorAll('.force-exit-btn'));
  const cancelButtons = Array.from(document.querySelectorAll('.cancel-pending-btn'));
  if (!buttons.length && !cancelButtons.length) return;

  function notify(msg, ok){
    if (window.dbExchangeToast) {
      window.dbExchangeToast(msg, ok ? 'ok' : 'bad');
      return;
    }
    alert(msg);
  }

  function markButtonsRequested(btn, selector){
    const root = btn && btn.closest ? btn.closest('td') : null;
    const targets = root ? Array.from(root.querySelectorAll(selector)) : [btn];
    targets.forEach((b) => {
      if (!b) return;
      b.disabled = true;
      b.textContent = '요청됨';
    });
  }

  function updatePendingCell(btn){
    const row = btn && btn.closest ? btn.closest('tr') : null;
    if (!row) return;
    const cell = row.querySelector('.pending-cell');
    if (!cell) return;
    cell.innerHTML = '<span class="text-muted">없음</span>';
    const cancelBtn = row.querySelector('.cancel-pending-btn');
    if (cancelBtn) cancelBtn.disabled = true;
  }

  async function postForceExit(btn){
    const market = btn.getAttribute('data-market');
    const exchange = btn.getAttribute('data-exchange');
    const fraction = Number(btn.getAttribute('data-fraction'));
    const label = fraction >= 1 ? '전량' : '50%';
    if (!market || !Number.isFinite(fraction)) return;
    const ok = confirm(`[${market}] ${label} 정리를 요청할까요?`);
    if (!ok) return;
    btn.disabled = true;
    try{
      const res = await fetch('/api/trading/force-exit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ market, fraction, provider: exchange }),
      });
      const text = await res.text();
      let payload = null;
      try { payload = JSON.parse(text); } catch(_) { payload = null; }
      if (!res.ok || !payload || !payload.ok) {
        const msg = payload && payload.error ? payload.error : '요청 실패';
        notify(msg, false);
        return;
      }
      const when = payload.scheduled_exec_kst ? ` (예정 ${payload.scheduled_exec_kst})` : '';
      notify(`강제 정리 요청 완료${when}`, true);
      markButtonsRequested(btn, '.force-exit-btn');
    } catch (e) {
      notify('요청 중 오류가 발생했습니다', false);
    } finally {
      btn.disabled = false;
    }
  }

  async function postCancelPending(btn){
    const market = btn.getAttribute('data-market');
    const exchange = btn.getAttribute('data-exchange');
    const pendingCount = Number(btn.getAttribute('data-pending-count') || 0);
    if (!market) return;
    const label = pendingCount > 0 ? ` (${pendingCount}건)` : '';
    const ok = confirm(`[${market}] 대기 주문${label}을 모두 취소할까요?`);
    if (!ok) return;
    btn.disabled = true;
    try{
      const res = await fetch('/api/trading/cancel-pending', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ market, provider: exchange }),
      });
      const text = await res.text();
      let payload = null;
      try { payload = JSON.parse(text); } catch(_) { payload = null; }
      if (!res.ok || !payload || !payload.ok) {
        const msg = payload && payload.error ? payload.error : '요청 실패';
        notify(msg, false);
        return;
      }
      notify(`대기 주문 취소 완료 · ${payload.canceled || 0}건`, true);
      updatePendingCell(btn);
    } catch (e) {
      notify('요청 중 오류가 발생했습니다', false);
    } finally {
      btn.disabled = false;
    }
  }

  buttons.forEach((btn) => btn.addEventListener('click', () => postForceExit(btn)));
  cancelButtons.forEach((btn) => btn.addEventListener('click', () => postCancelPending(btn)));
})();
</script>

<script>
(function(){
  const badges = Array.from(document.querySelectorAll('.badge[data-lineage-href]'));
  if (!badges.length) return;
  const byHref = new Map();
  for (const node of badges) {
    const href = String(node.getAttribute('data-lineage-href') || '').trim();
    if (!href) continue;
    if (!byHref.has(href)) byHref.set(href, []);
    byHref.get(href).push(node);
  }
  const setBadge = (nodes, text, klass, title) => {
    (nodes || []).forEach((node) => {
      node.textContent = text;
      node.classList.remove('ok', 'bad', 'warn');
      if (klass) node.classList.add(klass);
      node.title = title || '';
    });
  };
  byHref.forEach((nodes, href) => {
    setBadge(nodes, '확인 중', null, '추적 조회 중');
    fetch(href, { credentials: 'include' })
      .then((res) => res.json().catch(() => null))
      .then((payload) => {
        if (!payload || payload.ok !== true) {
          setBadge(nodes, '오류', 'warn', '추적 조회 실패');
          return;
        }
        const diagnostics = payload.diagnostics || {};
        const broken = Array.isArray(diagnostics.broken_links) ? diagnostics.broken_links : [];
        if (diagnostics.complete === true || broken.length === 0) {
          setBadge(nodes, '정상', 'ok', '연결 완료');
          return;
        }
        setBadge(nodes, `끊김 ${broken.length}`, 'bad', broken.join(', '));
      })
      .catch(() => {
        setBadge(nodes, '오류', 'warn', '추적 조회 실패');
      });
  });
})();
</script>

<%- include('partials/app_end_unified') %>
