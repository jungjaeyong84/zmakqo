<%- include('partials/app_start_trader', { title: '거래기록 · DONBEOLJA Trader', pageTitle: '거래기록', active: 'trading' }) %>

<%
  const budgetUnit = String(String(exchange || '').includes('BINANCE') ? 'USDT' : 'KRW').toUpperCase();
  const signalRows = Array.isArray(signals12) ? signals12 : [];
  const fillRows = Array.isArray(fills12) ? fills12 : [];
  const marketRows = Array.isArray(rows) ? rows : [];
  const dropSummary = health && health.drop_summary ? health.drop_summary : null;
  const topDropMarkets = Array.isArray(dropSummary && dropSummary.by_market) ? dropSummary.by_market.slice(0, 5) : [];
  const recentDropN = dropSummary && dropSummary.total != null ? Number(dropSummary.total) : 0;
  const monitoredMarketsN = Array.isArray(markets_expected) ? markets_expected.length : 0;
  const shadowMode = !!show_shadow_signals;
  const activePositionsN = marketRows.filter((row) => {
    const state = String(row && row.position_state || '').toUpperCase();
    return state === 'ACTIVE' || state === 'EXIT_ONLY';
  }).length;
  const pendingMarketsN = marketRows.filter((row) => Array.isArray(row && row.pending_intents) && row.pending_intents.length > 0).length;

  function fmtNum(x, digits = 0) {
    const n = Number(x);
    if (!Number.isFinite(n)) return '-';
    return n.toLocaleString(undefined, { minimumFractionDigits: digits, maximumFractionDigits: digits });
  }
  function fmtPrice(x) {
    const n = Number(x);
    if (!Number.isFinite(n)) return '-';
    return budgetUnit === 'USDT'
      ? n.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })
      : (Math.trunc(n / 10) * 10).toLocaleString();
  }
  function fmtPct(x) {
    const n = Number(x);
    if (!Number.isFinite(n)) return '-';
    return (n * 100).toFixed(1) + '%';
  }
  function fmtKst(v) {
    if (!v) return '-';
    const raw = String(v);
    if (raw.includes('KST')) return raw;
    const ms = Date.parse(raw);
    if (!Number.isFinite(ms)) return raw;
    const d = new Date(ms + 9 * 60 * 60 * 1000);
    const pad = (n) => String(n).padStart(2, '0');
    return `${pad(d.getUTCMonth() + 1)}-${pad(d.getUTCDate())} ${pad(d.getUTCHours())}:${pad(d.getUTCMinutes())}`;
  }
  function eventLabel(event) {
    const s = String(event || '').toUpperCase();
    if (s.includes('SHORT')) return '숏';
    if (s.includes('LONG')) return '롱';
    if (s.startsWith('EXIT')) return '청산';
    return s || '-';
  }
  function eventTone(event) {
    const s = String(event || '').toUpperCase();
    if (s.includes('SHORT')) return 'short';
    if (s.includes('LONG')) return 'long';
    return 'soft';
  }
  function gradeLabel(signal) {
    const g = String(signal && signal.entry_grade || '').toUpperCase();
    if (g === 'CORE') return '코어';
    if (g === 'EARLY') return '얼리';
    return '-';
  }
  function sourceLabel(signal) {
    if (!signal) return '-';
    const source = String(signal.source || '').toUpperCase();
    if (signal.authoritative === true || source === 'SERVER') return '서버';
    if (source === 'PINE_SHADOW') return 'Pine';
    if (source === 'WEBHOOK') return '외부';
    return '-';
  }
  function statusLabel(signal) {
    if (!signal) return '-';
    if (signal.exec_plan && signal.exec_plan.status) {
      const s = String(signal.exec_plan.status).toUpperCase();
      if (s === 'PENDING') return '주문 대기';
      if (s === 'FILLED') return '체결 완료';
      if (s === 'CANCELED') return '취소';
      return s;
    }
    if (signal._signal_source === 'DROP') return '드롭';
    return '수신';
  }
  function positionStateLabel(row) {
    const s = String(row && row.position_state || '').toUpperCase();
    if (s === 'ACTIVE') return '보유 중';
    if (s === 'EXIT_ONLY') return '청산 대기';
    return '대기';
  }
  function positionSideLabel(row) {
    const side = String(row && row.position && (row.position.position_side || row.position.positionSide || row.position.side) || '').toUpperCase();
    if (side === 'LONG') return '롱';
    if (side === 'SHORT') return '숏';
    return null;
  }
  function leverageText(x, tier) {
    const n = Number(x);
    if (tier) return String(tier);
    if (!Number.isFinite(n) || n <= 0) return '-';
    return `${Math.round(n * 10) / 10}x`;
  }
  function noteShort(v, len = 28) {
    const raw = String(v || '-');
    return raw.length > len ? raw.slice(0, len) + '...' : raw;
  }
%>

<style>
  .trading-records {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .records-top {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) 340px;
    gap: 16px;
  }
  .records-kpis {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }
  .records-kpi {
    padding: 14px 15px;
    border-radius: 18px;
    border: 1px solid var(--trade-border);
    background: linear-gradient(180deg, #ffffff 0%, #fbfcfe 100%);
  }
  .records-kpi .label,
  .records-mini .label,
  .runtime-row .label,
  .drop-row .label {
    color: var(--trade-muted);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .07em;
  }
  .records-kpi .value,
  .records-mini .value {
    margin-top: 6px;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: -.04em;
  }
  .records-kpi .meta,
  .records-mini .meta,
  .runtime-row .meta,
  .drop-row .meta {
    margin-top: 5px;
    color: var(--trade-muted);
    font-size: 11px;
    line-height: 1.45;
  }
  .records-hero .trade-panel-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .records-mini {
    padding: 12px 13px;
    border: 1px solid var(--trade-border);
    border-radius: 14px;
    background: #fbfcfd;
  }
  .side-stack {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .runtime-list,
  .drop-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .runtime-row,
  .drop-row {
    padding: 10px 12px;
    border: 1px solid var(--trade-border);
    border-radius: 14px;
    background: #fbfcfd;
  }
  .runtime-row strong,
  .drop-row strong {
    display: block;
    margin-top: 4px;
    font-size: 12px;
  }
  .trade-layout-grid,
  .market-layout-grid,
  .fills-layout-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) 340px;
    gap: 16px;
  }
  .compact-record-table th,
  .compact-record-table td {
    padding-top: 8px;
    padding-bottom: 8px;
  }
  .compact-record-table td strong {
    display: block;
    font-size: 11px;
  }
  .compact-record-table td span {
    display: block;
    margin-top: 2px;
    color: var(--trade-muted);
    font-size: 10px;
  }
  .table-chip.soft {
    color: var(--trade-muted);
    background: #f7f8fa;
  }
  .table-chip.status {
    color: #3f4954;
    background: #f4f6f8;
  }
  .action-stack {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 30px;
    padding: 0 10px;
    border-radius: 10px;
    border: 1px solid var(--trade-border);
    background: #fff;
    font-size: 11px;
    font-weight: 700;
    color: var(--trade-text);
    cursor: pointer;
  }
  .action-btn:disabled {
    opacity: .45;
    cursor: default;
  }
  .action-btn.warn {
    border-color: #ead8a2;
    background: #fff8e7;
    color: #8a6303;
  }
  .action-btn.bad {
    border-color: #f0c5c1;
    background: #fff1f0;
    color: var(--trade-down);
  }
  .pending-stack {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  .subchip {
    display: inline-flex;
    align-items: center;
    padding: 4px 7px;
    border-radius: 999px;
    background: #f4f6f8;
    color: var(--trade-muted);
    font-size: 10px;
    font-weight: 700;
  }
  .right-align { text-align: right; }
  .center-align { text-align: center; }
  @media (max-width: 1260px) {
    .records-top,
    .trade-layout-grid,
    .market-layout-grid,
    .fills-layout-grid { grid-template-columns: 1fr; }
    .records-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 860px) {
    .records-kpis,
    .records-hero .trade-panel-body { grid-template-columns: 1fr; }
  }
</style>

<section class="trading-records">
  <section class="records-top">
    <article class="trade-panel soft records-hero compact">
      <div class="trade-panel-head">
        <div>
          <div class="trade-panel-title">거래기록 요약</div>
          <div class="trade-panel-sub">신호, 드롭, 대기 인텐트, 체결을 거래소형 화면으로 빠르게 읽습니다.</div>
        </div>
      </div>
      <div class="trade-panel-body">
        <div class="records-mini">
          <div class="label">거래소 · TF</div>
          <div class="value"><%= exchange || '-' %></div>
          <div class="meta">기본 TF <span class="mono"><%= tf_default || '-' %></span> · <span class="mono"><%= now_kst || '-' %></span></div>
        </div>
        <div class="records-mini">
          <div class="label">실행 상태</div>
          <div class="value"><%= health && health.last_tick_kst ? '가동 중' : '대기' %></div>
          <div class="meta">최근 스케줄러 <span class="mono"><%= health && health.last_tick_kst ? health.last_tick_kst : '-' %></span></div>
        </div>
        <div class="records-mini">
          <div class="label">신호 보기</div>
          <div class="value"><%= shadowMode ? '그림자 포함' : '정본 기준' %></div>
          <div class="meta"><a class="trade-btn" href="<%= shadowMode ? '/dashboard/trading?shadow=0' : '/dashboard/trading?shadow=1' %>"><%= shadowMode ? '정본만 보기' : '그림자 포함 보기' %></a></div>
        </div>
        <div class="records-mini">
          <div class="label">감시 마켓</div>
          <div class="value"><%= fmtNum(monitoredMarketsN) %>개</div>
          <div class="meta">활성 포지션 <%= fmtNum(activePositionsN) %> · 대기 마켓 <%= fmtNum(pendingMarketsN) %></div>
        </div>
      </div>
    </article>

    <aside class="side-stack">
      <section class="trade-panel compact">
        <div class="trade-panel-head">
          <div>
            <div class="trade-panel-title">실행 런타임</div>
            <div class="trade-panel-sub">감시와 가드레일 상태</div>
          </div>
        </div>
        <div class="trade-panel-body runtime-list">
          <div class="runtime-row">
            <div class="label">리스크 가드레일</div>
            <strong><%= health && health.guardrail && health.guardrail.status ? health.guardrail.status : '-' %></strong>
            <div class="meta">일일 손익 <%= fmtPrice(health && health.guardrail ? health.guardrail.daily_realized_krw : null) %> <%= budgetUnit %></div>
          </div>
          <div class="runtime-row">
            <div class="label">봉 최신</div>
            <strong><%= health && health.latest_bar_kst ? health.latest_bar_kst : '-' %></strong>
            <div class="meta">지연 봉 <%= fmtNum(health && health.stale_bars_n) %>개</div>
          </div>
          <div class="runtime-row">
            <div class="label">최근 체결</div>
            <strong><%= health && health.last_fill_kst ? health.last_fill_kst : '-' %></strong>
            <div class="meta">로그 <span class="mono"><%= health && health.log_level ? health.log_level : '-' %></span></div>
          </div>
        </div>
      </section>
    </aside>
  </section>

  <section class="records-kpis">
    <article class="records-kpi">
      <div class="label">최근 신호</div>
      <div class="value"><%= fmtNum(signalRows.length) %>건</div>
      <div class="meta">현재 화면에 표시되는 최근 12건 기준</div>
    </article>
    <article class="records-kpi">
      <div class="label">최근 드롭</div>
      <div class="value"><%= fmtNum(recentDropN) %>건</div>
      <div class="meta"><%= dropSummary ? `${dropSummary.window_hours}시간 필터링 기준` : '드롭 집계 없음' %></div>
    </article>
    <article class="records-kpi">
      <div class="label">대기 인텐트</div>
      <div class="value"><%= intent_summary && intent_summary.pending != null ? fmtNum(intent_summary.pending) : '-' %></div>
      <div class="meta">총 <%= intent_summary && intent_summary.total != null ? fmtNum(intent_summary.total) : '-' %>건</div>
    </article>
    <article class="records-kpi">
      <div class="label">최근 체결</div>
      <div class="value"><%= fmtNum(fillRows.length) %>건</div>
      <div class="meta">최근 12건 기준</div>
    </article>
  </section>

  <section class="trade-layout-grid">
    <article class="trade-panel compact">
      <div class="trade-panel-head">
        <div>
          <div class="trade-panel-title">최근 신호</div>
          <div class="trade-panel-sub">홈보다 조금 더 자세히 읽지만, 과한 내부 코드는 숨깁니다.</div>
        </div>
      </div>
      <div class="trade-panel-body">
        <% if (signalRows.length) { %>
          <table class="trade-table compact-record-table">
            <colgroup>
              <col style="width: 18%">
              <col style="width: 18%">
              <col style="width: 18%">
              <col style="width: 18%">
              <col style="width: 28%">
            </colgroup>
            <thead>
              <tr>
                <th>시각</th>
                <th>마켓</th>
                <th>신호</th>
                <th>상태</th>
                <th>메모</th>
              </tr>
            </thead>
            <tbody>
              <% signalRows.forEach((s) => { %>
                <tr>
                  <td class="mono"><%= fmtKst(s.created_kst || s.created_at) %></td>
                  <td><strong><%= s.symbol_or_pair_id || s.symbol || '-' %></strong><span><%= s.market || s.timeframe || '-' %></span></td>
                  <td>
                    <span class="table-chip <%= eventTone(s.event) %>"><%= eventLabel(s.event) %></span>
                    <span class="table-chip <%= gradeLabel(s) === '코어' ? 'core' : 'soft' %>"><%= gradeLabel(s) %></span>
                  </td>
                  <td>
                    <span class="table-chip soft"><%= sourceLabel(s) %></span>
                    <span class="table-chip status"><%= statusLabel(s) %></span>
                  </td>
                  <td><span><%= noteShort(s.display_reason_ko || s.display_reason || s.reason || '-') %></span></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %>
          <div class="trade-empty">최근 신호가 없습니다.</div>
        <% } %>
      </div>
    </article>

    <aside class="trade-panel compact">
      <div class="trade-panel-head">
        <div>
          <div class="trade-panel-title">드롭 요약</div>
          <div class="trade-panel-sub">최근 필터링이 어디서 많이 발생하는지 봅니다.</div>
        </div>
      </div>
      <div class="trade-panel-body drop-list">
        <% if (topDropMarkets.length) { %>
          <% topDropMarkets.forEach((m) => { %>
            <div class="drop-row">
              <div class="label"><%= m.market || '-' %></div>
              <strong><%= fmtNum(m.total) %>건 · AI <%= fmtNum(m.ai_block) %>건</strong>
              <div class="meta"><%= (m.top_reasons || []).join(', ') || '상세 사유 없음' %></div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="trade-empty">최근 드롭이 없습니다.</div>
        <% } %>
      </div>
    </aside>
  </section>

  <section class="market-layout-grid">
    <article class="trade-panel compact">
      <div class="trade-panel-head">
        <div>
          <div class="trade-panel-title">마켓 실행 보드</div>
          <div class="trade-panel-sub">포지션, 최근 신호, 대기 주문, 즉시 조치를 한 줄에서 봅니다.</div>
        </div>
      </div>
      <div class="trade-panel-body">
        <table class="trade-table compact-record-table">
          <colgroup>
            <col style="width: 16%">
            <col style="width: 18%">
            <col style="width: 18%">
            <col style="width: 16%">
            <col style="width: 14%">
            <col style="width: 18%">
          </colgroup>
          <thead>
            <tr>
              <th>마켓</th>
              <th>포지션</th>
              <th>최근 신호</th>
              <th>대기</th>
              <th>최근 체결</th>
              <th>조치</th>
            </tr>
          </thead>
          <tbody>
            <% marketRows.forEach((r) => { %>
              <% const posSide = positionSideLabel(r); %>
              <% const pendingCount = Array.isArray(r.pending_intents) ? r.pending_intents.length : 0; %>
              <% const posActive = String(r.position_state || '').toUpperCase() === 'ACTIVE' || String(r.position_state || '').toUpperCase() === 'EXIT_ONLY'; %>
              <tr>
                <td><strong><%= r.market %></strong><span><%= r.tf || tf_default || '-' %></span></td>
                <td>
                  <span class="table-chip status"><%= positionStateLabel(r) %></span>
                  <% if (posSide) { %><span class="table-chip <%= posSide === '롱' ? 'long' : 'short' %>"><%= posSide %></span><% } %>
                  <span><%= r.position_size_pct != null ? `${fmtNum(r.position_size_pct, 0)}%` : '비중 없음' %> · <%= leverageText(r.position_leverage, r.position_leverage_tier) %></span>
                </td>
                <td>
                  <% if (r.last_signal) { %>
                    <span class="table-chip <%= eventTone(r.last_signal.event) %>"><%= eventLabel(r.last_signal.event) %></span>
                    <span class="table-chip soft"><%= sourceLabel(r.last_signal) %></span>
                    <span><%= fmtKst(r._view && r._view.last_signal_ts) %></span>
                  <% } else { %>
                    <span>신호 없음</span>
                  <% } %>
                </td>
                <td class="pending-cell">
                  <% if (pendingCount > 0) { %>
                    <div class="pending-stack">
                      <span class="subchip"><%= pendingCount %>건</span>
                    </div>
                  <% } else { %>
                    <span>없음</span>
                  <% } %>
                </td>
                <td class="right-align">
                  <% if (r.last_fill && r.last_fill.exec_price != null) { %>
                    <strong class="mono"><%= fmtPrice(r.last_fill.exec_price) %></strong>
                    <span><%= fmtKst(r._view && r._view.last_fill_ts) %></span>
                  <% } else { %>
                    <span>-</span>
                  <% } %>
                </td>
                <td>
                  <div class="action-stack">
                    <button class="action-btn cancel-pending-btn" data-market="<%= r.market %>" data-exchange="<%= exchange %>" data-pending-count="<%= pendingCount %>" <%= pendingCount ? '' : 'disabled' %>>대기 취소</button>
                    <button class="action-btn warn force-exit-btn" data-market="<%= r.market %>" data-exchange="<%= exchange %>" data-fraction="0.5" <%= posActive ? '' : 'disabled' %>>50% 정리</button>
                    <button class="action-btn bad force-exit-btn" data-market="<%= r.market %>" data-exchange="<%= exchange %>" data-fraction="1" <%= posActive ? '' : 'disabled' %>>전량 정리</button>
                  </div>
                </td>
              </tr>
            <% }) %>
            <% if (!marketRows.length) { %>
              <tr><td colspan="6" class="trade-empty">감시 중인 마켓이 없습니다.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </article>

    <aside class="side-stack">
      <section class="trade-panel compact">
        <div class="trade-panel-head">
          <div>
            <div class="trade-panel-title">레버리지 요약</div>
            <div class="trade-panel-sub">현재 감시 마켓의 레버리지 상태</div>
          </div>
        </div>
        <div class="trade-panel-body runtime-list">
          <div class="runtime-row">
            <div class="label">2x 마켓</div>
            <strong><%= leverage_summary && leverage_summary.tier_2x != null ? fmtNum(leverage_summary.tier_2x) : '-' %></strong>
            <div class="meta">활성 <%= leverage_summary && leverage_summary.active_markets != null ? fmtNum(leverage_summary.active_markets) : '-' %>개</div>
          </div>
          <div class="runtime-row">
            <div class="label">3x 마켓</div>
            <strong><%= leverage_summary && leverage_summary.tier_3x != null ? fmtNum(leverage_summary.tier_3x) : '-' %></strong>
            <div class="meta">기본 레버리지 <%= leverage_summary && leverage_summary.default_leverage != null ? leverage_summary.default_leverage : '-' %>x</div>
          </div>
          <div class="runtime-row">
            <div class="label">롤백 상태</div>
            <strong><%= rollback_summary && rollback_summary.rollback_active != null ? fmtNum(rollback_summary.rollback_active) : '-' %></strong>
            <div class="meta">최대 남은 시간 <%= rollback_summary && rollback_summary.max_remaining_ms != null ? fmtNum(Math.round(rollback_summary.max_remaining_ms / 60000)) : '-' %>분</div>
          </div>
        </div>
      </section>
    </aside>
  </section>

  <section class="fills-layout-grid">
    <article class="trade-panel compact">
      <div class="trade-panel-head">
        <div>
          <div class="trade-panel-title">최근 체결</div>
          <div class="trade-panel-sub">체결까지 내려온 거래만 따로 봅니다.</div>
        </div>
      </div>
      <div class="trade-panel-body">
        <% if (fillRows.length) { %>
          <table class="trade-table compact-record-table">
            <colgroup>
              <col style="width: 18%">
              <col style="width: 18%">
              <col style="width: 14%">
              <col style="width: 18%">
              <col style="width: 32%">
            </colgroup>
            <thead>
              <tr>
                <th>시각</th>
                <th>마켓</th>
                <th>방향</th>
                <th class="right-align">체결가</th>
                <th>메모</th>
              </tr>
            </thead>
            <tbody>
              <% fillRows.forEach((f) => { %>
                <tr>
                  <td class="mono"><%= fmtKst(f.created_kst || f.created_at) %></td>
                  <td><strong><%= f.symbol || f.symbol_or_pair_id || f.market || '-' %></strong><span><%= leverageText(f.leverage_applied, f.leverage_tier) %></span></td>
                  <td class="center-align"><span class="table-chip <%= eventTone(f.event) %>"><%= eventLabel(f.event) %></span></td>
                  <td class="right-align mono"><%= f.exec_price != null ? fmtPrice(f.exec_price) : '-' %></td>
                  <td><span><%= noteShort(f.display_exec_ko || f.display_exec_text || '-') %></span></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %>
          <div class="trade-empty">최근 체결이 없습니다.</div>
        <% } %>
      </div>
    </article>

    <aside class="trade-panel compact">
      <div class="trade-panel-head">
        <div>
          <div class="trade-panel-title">KPI 준비 상태</div>
          <div class="trade-panel-sub">실행 품질 지표 준비 상황</div>
        </div>
      </div>
      <div class="trade-panel-body runtime-list">
        <div class="runtime-row">
          <div class="label">준비 마켓</div>
          <strong><%= kpi_summary && kpi_summary.ready_markets != null ? fmtNum(kpi_summary.ready_markets) : '-' %> / <%= kpi_summary && kpi_summary.total_markets != null ? fmtNum(kpi_summary.total_markets) : '-' %></strong>
          <div class="meta">최소 표본 <%= kpi_summary && kpi_summary.kpi_min_n != null ? fmtNum(kpi_summary.kpi_min_n) : '-' %>건</div>
        </div>
        <div class="runtime-row">
          <div class="label">평균 승률</div>
          <strong><%= kpi_summary && kpi_summary.avg_win_rate != null ? fmtPct(kpi_summary.avg_win_rate) : '-' %></strong>
          <div class="meta">평균 EV <%= kpi_summary && kpi_summary.avg_ev != null ? fmtNum(kpi_summary.avg_ev, 2) : '-' %></div>
        </div>
        <div class="runtime-row">
          <div class="label">상태</div>
          <strong><%= kpi_summary && kpi_summary.status_text ? kpi_summary.status_text : '-' %></strong>
          <div class="meta">최근 계산 <%= kpi_summary && kpi_summary.last_computed_kst ? kpi_summary.last_computed_kst : '-' %></div>
        </div>
      </div>
    </aside>
  </section>
</section>

<script>
(function(){
  const buttons = Array.from(document.querySelectorAll('.force-exit-btn'));
  const cancelButtons = Array.from(document.querySelectorAll('.cancel-pending-btn'));
  if (!buttons.length && !cancelButtons.length) return;

  function notify(msg, ok){
    if (window.dbExchangeToast) {
      window.dbExchangeToast(msg, ok ? 'ok' : 'bad');
      return;
    }
    alert(msg);
  }

  function markButtonsRequested(btn, selector){
    const root = btn && btn.closest ? btn.closest('td') : null;
    const targets = root ? Array.from(root.querySelectorAll(selector)) : [btn];
    targets.forEach((b) => {
      if (!b) return;
      b.disabled = true;
      b.textContent = '요청됨';
    });
  }

  function updatePendingCell(btn){
    const row = btn && btn.closest ? btn.closest('tr') : null;
    if (!row) return;
    const cell = row.querySelector('.pending-cell');
    if (!cell) return;
    cell.innerHTML = '<span>없음</span>';
    const cancelBtn = row.querySelector('.cancel-pending-btn');
    if (cancelBtn) cancelBtn.disabled = true;
  }

  async function postForceExit(btn){
    const market = btn.getAttribute('data-market');
    const exchange = btn.getAttribute('data-exchange');
    const fraction = Number(btn.getAttribute('data-fraction'));
    const label = fraction >= 1 ? '전량' : '50%';
    if (!market || !Number.isFinite(fraction)) return;
    const ok = confirm(`[${market}] ${label} 정리를 요청할까요?`);
    if (!ok) return;
    btn.disabled = true;
    try{
      const res = await fetch('/api/trading/force-exit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ market, fraction, provider: exchange }),
      });
      const text = await res.text();
      let payload = null;
      try { payload = JSON.parse(text); } catch(_) { payload = null; }
      if (!res.ok || !payload || !payload.ok) {
        const msg = payload && payload.error ? payload.error : '요청 실패';
        notify(msg, false);
        return;
      }
      const when = payload.scheduled_exec_kst ? ` (예정 ${payload.scheduled_exec_kst})` : '';
      notify(`강제 정리 요청 완료${when}`, true);
      markButtonsRequested(btn, '.force-exit-btn');
    } catch (e) {
      notify('요청 중 오류가 발생했습니다', false);
    } finally {
      btn.disabled = false;
    }
  }

  async function postCancelPending(btn){
    const market = btn.getAttribute('data-market');
    const exchange = btn.getAttribute('data-exchange');
    const pendingCount = Number(btn.getAttribute('data-pending-count') || 0);
    if (!market) return;
    const label = pendingCount > 0 ? ` (${pendingCount}건)` : '';
    const ok = confirm(`[${market}] 대기 주문${label}을 모두 취소할까요?`);
    if (!ok) return;
    btn.disabled = true;
    try{
      const res = await fetch('/api/trading/cancel-pending', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ market, provider: exchange }),
      });
      const text = await res.text();
      let payload = null;
      try { payload = JSON.parse(text); } catch(_) { payload = null; }
      if (!res.ok || !payload || !payload.ok) {
        const msg = payload && payload.error ? payload.error : '요청 실패';
        notify(msg, false);
        return;
      }
      notify(`대기 주문 취소 완료 · ${payload.canceled || 0}건`, true);
      updatePendingCell(btn);
    } catch (e) {
      notify('요청 중 오류가 발생했습니다', false);
    } finally {
      btn.disabled = false;
    }
  }

  buttons.forEach((btn) => btn.addEventListener('click', () => postForceExit(btn)));
  cancelButtons.forEach((btn) => btn.addEventListener('click', () => postCancelPending(btn)));
})();
</script>

<%- include('partials/app_end_trader') %>
