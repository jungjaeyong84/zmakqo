<details class="details-block" style="margin-top:12px;" open>
  <summary>마켓 현황</summary>
  <div class="details-body">

<div class="tablewrap">
  <div class="head">
    <h2>마켓 목록</h2>
    <% if (budget_summary && budget_summary.enabled) { %>
      <div class="subtle">
        예산 합계:
        <span class="mono"><%= fmtKrw(budget_summary.total_used_krw) %></span>
        /
        <span class="mono"><%= fmtKrw(budget_summary.total_max_krw) %></span>
