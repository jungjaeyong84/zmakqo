<%- include('partials/app_start_unified', { title: '지금 · DONBEOLJA', pageTitle: '지금', active: 'home' }) %>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>

<%
  var budgetUnit = String(
    (budget_summary && budget_summary.unit) ||
    (budget_perf && budget_perf.unit) ||
    (String(exchange || '').includes('BINANCE') ? 'USDT' : 'KRW')
  ).toUpperCase();
  var todayPnl = home_profit_ranges && home_profit_ranges.today ? home_profit_ranges.today.total : null;
  var weeklyPnl = weekly_range_perf && weekly_range_perf.total_realized_krw != null ? weekly_range_perf.total_realized_krw : null;
  var totalAsset = (budget_summary && budget_summary.total_max_krw != null) ? budget_summary.total_max_krw : null;
  var riskPct = (budget_summary && budget_summary.total_used_pct != null) ? Number(budget_summary.total_used_pct) : null;
  var totalPnl = budget_perf && budget_perf.total_pnl_krw != null ? budget_perf.total_pnl_krw : null;
  var realizedPnl = budget_perf && budget_perf.total_realized_krw != null ? budget_perf.total_realized_krw : null;
  var signals = Array.isArray(signals12) ? signals12 : [];
  var fills = Array.isArray(fills12) ? fills12 : [];
  var positions = Array.isArray(typeof active_positions !== 'undefined' ? active_positions : []) ? (typeof active_positions !== 'undefined' ? active_positions : []) : [];
  var divergencePositions = positions.filter(function(p) {
    return p && p.exit_stage && Array.isArray(p.exit_stage.stop_divergence_codes) && p.exit_stage.stop_divergence_codes.length;
  });
  var topMarkets = Array.isArray(weekly_range_perf && weekly_range_perf.top3) ? weekly_range_perf.top3.slice(0, 4) : [];
  var quickMetrics = [
    { label: '오늘', value: home_profit_ranges && home_profit_ranges.today ? home_profit_ranges.today.total : null },
    { label: '7일', value: home_profit_ranges && home_profit_ranges.d7 ? home_profit_ranges.d7.total : null },
    { label: '30일', value: home_profit_ranges && home_profit_ranges.d30 ? home_profit_ranges.d30.total : null },
    { label: '전체', value: home_profit_ranges && home_profit_ranges.total ? home_profit_ranges.total.total : null },
  ];
  var systemGuards = (typeof system_runtime_guards !== 'undefined' && system_runtime_guards) ? system_runtime_guards : null;
  var systemGuardTone = systemGuards && systemGuards.circuit_breaker_open ? 'warn' : (systemGuards && systemGuards.block_new_entries ? 'warn' : 'ok');
  var systemGuardTitle = systemGuards
    ? (systemGuards.circuit_breaker_open ? '런타임 가드 차단' : (systemGuards.block_new_entries ? '런타임 가드 보류' : '런타임 가드 정상'))
    : '런타임 가드 확인 중';
  var systemGuardDetail = systemGuards
    ? [systemGuards.anomaly_reason || null, systemGuards.slo_reason || null].filter(Boolean).join(' · ')
    : '';
  var systemGuardRemediation = systemGuards && systemGuards.remediation ? systemGuards.remediation : null;
  var systemGuardWriterAuthority = systemGuards && systemGuards.writer_authority ? systemGuards.writer_authority : null;
  var systemGuardWriterTop = systemGuardWriterAuthority && Array.isArray(systemGuardWriterAuthority.remediation_candidates) && systemGuardWriterAuthority.remediation_candidates.length
    ? systemGuardWriterAuthority.remediation_candidates[0]
    : null;
  var missionHeroRaw = (typeof mission_control !== 'undefined' && mission_control && mission_control.hero) ? mission_control.hero : {};
  var statusKoMap = {
    'OBJECTIVE_RECOVERY_REQUIRED': '수익 회복 진행 중',
    'RECOVERY_CANARY_BLOCKED': '회복 대기 중',
    'HOLD': '자동매매 보류 중',
    'PASS': '자동매매 정상 운영 중',
    'READY': '자동매매 준비됨',
    'DEGRADED': '제한 운영 중',
  };
  var mTitle = missionHeroRaw.title || '';
  var missionHero = {
    title: statusKoMap[mTitle] || (mTitle.includes('_') ? '자동매매 운영 중' : mTitle) || '자동매매 운영 중',
    detail: missionHeroRaw.detail || '',
  };
  var dailySeries = (home_profit_ranges && home_profit_ranges.d7_daily)
    ? home_profit_ranges.d7_daily
    : (home_profit_ranges && home_profit_ranges.d7 && home_profit_ranges.d7.daily)
      ? home_profit_ranges.d7.daily : [];

  function fmtN(x, d) { var n = Number(x); if (!Number.isFinite(n)) return '-'; return n.toLocaleString(undefined, { minimumFractionDigits: d||2, maximumFractionDigits: d||2 }); }
  function fmtSigned(x) { var n = Number(x); if (!Number.isFinite(n)) return '-'; var t = (n>0?'+':'') + fmtN(n, budgetUnit==='USDT'?2:0) + ' USDT'; if (budgetUnit==='USDT') t += '<span class="krw-auto mono" data-usdt="'+n+'"></span>'; return t; }
  function fmtUnit(x) { var n = Number(x); if (!Number.isFinite(n)) return '-'; var t = fmtN(n, budgetUnit==='USDT'?2:0) + ' USDT'; if (budgetUnit==='USDT') t += '<span class="krw-auto mono" data-usdt="'+n+'"></span>'; return t; }
  function pnlCls(x) { var n = Number(x); if (!Number.isFinite(n)||n===0) return ''; return n>0?'profit-up':'profit-down'; }
  function eventKo(e) { var s = String(e||'').toUpperCase(); if (s==='LONG') return '매수'; if (s==='SHORT') return '매도'; if (s.includes('EXIT')||s.includes('TP')||s.includes('SL')) return '청산'; return s||'-'; }
  function eventCls(e) { var s = String(e||'').toUpperCase(); return s==='LONG'?'long':s==='SHORT'?'short':''; }
  function statusKo(sig) { if (!sig) return '-'; if (String(sig.signal_source||'').toUpperCase()==='DROP') return '건너뜀'; if (sig.exec_plan&&sig.exec_plan.status) { var s=String(sig.exec_plan.status_detail||sig.exec_plan.status).toUpperCase(); if(s==='FILLED') return '체결'; if(s==='PENDING') return '대기'; if(s.includes('REJECT')||s.includes('TIMEOUT')) return '실패'; if(s==='CANCELED') return '취소'; } return '수신'; }
  function statusCls(sig) { var s=statusKo(sig); if(s==='체결') return 'success'; if(s==='실패') return 'error'; if(s==='건너뜀'||s==='취소') return 'warning'; return 'filled'; }
  function fmtTime(s) { if(!s) return '-'; var raw=String(s); var m=raw.match(/(\d{2}-\d{2})\s+(\d{2}:\d{2})/); if(m) return m[1]+' '+m[2]; var ms=Date.parse(raw); if(!Number.isFinite(ms)) return raw; var d=new Date(ms+9*3600000); var p=function(n){return String(n).padStart(2,'0');}; return p(d.getUTCMonth()+1)+'-'+p(d.getUTCDate())+' '+p(d.getUTCHours())+':'+p(d.getUTCMinutes()); }
  function elapsed(iso) { if(!iso) return ''; var ms=Date.now()-Date.parse(iso); if(!Number.isFinite(ms)||ms<0) return ''; var m=Math.floor(ms/60000); if(m<60) return m+'분'; var h=Math.floor(m/60); if(h<24) return h+'시간'; return Math.floor(h/24)+'일'; }
  function sideKo(s) { return String(s||'').toUpperCase()==='LONG'?'매수':'매도'; }
  function fmtPct(x) { var n=Number(x); if(!Number.isFinite(n)) return '-'; return (n*100).toFixed(0)+'%'; }
%>

<style>
  .home-page { display: flex; flex-direction: column; gap: 24px; }
  .home-hero { text-align: center; padding: 32px 24px 24px; background: var(--md-surface); border: 1px solid var(--md-outline-variant); border-radius: var(--md-shape-lg); box-shadow: var(--md-elevation-1); }
  .home-hero-label { font-size: 13px; font-weight: 500; color: var(--md-on-surface-variant); margin-bottom: 6px; }
  .home-hero-value { font-family: var(--md-font-display); font-size: 40px; font-weight: 500; letter-spacing: -0.03em; line-height: 1.1; }
  .home-hero-value .krw { font-size: 15px; color: var(--md-on-surface-variant); font-weight: 400; }
  .home-sub { display: flex; justify-content: center; gap: 20px; margin-top: 10px; font-size: 13px; color: var(--md-on-surface-variant); flex-wrap: wrap; }
  .home-sub strong { color: var(--md-on-surface); font-weight: 500; }
  .home-main { display: grid; grid-template-columns: minmax(0, 1.2fr) 340px; gap: 24px; }
  .home-side { display: flex; flex-direction: column; gap: 16px; }
  .pnl-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .pnl-item { padding: 12px 14px; border: 1px solid var(--md-outline-variant); border-radius: var(--md-shape-md); background: var(--md-surface); }
  .pnl-item-label { font-size: 11px; font-weight: 500; color: var(--md-on-surface-variant); }
  .pnl-item-value { font-family: var(--md-font-display); font-size: 15px; font-weight: 500; margin-top: 4px; }
  .pos-card { display: grid; grid-template-columns: 56px 48px 1fr auto; gap: 8px; align-items: center; padding: 12px 16px; border: 1px solid var(--md-outline-variant); border-radius: var(--md-shape-md); background: var(--md-surface); }
  .pos-sym { font-weight: 600; font-size: 14px; }
  .pos-meta { font-size: 11px; color: var(--md-on-surface-variant); }
  .pos-meta.alert { color: var(--md-warning, #e65100); }
  .warn-card { border: 1px solid var(--md-warning, #f59e0b); background: color-mix(in srgb, var(--md-warning, #f59e0b) 8%, var(--md-surface)); }
  .warn-list { display:flex; flex-direction:column; gap:8px; }
  .warn-item { padding:10px 12px; border:1px solid var(--md-outline-variant); border-radius: var(--md-shape-md); background: var(--md-surface); }
  .warn-item-title { font-weight:600; font-size:13px; }
  .warn-item-meta { margin-top:4px; font-size:11px; color: var(--md-on-surface-variant); }
  .pos-pnl { font-weight: 500; font-size: 13px; text-align: right; }
  .trade-row { display: grid; grid-template-columns: 80px 44px 1fr auto; gap: 8px; align-items: center; padding: 8px 12px; border-radius: var(--md-shape-sm); }
  .trade-row:hover { background: var(--md-surface-container-low); }
  .trade-time { font-size: 11px; color: var(--md-on-surface-variant); font-family: var(--md-font-mono); }
  .trade-sym { font-weight: 500; font-size: 13px; }
  .status-row { display: flex; align-items: center; gap: 8px; padding: 12px 16px; border: 1px solid var(--md-outline-variant); border-radius: var(--md-shape-md); background: var(--md-surface); }
  .status-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .status-dot.ok { background: var(--md-success); }
  .status-dot.warn { background: var(--md-warning); }
  .spark-wrap { height: 56px; background: var(--md-surface); border: 1px solid var(--md-outline-variant); border-radius: var(--md-shape-md); padding: 6px 12px; }
  .side-item { display: grid; grid-template-columns: 1fr auto; gap: 8px; align-items: center; padding: 10px 14px; border: 1px solid var(--md-outline-variant); border-radius: var(--md-shape-md); }
  .side-item-name { font-weight: 500; font-size: 13px; }
  .side-item-meta { font-size: 11px; color: var(--md-on-surface-variant); }
  .side-item-value { font-weight: 500; font-size: 13px; text-align: right; }
  @media (max-width: 1024px) { .home-main { grid-template-columns: 1fr; } }
  @media (max-width: 768px) { .home-hero-value { font-size: 30px; } .pnl-grid { grid-template-columns: 1fr 1fr; } .home-sub { flex-direction: column; gap: 4px; align-items: center; } .pos-card { grid-template-columns: 48px 40px 1fr auto; } }
</style>

<div class="home-page">

  <!-- 히어로: 오늘 손익 -->
  <div class="home-hero">
    <div class="home-hero-label">오늘 손익</div>
    <div class="home-hero-value <%= pnlCls(todayPnl) %>" id="hero-today"><%- fmtSigned(todayPnl) %></div>
    <div class="home-sub">
      <span>총자산 <strong id="hero-total"><%- fmtUnit(totalAsset) %></strong></span>
      <span>이번주 <strong class="<%= pnlCls(weeklyPnl) %>"><%- fmtSigned(weeklyPnl) %></strong></span>
      <% if (riskPct != null) { %><span>사용률 <strong><%= (riskPct*100).toFixed(0) %>%</strong></span><% } %>
    </div>
  </div>

  <!-- 기간별 손익 + 스파크라인 -->
  <div class="pnl-grid">
    <% quickMetrics.forEach(function(q) { %>
      <div class="pnl-item">
        <div class="pnl-item-label"><%= q.label %></div>
        <div class="pnl-item-value <%= pnlCls(q.value) %>"><%- fmtSigned(q.value) %></div>
      </div>
    <% }) %>
  </div>

  <% if (dailySeries && dailySeries.length) { %>
    <div class="spark-wrap"><canvas id="spark-chart" height="40"></canvas></div>
  <% } %>

  <!-- 메인: 포지션+거래 / 사이드: 종목별+자금 -->
  <div class="home-main">
    <div>
      <!-- 진행 중인 포지션 -->
      <div class="card">
        <div class="card-header"><div><div class="card-title">진행 중인 포지션</div></div></div>
        <div class="card-body" style="display:flex;flex-direction:column;gap:8px">
          <% if (positions.length) { positions.forEach(function(p) { %>
            <div class="pos-card">
              <div class="pos-sym"><%= (p.symbol||'-').replace('USDT','') %></div>
              <div><span class="chip sm <%= p.side==='LONG'?'long':'short' %>"><%= sideKo(p.side) %></span></div>
              <div>
                <div class="pos-meta"><%= p.avg_price ? fmtN(p.avg_price,2) : '-' %><% if (elapsed(p.entry_at)) { %> &middot; <%= elapsed(p.entry_at) %><% } %></div>
                <% if (p.exit_stage && p.exit_stage.canonical_exit_stage) { %>
                  <div class="pos-meta <%= p.exit_stage.stop_divergence ? 'alert' : '' %>">
                    <%= p.exit_stage.canonical_exit_stage %>
                    <% if (p.exit_stage.canonical_runner_remaining_abs != null) { %> · rem <%= fmtN(p.exit_stage.canonical_runner_remaining_abs, 3) %><% } %>
                    <% if (p.exit_stage.chosen_stop_source || p.exit_stage.chosen_stop_price != null) { %>
                      · <%= p.exit_stage.chosen_stop_source || '-' %> <%= p.exit_stage.chosen_stop_price != null ? fmtN(p.exit_stage.chosen_stop_price, 2) : '-' %>
                    <% } %>
                  </div>
                <% } %>
              </div>
              <div class="pos-pnl <%= pnlCls(p.pnl_pct) %>"><%= p.pnl_pct!=null ? (p.pnl_pct>0?'+':'')+(p.pnl_pct*100).toFixed(2)+'%' : '-' %></div>
            </div>
          <% }) } else { %>
            <div style="text-align:center;padding:16px;color:var(--md-on-surface-variant);font-size:13px">진행 중인 포지션 없음</div>
          <% } %>
        </div>
      </div>

      <!-- 최근 거래 -->
      <div class="card" style="margin-top:16px">
        <div class="card-header">
          <div><div class="card-title">최근 거래</div></div>
          <a href="/dashboard/trading" class="btn btn-text sm">전체 보기 &rarr;</a>
        </div>
        <div class="card-body">
          <% if (signals.length) { %>
            <div style="display:flex;flex-direction:column;gap:4px">
              <% signals.slice(0,5).forEach(function(sig) { %>
                <div class="trade-row">
                  <div class="trade-time"><%= fmtTime(sig.created_kst || sig.created_at) %></div>
                  <div class="trade-sym"><%= (sig.symbol||'-').replace('USDT','') %></div>
                  <div><span class="chip sm <%= eventCls(sig.event) %>"><%= eventKo(sig.event) %></span></div>
                  <div><span class="chip sm <%= statusCls(sig) %>"><%= statusKo(sig) %></span></div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div style="text-align:center;padding:16px;color:var(--md-on-surface-variant);font-size:13px">아직 거래 기록이 없습니다</div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- 사이드 -->
    <div class="home-side">
      <div class="card <%= divergencePositions.length ? 'warn-card' : '' %>">
        <div class="card-header">
          <div>
            <div class="card-title">청산 무결성</div>
            <div class="card-subtitle"><%= divergencePositions.length ? (divergencePositions.length + '개 심볼 경고') : '실시간 divergence 없음' %></div>
          </div>
          <a href="/dashboard/trading" class="btn btn-text sm">상세 &rarr;</a>
        </div>
        <div class="card-body">
          <% if (divergencePositions.length) { %>
            <div class="warn-list">
              <% divergencePositions.slice(0, 4).forEach(function(p) { %>
                <div class="warn-item">
                  <div class="warn-item-title"><%= (p.symbol||'-').replace('USDT','') %> <%= p.side === 'LONG' ? '매수' : '매도' %></div>
                  <div class="warn-item-meta">
                    canon <%= p.exit_stage.canonical_exit_stage || '-' %>
                    <% if (p.exit_stage.chosen_stop_source || p.exit_stage.chosen_stop_price != null) { %>
                      · chosen <%= p.exit_stage.chosen_stop_source || '-' %> <%= p.exit_stage.chosen_stop_price != null ? fmtN(p.exit_stage.chosen_stop_price, 2) : '-' %>
                    <% } %>
                    · floor <%= p.exit_stage.runner_floor_stop != null ? fmtN(p.exit_stage.runner_floor_stop, 2) : '-' %>
                    · r <%= p.exit_stage.trail_stop_by_r != null ? fmtN(p.exit_stage.trail_stop_by_r, 2) : '-' %>
                    · native <%= p.exit_stage.native_stop_price != null ? fmtN(p.exit_stage.native_stop_price, 2) : '-' %>
                  </div>
                  <div style="display:flex; flex-wrap:wrap; gap:6px; margin-top:6px;">
                    <% var divergenceItems = (Array.isArray(p.exit_stage.stop_divergence_items) && p.exit_stage.stop_divergence_items.length) ? p.exit_stage.stop_divergence_items : (p.exit_stage.stop_divergence_codes || []).map(function(code) { return { display: code }; }); %>
                    <% divergenceItems.forEach(function(item) { %>
                      <span class="chip sm warning"><%= item.display %></span>
                    <% }) %>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div style="text-align:center;padding:12px;color:var(--md-on-surface-variant);font-size:13px">현재 활성 포지션 기준 divergence 없음</div>
          <% } %>
        </div>
      </div>

      <!-- 종목별 수익 -->
      <div class="card">
        <div class="card-header"><div><div class="card-title">종목별 수익</div><div class="card-subtitle">이번 주</div></div></div>
        <div class="card-body" style="display:flex;flex-direction:column;gap:6px">
          <% if (topMarkets.length) { topMarkets.forEach(function(row) { %>
            <div class="side-item">
              <div>
                <div class="side-item-name"><%= (row.market||'-').replace('USDT','') %></div>
                <div class="side-item-meta">비중 <%= row.share_pct!=null ? fmtPct(row.share_pct) : '-' %></div>
              </div>
              <div class="side-item-value <%= pnlCls(row.realized_krw) %>"><%- fmtSigned(row.realized_krw) %></div>
            </div>
          <% }) } else { %>
            <div style="text-align:center;padding:12px;color:var(--md-on-surface-variant);font-size:13px">데이터 부족</div>
          <% } %>
        </div>
      </div>

      <!-- 자금 요약 -->
      <div class="card">
        <div class="card-header"><div><div class="card-title">자금 요약</div></div></div>
        <div class="card-body" style="display:flex;flex-direction:column;gap:8px">
          <div class="side-item">
            <div><div class="side-item-meta">총 손익</div></div>
            <div class="side-item-value <%= pnlCls(totalPnl) %>"><%- fmtSigned(totalPnl) %></div>
          </div>
          <div class="side-item">
            <div><div class="side-item-meta">실현 손익</div></div>
            <div class="side-item-value <%= pnlCls(realizedPnl) %>"><%- fmtSigned(realizedPnl) %></div>
          </div>
          <div class="side-item">
            <div><div class="side-item-meta">주간 체결</div></div>
            <div class="side-item-value"><%= weekly_range_perf && weekly_range_perf.trades_n != null ? fmtN(weekly_range_perf.trades_n, 0) : '-' %>건</div>
          </div>
        </div>
      </div>

      <div class="status-row">
        <span class="status-dot <%= systemGuardTone %>"></span>
        <strong style="font-size:13px"><%= systemGuardTitle %></strong>
        <% if (systemGuardRemediation && (systemGuardRemediation.remediated_positions > 0 || systemGuardRemediation.skipped === true)) { %>
          <span class="body-sm" style="color:var(--md-on-surface-variant)">
            <%= systemGuardRemediation.skipped === true
              ? '조치 없음'
              : ('flatten ' + systemGuardRemediation.remediated_positions + '건') %>
          </span>
        <% } %>
        <% if (systemGuardDetail) { %>
          <span style="flex:1"></span>
          <span class="body-sm" style="color:var(--md-on-surface-variant)"><%= systemGuardDetail %></span>
        <% } else if (systemGuardWriterTop) { %>
          <span style="flex:1"></span>
        <% } %>
        <% if (systemGuardWriterTop) { %>
          <span class="body-sm" style="color:var(--md-on-surface-variant)">
            writer authority <%= systemGuardWriterTop.symbol %> <%= systemGuardWriterTop.count %>건
          </span>
        <% } %>
      </div>

      <!-- 자동매매 상태 -->
      <div class="status-row">
        <span class="status-dot <%= missionHero.title.includes('정상') ? 'ok' : 'warn' %>"></span>
        <strong style="font-size:13px"><%= missionHero.title %></strong>
        <span style="flex:1"></span>
        <a href="/dashboard/recovery" class="body-sm" style="color:var(--md-primary)">상세 &rarr;</a>
      </div>
    </div>
  </div>

</div>

<%- include('partials/app_end_unified') %>

<script>
(function(){
  var canvas = document.getElementById('spark-chart');
  if (!canvas || typeof Chart === 'undefined') return;
  var raw = <%- JSON.stringify(dailySeries || []) %>;
  if (!raw.length) return;
  new Chart(canvas, {
    type: 'line',
    data: { labels: raw.map(function(d){return d.day||''}), datasets: [{ data: raw.map(function(d){return d.pnl||d.value||0}), borderColor: '#1a73e8', backgroundColor: 'rgba(26,115,232,0.08)', fill: true, tension: 0.3, pointRadius: 0, borderWidth: 2 }] },
    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }, tooltip: { enabled: false } }, scales: { x: { display: false }, y: { display: false } } }
  });
})();
</script>
<script>
(function(){
  var exchange = '<%= String(exchange||'').toUpperCase()||'BINANCEFUT' %>';
  var heroTotal = document.getElementById('hero-total');
  function fmtV(x){var n=Number(x);return Number.isFinite(n)?n.toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2})+' USDT':'-';}
  function fmtK(x){var n=Number(x);if(!Number.isFinite(n))return '';var sign=n<0?'-':'';return '(\u2248'+sign+Math.round(Math.abs(n)).toLocaleString()+'\uc6d0)';}
  function applyAllKrw(rate){
    document.querySelectorAll('.krw-auto[data-usdt]').forEach(function(el){
      var v=Number(el.dataset.usdt);
      el.textContent = Number.isFinite(v)&&Number.isFinite(rate) ? fmtK(v*rate) : '';
    });
  }
  var _rate=null;
  fetch('https://open.er-api.com/v6/latest/USD').then(function(r){return r.json()}).then(function(j){
    if(j&&j.rates&&j.rates.KRW){ _rate=j.rates.KRW; applyAllKrw(_rate); }
  }).catch(function(){});
  fetch('/api/account/summary?exchange='+encodeURIComponent(exchange)).then(function(r){return r.json()}).then(function(j){
    if(!j||!j.ok)return;
    var total=j.total_value!=null?j.total_value:j.total_usdt;
    if(heroTotal&&Number.isFinite(Number(total))){heroTotal.textContent=fmtV(total);if(_rate)heroTotal.textContent+=fmtK(Number(total)*_rate);}
  }).catch(function(){});
})();
</script>
<script src="/js/realtime.js"></script>
<script>initRealtime('<%= String(exchange||'').toUpperCase()||'BINANCEFUT' %>');</script>
