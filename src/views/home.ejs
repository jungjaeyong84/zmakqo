        <div class="k">충족 마켓</div>
        <div class="v mono"><%= (tp_status && tp_status.ready_markets && tp_status.ready_markets.length) ? tp_status.ready_markets.join(', ') : '-' %></div>
        <div class="k">마감 시각</div>
        <div class="v mono"><%= tp_status && tp_status.latest_exec_kst ? tp_status.latest_exec_kst : '-' %></div>
