        <div style="display:flex; gap:6px; flex-wrap:wrap;">
          <% (intent_failures.top || []).forEach((x)=>{ %>
            <span class="pill bad"><%= x.reason %> · <%= fmtNum(x.count) %></span>
          <% }) %>
        </div>
        <% if (intent_failures.recent && intent_failures.recent.length) { %>
