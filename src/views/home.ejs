<%- include('partials/app_start_trader', { title: '홈 · DONBEOLJA Trader', pageTitle: '홈', active: 'home' }) %>

<%
  const budgetUnit = String(
    (budget_summary && budget_summary.unit) ||
    (budget_perf && budget_perf.unit) ||
    (String(exchange || '').includes('BINANCE') ? 'USDT' : 'KRW')
  ).toUpperCase();
  const signals = Array.isArray(signals12) ? signals12 : [];
  const fills = Array.isArray(fills12) ? fills12 : [];
  const latestSignal = signals.length ? signals[0] : null;
  const latestFill = fills.length ? fills[0] : null;
  const missionHero = mission_control && mission_control.hero ? mission_control.hero : {};
  const missionHeroPills = Array.isArray(missionHero.pills) ? missionHero.pills.slice(0, 4) : [];
  const missionMetrics = mission_control && Array.isArray(mission_control.metrics) ? mission_control.metrics.slice(0, 6) : [];
  const riskUsedPct = (budget_summary && budget_summary.total_used_pct != null) ? Number(budget_summary.total_used_pct) : null;
  const accountTotalInitial = (budget_summary && budget_summary.total_max_krw != null) ? budget_summary.total_max_krw : null;
  const accountUsedInitial = (budget_summary && budget_summary.total_used_krw != null) ? budget_summary.total_used_krw : null;
  const accountAvailableInitial = (accountTotalInitial != null && accountUsedInitial != null)
    ? Number(accountTotalInitial) - Number(accountUsedInitial)
    : null;
  const weeklyRealizedInitial = weekly_range_perf && weekly_range_perf.total_realized_krw != null
    ? weekly_range_perf.total_realized_krw
    : null;
  const topMarkets = Array.isArray(weekly_range_perf && weekly_range_perf.top3) ? weekly_range_perf.top3.slice(0, 4) : [];
  const quickMetrics = [
    { label: '오늘 손익', value: home_profit_ranges && home_profit_ranges.today ? home_profit_ranges.today.total : null },
    { label: '7일 손익', value: home_profit_ranges && home_profit_ranges.d7 ? home_profit_ranges.d7.total : null },
    { label: '30일 손익', value: home_profit_ranges && home_profit_ranges.d30 ? home_profit_ranges.d30.total : null },
    { label: '6개월 손익', value: home_profit_ranges && home_profit_ranges.m6 ? home_profit_ranges.m6.total : null },
    { label: '총 손익', value: home_profit_ranges && home_profit_ranges.total ? home_profit_ranges.total.total : null },
  ];
  const signalPreview = signals.slice(0, 6);
  const signalLongN = signalPreview.filter((signal) => String(signal && signal.event || '').toUpperCase() === 'LONG').length;
  const signalShortN = signalPreview.filter((signal) => String(signal && signal.event || '').toUpperCase() === 'SHORT').length;
  const signalCoreN = signalPreview.filter((signal) => String(signal && signal.entry_grade || '').toUpperCase() === 'CORE').length;
  const signalEarlyN = signalPreview.filter((signal) => String(signal && signal.entry_grade || '').toUpperCase() === 'EARLY').length;
  const signalServerN = signalPreview.filter((signal) => signal && signal.source !== 'PINE_SHADOW').length;
  const signalShadowN = signalPreview.filter((signal) => signal && signal.source === 'PINE_SHADOW').length;
  const signalDirectionTotal = Math.max(signalPreview.length, 1);
  const signalLongPct = (signalLongN / signalDirectionTotal) * 100;
  const signalShortPct = (signalShortN / signalDirectionTotal) * 100;
  const signalCorePct = (signalCoreN / signalDirectionTotal) * 100;
  const signalServerPct = (signalServerN / signalDirectionTotal) * 100;

  function fmtNum(x, digits = 2) {
    const n = Number(x);
    if (!Number.isFinite(n)) return '-';
    return n.toLocaleString(undefined, { minimumFractionDigits: digits, maximumFractionDigits: digits });
  }
  function fmtPct(x) {
    const n = Number(x);
    if (!Number.isFinite(n)) return '-';
    return (n * 100).toFixed(0) + '%';
  }
  function fmtKst(s) {
    if (!s) return '-';
    const raw = String(s);
    if (raw.includes('KST')) return raw;
    const ms = Date.parse(raw);
    if (!Number.isFinite(ms)) return raw;
    const d = new Date(ms + 9 * 60 * 60 * 1000);
    const pad = (n) => String(n).padStart(2, '0');
    return `${pad(d.getUTCMonth() + 1)}-${pad(d.getUTCDate())} ${pad(d.getUTCHours())}:${pad(d.getUTCMinutes())}`;
  }
  function pnlTone(x) {
    const n = Number(x);
    if (!Number.isFinite(n) || n === 0) return 'profit-neutral';
    return n > 0 ? 'profit-up' : 'profit-down';
  }
  function eventDisplay(event) {
    const s = String(event || '').toUpperCase();
    if (s === 'LONG') return '롱';
    if (s === 'SHORT') return '숏';
    return s || '-';
  }
  function gradeDisplay(signal) {
    const g = signal && signal.entry_grade ? String(signal.entry_grade).toUpperCase() : '';
    if (g === 'CORE') return '코어';
    if (g === 'EARLY') return '얼리';
    return '-';
  }
  function sourceDisplay(signal) {
    if (!signal) return '-';
    return signal.source === 'PINE_SHADOW' ? 'Pine 비교' : '서버 정본';
  }
  function sourceShort(signal) {
    if (!signal) return '-';
    return signal.source === 'PINE_SHADOW' ? 'Pine' : '서버';
  }
  function statusDisplay(signal) {
    if (!signal) return '-';
    if (signal.exec_plan && signal.exec_plan.status) {
      const s = String(signal.exec_plan.status).toUpperCase();
      if (s === 'PENDING') return '주문 대기';
      if (s === 'FILLED') return '체결 완료';
      if (s === 'CANCELED') return '취소';
      return s;
    }
    return '수신';
  }
  function fillMemoDisplay(fill) {
    if (!fill) return '-';
    const raw = String(fill.display_exec_ko || fill.display_exec_text || '-');
    if (raw.length <= 26) return raw;
    return raw.slice(0, 26) + '...';
  }
  function renderUnitValue(value, opts = {}) {
    const n = Number(value);
    if (!Number.isFinite(n)) return '-';
    const digits = budgetUnit === 'USDT' ? 2 : 0;
    const txt = fmtNum(n, digits) + ' ' + budgetUnit;
    if (!opts.krwHint || budgetUnit !== 'USDT') return txt;
    return txt + ` <span class="mono home-krw-hint" data-usdt="${n}">(≈ - KRW)</span>`;
  }
  function renderSignedUnitValue(value, opts = {}) {
    const n = Number(value);
    if (!Number.isFinite(n)) return '-';
    const sign = n > 0 ? '+' : '';
    const digits = budgetUnit === 'USDT' ? 2 : 0;
    const txt = sign + fmtNum(n, digits) + ' ' + budgetUnit;
    if (!opts.krwHint || budgetUnit !== 'USDT') return txt;
    return txt + ` <span class="mono home-krw-hint" data-usdt="${n}">(≈ - KRW)</span>`;
  }
%>

<style>
  .trader-home {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .overview-shell {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 16px;
  }
  .overview-sidecard,
  .capital-card,
  .market-card,
  .ops-card,
  .snapshot-card,
  .signal-card,
  .fill-card,
  .profit-card,
  .kpi-card {
    border-radius: 20px;
  }
  .overview-line {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }
  .overview-mini-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 12px;
  }
  .overview-mini {
    padding: 11px 12px;
    border: 1px solid var(--trade-border);
    border-radius: 14px;
    background: #fbfcfd;
  }
  .overview-mini .label,
  .kpi-card .label,
  .metric-card .label,
  .summary-item .label {
    color: var(--trade-muted);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .07em;
  }
  .overview-mini .value,
  .kpi-card .value,
  .metric-card .value,
  .summary-item .value {
    margin-top: 6px;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: -.04em;
  }
  .overview-mini .meta,
  .kpi-card .meta,
  .metric-card .meta,
  .summary-item .meta {
    margin-top: 6px;
    font-size: 11px;
    color: var(--trade-muted);
    line-height: 1.45;
  }
  .summary-item .value {
    font-size: 16px;
  }

  .kpi-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }
  .kpi-card {
    padding: 14px 15px;
    background: linear-gradient(180deg, #ffffff 0%, #fbfcfe 100%);
    border: 1px solid var(--trade-border);
  }
  .kpi-card .value {
    font-size: 16px;
  }

  .workspace-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) 320px;
    gap: 16px;
  }
  .trade-panel.compact .trade-panel-head {
    margin-bottom: 10px;
  }
  .trade-panel.compact .trade-panel-body {
    padding-top: 0;
  }
  .trade-panel-title {
    font-size: 15px;
    font-weight: 800;
    letter-spacing: -.03em;
  }
  .trade-panel-sub {
    margin-top: 3px;
    color: var(--trade-muted);
    font-size: 11px;
    line-height: 1.5;
  }
  .signal-table td strong,
  .fill-table td strong {
    display: block;
    font-size: 11px;
  }
  .signal-table td span,
  .fill-table td span {
    display: block;
    margin-top: 3px;
    color: var(--trade-muted);
    font-size: 10px;
  }
  .table-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 8px;
    border-radius: 999px;
    font-size: 10px;
    font-weight: 700;
    border: 1px solid var(--trade-border);
    background: #fff;
    white-space: nowrap;
  }
  .table-chip.long { color: var(--trade-up); background: #eef8f2; border-color: #cbe8d6; }
  .table-chip.short { color: var(--trade-down); background: #fdf1f0; border-color: #f3cbc7; }
  .table-chip.core { color: #8a6303; background: #fff4d7; border-color: #ead8a2; }
  .table-chip.soft {
    color: var(--trade-muted);
    background: #f7f8fa;
  }
  .table-chip.status {
    color: #3f4954;
    background: #f4f6f8;
  }
  .signal-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    padding: 0 0 12px;
  }
  .signal-balance {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 10px 11px;
    border: 1px solid var(--trade-border);
    border-radius: 14px;
    background: #fbfcfd;
  }
  .signal-balance-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .signal-balance-head strong {
    font-size: 11px;
    letter-spacing: -.02em;
  }
  .signal-balance-head span {
    color: var(--trade-muted);
    font-size: 10px;
  }
  .signal-balance-bar {
    height: 8px;
    border-radius: 999px;
    overflow: hidden;
    background: #eef1f4;
    display: flex;
  }
  .signal-balance-bar span.long { background: linear-gradient(90deg, #8de0b0 0%, var(--trade-up) 100%); }
  .signal-balance-bar span.short { background: linear-gradient(90deg, #ffb2ac 0%, var(--trade-down) 100%); }
  .signal-balance-bar span.core { background: linear-gradient(90deg, #f0d486 0%, #cc9a1c 100%); }
  .signal-balance-bar span.early { background: linear-gradient(90deg, #cde1ff 0%, #86b0f4 100%); }
  .signal-balance-bar span.server { background: linear-gradient(90deg, #8de0b0 0%, var(--trade-up) 100%); }
  .signal-balance-bar span.shadow { background: linear-gradient(90deg, #e8d39a 0%, #c99618 100%); }
  .signal-balance-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    color: var(--trade-muted);
    font-size: 10px;
    font-weight: 700;
  }
  .compact-log-table th,
  .compact-log-table td {
    padding-top: 8px;
    padding-bottom: 8px;
  }
  .compact-log-table td.market-cell strong {
    font-size: 11px;
    letter-spacing: -.02em;
  }
  .compact-log-table td.market-cell span {
    margin-top: 2px;
    font-size: 9px;
  }
  .compact-log-table td.center-cell {
    text-align: center;
  }
  .compact-log-table td.right-cell,
  .compact-log-table th.right-cell {
    text-align: right;
  }
  .compact-log-table .signal-stack,
  .compact-log-table .state-stack {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  .compact-log-table .mono.muted {
    color: var(--trade-muted);
    font-size: 10px;
  }
  .compact-log-table .memo-cell {
    color: var(--trade-muted);
    font-size: 10px;
    line-height: 1.45;
  }

  .side-stack {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .summary-list,
  .market-list,
  .ops-list,
  .snapshot-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .summary-item,
  .market-row,
  .ops-row,
  .snapshot-row {
    padding: 10px 12px;
    border-radius: 14px;
    border: 1px solid var(--trade-border);
    background: #fbfcfd;
  }
  .snapshot-row strong,
  .market-row strong,
  .ops-row strong {
    display: block;
    font-size: 12px;
  }
  .snapshot-row span,
  .market-row span,
  .ops-row span {
    display: block;
    margin-top: 4px;
    color: var(--trade-muted);
    font-size: 10px;
    line-height: 1.45;
  }
  .performance-grid,
  .bottom-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) 320px;
    gap: 16px;
  }
  .metric-row {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
  }
  .metric-card {
    padding: 12px;
    border: 1px solid var(--trade-border);
    border-radius: 16px;
    background: linear-gradient(180deg, #ffffff 0%, #fbfcfd 100%);
  }
  .metric-card .value {
    font-size: 15px;
  }
  .market-row,
  .ops-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 10px;
    align-items: center;
  }
  .market-row .value,
  .ops-row .value {
    font-size: 11px;
    font-weight: 700;
    text-align: right;
  }

  @media (max-width: 1240px) {
    .overview-shell,
    .workspace-grid,
    .performance-grid,
    .bottom-grid { grid-template-columns: 1fr; }
    .kpi-strip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .metric-row { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .signal-strip { grid-template-columns: 1fr; }
  }
  @media (max-width: 860px) {
    .overview-mini-grid,
    .metric-row,
    .kpi-strip { grid-template-columns: 1fr; }
    .overview-title { font-size: 24px; }
  }
</style>

<section class="trader-home">
  <section class="overview-shell">
    <section class="trade-panel overview-sidecard compact soft">
      <div class="trade-panel-head">
        <div>
          <div class="trade-panel-title">전략 상태 요약</div>
          <div class="trade-panel-sub">현재 자동 전략과 서버 우선 전환 상태</div>
        </div>
      </div>
      <div class="trade-panel-body">
        <div class="summary-item">
          <div class="label">현재 상태</div>
          <div class="value"><%= missionHero.title || '서버 우선 전환 진행 중' %></div>
          <div class="meta"><%= missionHero.detail || '정본 신호는 서버 기준, Pine는 비교용 shadow를 유지합니다.' %></div>
        </div>
        <div class="overview-line">
          <span class="trade-chip gold">서버 정본</span>
          <span class="trade-chip soft">Pine 비교</span>
        </div>
        <div class="overview-mini-grid">
          <% if (missionHeroPills.length) { %>
            <% missionHeroPills.forEach((pill) => { %>
              <div class="overview-mini">
                <div class="label"><%= pill.label %></div>
                <div class="value"><%= pill.value || '-' %></div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="overview-mini">
              <div class="label">소스</div>
              <div class="value">서버 정본</div>
            </div>
            <div class="overview-mini">
              <div class="label">비교</div>
              <div class="value">Pine Shadow</div>
            </div>
          <% } %>
        </div>
      </div>
    </section>

    <section class="trade-panel snapshot-card compact">
      <div class="trade-panel-head">
        <div>
          <div class="trade-panel-title">실시간 스냅샷</div>
          <div class="trade-panel-sub">가장 최근 신호와 체결</div>
        </div>
      </div>
      <div class="trade-panel-body snapshot-list">
        <div class="snapshot-row">
          <strong>최근 신호</strong>
          <% if (latestSignal) { %>
            <span><%= latestSignal.symbol || '-' %> · <%= eventDisplay(latestSignal.event) %> · <%= gradeDisplay(latestSignal) %></span>
            <span><%= sourceDisplay(latestSignal) %> · <%= statusDisplay(latestSignal) %> · <%= fmtKst(latestSignal.created_kst || latestSignal.created_at) %></span>
          <% } else { %>
            <span>최근 신호가 없습니다.</span>
          <% } %>
        </div>
        <div class="snapshot-row">
          <strong>최근 체결</strong>
          <% if (latestFill) { %>
            <span><%= latestFill.symbol || '-' %> · <%= eventDisplay(latestFill.event) %> · <%= latestFill.exec_price != null ? fmtNum(latestFill.exec_price, 2) : '-' %></span>
            <span><%= latestFill.display_exec_ko || latestFill.display_exec_text || '체결' %> · <%= fmtKst(latestFill.created_kst || latestFill.created_at) %></span>
          <% } else { %>
            <span>최근 체결이 없습니다.</span>
          <% } %>
        </div>
      </div>
    </section>
  </section>

  <section class="kpi-strip">
    <article class="kpi-card">
      <div class="label">현재 총자산</div>
      <div class="value profit-neutral" id="acc-total-value"><%- renderUnitValue(accountTotalInitial, { krwHint: true }) %></div>
      <div class="meta">실시간 계좌 요약 기준</div>
    </article>
    <article class="kpi-card">
      <div class="label" id="acc-cash-label">가용 자금</div>
      <div class="value profit-neutral" id="acc-cash-value"><%- renderUnitValue(accountAvailableInitial, { krwHint: true }) %></div>
      <div class="meta" id="acc-note">계좌 요약 불러오는 중</div>
    </article>
    <article class="kpi-card">
      <div class="label">총 손익</div>
      <div class="value <%= pnlTone(budget_perf && budget_perf.total_pnl_krw) %>"><%- renderSignedUnitValue(budget_perf && budget_perf.total_pnl_krw, { krwHint: true }) %></div>
      <div class="meta">실현 <%- renderSignedUnitValue(budget_perf && budget_perf.total_realized_krw, { krwHint: true }) %> · 미실현 <%- renderSignedUnitValue(budget_perf && budget_perf.total_unrealized_krw, { krwHint: true }) %></div>
    </article>
    <article class="kpi-card">
      <div class="label">주간 실현손익</div>
      <div class="value <%= pnlTone(weeklyRealizedInitial) %>"><%- renderSignedUnitValue(weeklyRealizedInitial, { krwHint: true }) %></div>
      <div class="meta">사용률 <%= riskUsedPct != null ? fmtPct(riskUsedPct) : '-' %></div>
    </article>
  </section>

  <section class="performance-grid">
    <article class="trade-panel profit-card compact">
      <div class="trade-panel-head">
        <div>
          <div class="trade-panel-title">쉬운 수익 카테고리</div>
          <div class="trade-panel-sub">수익 페이지에서 가장 읽기 쉬운 구조만 가져왔습니다.</div>
        </div>
      </div>
      <div class="trade-panel-body">
        <div class="metric-row">
          <% quickMetrics.forEach((item) => { %>
            <div class="metric-card">
              <div class="label"><%= item.label %></div>
              <div class="value <%= pnlTone(item.value) %>"><%- renderSignedUnitValue(item.value, { krwHint: true }) %></div>
              <div class="meta">기간별 손익 요약</div>
            </div>
          <% }) %>
        </div>
      </div>
    </article>

    <aside class="trade-panel capital-card compact">
      <div class="trade-panel-head">
        <div>
          <div class="trade-panel-title">자금과 손익</div>
          <div class="trade-panel-sub">핵심 숫자만 다시 묶었습니다.</div>
        </div>
      </div>
      <div class="trade-panel-body">
        <div class="summary-list">
          <div class="summary-item">
            <div class="label">사용 중 자금</div>
            <div class="value profit-neutral"><%- renderUnitValue(accountUsedInitial, { krwHint: true }) %></div>
            <div class="meta">사용률 <%= riskUsedPct != null ? fmtPct(riskUsedPct) : '-' %></div>
          </div>
          <div class="summary-item">
            <div class="label">주간 체결 수</div>
            <div class="value"><%= weekly_range_perf && weekly_range_perf.trades_n != null ? fmtNum(weekly_range_perf.trades_n, 0) : '-' %>건</div>
            <div class="meta">이번 주 실현손익과 함께 봅니다.</div>
          </div>
        </div>
      </div>
    </aside>
  </section>

  <section class="workspace-grid">
    <article class="trade-panel signal-card compact">
      <div class="trade-panel-head">
        <div>
          <div class="trade-panel-title">최근 신호</div>
          <div class="trade-panel-sub">홈에서는 최근 흐름만 짧게 읽고, 자세한 내용은 거래기록으로 내려갑니다.</div>
        </div>
        <a class="trade-btn" href="/dashboard/trading">전체 보기</a>
      </div>
      <div class="trade-panel-body">
        <% if (signals.length) { %>
          <div class="signal-strip">
            <div class="signal-balance">
              <div class="signal-balance-head">
                <strong>방향</strong>
                <span>롱 <%= signalLongN %> · 숏 <%= signalShortN %></span>
              </div>
              <div class="signal-balance-bar">
                <span class="long" style="width:<%= signalLongPct %>%"></span>
                <span class="short" style="width:<%= signalShortPct %>%"></span>
              </div>
              <div class="signal-balance-meta"><span>최근 6개 신호 기준</span></div>
            </div>
            <div class="signal-balance">
              <div class="signal-balance-head">
                <strong>등급</strong>
                <span>코어 <%= signalCoreN %> · 얼리 <%= signalEarlyN %></span>
              </div>
              <div class="signal-balance-bar">
                <span class="core" style="width:<%= signalCorePct %>%"></span>
                <span class="early" style="width:<%= 100 - signalCorePct %>%"></span>
              </div>
              <div class="signal-balance-meta"><span>진입 강도 분포</span></div>
            </div>
            <div class="signal-balance">
              <div class="signal-balance-head">
                <strong>원천</strong>
                <span>서버 <%= signalServerN %> · Pine <%= signalShadowN %></span>
              </div>
              <div class="signal-balance-bar">
                <span class="server" style="width:<%= signalServerPct %>%"></span>
                <span class="shadow" style="width:<%= 100 - signalServerPct %>%"></span>
              </div>
              <div class="signal-balance-meta"><span>정본과 비교 신호 비율</span></div>
            </div>
          </div>
          <table class="trade-table signal-table">
            <colgroup>
              <col style="width: 18%">
              <col style="width: 22%">
              <col style="width: 24%">
              <col style="width: 36%">
            </colgroup>
            <thead>
              <tr>
                <th>시각</th>
                <th>마켓</th>
                <th>신호</th>
                <th>상태</th>
              </tr>
            </thead>
            <tbody class="compact-log-table">
              <% signals.slice(0, 6).forEach((signal) => { %>
                <tr>
                  <td class="mono muted"><%= fmtKst(signal.created_kst || signal.created_at) %></td>
                  <td class="market-cell"><strong><%= signal.symbol || '-' %></strong><span><%= signal.market || signal.timeframe || '-' %></span></td>
                  <td>
                    <div class="signal-stack">
                      <span class="table-chip <%= String(signal.event || '').toLowerCase() %>"><%= eventDisplay(signal.event) %></span>
                      <span class="table-chip <%= gradeDisplay(signal) === '코어' ? 'core' : 'soft' %>"><%= gradeDisplay(signal) %></span>
                    </div>
                  </td>
                  <td>
                    <div class="state-stack">
                      <span class="table-chip soft"><%= sourceShort(signal) %></span>
                      <span class="table-chip status"><%= statusDisplay(signal) %></span>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %>
          <div class="trade-empty">최근 신호가 아직 없습니다.</div>
        <% } %>
      </div>
    </article>

    <aside class="side-stack">
      <section class="trade-panel market-card compact">
        <div class="trade-panel-head">
          <div>
            <div class="trade-panel-title">주간 기여 마켓</div>
            <div class="trade-panel-sub">이번 주 손익에 영향을 준 마켓</div>
          </div>
        </div>
        <div class="trade-panel-body">
          <div class="market-list">
            <% if (topMarkets.length) { %>
              <% topMarkets.forEach((row) => { %>
                <div class="market-row">
                  <div>
                    <strong><%= row.market || '-' %></strong>
                    <span>기여도 <%= row.share_pct != null ? fmtPct(row.share_pct) : '-' %></span>
                  </div>
                  <div class="value <%= pnlTone(row.realized_krw) %>"><%- renderSignedUnitValue(row.realized_krw, { krwHint: true }) %></div>
                </div>
              <% }) %>
            <% } else { %>
              <div class="trade-empty">주간 기여 마켓 데이터가 아직 부족합니다.</div>
            <% } %>
          </div>
        </div>
      </section>

    </aside>
  </section>

  <section class="bottom-grid">
    <article class="trade-panel fill-card compact">
      <div class="trade-panel-head">
        <div>
          <div class="trade-panel-title">최근 체결</div>
          <div class="trade-panel-sub">실제로 체결까지 이어진 거래만 짧게 봅니다.</div>
        </div>
      </div>
      <div class="trade-panel-body">
        <% if (fills.length) { %>
          <table class="trade-table fill-table">
            <colgroup>
              <col style="width: 18%">
              <col style="width: 20%">
              <col style="width: 16%">
              <col style="width: 16%">
              <col style="width: 30%">
            </colgroup>
            <thead>
              <tr>
                <th>시각</th>
                <th>마켓</th>
                <th>방향</th>
                <th class="right-cell">체결가</th>
                <th>메모</th>
              </tr>
            </thead>
            <tbody class="compact-log-table">
              <% fills.slice(0, 6).forEach((fill) => { %>
                <tr>
                  <td class="mono muted"><%= fmtKst(fill.created_kst || fill.created_at) %></td>
                  <td class="market-cell"><strong><%= fill.symbol || '-' %></strong><span><%= fill.market || '-' %></span></td>
                  <td class="center-cell"><span class="table-chip <%= String(fill.event || '').toLowerCase() %>"><%= eventDisplay(fill.event) %></span></td>
                  <td class="right-cell mono"><%= fill.exec_price != null ? fmtNum(fill.exec_price, 2) : '-' %></td>
                  <td class="memo-cell"><%= fillMemoDisplay(fill) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %>
          <div class="trade-empty">최근 체결이 없습니다.</div>
        <% } %>
      </div>
    </article>

    <aside class="trade-panel ops-card compact">
      <div class="trade-panel-head">
        <div>
          <div class="trade-panel-title">전략 진행 상황</div>
          <div class="trade-panel-sub">전환과 자동 조치 상태를 짧게 읽습니다.</div>
        </div>
      </div>
      <div class="trade-panel-body">
        <div class="ops-list">
          <% if (missionMetrics.length) { %>
            <% missionMetrics.forEach((metric) => { %>
              <div class="ops-row">
                <div>
                  <strong><%= metric.label %></strong>
                  <span><%= metric.meta || '자동 전략 상태 요약' %></span>
                </div>
                <div class="value"><%= metric.value || '-' %></div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="trade-empty">전략 진행 요약 데이터를 불러오는 중입니다.</div>
          <% } %>
        </div>
      </div>
    </aside>
  </section>
</section>

<%- include('partials/app_end_trader') %>

<script>
(function(){
  const totalEl = document.getElementById('acc-total-value');
  const cashEl = document.getElementById('acc-cash-value');
  const noteEl = document.getElementById('acc-note');
  const cashLabelEl = document.getElementById('acc-cash-label');
  const exchange = '<%= String(exchange || '').toUpperCase() || 'BINANCEFUT' %>';

  const fmtValue = (x, unit) => {
    const n = Number(x);
    if (!Number.isFinite(n)) return '-';
    if (unit === 'USDT') {
      return n.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
    return (Math.trunc(n / 10) * 10).toLocaleString();
  };
  const fmtKrwApprox = (x) => {
    const n = Number(x);
    if (!Number.isFinite(n)) return '-';
    const sign = n < 0 ? '-' : '';
    return sign + (Math.trunc(Math.abs(n) / 10) * 10).toLocaleString();
  };
  const getUsdtKrwRate = (() => {
    let cached = null;
    let inflight = null;
    return () => {
      if (cached) return Promise.resolve(cached);
      if (inflight) return inflight;
      inflight = fetch('https://open.er-api.com/v6/latest/USD')
        .then((r) => r.json())
        .then((fx) => {
          const usdKrw = fx && fx.rates ? Number(fx.rates.KRW) : NaN;
          if (!Number.isFinite(usdKrw) || usdKrw <= 0) return null;
          cached = usdKrw;
          return cached;
        })
        .catch(() => null)
        .finally(() => { inflight = null; });
      return inflight;
    };
  })();
  const applyUsdtKrw = (rate) => {
    const targets = document.querySelectorAll('.home-krw-hint[data-usdt]');
    targets.forEach((el) => {
      const raw = Number(el.dataset.usdt);
      if (!Number.isFinite(raw) || !Number.isFinite(rate)) {
        el.textContent = '(≈ - KRW)';
        return;
      }
      el.textContent = `(≈ ${fmtKrwApprox(raw * rate)} KRW)`;
    });
  };

  getUsdtKrwRate().then((rate) => {
    if (rate) applyUsdtKrw(rate);
  });

  fetch('/api/account/summary?exchange=' + encodeURIComponent(exchange))
    .then((r) => r.json())
    .then((j) => {
      if (!j || !j.ok) {
        if (noteEl) noteEl.textContent = '불러오기 실패';
        return;
      }
      const unit = String(j.unit || (exchange.includes('BINANCE') ? 'USDT' : 'KRW')).toUpperCase();
      const totalVal = (j.total_value != null) ? j.total_value : (unit === 'USDT' ? j.total_usdt : j.total_krw);
      const cashVal = (j.cash_value != null) ? j.cash_value : (unit === 'USDT' ? j.cash_usdt : j.cash_krw);
      const totalText = fmtValue(totalVal, unit) + ' ' + unit;
      const cashText = fmtValue(cashVal, unit) + ' ' + unit;
      if (totalEl) totalEl.textContent = totalText;
      if (cashEl) cashEl.textContent = cashText;
      if (cashLabelEl) cashLabelEl.textContent = '가용 자금';
      if (noteEl) {
        const missing = Array.isArray(j.missing_markets) && j.missing_markets.length
          ? '가격 미확인: ' + j.missing_markets.join(', ')
          : '정상';
        noteEl.textContent = missing;
      }
      if (unit === 'USDT') {
        getUsdtKrwRate().then((rate) => {
          if (!rate) return;
          if (totalEl && Number.isFinite(Number(totalVal))) {
            totalEl.textContent = `${totalText} (≈ ${fmtKrwApprox(Number(totalVal) * rate)} KRW)`;
          }
          if (cashEl && Number.isFinite(Number(cashVal))) {
            cashEl.textContent = `${cashText} (≈ ${fmtKrwApprox(Number(cashVal) * rate)} KRW)`;
          }
          applyUsdtKrw(rate);
        });
      }
    })
    .catch(() => {
      if (noteEl) noteEl.textContent = '불러오기 실패';
    });
})();
</script>
