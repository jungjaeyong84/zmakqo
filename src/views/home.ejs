  @media (max-width: 1280px) {
    .metric-strip { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .pipeline-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 1080px) {
    .hero-grid,
    .board-grid,
    .split-grid { grid-template-columns: 1fr; }
    .hero-micro { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 720px) {
    .hero-title { font-size: 34px; }
    .summary-value { font-size: 38px; }
    .metric-strip,
    .bootstrap-metrics,
    .runtime-grid,
    .summary-grid,
    .pipeline-grid { grid-template-columns: 1fr; }
    .timeline-row { grid-template-columns: 1fr; }
  }
</style>

<div class="local-board">
  <section class="hero-grid">
    <article class="board-surface hero-panel">
      <div class="hero-eyebrow">Local dashboard / v3 paper runtime</div>
      <h2 class="hero-title">로컬 종이매매 운영 흐름을 한 화면에서 정리했습니다.</h2>
      <p class="hero-copy">기존 홈 화면의 거래, 손익, 시스템 가드 정보는 유지하고, 로컬에서 실제로 도는 <strong>v3 paper lane</strong>, 최근 cycle, bootstrap edge, 청산 무결성을 같은 문맥에서 읽게 재구성했습니다.</p>

      <div class="hero-meta">
        <span class="hero-badge"><strong><%= exchange || 'BINANCEFUT' %></strong></span>
        <span class="hero-badge">runtime <strong><%= runtimeMode %></strong></span>
        <span class="hero-badge">exec <strong><%= executionMode %></strong></span>
        <span class="hero-badge">mode <strong><%= liveLabel %></strong></span>
        <span class="tone-pill <%= badgeTone(guardState) %>">guard <strong><%= statusLabel(guardState) %></strong></span>
      </div>

      <div class="hero-actions">
        <a class="btn btn-filled sm" href="/dashboard/trading">거래기록</a>
        <a class="btn btn-outlined sm" href="/dashboard/profit">수익 분석</a>
        <a class="btn btn-outlined sm" href="/dashboard/recovery">자동화 상태</a>
        <a class="btn btn-outlined sm" href="/dashboard/protection/view">보호주문</a>
      </div>

      <div class="hero-micro">
        <% quickMetrics.forEach(function(item) { %>
          <div class="micro-card">
            <div class="metric-label"><%= item.label %></div>
            <div class="micro-value <%= toneClass(item.value) %>"><%= fmtSignedUnit(item.value) %></div>
          </div>
        <% }) %>
      </div>

      <% if (sparkPoints.length) { %>
        <div class="spark-grid">
          <% sparkPoints.forEach(function(point) { var pointValue = n(point.value) || 0; var heightPct = Math.max(8, Math.round((Math.abs(pointValue) / sparkMaxAbs) * 100)); %>
            <div class="spark-col">
              <div class="spark-value <%= toneClass(pointValue) %>"><%= pointValue === 0 ? '0' : fmtN(pointValue, unitLabel === 'USDT' ? 2 : 0) %></div>
              <div class="spark-bar">
                <div class="spark-track">
                  <div class="spark-fill <%= pointValue < 0 ? 'down' : '' %>" style="height:<%= heightPct %>%"></div>
                </div>
              </div>
              <div class="spark-day"><%= point.label %></div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </article>

    <article class="board-surface summary-panel">
      <div>
        <div class="summary-label">오늘 손익</div>
        <div class="summary-value <%= toneClass(todayPnl) %>"><%= fmtSignedUnit(todayPnl) %></div>
        <div class="summary-subtext">
          총자산 <strong><%= fmtUnit(totalAsset) %></strong>
          <% if (weeklyPnl != null) { %>
            · 이번주 <strong class="<%= toneClass(weeklyPnl) %>"><%= fmtSignedUnit(weeklyPnl) %></strong>
          <% } %>
          <% if (riskPct != null) { %>
            · 사용률 <strong><%= (riskPct * 100).toFixed(0) %>%</strong>
          <% } %>
        </div>
      </div>

      <div class="summary-grid">
        <div class="summary-box">
          <div class="label">v3 cycle</div>
          <div class="value"><%= statusLabel(v3CycleLatest && v3CycleLatest.ok ? 'OK' : (v3CycleLatest && v3CycleLatest.rc != null ? 'HOLD' : 'CHECK')) %></div>
          <div class="meta"><%= v3CycleLatest && v3CycleLatest.ts ? formatTime(v3CycleLatest.ts) + ' · ' + formatAgo(v3CycleLatest.ts) : '최근 cycle 기록 없음' %></div>
        </div>
        <div class="summary-box">
          <div class="label">bootstrap</div>
          <div class="value"><%= bootstrapRecommendation === 'KEEP_SHADOW_ONLY' ? 'shadow' : bootstrapRecommendation.toLowerCase() %></div>
          <div class="meta">retained <%= v3Bootstrap.retained_sample_n != null ? fmtN(v3Bootstrap.retained_sample_n, 0) : '-' %> / sample <%= v3Bootstrap.source_sample_n != null ? fmtN(v3Bootstrap.source_sample_n, 0) : '-' %></div>
        </div>
        <div class="summary-box">
          <div class="label">runtime guard</div>
          <div class="value"><%= statusLabel(guardState) %></div>
          <div class="meta"><%= guardMessage || '정상 운영 중' %></div>
        </div>
        <div class="summary-box">
          <div class="label">last signal</div>
          <div class="value"><%= latestSignalsAt ? formatTime(latestSignalsAt) : '-' %></div>
          <div class="meta"><%= latestSignalsAt ? formatAgo(latestSignalsAt) : '최근 신호 없음' %></div>
        </div>
      </div>
    </article>
  </section>

  <section class="metric-strip">
    <article class="board-surface metric-card">
      <div class="metric-label">허용 신호</div>
      <div class="metric-value"><%= v3Lane.allowed_signal_n != null ? fmtN(v3Lane.allowed_signal_n, 0) : '-' %></div>
      <div class="metric-note">최근 lane 기준 active candidate 수</div>
    </article>
    <article class="board-surface metric-card">
      <div class="metric-label">v3 오픈 포지션</div>
      <div class="metric-value"><%= v3Perf.open_position_n != null ? fmtN(v3Perf.open_position_n, 0) : '-' %></div>
      <div class="metric-note">entry ledger 대비 아직 종료되지 않은 포지션</div>
    </article>
    <article class="board-surface metric-card">
      <div class="metric-label">오늘 종료</div>
      <div class="metric-value"><%= v3Perf.today_closed_trade_n != null ? fmtN(v3Perf.today_closed_trade_n, 0) : '-' %></div>
      <div class="metric-note">오늘 KST 기준 close 된 paper trade</div>
    </article>
    <article class="board-surface metric-card">
      <div class="metric-label">live R WR <span class="badge"><%= bootstrapLiveGate.hit ? 'HIT' : 'MISS' %></span></div>
      <div class="metric-value <%= bootstrapLiveGate.hit ? 'up' : 'down' %>"><%= bootstrapLiveGate.win_rate_pct != null ? fmtPlainPct(bootstrapLiveGate.win_rate_pct, 2) : '-' %></div>
      <div class="metric-note">v3 진짜 표본 (n=<%= bootstrapLiveGate.sample_n != null ? fmtN(bootstrapLiveGate.sample_n, 0) : '-' %>) · 목표 ≥55%</div>
    </article>
    <article class="board-surface metric-card">
      <div class="metric-label">static USDT WR <span class="badge"><%= bootstrapStaticGate.hit ? 'HIT' : 'MISS' %></span></div>
      <div class="metric-value <%= bootstrapStaticGate.hit ? 'up' : 'down' %>"><%= bootstrapStaticGate.win_rate_pct != null ? fmtPlainPct(bootstrapStaticGate.win_rate_pct, 2) : '-' %></div>
      <div class="metric-note">외부 holdout (n=<%= bootstrapStaticGate.sample_n != null ? fmtN(bootstrapStaticGate.sample_n, 0) : '-' %>) · 목표 ≥55%</div>
    </article>
    <article class="board-surface metric-card">
      <div class="metric-label">청산 경고</div>
      <div class="metric-value <%= divergencePositions.length ? 'down' : 'up' %>"><%= fmtN(divergencePositions.length, 0) %></div>
      <div class="metric-note">stop divergence 감지된 runtime 포지션 수</div>
    </article>
  </section>

  <section class="board-grid">
    <div class="panel-stack">
      <article class="board-surface board-panel">
        <div class="panel-head">
          <div>
            <div class="panel-eyebrow">Pipeline</div>
            <h3 class="panel-title">v3 paper cycle</h3>
            <p class="panel-copy">lane → entry ledger → exit ledger → performance 순서로 180초마다 도는 로컬 파이프라인입니다.</p>
          </div>
          <div class="badge-row">
            <span class="tone-pill <%= badgeTone(v3CycleLatest && v3CycleLatest.ok ? 'OK' : (v3CycleLatest && v3CycleLatest.rc != null ? 'HOLD' : 'CHECK')) %>"><%= v3CycleLatest && v3CycleLatest.ts ? formatAgo(v3CycleLatest.ts) : 'cycle 없음' %></span>
          </div>
        </div>
        <div class="pipeline-grid">
          <div class="stage-card">
            <div class="stage-name">Lane</div>
            <div class="stage-stat"><%= v3Lane.allowed_signal_n != null ? fmtN(v3Lane.allowed_signal_n, 0) : '-' %></div>
            <div class="stage-meta">source <%= v3Lane.source_signal_n != null ? fmtN(v3Lane.source_signal_n, 0) : '-' %> · blocked <%= v3Lane.blocked_signal_n != null ? fmtN(v3Lane.blocked_signal_n, 0) : '-' %></div>
            <div class="stage-foot reason-row">
              <% topReasonList(v3BlockedReasons, 2).forEach(function(item) { %>
                <span class="reason-pill"><%= item.key %> · <%= item.value %></span>
              <% }) %>
              <% if (!countKeys(v3BlockedReasons)) { %><span class="reason-pill">blocked reason 없음</span><% } %>
            </div>
          </div>
          <div class="stage-card">
            <div class="stage-name">Entry Ledger</div>
            <div class="stage-stat"><%= v3Entry.open_position_n != null ? fmtN(v3Entry.open_position_n, 0) : '-' %></div>
            <div class="stage-meta">queue <%= v3Entry.source_queue_n != null ? fmtN(v3Entry.source_queue_n, 0) : '-' %> · appended <%= v3Entry.appended_entry_n != null ? fmtN(v3Entry.appended_entry_n, 0) : '-' %></div>
            <div class="stage-foot"><span class="reason-pill"><%= v3Entry.generated_at ? formatTime(v3Entry.generated_at) : 'entry latest 없음' %></span></div>
          </div>
          <div class="stage-card">
            <div class="stage-name">Exit Ledger</div>
            <div class="stage-stat"><%= v3Exit.remaining_open_position_n != null ? fmtN(v3Exit.remaining_open_position_n, 0) : '-' %></div>
            <div class="stage-meta">eligible <%= v3Exit.eligible_open_entry_n != null ? fmtN(v3Exit.eligible_open_entry_n, 0) : '-' %> · appended <%= v3Exit.appended_exit_n != null ? fmtN(v3Exit.appended_exit_n, 0) : '-' %></div>
            <div class="stage-foot"><span class="reason-pill">live price symbols <%= v3Exit.live_price_symbol_n != null ? fmtN(v3Exit.live_price_symbol_n, 0) : '-' %></span></div>
          </div>
          <div class="stage-card">
            <div class="stage-name">Performance</div>
            <div class="stage-stat"><%= v3Perf.today_closed_trade_n != null ? fmtN(v3Perf.today_closed_trade_n, 0) : '-' %></div>
            <div class="stage-meta">today win rate <%= v3Perf.today_metrics_r && v3Perf.today_metrics_r.win_rate_pct != null ? fmtPlainPct(v3Perf.today_metrics_r.win_rate_pct, 2) : '-' %> · all-time sample <%= v3Perf.all_time_metrics_r && v3Perf.all_time_metrics_r.sample_n != null ? fmtN(v3Perf.all_time_metrics_r.sample_n, 0) : '-' %></div>
            <div class="stage-foot"><span class="reason-pill"><%= v3Perf.generated_at ? formatTime(v3Perf.generated_at) : 'performance latest 없음' %></span></div>
          </div>
        </div>
      </article>

      <article class="board-surface board-panel">
        <div class="panel-head">
          <div>
            <div class="panel-eyebrow">Edge Filter</div>
            <h3 class="panel-title">bootstrap retained edge</h3>
            <p class="panel-copy">기존 결과 표본에서 어떤 코호트를 남기고 무엇을 버릴지 정리한 bootstrap 결과입니다.</p>
          </div>
          <div class="badge-row">
            <span class="tone-pill <%= bootstrapTargetHit ? 'ok' : 'bad' %>"><%= bootstrapTargetHit ? 'GATE_PASS' : 'GATE_FAIL' %></span>
            <span class="tone-pill <%= badgeTone(bootstrapRecommendation) %>"><%= bootstrapRecommendation %></span>
          </div>
        </div>
        <div class="bootstrap-metrics">
          <div class="bootstrap-box">
            <div class="metric-label">baseline WR (혼합)</div>
            <div class="value"><%= v3Bootstrap.baseline_metrics && v3Bootstrap.baseline_metrics.win_rate_pct != null ? fmtPlainPct(v3Bootstrap.baseline_metrics.win_rate_pct, 2) : '-' %></div>
            <div class="metric-note" style="margin-top:6px;">정책 적용 전 표본</div>
          </div>
          <div class="bootstrap-box">
            <div class="metric-label">live R WR <span style="font-size:11px;color:<%= bootstrapLiveGate.hit ? '#137a4b' : '#b43224' %>">[<%= bootstrapLiveGate.hit ? 'HIT' : 'MISS' %>]</span></div>
            <div class="value <%= bootstrapLiveGate.hit ? 'up' : 'down' %>"><%= bootstrapLiveGate.win_rate_pct != null ? fmtPlainPct(bootstrapLiveGate.win_rate_pct, 2) : '-' %></div>
            <div class="metric-note" style="margin-top:6px;">v3 표본 n=<%= bootstrapLiveGate.sample_n != null ? fmtN(bootstrapLiveGate.sample_n, 0) : '-' %> · expectancy <%= bootstrapLiveGate.expectancy_r != null ? fmtN(bootstrapLiveGate.expectancy_r, 4) : '-' %>R</div>
          </div>
          <div class="bootstrap-box">
            <div class="metric-label">static USDT WR <span style="font-size:11px;color:<%= bootstrapStaticGate.hit ? '#137a4b' : '#b43224' %>">[<%= bootstrapStaticGate.hit ? 'HIT' : 'MISS' %>]</span></div>
            <div class="value <%= bootstrapStaticGate.hit ? 'up' : 'down' %>"><%= bootstrapStaticGate.win_rate_pct != null ? fmtPlainPct(bootstrapStaticGate.win_rate_pct, 2) : '-' %></div>
            <div class="metric-note" style="margin-top:6px;">외부 holdout n=<%= bootstrapStaticGate.sample_n != null ? fmtN(bootstrapStaticGate.sample_n, 0) : '-' %> · expectancy <%= bootstrapStaticGate.expectancy_usdt != null ? fmtN(bootstrapStaticGate.expectancy_usdt, 4) : '-' %> USDT</div>
          </div>
          <div class="bootstrap-box">
            <div class="metric-label">combined outcome WR <span style="font-size:11px;color:#6f675b">[참고]</span></div>
            <div class="value"><%= v3Bootstrap.retained_metrics && v3Bootstrap.retained_metrics.win_rate_pct != null ? fmtPlainPct(v3Bootstrap.retained_metrics.win_rate_pct, 2) : '-' %></div>
            <div class="metric-note" style="margin-top:6px;">단순 평균 · 게이트 판단 미사용</div>
          </div>
        </div>
        <div class="metric-note" style="margin-top:10px;">목표: live R WR ≥ 55% <strong>AND</strong> static USDT WR ≥ 55% (둘 다 충족 시 GATE_PASS)</div>
        <div class="reason-row" style="margin-top:16px;">
          <% topReasonList(bootstrapRemovedReasons, 4).forEach(function(item) { %>
            <span class="reason-pill"><%= item.key %> · <%= item.value %></span>
          <% }) %>
          <% if (!countKeys(bootstrapRemovedReasons)) { %><span class="reason-pill">제외 사유 데이터 없음</span><% } %>
        </div>
      </article>

      <article class="board-surface board-panel">
        <div class="panel-head">
          <div>
            <div class="panel-eyebrow">Positions</div>
            <h3 class="panel-title">runtime vs v3 paper</h3>
            <p class="panel-copy">실제 runtime active position과 v3 paper ledger의 open position을 같이 비교할 수 있게 나눴습니다.</p>
          </div>
        </div>
        <div class="split-grid">
          <div class="subpanel">
            <div class="subpanel-title">runtime active positions</div>
            <div class="list-stack">
              <% if (positions.length) { positions.slice(0, 6).forEach(function(pos) { %>
                <div class="row-card">
                  <div class="row-head">
                    <div class="row-title"><%= shortSym(pos.symbol) %> · <%= sideLabel(pos.side) %></div>
                    <span class="tone-pill <%= pos.exit_stage && pos.exit_stage.stop_divergence ? 'bad' : 'ok' %>"><%= pos.exit_stage && pos.exit_stage.canonical_exit_stage ? pos.exit_stage.canonical_exit_stage : 'ACTIVE' %></span>
                  </div>
                  <div class="row-meta">avg <%= pos.avg_price != null ? fmtN(pos.avg_price, 2) : '-' %> · lev <%= pos.leverage != null ? fmtN(pos.leverage, 2) + 'x' : '-' %> · entered <%= formatAgo(pos.entry_at) || '-' %></div>
                  <div class="row-submeta runtime-pnl <%= toneClass(pos.pnl_pct) %>"><%= pos.pnl_pct != null ? fmtPlainPct(pos.pnl_pct * 100, 2) : '-' %></div>
                </div>
              <% }) } else { %>
                <div class="empty-state">현재 runtime active position이 없습니다.</div>
              <% } %>
            </div>
          </div>

          <div class="subpanel">
            <div class="subpanel-title">v3 paper open positions</div>
            <div class="list-stack">
              <% if (v3OpenPositions.length) { v3OpenPositions.slice(0, 6).forEach(function(pos) { %>
                <div class="row-card">
                  <div class="row-head">
                    <div class="row-title"><%= shortSym(pos.symbol) %> · <%= sideLabel(pos.side) %></div>
                    <span class="tone-pill ok">OPEN</span>
                  </div>
                  <div class="row-meta">setup <%= pos.setup_type || '-' %> · grade <%= pos.entry_grade || '-' %> · tf <%= pos.tf || '-' %></div>
                  <div class="row-submeta">created <%= formatTime(pos.created_at) %> · signal <%= pos.signal_price != null ? fmtN(pos.signal_price, 4) : '-' %></div>
                </div>
              <% }) } else { %>
                <div class="empty-state">v3 paper ledger에 열린 포지션이 없습니다.</div>
              <% } %>
            </div>
          </div>
        </div>
      </article>

      <article class="board-surface board-panel">
        <div class="panel-head">
          <div>
            <div class="panel-eyebrow">Feed</div>
            <h3 class="panel-title">recent signal & fill tape</h3>
            <p class="panel-copy">홈 화면에서 가장 자주 보는 최근 신호와 체결만 두 개의 짧은 테이프로 유지했습니다.</p>
          </div>
        </div>
        <div class="split-grid">
          <div class="subpanel">
            <div class="subpanel-title">최근 신호</div>
            <div class="list-stack">
              <% if (signals.length) { signals.slice(0, 6).forEach(function(sig) { %>
                <div class="row-card">
                  <div class="row-head">
                    <div class="row-title"><%= shortSym(sig.symbol) %> · <%= eventLabel(sig.event) %></div>
                    <span class="tone-pill neutral"><%= sig.exec_plan && sig.exec_plan.status ? sig.exec_plan.status : 'SIGNAL' %></span>
                  </div>
                  <div class="row-meta"><%= formatTime(sig.created_kst || sig.created_at) %> · <%= sig.tf || '-' %> · <%= sig.display_reason_ko || sig.display_reason_stage_label || sig.display_reason_primary || '-' %></div>
                </div>
              <% }) } else { %>
                <div class="empty-state">최근 신호가 없습니다.</div>
              <% } %>
            </div>
          </div>
          <div class="subpanel">
            <div class="subpanel-title">최근 체결</div>
            <div class="list-stack">
              <% if (fills.length) { fills.slice(0, 6).forEach(function(fill) { %>
                <div class="row-card">
                  <div class="row-head">
                    <div class="row-title"><%= shortSym(fill.symbol) %> · <%= eventLabel(fill.event) %></div>
                    <span class="tone-pill neutral"><%= fill.leverage_applied != null ? fmtN(fill.leverage_applied, 1) + 'x' : 'fill' %></span>
                  </div>
                  <div class="row-meta"><%= formatTime(fill.created_kst || fill.created_at) %> · price <%= fill.exec_price != null ? fmtN(fill.exec_price, 4) : '-' %></div>
                  <div class="row-submeta"><%= fill.display_exec_ko || fill.display_exec_text || fill.decision_reason || '-' %></div>
                </div>
              <% }) } else { %>
                <div class="empty-state">최근 체결이 없습니다.</div>
              <% } %>
            </div>
          </div>
        </div>
      </article>
    </div>

    <aside class="panel-stack">
      <article class="board-surface board-panel">
        <div class="panel-head">
          <div>
            <div class="panel-eyebrow">System</div>
            <h3 class="panel-title">runtime health</h3>
            <p class="panel-copy">실행 환경, guard, 최신 시그널/체결 시간을 요약합니다.</p>
          </div>
        </div>
        <div class="runtime-grid">
          <div class="runtime-chip">
            <div class="metric-label">runtime</div>
            <div class="value"><%= runtimeMode %></div>
          </div>
          <div class="runtime-chip">
            <div class="metric-label">engine</div>
            <div class="value"><%= engineVersion %></div>
          </div>
          <div class="runtime-chip">
            <div class="metric-label">execution</div>
            <div class="value"><%= executionMode %></div>
          </div>
          <div class="runtime-chip">
            <div class="metric-label">live gate</div>
            <div class="value"><%= liveLabel %></div>
          </div>
          <div class="runtime-chip">
            <div class="metric-label">latest signal</div>
            <div class="value"><%= latestSignalsAt ? formatTime(latestSignalsAt) : '-' %></div>
          </div>
          <div class="runtime-chip">
            <div class="metric-label">latest fill</div>
            <div class="value"><%= latestFillsAt ? formatTime(latestFillsAt) : '-' %></div>
          </div>
        </div>
        <div class="reason-row" style="margin-top:16px;">
          <span class="tone-pill <%= badgeTone(guardState) %>">guard <%= statusLabel(guardState) %></span>
          <% if (system_settings && system_settings.futures_leverage != null) { %><span class="reason-pill">default leverage <%= fmtN(system_settings.futures_leverage, 1) %>x</span><% } %>
          <% if (signal_tf) { %><span class="reason-pill">signal tf <%= signal_tf %></span><% } %>
          <% if (exec_tf) { %><span class="reason-pill">exec tf <%= exec_tf %></span><% } %>
        </div>
        <div class="row-submeta" style="margin-top:12px;"><%= guardMessage %></div>
      </article>

      <article class="board-surface board-panel">
        <div class="panel-head">
          <div>
            <div class="panel-eyebrow">Integrity</div>
            <h3 class="panel-title">청산 무결성과 리듬</h3>
            <p class="panel-copy">divergence 경고와 최근 v3 cycle step 시간을 같이 봅니다.</p>
          </div>
        </div>
        <% if (divergencePositions.length) { %>
          <div class="list-stack">
            <% divergencePositions.slice(0, 4).forEach(function(pos) { %>
              <div class="row-card">
                <div class="row-head">
                  <div class="row-title"><%= shortSym(pos.symbol) %> · <%= sideLabel(pos.side) %></div>
                  <span class="tone-pill bad">divergence</span>
                </div>
                <div class="row-meta">canon <%= pos.exit_stage && pos.exit_stage.canonical_exit_stage ? pos.exit_stage.canonical_exit_stage : '-' %></div>
                <div class="row-submeta"><%= Array.isArray(pos.exit_stage && pos.exit_stage.stop_divergence_codes) ? pos.exit_stage.stop_divergence_codes.join(', ') : '-' %></div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="empty-state">현재 divergence 경고는 없습니다.</div>
        <% } %>

        <div class="timeline">
          <% if (v3RecentSteps.length) { v3RecentSteps.slice().reverse().forEach(function(step) { %>
            <div class="timeline-row">
              <div class="timeline-label"><%= step.step || '-' %></div>
              <div>
                <div class="timeline-step"><%= step.script || '-' %></div>
                <div class="timeline-meta"><%= step.ts ? formatTime(step.ts) : '-' %> · <%= step.duration_ms != null ? fmtN(step.duration_ms, 0) + 'ms' : '-' %></div>
              </div>
              <span class="tone-pill <%= step.rc === 0 ? 'ok' : 'bad' %>">rc <%= step.rc != null ? step.rc : '-' %></span>
            </div>
          <% }) } else { %>
            <div class="empty-state">최근 cycle step 로그가 없습니다.</div>
          <% } %>
        </div>
      </article>

      <article class="board-surface board-panel">
        <div class="panel-head">
          <div>
            <div class="panel-eyebrow">Markets</div>
            <h3 class="panel-title">주간 기여 마켓</h3>
            <p class="panel-copy">기존 성과 집계 기준 상위 기여 마켓만 요약했습니다.</p>
          </div>
        </div>
        <div class="market-grid">
          <% if (topMarkets.length) { topMarkets.forEach(function(market) { %>
            <div class="market-card">
              <div class="market-head">
                <div class="market-name"><%= shortSym(market.market || market.symbol || '-') %></div>
                <div class="market-value <%= toneClass(market.total_realized_krw) %>"><%= fmtSignedUnit(market.total_realized_krw) %></div>
              </div>
              <div class="row-submeta">trade <%= market.trades_n != null ? fmtN(market.trades_n, 0) : '-' %> · win rate <%= market.win_rate_pct != null ? fmtPlainPct(market.win_rate_pct, 1) : '-' %></div>
            </div>
          <% }) } else { %>
            <div class="empty-state">주간 기여 마켓 데이터가 없습니다.</div>
          <% } %>
        </div>
      </article>

      <article class="board-surface board-panel">
        <div class="panel-head">
          <div>
            <div class="panel-eyebrow">Recent exits</div>
            <h3 class="panel-title">v3 종료 기록</h3>
            <p class="panel-copy">exit ledger가 쌓이기 시작하면 여기서 바로 확인합니다.</p>
          </div>
        </div>
        <div class="list-stack">
          <% if (v3RecentExits.length) { v3RecentExits.slice(0, 5).forEach(function(exitRow) { %>
            <div class="row-card">
              <div class="row-head">
                <div class="row-title"><%= shortSym(exitRow.symbol) %> · <%= exitRow.exit_event || 'EXIT' %></div>
                <span class="tone-pill <%= badgeTone(n(exitRow.realized_pnl_pct) >= 0 ? 'OK' : 'BLOCK') %>"><%= exitRow.realized_pnl_pct != null ? fmtPlainPct(exitRow.realized_pnl_pct, 2) : '-' %></span>
              </div>
              <div class="row-meta"><%= formatTime(exitRow.closed_at) %> · R <%= exitRow.realized_r != null ? fmtN(exitRow.realized_r, 2) : '-' %></div>
            </div>
          <% }) } else { %>
            <div class="empty-state">아직 v3 exit ledger가 비어 있습니다.</div>
          <% } %>
        </div>
      </article>
    </aside>
  </section>
</div>

<script>
  (function () {
    var pulse = document.getElementById('pulse-time');
    if (pulse) {
      pulse.textContent = '기준 <%= as_of_kst ? String(as_of_kst).replace(/'/g, "\\'") : '-' %>';
    }
  })();
</script>

<%- include('partials/app_end_unified') %>
