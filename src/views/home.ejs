          <% } %>
        </div>
        <div class="k">실현</div>
        <div class="v mono">
          <%= fmtKrwSigned(budget_perf && budget_perf.total_realized_krw) %> <%= budgetUnit %>
          <% if (budgetUnit === "USDT") { %>
            <span class="subtle mono usdt-krw" data-usdt="<%= rawNum(budget_perf && budget_perf.total_realized_krw) %>">(≈ - KRW)</span>
          <% } %>
        </div>
        <div class="k">총 손익</div>
        <div class="v mono">
          <%= fmtKrwSigned(budget_perf && budget_perf.total_pnl_krw) %> <%= budgetUnit %>
          <% if (budgetUnit === "USDT") { %>
