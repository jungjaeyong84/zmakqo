<%- include('partials/app_start', { title: '대시보드 · DONBEOLJA Ω', pageTitle: '대시보드', active: 'home' }) %>

<%
  const budgetUnit = String(
    (budget_summary && budget_summary.unit) ||
    (budget_perf && budget_perf.unit) ||
    (String(exchange || "").includes("BINANCE") ? "USDT" : "KRW")
  ).toUpperCase();
  const fmtNum = (x) => (x == null || x === '' || Number.isNaN(Number(x))) ? '-' : Number(x).toLocaleString();
  const rawNum = (x) => {
    const n = Number(x);
    return Number.isFinite(n) ? n : '';
  };
  const fmtKrw = (x) => {
    const n = Number(x);
    if (!Number.isFinite(n)) return '-';
    if (budgetUnit === "USDT") {
      return n.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
    const cut = Math.trunc(n / 10) * 10;
    return cut.toLocaleString();
  };
  const fmtPct = (x) => (x == null || x === '' || Number.isNaN(Number(x))) ? '-' : (Number(x).toFixed(2) + '%');
  const fmtPctSigned = (x) => {
    const n = Number(x);
    if (!Number.isFinite(n)) return '-';
    const sign = n > 0 ? '+' : n < 0 ? '' : '';
    return sign + (n * 100).toFixed(2) + '%';
  };
  const fmtNumSigned = (x) => {
    const n = Number(x);
    if (!Number.isFinite(n)) return '-';
    const sign = n > 0 ? '+' : n < 0 ? '' : '';
    return sign + n.toLocaleString();
  };
  const fmtKrwSigned = (x) => {
    const n = Number(x);
    if (!Number.isFinite(n)) return '-';
    const sign = n > 0 ? '+' : n < 0 ? '' : '';
    if (budgetUnit === "USDT") {
      return sign + n.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
    const cut = Math.trunc(n / 10) * 10;
    return sign + cut.toLocaleString();
  };
  const fmtPctShort = (x) => {
    const n = Number(x);
    if (!Number.isFinite(n)) return '-';
    return (n * 100).toFixed(0) + '%';
  };
  const reportLink = (market) => {
    let url = "/dashboard/report?mode=weekly";
    if (weekly_range_perf && weekly_range_perf.from && weekly_range_perf.to) {
      url += `&from=${encodeURIComponent(weekly_range_perf.from)}&to=${encodeURIComponent(weekly_range_perf.to)}`;
    }
    if (market) url += `&market=${encodeURIComponent(market)}`;
    return url;
  };
  const fmtKst = (s) => {
    if (!s) return '-';
    const raw = String(s);
    if (raw.includes('KST')) return raw;
    const ms = Date.parse(raw);
    if (!Number.isFinite(ms)) return raw;
    const k = new Date(ms + 9 * 60 * 60 * 1000);
    const pad = (n) => String(n).padStart(2, '0');
    return `${k.getUTCFullYear()}-${pad(k.getUTCMonth() + 1)}-${pad(k.getUTCDate())} ${pad(k.getUTCHours())}:${pad(k.getUTCMinutes())}:${pad(k.getUTCSeconds())} KST`;
  };
  const stackColor = (x) => {
    const n = Number(x);
    if (!Number.isFinite(n)) return '#c9c9cc';
    if (n > 0) return '#0a7a5a';
    if (n < 0) return '#b42318';
    return '#8a8f98';
  };
  const kpiBadge = (st) => {
    const s = String(st || 'INCONCLUSIVE').toUpperCase();
    if (s === 'GREEN' || s === 'PASS') return 'ok';
    if (s === 'YELLOW' || s === 'WARN') return 'warn';
    if (s === 'RED' || s === 'FAIL') return 'bad';
    return 'dim';
  };
  const statusLabel = (st) => {
    const s = String(st || 'INCONCLUSIVE').toUpperCase();
    if (s === 'GREEN' || s === 'PASS') return '양호';
    if (s === 'YELLOW' || s === 'WARN') return '주의';
    if (s === 'RED' || s === 'FAIL') return '경고';
    if (s === 'INCONCLUSIVE' || s === 'NEED_DATA') return '보류';
    return st || '-';
  };
  const liveStatus = (sys) => {
    const s = sys || {};
    const exec = String(s.execution_mode || 'PAPER').toUpperCase();
    if (exec !== 'LIVE') return { label: 'PAPER', badge: 'dim' };
    if (s.live_dry_run) return { label: 'DRY RUN', badge: 'warn' };
    if (s.live_enabled) return { label: 'LIVE', badge: 'ok' };
    return { label: 'OFF', badge: 'bad' };
  };
  const parseAiBiasRaw = (raw) => {
    const key = String(raw || '').trim().toLowerCase();
    if (!key) return null;
    if (
      key === 'long' || key === 'bull' || key === 'up' ||
      key.includes('long') || key.includes('bull') ||
      key.includes('롱') || key.includes('상승')
    ) return 'long';
    if (
      key === 'short' || key === 'bear' || key === 'down' ||
      key.includes('short') || key.includes('bear') ||
      key.includes('숏') || key.includes('하락')
    ) return 'short';
    if (
      key === 'neutral' || key === 'flat' || key === 'none' ||
      key.includes('neutral') || key.includes('중립')
    ) return 'neutral';
    return null;
  };
  const aiBiasKey = (src) => {
    const obj = (src && typeof src === 'object') ? src : null;
    const side = (obj && obj.side_allocation && typeof obj.side_allocation === 'object') ? obj.side_allocation : null;
    const candidates = [
      side && side.bias_direction,
      obj && obj.bias_direction,
      obj && obj.direction,
      src,
    ];
    for (const c of candidates) {
      const parsed = parseAiBiasRaw(c);
      if (parsed) return parsed;
    }
    if (side) {
      const longPct = Number(side.long_pct);
      const shortPct = Number(side.short_pct);
      if (Number.isFinite(longPct) && Number.isFinite(shortPct)) {
        const diff = longPct - shortPct;
        if (Math.abs(diff) < 0.02) return 'neutral';
        return diff > 0 ? 'long' : 'short';
      }
    }
    const mode = String(obj ? (obj.mode || '') : '').toLowerCase();
    if (mode === 'aggressive') return 'long';
    if (mode === 'conservative') return 'short';
    return 'neutral';
  };
  const aiBiasLabel = (src) => {
    const key = aiBiasKey(src);
    if (key === 'long') return '롱우위';
    if (key === 'short') return '숏우위';
    return '중립';
  };
  const aiBiasBadge = (src) => {
    const key = aiBiasKey(src);
    if (key === 'long') return 'ok';
    if (key === 'short') return 'warn';
    return 'dim';
  };
  const aiReason = (r) => {
    if (!r) return '-';
    const s = String(r).trim();
    if (s.length <= 160) return s;
    return s.slice(0, 160) + '…';
  };
  const shortText = (txt, maxLen = 260) => {
    const s = String(txt || '').trim();
    if (!s) return '-';
    if (s.length <= maxLen) return s;
    return s.slice(0, maxLen) + '…';
  };
  const newsSourceLabel = (run) => {
    if (!run) return '-';
    const p = String(run.news_provider || '').trim();
    if (!p) return '-';
    const base = p.toLowerCase();
    return run.news_cached ? `${base} (cache)` : base;
  };
  const newsReasonLabel = (run) => {
    if (!run || !run.news_reason) return '-';
    const s = String(run.news_reason).trim();
    return s || '-';
  };
  const applyReasonLabel = (run, opts = {}) => {
    if (!run) return '-';
    if (run.applied) {
      if (run.news_ok === false) return '뉴스 실패 후 중립 fallback 적용';
      if (run.ensemble_used) return '앙상블 결과를 예산 설정에 반영';
      if (run.gpt_attempted || run.claude_attempted) return '개별 판단 또는 기본 정책을 예산 설정에 반영';
      return '현재 실행 결과를 예산 설정에 반영';
    }
    const s = String(run.apply_reason || '').trim();
    if (!s) return '-';
    const stale = !!opts.stale;
    const liveNow = !!opts.liveNow;
    if (s === 'LIVE_MODE_OFF' && liveNow) {
      return stale ? 'LIVE_MODE_OFF (최근 실행 기준, 현재 LIVE)' : 'LIVE_MODE_OFF (설정 확인 필요)';
    }
    if (stale) return `${s} (최근 실행 기준)`;
    return s;
  };
  const aiModelStatus = (attempted, ok) => {
    if (!attempted) return '-';
    return ok ? 'OK' : 'FAIL';
  };
  const applyStateLabel = (run) => {
    if (!run) return '-';
    if (!run.applied) return '미적용';
    if (run.news_ok === false) return '중립 fallback';
    if (run.ensemble_used) return '적용';
    return '기본 적용';
  };
  const ensembleUsageLabel = (cfg, run) => {
    if (!(cfg && cfg.ensemble_enabled)) return 'OFF';
    if (run && run.ensemble_used) return '사용';
    if (run && (run.gpt_attempted || run.claude_attempted || run.news_ok === false)) return '켜짐(이번 실행 미사용)';
    return '켜짐';
  };
  const aiEnsembleWeightLabel = (cfg, run) => {
    const g = Number(
      (cfg && cfg.ensemble_w_gpt != null) ? cfg.ensemble_w_gpt
        : (run && run.ensemble_w_gpt != null) ? run.ensemble_w_gpt
          : 0.6
    );
    const c = Number(
      (cfg && cfg.ensemble_w_claude != null) ? cfg.ensemble_w_claude
        : (run && run.ensemble_w_claude != null) ? run.ensemble_w_claude
          : 0.4
    );
    const gTxt = Number.isFinite(g) ? g.toFixed(2) : '-';
    const cTxt = Number.isFinite(c) ? c.toFixed(2) : '-';
    return `GPT ${gTxt} / Claude ${cTxt}`;
  };
  const aiScheduleLabel = (cfg) => {
    if (!cfg || cfg.enabled !== true) return '비활성';
    const minuteNum = Number(cfg.run_minute_kst);
    const minute = Number.isFinite(minuteNum)
      ? String(Math.max(0, Math.min(59, Math.trunc(minuteNum)))).padStart(2, '0')
      : '30';
    const arr = Array.isArray(cfg.run_hours_kst)
      ? cfg.run_hours_kst.filter((x) => Number.isFinite(Number(x))).map((x) => Number(x)).sort((a, b) => a - b)
      : [];
    if (arr.length) return `매일 ${arr.map((x) => `${String(x).padStart(2, '0')}:${minute}`).join(', ')} (KST)`;
    if (cfg.run_hour_kst != null) return `기본 ${String(cfg.run_hour_kst).padStart(2, '0')}:${minute} (KST)`;
    return '-';
  };
  const buildAiDeltas = (run) => {
    if (!run || !run.current_by_market || !run.next_by_market) return [];
    const cur = run.current_by_market || {};
    const nxt = run.next_by_market || {};
    const keys = Array.from(new Set([...Object.keys(cur), ...Object.keys(nxt)])).sort();
    const out = [];
    for (const k of keys) {
      const c = Number(cur[k] || 0);
      const n = Number(nxt[k] || 0);
      if (!Number.isFinite(c) && !Number.isFinite(n)) continue;
      const delta = n - c;
      if (!Number.isFinite(delta) || delta === 0) continue;
      out.push({ market: k, delta });
    }
    out.sort((a, b) => Math.abs(b.delta) - Math.abs(a.delta));
    return out.slice(0, 6);
  };
  const buildAiMajors = (run, limit = 5, filterFn = null, strict = false) => {
    if (!run) return [];
    const next = (run.next_by_market && typeof run.next_by_market === 'object') ? run.next_by_market : null;
    const cur = (run.current_by_market && typeof run.current_by_market === 'object') ? run.current_by_market : null;
    const src = next || cur || {};
    const rows = Object.entries(src).map(([market, value]) => ({
      market,
      value: Number(value),
    })).filter((x) => Number.isFinite(x.value));
    const filtered = (typeof filterFn === 'function') ? rows.filter((x) => filterFn(x.market)) : rows;
    const list = (strict && typeof filterFn === 'function') ? filtered : (filtered.length ? filtered : rows);
    list.sort((a, b) => b.value - a.value);
    return list.slice(0, Math.max(1, limit));
  };
  const buildAiDeltaRows = (run) => {
    if (!run || !run.current_by_market || !run.next_by_market) return [];
    const cur = run.current_by_market || {};
    const nxt = run.next_by_market || {};
    const keys = Array.from(new Set([...Object.keys(cur), ...Object.keys(nxt)])).sort();
    const rows = [];
    for (const k of keys) {
      const c = Number(cur[k] || 0);
      const n = Number(nxt[k] || 0);
      const delta = n - c;
      if (!Number.isFinite(c) && !Number.isFinite(n)) continue;
      rows.push({ market: k, cur: c, next: n, delta });
    }
    rows.sort((a, b) => Math.abs(b.delta) - Math.abs(a.delta));
    return rows;
  };
  const pnlBadge = (x) => {
    const n = Number(x);
    if (!Number.isFinite(n)) return 'dim';
    if (n > 0) return 'ok';
    if (n < 0) return 'bad';
    return 'warn';
  };
  const charterMismatch = (charter_check && Array.isArray(charter_check.checks))
    ? charter_check.checks.filter(c => !c.ok)
    : [];
  const charterTotal = (charter_check && Array.isArray(charter_check.checks))
    ? charter_check.checks.length
    : 0;
  const charterOkCount = Math.max(0, charterTotal - charterMismatch.length);
  const positionLabel = (st) => {
    const s = String(st || 'FLAT').toUpperCase();
    if (s === 'FLAT') return '대기';
    if (s === 'ACTIVE') return '보유';
    if (s === 'EXIT_ONLY') return '청산만';
    return st || '-';
  };
  const sideLabel = (side) => {
    const s = String(side || '').toUpperCase();
    if (s === 'BUY') return '매수';
    if (s === 'SELL') return '매도';
    if (s === 'HOLD') return '대기';
    return side || '-';
  };
  const exchangeLabel = (ex) => {
    const v = String(ex || "").toUpperCase();
    if (v.includes("BINANCE")) return "바이낸스";
    return "바이낸스";
  };
  const gateBadge = (g) => {
    const st = String(g && (g.status || g.overall_status) || '').toUpperCase();
    const sev = String(g && g.severity || '').toUpperCase();
    if (st === 'PASS') return 'ok';
    if (sev === 'SOFT') return 'warn';
    if (sev === 'HARD') return 'bad';
    return 'dim';
  };
  const gateLabel = (g) => {
    const st = String(g && g.status || '').toUpperCase();
    if (!st) return '-';
    if (st === 'PASS') return 'PASS';
    return st;
  };
  const gateReasonLabel = (code, g) => {
    const c = String(code || '').toUpperCase();
    if (!c) return '-';
    if (c === 'BAR_INTERVAL_MISMATCH') {
      const exp = g && g.metrics_json && g.metrics_json.interval_expected_ms;
      const act = g && g.metrics_json && g.metrics_json.interval_actual_ms;
      if (Number.isFinite(exp) && Number.isFinite(act)) {
        const expMin = Math.round(exp / 60000);
        const actMin = Math.round(act / 60000);
        return `봉 간격 불일치 (${actMin}m vs ${expMin}m)`;
      }
      return '봉 간격 불일치';
    }
    if (c === 'SESSION_GAP') return '세션 공백(장 종료)';
    if (c === 'BAR_LAG_TOO_HIGH') return '봉 지연';
    if (c === 'NOT_STABLE_ENOUGH') return '데이터 부족';
    if (c === 'NO_BARS') return '봉 없음';
    if (c === 'RATE_LIMIT_OR_FETCH_FAIL') return '데이터 조회 실패';
    return c;
  };
  const gateReasonText = (g) => {
    if (!g) return '-';
    const codes = Array.isArray(g.reason_codes) ? g.reason_codes : (Array.isArray(g.reasonCodes) ? g.reasonCodes : []);
    if (!codes.length) return '-';
    return codes.map((c) => gateReasonLabel(c, g)).join(', ');
  };
  const latestSignal = (signals12 && signals12.length) ? signals12[0] : null;
  const latestFill = (fills12 && fills12.length) ? fills12[0] : null;
  const leverageSummary = (typeof leverage_summary !== 'undefined' && leverage_summary) ? leverage_summary : null;
  const rollbackSummary = (typeof rollback_summary !== 'undefined' && rollback_summary) ? rollback_summary : null;
  const fmtLeverage = (v) => {
    const n = Number(v);
    if (!Number.isFinite(n) || n <= 0) return '-';
    const rounded = Math.round(n * 10) / 10;
    return `${rounded}x`;
  };
  const leverageBadge = (tier) => {
    const t = String(tier || '').toLowerCase();
    if (t === '3x') return 'warn';
    if (t === '2x') return 'ok';
    if (t.endsWith('x')) return 'dim';
    return 'dim';
  };
  const exitEventTag = (event) => {
    const ev = String(event || '').toUpperCase();
    let m = ev.match(/^EXIT_TP_P1_([0-9]+(?:\.[0-9]+)?)P$/);
    if (m) return `TP1_${m[1]}`;
    m = ev.match(/^EXIT_TP_C_([0-9]+(?:\.[0-9]+)?)P$/);
    if (m) return `TP1_${m[1]}`;
    m = ev.match(/^EXIT_TRAIL_([0-9]+(?:\.[0-9]+)?)P$/);
    if (m) return `TRAIL_${m[1]}`;
    m = ev.match(/^EXIT_SL_([0-9]+(?:\.[0-9]+)?)P$/);
    if (m) return `SL_${m[1]}`;
    m = ev.match(/^EXIT_BE_([0-9]+(?:\.[0-9]+)?)P$/);
    if (m) return `BE_${m[1]}`;
    if (ev.startsWith('EXIT_TP_P1')) return 'TP1';
    if (ev.startsWith('EXIT_TP_C')) return 'TP1';
    if (ev.startsWith('EXIT_TRAIL')) return 'TRAIL';
    if (ev.startsWith('EXIT_SL')) return 'SL';
    if (ev.startsWith('EXIT_BE')) return 'BE';
    return null;
  };
  const eventDisplay = (event) => {
    const rawUpper = String(event || '').toUpperCase();
    if (rawUpper === 'LONG') return 'LONG';
    if (rawUpper === 'SHORT') return 'SHORT';
    const entryMatch = rawUpper.match(/^(EARLY|CORE|PRE_REAL|REAL)_(LONG|SHORT)$/);
    if (entryMatch) return entryMatch[2];
    let raw = String(event || '-');
    raw = rawUpper.replace(/^EXIT_TP_C_([0-9]+(?:\.[0-9]+)?)P$/, 'EXIT_TP_P1_$1P');
    raw = raw === 'EXIT_TP_C' ? 'EXIT_TP_P1' : raw;
    const tag = exitEventTag(event);
    return tag ? `${raw} (${tag})` : raw;
  };
  const ratioToPctToken = (ratio, abs = false) => {
    const n = Number(ratio);
    if (!Number.isFinite(n)) return null;
    const pct = Math.round(((abs ? Math.abs(n) : n) * 100) * 100) / 100;
    const asInt = Math.round(pct);
    if (Math.abs(pct - asInt) < 1e-9) return String(asInt);
    return String(pct).replace(/\.?0+$/, '');
  };
  const parseMs = (v) => {
    if (!v) return null;
    const ms = Date.parse(String(v));
    return Number.isFinite(ms) ? ms : null;
  };
  const fmtRemain = (ms) => {
    const n = Number(ms);
    if (!Number.isFinite(n) || n <= 0) return '-';
    const totalSec = Math.max(0, Math.round(n / 1000));
    const h = Math.floor(totalSec / 3600);
    const m = Math.floor((totalSec % 3600) / 60);
    if (h > 0) return `${h}h ${m}m`;
    return `${m}m`;
  };
  const latestSignalMs = latestSignal ? parseMs(latestSignal.created_at || latestSignal.created_kst) : null;
  const latestFillMs = latestFill ? parseMs(latestFill.created_at || latestFill.created_kst) : null;
  const signalToFillMin = (latestSignalMs && latestFillMs)
    ? Math.round((latestFillMs - latestSignalMs) / 60000)
    : null;
  const decisionState = latestFill ? "EXECUTED" : (latestSignal ? "SIGNAL_ONLY" : "IDLE");
  const decisionLabel = (decisionState === "EXECUTED")
    ? "실행됨"
    : (decisionState === "SIGNAL_ONLY" ? "신호만" : "대기");
  const riskUsedPct = (budget_summary && budget_summary.total_used_pct != null)
    ? budget_summary.total_used_pct
    : null;
%>

<div class="section-head">
  <div class="section-title">시스템 핵심</div>
  <div class="subtle">판단 흐름과 손익 중심으로 간결하게 요약합니다.</div>
</div>

<div class="metric-grid">
  <div class="metric-card">
    <div class="metric-label">운영 상태</div>
    <div class="metric-value">
      <span class="pill <%= liveStatus(system_settings).badge %>"><%= liveStatus(system_settings).label %></span>
    </div>
    <div class="metric-meta mono">
      <%= runtime && runtime.mode ? runtime.mode : '-' %> · <%= runtime && runtime.engine_version ? runtime.engine_version : '-' %>
    </div>
  </div>
  <div class="metric-card">
    <div class="metric-label">게이트</div>
    <div class="metric-value">
      <span class="pill <%= gateBadge(gate_latest) %>"><%= gateLabel(gate_latest) %></span>
    </div>
    <div class="metric-meta"><%= gateReasonText(gate_latest) %></div>
  </div>
  <div class="metric-card">
    <div class="metric-label">리스크 사용률</div>
    <div class="metric-value">
      <%= (riskUsedPct == null) ? '-' : fmtPct(riskUsedPct) %>
    </div>
    <div class="metric-meta">
      <%= fmtKrw(budget_summary && budget_summary.total_used_krw) %> / <%= fmtKrw(budget_summary && budget_summary.total_max_krw) %> <%= budgetUnit %>
    </div>
  </div>
  <div class="metric-card">
    <div class="metric-label">총 손익</div>
    <div class="metric-value">
      <span class="pill <%= pnlBadge(budget_perf && budget_perf.total_pnl_krw) %>"><%= fmtKrwSigned(budget_perf && budget_perf.total_pnl_krw) %> <%= budgetUnit %></span>
      <% if (budgetUnit === "USDT") { %>
        <span class="subtle mono usdt-krw" data-usdt="<%= rawNum(budget_perf && budget_perf.total_pnl_krw) %>">(≈ - KRW)</span>
      <% } %>
    </div>
    <div class="metric-meta">
      성장률 <%= fmtPctSigned(budget_perf && budget_perf.growth_pct_total) %> · 실현(<%= (budget_perf && budget_perf.pnl_scope_days) ? budget_perf.pnl_scope_days : 730 %>일)+미실현
    </div>
  </div>
</div>

<div class="grid cols-2" style="margin-top:12px;">
  <div class="card">
    <h2>판단 흐름</h2>
    <div class="subtle">신호 → 게이트 → 실행 순으로 최신 판단을 요약합니다.</div>
    <div class="hr"></div>
    <div class="pipeline">
      <div class="pipeline-step <%= latestSignal ? 'ok' : 'dim' %>">
        <span class="pipeline-dot"></span>
        <div>
          <div class="pipeline-title">Signal</div>
          <div class="pipeline-meta">
            <%= latestSignal ? (fmtKst(latestSignal.created_kst || latestSignal.created_at) + " · " + (latestSignal.symbol || '-') + " · " + eventDisplay(latestSignal.event) + " · " + sideLabel(latestSignal.side)) : '최근 신호 없음' %>
            <% if (latestSignal && latestSignal.display_reason_external_fill) { %>
              · <span class="pill ok">외부체결 보정</span>
            <% } else if (latestSignal && latestSignal.display_reason_stage_text) { %>
              · <span class="subtle"><%= latestSignal.display_reason_stage_text %></span>
              <% if (latestSignal.display_reason_ko) { %>
                · <span class="subtle"><%= latestSignal.display_reason_ko %></span>
              <% } else if (latestSignal.display_reason) { %>
                · <span class="subtle"><%= latestSignal.display_reason %></span>
              <% } %>
            <% } else if (latestSignal && latestSignal.display_reason) { %>
              · <span class="subtle"><%= latestSignal.display_reason %></span>
            <% } %>
          </div>
        </div>
      </div>
      <div class="pipeline-step <%= gateBadge(gate_latest) %>">
        <span class="pipeline-dot"></span>
        <div>
          <div class="pipeline-title">Gate</div>
          <div class="pipeline-meta"><%= gateLabel(gate_latest) %> · <%= gateReasonText(gate_latest) %></div>
        </div>
      </div>
      <div class="pipeline-step <%= latestFill ? 'ok' : (latestSignal ? 'warn' : 'dim') %>">
        <span class="pipeline-dot"></span>
        <div>
          <div class="pipeline-title">Execution</div>
          <div class="pipeline-meta">
            <%= latestFill ? (fmtKst(latestFill.created_kst || latestFill.created_at) + " · " + (latestFill.symbol || '-') + " · " + eventDisplay(latestFill.event) + " · " + sideLabel(latestFill.side) + ((latestFill.leverage_tier || latestFill.leverage_applied != null) ? (" · " + (latestFill.leverage_tier || fmtLeverage(latestFill.leverage_applied))) : "")) : '체결 대기 또는 미발생' %>
            <% if (latestFill && latestFill.display_exec_text) { %>
              · <span class="subtle"><%= latestFill.display_exec_text %></span>
            <% } %>
            <% if (signalToFillMin != null) { %>
              · 지연 <%= fmtNum(signalToFillMin) %> 분
            <% } %>
          </div>
          <% if (latestFill && latestFill.display_exec_ko) { %>
            <div class="pipeline-meta subtle"><%= latestFill.display_exec_ko %></div>
          <% } %>
        </div>
      </div>
    </div>
    <div class="hr"></div>
    <div class="kv">
      <div class="k">상태</div>
      <div class="v"><span class="pill <%= decisionState === 'EXECUTED' ? 'ok' : (decisionState === 'SIGNAL_ONLY' ? 'warn' : 'dim') %>"><%= decisionLabel %></span></div>
      <div class="k">신호 최신</div><div class="v mono"><%= fmtKst(latestSignalsAt) %></div>
      <div class="k">체결 최신</div><div class="v mono"><%= fmtKst(latestFillsAt) %></div>
    </div>
  </div>
  <div class="card">
    <h2>손익 & 리스크 요약</h2>
    <div class="subtle">총손익 = 실현(최근 <%= (budget_perf && budget_perf.pnl_scope_days) ? budget_perf.pnl_scope_days : 730 %>일) + 미실현(현재 포지션)</div>
    <div class="hr"></div>
    <div class="kv">
      <div class="k">미실현</div>
      <div class="v mono">
        <%= fmtKrwSigned(budget_perf && budget_perf.total_unrealized_krw) %> <%= budgetUnit %>
        <% if (budgetUnit === "USDT") { %>
          <span class="subtle mono usdt-krw" data-usdt="<%= rawNum(budget_perf && budget_perf.total_unrealized_krw) %>">(≈ - KRW)</span>
        <% } %>
      </div>
      <div class="k">실현(최근 <%= (budget_perf && budget_perf.pnl_scope_days) ? budget_perf.pnl_scope_days : 730 %>일)</div>
      <div class="v mono">
        <%= fmtKrwSigned(budget_perf && budget_perf.total_realized_krw) %> <%= budgetUnit %>
        <% if (budgetUnit === "USDT") { %>
          <span class="subtle mono usdt-krw" data-usdt="<%= rawNum(budget_perf && budget_perf.total_realized_krw) %>">(≈ - KRW)</span>
        <% } %>
      </div>
      <div class="k">주간 실현</div>
      <div class="v mono">
        <%= fmtKrwSigned(weekly_range_perf && weekly_range_perf.total_realized_krw) %> <%= budgetUnit %>
        <% if (budgetUnit === "USDT") { %>
          <span class="subtle mono usdt-krw" data-usdt="<%= rawNum(weekly_range_perf && weekly_range_perf.total_realized_krw) %>">(≈ - KRW)</span>
        <% } %>
      </div>
      <div class="k">실현 소스</div><div class="v mono"><%= budget_perf && budget_perf.realized_source_mode ? budget_perf.realized_source_mode : '-' %></div>
      <div class="k">배율 상태</div>
      <div class="v">
        <% if (leverageSummary && leverageSummary.enabled) { %>
          <span class="pill ok">2x <%= fmtNum(leverageSummary.tier_2x || 0) %></span>
          <span class="pill warn">3x <%= fmtNum(leverageSummary.tier_3x || 0) %></span>
          <span class="subtle mono">· 활성 <%= fmtNum(leverageSummary.active_markets || 0) %></span>
        <% } else { %>
          <span class="pill dim">현물/비활성</span>
        <% } %>
      </div>
      <div class="k">롤백 상태</div>
      <div class="v">
        <% if (rollbackSummary && rollbackSummary.enabled) { %>
          <% const rbCount = Number(rollbackSummary.rollback_active || 0); %>
          <% if (rbCount > 0) { %>
            <span class="pill bad">활성 <%= fmtNum(rbCount) %></span>
            <span class="subtle mono">· 최대 남은 <%= fmtRemain(rollbackSummary.max_remaining_ms) %></span>
          <% } else { %>
            <span class="pill ok">비활성</span>
          <% } %>
        <% } else { %>
          <span class="pill dim">현물/비활성</span>
        <% } %>
      </div>
      <div class="k">리스크 상태</div>
      <div class="v">
        <span class="pill <%= (charter_check && charter_check.ok) ? 'ok' : 'warn' %>"><%= (charter_check && charter_check.ok) ? '정상' : '확인 필요' %></span>
      </div>
      <div class="k">방향 기준</div>
      <div class="v">
        <% if (budget_summary && budget_summary.source === 'ai_allocation') { %>
          <span class="pill <%= aiBiasBadge(ai_run_latest) %>">AI <%= aiBiasLabel(ai_run_latest) %></span>
          <% if (budget_summary.virtual) { %>
            <span class="subtle">· 미적용(가상)</span>
          <% } %>
        <% } else if (budget_summary && budget_summary.enabled) { %>
          <span class="pill dim">수동 예산</span>
        <% } else { %>
          <span class="pill dim">미설정</span>
        <% } %>
      </div>
    </div>
    <div class="hr"></div>
    <div class="subtle">판단 근거(데이터 커버리지)</div>
    <div class="hr"></div>
    <div class="kv">
      <div class="k">KPI 표본</div><div class="v mono"><%= coverage && coverage.min_n != null ? coverage.min_n : '-' %> / <%= coverage && coverage.kpi_min_n != null ? coverage.kpi_min_n : '-' %></div>
      <div class="k">상태</div><div class="v"><span class="pill <%= (coverage && coverage.label === 'DATA_OK') ? 'ok' : 'warn' %>"><%= coverage && coverage.label ? coverage.label : '-' %></span></div>
      <div class="k">메모</div><div class="v subtle"><%= coverage && coverage.note ? coverage.note : '-' %></div>
    </div>
  </div>
</div>

<details class="details-block" style="margin-top:14px;" open>
  <summary>운영 상세</summary>
  <div class="details-body">

<div class="grid cols-2">
  <div class="stack">
  <div class="card compact">
    <h2>운영 요약</h2>
    <div class="grid cols-2">
      <div>
        <div class="subtle">시스템</div>
        <div class="hr"></div>
        <div class="kv">
          <div class="k">실행 모드</div><div class="v mono"><%= runtime && runtime.mode ? runtime.mode : '-' %></div>
          <div class="k">엔진</div><div class="v mono"><%= runtime && runtime.engine_version ? runtime.engine_version : '-' %></div>
          <div class="k">실거래</div>
          <div class="v"><span class="pill <%= liveStatus(system_settings).badge %>"><%= liveStatus(system_settings).label %></span></div>
          <div class="k">신호 TF</div><div class="v mono"><%= signal_tf || '-' %></div>
          <div class="k">실행 TF</div><div class="v mono"><%= exec_tf || '-' %></div>
          <div class="k">금일 우위</div>
          <div class="v">
            <span class="pill <%= ai_mode_display ? aiBiasBadge(ai_mode_display) : 'dim' %>"><%= ai_mode_display ? aiBiasLabel(ai_mode_display) : '미산출' %></span>
            <% if (ai_mode_stale) { %><span class="pill warn">최근값(전일)</span><% } %>
          </div>
          <div class="k">우위 시각</div><div class="v mono"><%= ai_mode_display ? fmtKst(ai_mode_display.created_at) : '-' %></div>
          <div class="k">신호 최신(KST)</div><div class="v mono"><%= fmtKst(latestSignalsAt) %></div>
          <div class="k">체결 최신(KST)</div><div class="v mono"><%= fmtKst(latestFillsAt) %></div>
          <div class="k">게이트</div><div class="v"><span class="pill <%= gateBadge(gate_latest) %>"><%= gateLabel(gate_latest) %></span></div>
          <div class="k">게이트 사유</div><div class="v subtle"><%= gateReasonText(gate_latest) %></div>
        </div>
      </div>
      <div>
        <div class="subtle">데이터 커버리지</div>
        <div class="hr"></div>
        <div class="subtle">
          KPI 표본 수가 <b>최소 <%= coverage && coverage.kpi_min_n != null ? coverage.kpi_min_n : '-' %></b> 이상이면 EV/승률을 신뢰할 수 있습니다.
        </div>
        <div class="hr"></div>
        <div class="kv">
          <div class="k">상태</div><div class="v"><span class="pill <%= (coverage && coverage.label === 'DATA_OK') ? 'ok' : 'warn' %>"><%= coverage && coverage.label ? coverage.label : '-' %></span></div>
          <div class="k">최소 표본</div><div class="v mono"><%= coverage && coverage.min_n != null ? coverage.min_n : '-' %></div>
          <div class="k">메모</div><div class="v subtle"><%= coverage && coverage.note ? coverage.note : '-' %></div>
        </div>
        <div class="hr"></div>
        <div class="subtle">현장-구현 체크</div>
        <div class="hr"></div>
        <div class="kv">
          <div class="k">상태</div>
          <div class="v"><span class="pill <%= (charter_check && charter_check.ok) ? 'ok' : 'bad' %>"><%= (charter_check && charter_check.ok) ? 'OK' : '불일치' %></span></div>
          <div class="k">업데이트</div><div class="v mono"><%= charter_check && charter_check.updated_at ? fmtKst(charter_check.updated_at) : '-' %></div>
          <div class="k">일치</div><div class="v mono"><%= charterTotal ? (charterOkCount + '/' + charterTotal) : '-' %></div>
          <div class="k">요약</div>
          <div class="v subtle">
            <%= charterMismatch.length ? (charterMismatch[0].label + ' 불일치' + (charterMismatch.length > 1 ? (' 외 ' + (charterMismatch.length - 1) + '개') : '')) : '모든 규칙 일치' %>
          </div>
          <div class="k">불일치</div>
          <div class="v subtle">
            <% if (charterMismatch.length) { %>
              <% const _labels = charterMismatch.slice(0, 3).map(m => m.label); %>
              <%= _labels.join(', ') %><%= charterMismatch.length > 3 ? (' 외 ' + (charterMismatch.length - 3) + '개') : '' %>
            <% } else { %>
              -
            <% } %>
          </div>
          <div class="k">상세</div>
          <div class="v">
            <a class="btn ghost slim" href="<%= reportLink() %>">리포트에서 보기</a>
          </div>
        </div>
      </div>
    </div>
  </div>

    <div class="card">
      <% const _isBinance = String(exchange || '').toUpperCase().includes('BINANCE'); %>
      <% const fmtPctSummary = (value, min, max, abs = false) => {
        const minNum = Number(min);
        const maxNum = Number(max);
        if (Number.isFinite(minNum) && Number.isFinite(maxNum) && Math.abs(maxNum - minNum) > 1e-9) {
          return `${ratioToPctToken(minNum, abs) || '-'}~${ratioToPctToken(maxNum, abs) || '-'}`;
        }
        return ratioToPctToken(value, abs) || ratioToPctToken(min, abs) || '-';
      }; %>
      <h2>부분 익절 조건</h2>
      <div class="subtle">
        <%= tp_status && tp_status.rules_source_label ? tp_status.rules_source_label : `${exchangeLabel(exchange)} 기본 규칙` %>
        <%= tp_status && tp_status.exec_tf ? tp_status.exec_tf : '-' %> 봉 마감
        +<%= fmtPctSummary(tp_status && tp_status.threshold_pct, tp_status && tp_status.threshold_pct_min, tp_status && tp_status.threshold_pct_max) %>%
        (비중 <%= fmtPctSummary(tp_status && tp_status.tp_qty_pct, tp_status && tp_status.tp_qty_pct_min, tp_status && tp_status.tp_qty_pct_max) %>%)
        이후 남은 물량은 최소 +<%= fmtPctSummary(tp_status && tp_status.runner_min_profit_pct, tp_status && tp_status.runner_min_profit_pct_min, tp_status && tp_status.runner_min_profit_pct_max) %>% 수익 보호 기준 후
        트레일링 -<%= fmtPctSummary(tp_status && tp_status.trail_pct, tp_status && tp_status.trail_pct_min, tp_status && tp_status.trail_pct_max, true) %>% 기준입니다.
      </div>
      <div class="subtle mono">
        이벤트 키:
        SL_<%= fmtPctSummary(tp_status && tp_status.sl_pct, tp_status && tp_status.sl_pct_min, tp_status && tp_status.sl_pct_max, true) %>
        · TP1_<%= fmtPctSummary(tp_status && tp_status.threshold_pct, tp_status && tp_status.threshold_pct_min, tp_status && tp_status.threshold_pct_max) %>
        · TRAIL_<%= fmtPctSummary(tp_status && tp_status.trail_pct, tp_status && tp_status.trail_pct_min, tp_status && tp_status.trail_pct_max) %>
        · RUNNER_MIN_<%= fmtPctSummary(tp_status && tp_status.runner_min_profit_pct, tp_status && tp_status.runner_min_profit_pct_min, tp_status && tp_status.runner_min_profit_pct_max) %>
      </div>
      <% if (_isBinance) { %>
        <div class="subtle">선물 기준이며 레버리지 반영 수익률로 판단됩니다.</div>
      <% } %>
      <div class="hr"></div>
      <div class="kv">
        <div class="k">조건 충족</div>
        <div class="v">
          <span class="pill <%= (tp_status && tp_status.ready_count) ? 'ok' : 'dim' %>">
            <%= (tp_status && tp_status.ready_count) ? 'YES' : 'NO' %>
          </span>
