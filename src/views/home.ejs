        <% if (budgetUnit === "USDT") { %>
          <span class="subtle mono usdt-krw" data-usdt="<%= rawNum(budget_summary.total_used_krw) %>">(≈ - KRW)</span>
          <span class="subtle mono">/</span>
          <span class="subtle mono usdt-krw" data-usdt="<%= rawNum(budget_summary.total_max_krw) %>">(≈ - KRW)</span>
        <% } %>
      </div>
    <% } %>
  </div>
  <div class="scroll" style="max-height:420px;">
    <table>
      <thead>
        <tr>
          <th>마켓</th>
          <th>KPI 상태</th>
          <th>표본 수</th>
          <th>포지션</th>
          <th>청산 상태</th>
          <th>성장률</th>
          <th>최근 신호</th>
          <th>최근 체결</th>
        </tr>
      </thead>
      <tbody>
        <% (markets || []).forEach(m => { %>
          <tr>
            <td class="mono"><%= m.market %></td>
            <td>
              <span class="pill <%= kpiBadge(m.kpi && m.kpi.status) %>">
                <%= statusLabel(m.kpi && m.kpi.status) %>
              </span>
            </td>
            <td class="mono"><%= (m.kpi_n != null) ? m.kpi_n : '-' %></td>
            <td class="mono">
              <%= positionLabel(m.position && m.position.state) %>
              · <%= fmtPct(m.position && m.position.size_pct) %>
              <% if (m.position && m.position.leverage_tier) { %>
                · <span class="pill <%= leverageBadge(m.position.leverage_tier) %>"><%= m.position.leverage_tier %></span>
              <% } else if (m.position && m.position.leverage != null) { %>
                · <span class="pill dim"><%= fmtLeverage(m.position.leverage) %></span>
              <% } %>
              <% if (m.position && m.position.rollback_active) { %>
                · <span class="pill bad">롤백</span>
                <% if (m.position.rollback_remaining_ms != null) { %>
                  <span class="subtle mono"><%= fmtRemain(m.position.rollback_remaining_ms) %></span>
                <% } %>
              <% } %>
              <% if (m.position && m.position.avg_price != null) { %>
                · 평균가 <%= fmtKrw(m.position.avg_price) %>
              <% } %>
              <% if (m.position && (m.position.budget_used_krw != null || m.position.budget_max_krw != null)) { %>
                · 예산 <%= fmtKrw(m.position.budget_used_krw) %> / <%= fmtKrw(m.position.budget_max_krw) %>
              <% } %>
            </td>
            <td>
              <% if (m.exit_stage) { %>
                <% if (m.exit_stage.label && m.exit_stage.label !== 'TP1 대기') { %>
                  <span class="pill <%= m.exit_stage.pill %>"><%= m.exit_stage.label %></span>
                <% } %>
                <div class="subtle mono" style="margin-top:6px;">
                  <%= m.exit_stage.compact_headline.left_label %> <%= fmtKrw(m.exit_stage.compact_headline.left_price) %>
                  · <%= m.exit_stage.compact_headline.right_label %> <%= fmtKrw(m.exit_stage.compact_headline.right_price) %>
                </div>
                <div style="display:flex; flex-wrap:wrap; gap:6px; margin-top:6px;">
                  <% if (m.exit_stage.tp1_pending) { %>
                    <span class="pill warn">TP1 진행</span>
                  <% } %>
                  <% if (m.exit_stage.native_refresh_status && m.exit_stage.native_refresh_status !== 'OK') { %>
                    <span class="pill <%= m.exit_stage.native_refresh_status === 'FAILED' ? 'bad' : 'warn' %>">보호 <%= m.exit_stage.native_refresh_status %></span>
                  <% } %>
                  <% if (m.exit_stage.native_tp_status && m.exit_stage.native_tp_status !== 'OK' && m.exit_stage.native_tp_status !== m.exit_stage.native_refresh_status) { %>
                    <span class="pill <%= m.exit_stage.native_tp_status === 'FAILED' ? 'bad' : 'warn' %>">TP <%= m.exit_stage.native_tp_status %></span>
                  <% } %>
                  <% if (m.exit_stage.native_protection_stale) { %>
                    <span class="pill bad">보호 STALE</span>
                  <% } %>
                  <% if (m.exit_stage.tp1_skip_reason) { %>
                    <span class="pill bad"><%= m.exit_stage.tp1_skip_reason %></span>
                  <% } %>
                </div>
              <% } else { %>
                <span class="subtle">-</span>
              <% } %>
            </td>
            <td class="mono">
              <% if (m.growth_pct != null) { %>
                <span class="pill <%= pnlBadge(m.growth_pct) %>"><%= fmtPctSigned(m.growth_pct) %></span>
              <% } else { %>
                -
              <% } %>
            </td>
            <td class="mono">
              <% if (m.last_signal) { %>
                <%= fmtKst(m.last_signal.created_kst || m.last_signal.created_at) %>
                · <%= sideLabel(m.last_signal.side) %>
                · <%= eventDisplay(m.last_signal.event) %>
                <% if (m.last_signal.event_intent) { %> · <span class="subtle"><%= m.last_signal.event_intent %></span><% } %>
                <% if (m.last_signal.qty_pct != null) { %> · 비중 <%= fmtNum(m.last_signal.qty_pct) %><% } %>
                <% if (m.last_signal.late_by_bars != null && Number(m.last_signal.late_by_bars) !== 0) { %>
                  · 지연 <%= fmtNum(m.last_signal.late_by_bars) %> bar
                <% } %>
                <% if (m.last_signal.mapping_ok === false) { %> · <span class="pill bad">매핑 오류</span><% } %>
              <% } else { %>
                -
              <% } %>
            </td>
            <td class="mono">
              <% if (m.last_fill) { %>
                <%= fmtKst(m.last_fill.created_kst || m.last_fill.created_at) %>
                · <%= sideLabel(m.last_fill.side) %>
                · <%= eventDisplay(m.last_fill.event) %>
                <% if (m.last_fill.exec_price != null) { %> · <%= fmtKrw(m.last_fill.exec_price) %><% } %>
                <% if (m.last_fill.signal_price_diff_pct != null) { %>
                  · 신호대비 <%= fmtPctSigned(m.last_fill.signal_price_diff_pct) %>
                <% } %>
                <% if (m.last_fill.notional_krw != null) { %> · 체결금액 <%= fmtKrw(m.last_fill.notional_krw) %><% } %>
                <% if (m.last_fill.leverage_tier) { %>
                  · <span class="pill <%= leverageBadge(m.last_fill.leverage_tier) %>"><%= m.last_fill.leverage_tier %></span>
                <% } else if (m.last_fill.leverage_applied != null) { %>
                  · <span class="pill dim"><%= fmtLeverage(m.last_fill.leverage_applied) %></span>
                <% } %>
                <% if (m.last_fill.exec_price_source) { %> · <span class="subtle"><%= m.last_fill.exec_price_source %></span><% } %>
              <% } else { %>
                -
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

  </div>
</details>

