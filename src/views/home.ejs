      <div class="hr"></div>
      <% if (intent_failures && intent_failures.total) { %>
        <div class="kv">
          <div class="k">최근 실패 시각</div>
          <div class="v mono"><%= fmtKst(intent_failures.latest_at) %></div>
          <div class="k">최근 실패 건수</div>
          <div class="v mono"><%= fmtNum(intent_failures.total) %></div>
        </div>
