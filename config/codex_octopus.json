{
  "version": 1,
  "default_workflow": "general",
  "consensus": {
    "approve_ratio": 0.75,
    "min_available_subagents": 1
  },
  "providers": {
    "codex": {
      "type": "command",
      "enabled": true,
      "command": "/Applications/Codex.app/Contents/Resources/codex",
      "args": [
        "exec",
        "--skip-git-repo-check",
        "--dangerously-bypass-approvals-and-sandbox",
        "--cd",
        "{cwd}"
      ],
      "model": "gpt-5.4"
    },
    "claude": {
      "type": "claude_api",
      "enabled": true,
      "model": "claude-sonnet-4-6",
      "api_key_env": [
        "ANTHROPIC_API_KEY",
        "CLAUDE_API_KEY"
      ],
      "temperature": 0.2,
      "max_tokens": 1400,
      "cache_system": true
    },
    "gemini": {
      "type": "gemini_api",
      "enabled": true,
      "model": "gemini-2.5-pro",
      "api_key_env": [
        "GEMINI_API_KEY",
        "GOOGLE_API_KEY"
      ],
      "temperature": 0.2,
      "max_tokens": 1400,
      "retry_max": 2,
      "retry_base_ms": 1500
    }
  }
}
