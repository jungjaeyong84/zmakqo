<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.jeongjaeyong.donbeolja.openclawretrospect</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/zsh</string>
      <string>/Users/jeongjaeyong/Projects/donbeolja/ops/launchd/run_openclaw_retrospect.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/jeongjaeyong/Projects/donbeolja</string>

    <!-- Every 4 hours, offset 10 minutes so calibration runs first -->
    <key>StartCalendarInterval</key>
    <array>
      <dict><key>Hour</key><integer>0</integer><key>Minute</key><integer>15</integer></dict>
      <dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>15</integer></dict>
      <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>15</integer></dict>
      <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>15</integer></dict>
      <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>15</integer></dict>
      <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>15</integer></dict>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/jeongjaeyong/Projects/donbeolja/ops/runtime/openclaw_retrospect.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jeongjaeyong/Projects/donbeolja/ops/runtime/openclaw_retrospect.err.log</string>
  </dict>
</plist>
